-- ===============================================
-- MLP Compiler Driver (mlpdc.mlp)
-- ===============================================
-- Multi-Language Programming Compiler
-- Pipeline: Preprocessor → Lexer → Parser → Generator → Assembly
--
-- Bu ilk versiyon: Basit dosya okuma/yazma testi
-- ===============================================

YAZDIR "=== MLP Compiler Driver v0.1 ==="
YAZDIR ""

-- Dosya adlarını tanımla
METIN input_file = "test_input.mlp";
METIN output_file = "test_output.asm";

YAZDIR "Input: "
YAZDIR input_file
YAZDIR "Output: "
YAZDIR output_file
YAZDIR ""

-- Dosyayı oku
YAZDIR "1. Dosya okunuyor..."
METIN read_mode = "r";
SAYISAL file_handle = DOSYA_AC(input_file, read_mode);

EĞER file_handle == 0 İSE
    YAZDIR "HATA: Dosya açılamadı!"
DEĞİLSE
    YAZDIR "Dosya başarıyla açıldı"

    -- Dosya içeriğini oku
    METIN source_code = DOSYA_OKU(file_handle);
    SAYISAL close_result = DOSYA_KAPAT(file_handle);

    YAZDIR "Kaynak kod uzunluğu: "
    SAYISAL kod_uzunluk = STRING_UZUNLUK(source_code);
    YAZDIR kod_uzunluk
    YAZDIR ""

    -- =============================================
    -- STAGE 1: Preprocessor (TODO)
    -- =============================================
    YAZDIR "2. Preprocessor (TODO)"
    METIN preprocessed = source_code;

    -- =============================================
    -- STAGE 2: Lexer (TODO)
    -- =============================================
    YAZDIR "3. Lexer (TODO)"
    SAYISAL token_count = 0;

    -- =============================================
    -- STAGE 3: Parser (TODO)
    -- =============================================
    YAZDIR "4. Parser (TODO)"
    SAYISAL ast_count = 0;

    -- =============================================
    -- STAGE 4: Generator (TODO)
    -- =============================================
    YAZDIR "5. Code Generator (TODO)"

    -- Basit assembly template üret
    METIN asm_header = "extern printf";
    METIN asm_newline = "\n";
    METIN asm_data = "section .data";
    METIN asm_text = "section .text";
    METIN asm_global = "global main";
    METIN asm_main = "main:";
    METIN asm_push = "    push rbp";
    METIN asm_mov = "    mov rbp, rsp";
    METIN asm_xor = "    xor rax, rax";
    METIN asm_pop = "    pop rbp";
    METIN asm_ret = "    ret";

    -- Assembly kodunu birleştir
    METIN asm_code = STRING_BIRLESTIR(asm_header, asm_newline);
    asm_code = STRING_BIRLESTIR(asm_code, asm_data)
    asm_code = STRING_BIRLESTIR(asm_code, asm_newline)
    asm_code = STRING_BIRLESTIR(asm_code, asm_newline)
    asm_code = STRING_BIRLESTIR(asm_code, asm_text)
    asm_code = STRING_BIRLESTIR(asm_code, asm_newline)
    asm_code = STRING_BIRLESTIR(asm_code, asm_global)
    asm_code = STRING_BIRLESTIR(asm_code, asm_newline)
    asm_code = STRING_BIRLESTIR(asm_code, asm_main)
    asm_code = STRING_BIRLESTIR(asm_code, asm_newline)
    asm_code = STRING_BIRLESTIR(asm_code, asm_push)
    asm_code = STRING_BIRLESTIR(asm_code, asm_newline)
    asm_code = STRING_BIRLESTIR(asm_code, asm_mov)
    asm_code = STRING_BIRLESTIR(asm_code, asm_newline)
    asm_code = STRING_BIRLESTIR(asm_code, asm_xor)
    asm_code = STRING_BIRLESTIR(asm_code, asm_newline)
    asm_code = STRING_BIRLESTIR(asm_code, asm_pop)
    asm_code = STRING_BIRLESTIR(asm_code, asm_newline)
    asm_code = STRING_BIRLESTIR(asm_code, asm_ret)
    asm_code = STRING_BIRLESTIR(asm_code, asm_newline)

    -- Assembly kodunu dosyaya yaz
    YAZDIR "6. Assembly dosyasına yazılıyor..."
    METIN write_mode = "w";
    SAYISAL out_handle = DOSYA_AC(output_file, write_mode);

    EĞER out_handle == 0 İSE
        YAZDIR "HATA: Çıktı dosyası oluşturulamadı!"
    DEĞİLSE
        SAYISAL bytes_written = DOSYA_YAZ(out_handle, asm_code);
        SAYISAL close_out = DOSYA_KAPAT(out_handle);

        YAZDIR "Assembly kodu başarıyla yazıldı"
        YAZDIR "Yazılan byte sayısı: "
        YAZDIR bytes_written
    SON
SON

YAZDIR ""
YAZDIR "=== Compilation Pipeline Tamamlandı ==="
