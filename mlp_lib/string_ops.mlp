-- MLP String Operations Library
-- Pure MLP implementations of string functions
-- Phase 6.1: Runtime Migration

-- Convert string to uppercase
-- Returns: New string with all letters in uppercase
function string_to_upper(string input) returns string then
    if input == NULL then
        return NULL
    end
    
    numeric len = c_string_length(input)
    if len == 0 then
        return input
    end
    
    string result = c_malloc(len + 1)
    numeric i = 0
    
    while i < len then
        numeric ch = c_char_at(input, i)
        
        -- Check if lowercase letter (a-z is 97-122 in ASCII)
        if ch >= 97 then
            if ch <= 122 then
                ch = ch - 32  -- Convert to uppercase (A-Z is 65-90)
            end
        end
        
        c_set_char_at(result, i, ch)
        i = i + 1
    end
    
    c_set_char_at(result, len, 0)  -- Null terminator
    return result
end

-- Convert string to lowercase  
-- Returns: New string with all letters in lowercase
function string_to_lower(string input) returns string then
    if input == NULL then
        return NULL
    end
    
    numeric len = c_string_length(input)
    if len == 0 then
        return input
    end
    
    string result = c_malloc(len + 1)
    numeric i = 0
    
    while i < len then
        numeric ch = c_char_at(input, i)
        
        -- Check if uppercase letter (A-Z is 65-90 in ASCII)
        if ch >= 65 then
            if ch <= 90 then
                ch = ch + 32  -- Convert to lowercase (a-z is 97-122)
            end
        end
        
        c_set_char_at(result, i, ch)
        i = i + 1
    end
    
    c_set_char_at(result, len, 0)  -- Null terminator
    return result
end

-- Trim whitespace from both ends of string
-- Returns: New string without leading/trailing whitespace
function string_trim(string input) returns string then
    if input == NULL then
        return NULL
    end
    
    numeric len = c_string_length(input)
    if len == 0 then
        return input
    end
    
    -- Find first non-whitespace
    numeric start = 0
    while start < len then
        numeric ch = c_char_at(input, start)
        if ch == 32 then     -- space
            start = start + 1
        else
            if ch == 9 then  -- tab
                start = start + 1
            else
                if ch == 10 then  -- newline
                    start = start + 1
                else
                    if ch == 13 then  -- carriage return
                        start = start + 1
                    else
                        break
                    end
                end
            end
        end
    end
    
    -- All whitespace
    if start == len then
        return ""
    end
    
    -- Find last non-whitespace
    numeric end_pos = len - 1
    while end_pos > start then
        numeric ch = c_char_at(input, end_pos)
        if ch == 32 then
            end_pos = end_pos - 1
        else
            if ch == 9 then
                end_pos = end_pos - 1
            else
                if ch == 10 then
                    end_pos = end_pos - 1
                else
                    if ch == 13 then
                        end_pos = end_pos - 1
                    else
                        break
                    end
                end
            end
        end
    end
    
    -- Calculate new length
    numeric new_len = end_pos - start + 1
    string result = c_malloc(new_len + 1)
    
    -- Copy trimmed portion
    numeric i = 0
    while i < new_len then
        numeric ch = c_char_at(input, start + i)
        c_set_char_at(result, i, ch)
        i = i + 1
    end
    
    c_set_char_at(result, new_len, 0)
    return result
end
