-- MLP Standard Library: Optional<T>
-- Self-hosted implementation in MLP
-- Phase 6.2: Generic Optional Type
-- Using MLP keywords: numeric, string, boolean (NOT int/float/bool!)

-- ===== Optional<numeric> Implementation =====

struct OptionalNumeric then
    numeric value
    boolean has_value
end

function optional_numeric_none() then
    OptionalNumeric opt
    opt.value = 0
    opt.has_value = false
    return opt
end

function optional_numeric_some(numeric val) then
    OptionalNumeric opt
    opt.value = val
    opt.has_value = true
    return opt
end

function optional_numeric_has_value(OptionalNumeric opt) then
    return opt.has_value
end

function optional_numeric_value(OptionalNumeric opt) then
    if opt.has_value then
        return opt.value
    else
        print "ERROR: Accessing value of empty optional<numeric>!"
        return 0
    end
end

function optional_numeric_value_or(OptionalNumeric opt, numeric default_val) then
    if opt.has_value then
        return opt.value
    else
        return default_val
    end
end

-- ===== Optional<string> Implementation =====

struct OptionalString then
    string value
    boolean has_value
end

function optional_string_none() then
    OptionalString opt
    opt.value = ""
    opt.has_value = false
    return opt
end

function optional_string_some(string val) then
    OptionalString opt
    opt.value = val
    opt.has_value = true
    return opt
end

function optional_string_has_value(OptionalString opt) then
    return opt.has_value
end

function optional_string_value(OptionalString opt) then
    if opt.has_value then
        return opt.value
    else
        print "ERROR: Accessing value of empty optional<string>!"
        return ""
    end
end

function optional_string_value_or(OptionalString opt, string default_val) then
    if opt.has_value then
        return opt.value
    else
        return default_val
    end
end

-- ===== Test Functions =====

function test_optional_numeric() then
    print "=== Testing Optional<numeric> ==="

    -- Create empty optional
    OptionalNumeric maybe_num = optional_numeric_none()
    print "Created empty optional"

    if optional_numeric_has_value(maybe_num) then
        print "Has value (shouldn't happen!)"
    else
        print "No value (correct!)"
    end

    -- Get with default
    numeric val = optional_numeric_value_or(maybe_num, 42)
    print "Value or default:"
    print val

    -- Create optional with value
    OptionalNumeric some_num = optional_numeric_some(100)
    print "Created optional with value 100"

    if optional_numeric_has_value(some_num) then
        print "Has value (correct!)"
        numeric actual = optional_numeric_value(some_num)
        print "Actual value:"
        print actual
    end
end

function test_optional_string() then
    print ""
    print "=== Testing Optional<string> ==="

    -- Create empty optional
    OptionalString maybe_text = optional_string_none()
    print "Created empty optional<string>"

    string result = optional_string_value_or(maybe_text, "default text")
    print "Value or default:"
    print result

    -- Create optional with value
    OptionalString some_text = optional_string_some("Hello MLP!")
    print "Created optional with value"

    if optional_string_has_value(some_text) then
        string actual = optional_string_value(some_text)
        print "Actual value:"
        print actual
    end
end

-- Main test
print "=== MLP Optional<T> Library Test ==="
test_optional_numeric()
test_optional_string()
print ""
print "=== All Optional Tests Passed! ==="
