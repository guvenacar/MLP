-- Phase 5.4 Test: Modulo and Logical Operators

print "=== Testing Modulo Operator ==="

int a = 17;
int b = 5;
int remainder = a % b;
print "17 % 5 = "
print remainder

print ""
print "=== Testing Logical AND ==="

int x = 5;
int y = 10;

if x > 0 and y > 0 then
    print "Both x and y are positive"
end

if x > 100 and y > 0 then
    print "This should NOT print"
else
    print "x > 100 is false, so AND fails"
end

print ""
print "=== Testing Logical OR ==="

if x > 100 or y > 5 then
    print "At least one condition is true (y > 5)"
end

if x > 100 or y > 100 then
    print "This should NOT print"
else
    print "Both conditions are false"
end

print ""
print "=== Phase 5.4 Tests Complete ==="
