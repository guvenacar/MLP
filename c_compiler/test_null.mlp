-- Phase 5.6 Test: null keyword

print "=== Testing null Keyword ==="

int ptr = null;
print "ptr value (should be 0): "
print ptr

if ptr == null then
    print "ptr equals null"
end

if ptr == 0 then
    print "null equals 0 - correct!"
end

-- Setting non-null value
ptr = 42
if ptr != null then
    print "ptr is no longer null"
end

print ""
print "=== Phase 5.6 null Test Complete ==="
