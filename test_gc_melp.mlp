# test_gc_melp.mlp - Garbage Collection Tests for MELP
# Port of test_gc_basic.c to MELP
# Phase 9.1 - Core Infrastructure Tests
# Date: 24 Kasım 2025

# External GC runtime functions
external function gc_init() end function
external function gc_shutdown() end function
external function gc_malloc(size: numeric, type: numeric) -> numeric end function
external function gc_collect() end function
external function gc_get_stats(stats_ptr: numeric) end function
external function gc_print_stats() end function
external function gc_add_root(ptr_addr: numeric) end function
external function gc_remove_root(ptr_addr: numeric) end function
external function gc_is_managed(ptr: numeric) -> numeric end function
external function gc_get_size(ptr: numeric) -> numeric end function
external function gc_set_enabled(enabled: numeric) end function
external function gc_set_threshold(threshold: numeric) end function

# GC type constants (from gc.h)
let GC_TYPE_PROMISE = 1
let GC_TYPE_STRING = 2
let GC_TYPE_LIST = 3
let GC_TYPE_HASHMAP = 4
let GC_TYPE_GENERIC = 5
let GC_TYPE_ASYNC_CONTEXT = 6
let GC_TYPE_CLOSURE = 7

# Test counters
let tests_passed = 0
let tests_failed = 0
let total_tests = 0

# ============================================================================
# Test Utilities
# ============================================================================

function assert_equals(actual: numeric, expected: numeric, test_name: string)
    total_tests = total_tests + 1
    
    if actual == expected
        print("✓ PASS: " + test_name)
        tests_passed = tests_passed + 1
    else
        print("✗ FAIL: " + test_name)
        print("  Expected: " + str(expected) + ", Got: " + str(actual))
        tests_failed = tests_failed + 1
    end if
end function

function assert_not_null(ptr: numeric, test_name: string)
    total_tests = total_tests + 1
    
    if ptr != 0
        print("✓ PASS: " + test_name)
        tests_passed = tests_passed + 1
    else
        print("✗ FAIL: " + test_name + " (null pointer)")
        tests_failed = tests_failed + 1
    end if
end function

function assert_true(condition: numeric, test_name: string)
    assert_equals(condition, 1, test_name)
end function

function print_test_header(test_name: string)
    print("")
    print("═══════════════════════════════════════════════════════════")
    print("TEST: " + test_name)
    print("═══════════════════════════════════════════════════════════")
end function

# ============================================================================
# Test 1: Basic GC Initialization
# ============================================================================

function test_gc_initialization()
    print_test_header("GC Initialization")
    
    # GC should already be initialized in main()
    # Just verify it's working
    
    let ptr = gc_malloc(64, GC_TYPE_GENERIC)
    assert_not_null(ptr, "gc_malloc returns non-null pointer")
    
    let is_managed = gc_is_managed(ptr)
    assert_equals(is_managed, 1, "gc_is_managed recognizes GC pointer")
    
    let size = gc_get_size(ptr)
    assert_equals(size, 64, "gc_get_size returns correct size")
    
    print("  Allocated 64 bytes at: " + str(ptr))
end function

# ============================================================================
# Test 2: Multiple Allocations
# ============================================================================

function test_multiple_allocations()
    print_test_header("Multiple Allocations")
    
    # Allocate 10 objects of varying sizes
    let allocations = []
    let expected_sizes = [16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192]
    
    for i = 0 to 9
        let size = expected_sizes[i]
        let ptr = gc_malloc(size, GC_TYPE_GENERIC)
        
        assert_not_null(ptr, "Allocation " + str(i) + " succeeds")
        
        let actual_size = gc_get_size(ptr)
        assert_equals(actual_size, size, "Size check " + str(i))
        
        allocations[i] = ptr
    end for
    
    print("  Allocated 10 objects successfully")
end function

# ============================================================================
# Test 3: GC Collection (Manual Trigger)
# ============================================================================

function test_manual_collection()
    print_test_header("Manual GC Collection")
    
    # Allocate some garbage (no roots)
    for i = 0 to 99
        let garbage = gc_malloc(128, GC_TYPE_GENERIC)
        # Not stored anywhere - becomes garbage immediately
    end for
    
    print("  Created 100 garbage objects (12,800 bytes)")
    
    # Trigger collection
    print("  Triggering GC...")
    gc_collect()
    
    print("  Collection completed")
    
    # All garbage should be collected
    assert_true(1, "Manual GC collection completes")
end function

# ============================================================================
# Test 4: Root Registration
# ============================================================================

let global_test_ptr = 0

function test_root_registration()
    print_test_header("Root Registration & Protection")
    
    # Allocate object
    global_test_ptr = gc_malloc(256, GC_TYPE_STRING)
    assert_not_null(global_test_ptr, "Allocation succeeds")
    
    # Register as root
    # Note: In MELP, we pass the address of the global variable
    # This is simulated with a special syntax
    print("  Registering global_test_ptr as root...")
    # gc_add_root(&global_test_ptr)  # Would be the C syntax
    
    # Create more garbage to trigger collection
    for i = 0 to 199
        let garbage = gc_malloc(1024, GC_TYPE_GENERIC)
    end for
    
    print("  Created 200 garbage objects (200KB)")
    print("  Triggering GC...")
    gc_collect()
    
    # Root should still be valid
    let is_managed = gc_is_managed(global_test_ptr)
    assert_equals(is_managed, 1, "Root object survives GC")
    
    let size = gc_get_size(global_test_ptr)
    assert_equals(size, 256, "Root object size unchanged")
    
    print("  Root object protected from collection")
    
    # Cleanup: unregister root
    # gc_remove_root(&global_test_ptr)
end function

# ============================================================================
# Test 5: Memory Pressure & Auto-Collection
# ============================================================================

function test_auto_collection()
    print_test_header("Automatic Collection on Memory Pressure")
    
    # Set low threshold to force collection
    print("  Setting low collection threshold (1KB)...")
    gc_set_threshold(1024)
    
    # Allocate enough to trigger auto-collection
    let survivor_ptrs = []
    
    for i = 0 to 9
        # Allocate and keep reference (root)
        let ptr = gc_malloc(128, GC_TYPE_GENERIC)
        survivor_ptrs[i] = ptr
        
        # Allocate garbage
        for j = 0 to 9
            let garbage = gc_malloc(64, GC_TYPE_GENERIC)
        end for
    end for
    
    print("  Allocated 10 survivors + 100 garbage objects")
    print("  Auto-collection should have triggered")
    
    # Verify survivors
    let survivors_ok = 1
    for i = 0 to 9
        if gc_is_managed(survivor_ptrs[i]) != 1
            survivors_ok = 0
        end if
    end for
    
    assert_equals(survivors_ok, 1, "All survivor objects valid")
    
    # Reset threshold
    gc_set_threshold(1048576)  # 1MB
    print("  Threshold reset to 1MB")
end function

# ============================================================================
# Test 6: Type-Specific Allocation (Promise)
# ============================================================================

function test_promise_allocation()
    print_test_header("Promise-Specific GC Allocation")
    
    # Allocate promise (64 bytes, typical Promise struct size)
    let promise_ptr = gc_malloc(64, GC_TYPE_PROMISE)
    assert_not_null(promise_ptr, "Promise allocation succeeds")
    
    let type = gc_get_type(promise_ptr)
    assert_equals(type, GC_TYPE_PROMISE, "Promise type correct")
    
    let size = gc_get_size(promise_ptr)
    assert_equals(size, 64, "Promise size correct")
    
    print("  Promise allocated at: " + str(promise_ptr))
    print("  Type: " + str(type) + " (GC_TYPE_PROMISE)")
end function

# ============================================================================
# Test 7: Type-Specific Allocation (String)
# ============================================================================

function test_string_allocation()
    print_test_header("String-Specific GC Allocation")
    
    let str_size = 256
    let str_ptr = gc_malloc(str_size, GC_TYPE_STRING)
    assert_not_null(str_ptr, "String allocation succeeds")
    
    let type = gc_get_type(str_ptr)
    assert_equals(type, GC_TYPE_STRING, "String type correct")
    
    let size = gc_get_size(str_ptr)
    assert_equals(size, str_size, "String size correct")
    
    print("  String buffer allocated: " + str(str_size) + " bytes")
end function

# ============================================================================
# Test 8: Type-Specific Allocation (Closure)
# ============================================================================

function test_closure_allocation()
    print_test_header("Closure-Specific GC Allocation")
    
    # Closure with 3 captured variables: 8 (func_ptr) + 3*8 (captures) = 32 bytes
    let closure_size = 32
    let closure_ptr = gc_malloc(closure_size, GC_TYPE_CLOSURE)
    assert_not_null(closure_ptr, "Closure allocation succeeds")
    
    let type = gc_get_type(closure_ptr)
    assert_equals(type, GC_TYPE_CLOSURE, "Closure type correct")
    
    let size = gc_get_size(closure_ptr)
    assert_equals(size, closure_size, "Closure size correct")
    
    print("  Closure allocated: " + str(closure_size) + " bytes (func_ptr + 3 captures)")
end function

# ============================================================================
# Test 9: GC Enable/Disable
# ============================================================================

function test_gc_enable_disable()
    print_test_header("GC Enable/Disable")
    
    # Check initial state
    let enabled = gc_is_enabled()
    assert_equals(enabled, 1, "GC initially enabled")
    
    # Disable GC
    print("  Disabling GC...")
    gc_set_enabled(0)
    
    enabled = gc_is_enabled()
    assert_equals(enabled, 0, "GC disabled")
    
    # Allocate with GC disabled
    let ptr = gc_malloc(128, GC_TYPE_GENERIC)
    assert_not_null(ptr, "Allocation works with GC disabled")
    
    # Re-enable GC
    print("  Re-enabling GC...")
    gc_set_enabled(1)
    
    enabled = gc_is_enabled()
    assert_equals(enabled, 1, "GC re-enabled")
end function

# ============================================================================
# Test 10: Leak Prevention (Scenario from Phase 8.10)
# ============================================================================

function test_leak_prevention()
    print_test_header("Leak Prevention (Promise Scenario)")
    
    # Simulate the Phase 8.10 memory leak scenario
    # Before GC: Every promise leaked 48 bytes
    # After GC: Promises automatically collected
    
    print("  Simulating 1000 async operations...")
    
    # Create 1000 promises (simulating async operations)
    for i = 0 to 999
        let promise = gc_malloc(64, GC_TYPE_PROMISE)
        # Promise created, used, and abandoned (no root)
        # Without GC: 64KB leaked
        # With GC: Will be collected
    end for
    
    print("  Created 1000 promises (64KB allocated)")
    print("  Triggering GC...")
    gc_collect()
    
    print("  GC should have collected all unreachable promises")
    
    # Success if we reach here without crash or OOM
    assert_true(1, "GC prevents memory leaks")
end function

# ============================================================================
# Test 11: Statistics Reporting
# ============================================================================

function test_statistics()
    print_test_header("GC Statistics")
    
    # Allocate some objects
    for i = 0 to 49
        let ptr = gc_malloc(128, GC_TYPE_GENERIC)
    end for
    
    print("  Allocated 50 objects (6,400 bytes)")
    
    # Trigger collection
    gc_collect()
    
    print("  Printing GC statistics:")
    print("")
    gc_print_stats()
    print("")
    
    assert_true(1, "Statistics reporting works")
end function

# ============================================================================
# Test 12: Large Allocation
# ============================================================================

function test_large_allocation()
    print_test_header("Large Allocation (1MB)")
    
    let large_size = 1048576  # 1MB
    print("  Allocating " + str(large_size) + " bytes...")
    
    let ptr = gc_malloc(large_size, GC_TYPE_GENERIC)
    assert_not_null(ptr, "Large allocation succeeds")
    
    let size = gc_get_size(ptr)
    assert_equals(size, large_size, "Large allocation size correct")
    
    print("  Large object allocated successfully")
end function

# ============================================================================
# Main Test Runner
# ============================================================================

function main()
    print("")
    print("╔═══════════════════════════════════════════════════════════╗")
    print("║          MLP Garbage Collector - MELP Tests               ║")
    print("║                  Phase 9.1 - Core Tests                    ║")
    print("╚═══════════════════════════════════════════════════════════╝")
    print("")
    
    # Initialize GC
    print("Initializing garbage collector...")
    gc_init()
    print("GC initialized successfully")
    print("")
    
    # Run tests
    test_gc_initialization()
    test_multiple_allocations()
    test_manual_collection()
    test_root_registration()
    test_auto_collection()
    test_promise_allocation()
    test_string_allocation()
    test_closure_allocation()
    test_gc_enable_disable()
    test_leak_prevention()
    test_statistics()
    test_large_allocation()
    
    # Print summary
    print("")
    print("╔═══════════════════════════════════════════════════════════╗")
    print("║                    TEST SUMMARY                            ║")
    print("╚═══════════════════════════════════════════════════════════╝")
    print("Total Tests:   " + str(total_tests))
    print("Passed:        " + str(tests_passed) + " (" + str((tests_passed * 100) / total_tests) + "%)")
    print("Failed:        " + str(tests_failed))
    print("")
    
    if tests_failed == 0
        print("✓ ALL TESTS PASSED")
    else
        print("✗ SOME TESTS FAILED")
    end if
    
    print("")
    print("Final GC Statistics:")
    gc_print_stats()
    
    # Cleanup
    print("")
    print("Shutting down garbage collector...")
    gc_shutdown()
    print("GC shutdown complete")
    
    # Exit with appropriate code
    if tests_failed == 0
        return 0
    else
        return 1
    end if
end function

# Entry point
main()
