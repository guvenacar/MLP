-- ===============================================
-- My First MLP Project - Main File
-- ===============================================
-- A simple calculator program to demonstrate MLP

-- Function to add two numbers
IŞLEÇ topla(SAYISAL a, SAYISAL b) -> SAYISAL
    DÖNÜŞ a + b;
IŞLEÇ SON

-- Function to multiply two numbers
IŞLEÇ çarp(SAYISAL a, SAYISAL b) -> SAYISAL
    DÖNÜŞ a * b;
IŞLEÇ SON

-- Main program
YAZDIR "=================================";
YAZDIR "  Hoş Geldiniz - MLP Hesap Makinesi";
YAZDIR "=================================";
YAZDIR "";

SAYISAL sayi1 = 15;
SAYISAL sayi2 = 25;

YAZDIR "İlk sayı: " + sayi1;
YAZDIR "İkinci sayı: " + sayi2;
YAZDIR "";

SAYISAL sonuc_toplam = topla(sayi1, sayi2);
YAZDIR "Toplam: " + sayi1 + " + " + sayi2 + " = " + sonuc_toplam;

SAYISAL sonuc_carpim = çarp(sayi1, sayi2);
YAZDIR "Çarpım: " + sayi1 + " × " + sayi2 + " = " + sonuc_carpim;

YAZDIR "";
YAZDIR "Program başarıyla tamamlandı!";
