-- MLP Full Feature Demo
-- Tests functions and control flow

-- Global variables
numeric counter = 0
numeric total = 0

-- Function: Add two numbers
function add(numeric a, numeric b) numeric
    numeric result = 0
    result = a + b
    return result
end function

-- Function: Calculate factorial (with control flow)
function factorial(numeric n) numeric
    numeric result = 1
    numeric i = 1
    
    while i <= n then
        result = result * i
        i = i + 1
    end while
    
    return result
end function

-- Main function
function main() numeric
    numeric x = 5
    numeric y = 3
    numeric sum = 0
    
    -- Call add function
    sum = add(x, y)
    
    -- Calculate factorial
    numeric fact = factorial(5)
    
    -- Control flow
    if sum > 0 then
        counter = counter + 1
    end if
    
    return 0
end function
