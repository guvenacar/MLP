-- Phase 6: list<T> test
-- Tests: int list, string list, all operations

print "=== Phase 6: list<T> Test ==="

-- Test 1: Integer list
print ""
print "--- Test 1: Integer List ---"
list<int> numbers = list<int>()

-- Add elements
numbers.add(10)
numbers.add(20)
numbers.add(30)
print "Added 3 numbers (10, 20, 30)"

-- Get elements
int first = numbers.get(0)
int second = numbers.get(1)
int third = numbers.get(2)
print "First: "
print first
print "Second: "
print second
print "Third: "
print third

-- Length
int len = numbers.length()
print "Length: "
print len

-- Set element
numbers.set(1, 999)
int updated = numbers.get(1)
print "After set(1, 999): "
print updated

-- Insert element
numbers.insert(0, 5)
int inserted = numbers.get(0)
print "After insert(0, 5): "
print inserted

len = numbers.length()
print "Length after insert: "
print len

-- Remove element
numbers.remove(0)
int after_remove = numbers.get(0)
print "After remove(0), first element: "
print after_remove

len = numbers.length()
print "Length after remove: "
print len

-- Test 2: String list
print ""
print "--- Test 2: String List ---"
list<string> names = list<string>()

names.add("Ali")
names.add("Veli")
names.add("Ayşe")
print "Added 3 names"

string name1 = names.get(0)
string name2 = names.get(1)
string name3 = names.get(2)
print "Names: "
print name1
print ", "
print name2
print ", "
print name3

len = names.length()
print "Names count: "
print len

-- Clear
numbers.clear()
len = numbers.length()
print ""
print "--- After clear() ---"
print "Numbers list length: "
print len

print ""
print "=== All List Tests Passed! ==="
