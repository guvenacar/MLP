-- Phase 6: List test
print "=== List Test ==="

list<int> numbers = list<int>();
numbers.add(10)
numbers.add(20)
numbers.add(30)
print "Added 3 numbers"

int first = numbers.get(0);
print "First:"
print first

int len = numbers.length();
print "Length:"
print len

numbers.set(1, 999)
int updated = numbers.get(1);
print "After set:"
print updated

print "=== Complete ==="
