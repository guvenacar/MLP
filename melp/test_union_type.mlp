-- Test: Phase 11 - Union Types
-- Variable can hold multiple types
-- Syntax: numeric | string | boolean x

-- Simple union type
numeric | boolean x

x = 42
print(x)

x = 1  -- true (1 = true, 0 = false)
print(x)

-- Union with text (stored as first type for now)
numeric | text | boolean y
y = 100
print(y)

-- Union in function parameter would need runtime type checking
-- For now, just test declaration and assignment
numeric | decimal result
result = 55
print(result)

print(999)
