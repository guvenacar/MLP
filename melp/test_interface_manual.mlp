interface Drawable
    yaz draw()
    yaz getArea() returns numeric
end interface

struct Circle implements Drawable
    numeric radius
end struct

yaz Circle_draw(Circle c)
    yazdir(5)
    yazdir(c.radius)
end yaz

yaz Circle_getArea(Circle c) returns numeric
    dondur c.radius * c.radius
end yaz

yaz main() returns numeric
    Circle c
    c.radius = 10
    Circle_draw(c)
    numeric area = Circle_getArea(c)
    yazdir(area)
    yazdir(999)
    dondur 0
end yaz
