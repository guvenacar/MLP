-- Test null safety - simpler version

-- Regular null initialization
numeric x = 0  -- null is 0 in MELP
print(x == 0)  -- Should print 1 (true) - null check

-- Non-null value
numeric y = 42
print(y == 0)  -- Should print 0 (false) - not null
print(y)       -- Should print 42

-- Null check pattern
if y != 0 then
    print(100)  -- Should print 100
end if

if x == 0 then
    print(200)  -- Should print 200
end if

-- Reassignment
x = 99
print(x == 0)  -- Should print 0 (false) - not null anymore
print(x)       -- Should print 99

print(999)  -- Final marker
