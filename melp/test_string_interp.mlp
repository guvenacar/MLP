-- Test string interpolation

text name = "Alice"
numeric age = 25

-- Basic interpolation
text greeting = $"Hello, {name}!"
print(greeting)

-- Multiple expressions
text info = $"Name: {name}, Age: {age}"
print(info)

-- With calculations
numeric x = 10
numeric y = 20
text result = $"Sum: {x + y}, Product: {x * y}"
print(result)

print(999)  -- Final marker
