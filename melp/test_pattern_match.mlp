-- Test pattern matching (Phase 17)

-- Test 1: Single value match
numeric x = 3
match x
    case 1 => print(100)
    case 2 => print(200)
    case 3 => print(300)
    case _ => print(999)
end match

print(1000)

-- Test 2: Multiple values (comma separated)
numeric y = 5
match y
    case 1, 2 => print(110)
    case 3, 4, 5 => print(220)
    case 6, 7 => print(330)
    case _ => print(999)
end match

print(2000)

-- Test 3: Range matching
numeric z = 7
match z
    case 1 to 5 => print(111)
    case 6 to 10 => print(222)
    case 11 to 20 => print(333)
    case _ => print(999)
end match

print(3000)

-- Test 4: Wildcard only (default case)
numeric w = 100
match w
    case 1 => print(10)
    case 2 => print(20)
    case _ => print(444)
end match

print(4000)
