-- Test pattern matching

-- Test 1: Range matching (case 1 to 5)
numeric x = 3
switch x
    case 1 to 5
        print(100)  -- Should match
    case 6 to 10
        print(200)
    default
        print(0)
end switch

-- Test 2: Guard conditions (case x if x > 10)
numeric y = 15
switch y
    case 10 if y > 12
        print(300)  -- Should match (10 with guard y > 12)
    case 20
        print(400)
    default
        print(0)
end switch

-- Test 3: Type checking (case is null)
numeric z = 0  -- null
switch z
    case is null
        print(500)  -- Should match
    case 1
        print(600)
    default
        print(0)
end switch

-- Test 4: Combined - range with guard
numeric w = 7
switch w
    case 1 to 5
        print(700)
    case 6 to 10 if w > 8
        print(800)
    case 6 to 10 if w <= 8
        print(900)  -- Should match (7 is in range 6 to 10 and <= 8)
    default
        print(0)
end switch

print(999)  -- Final marker
