-- Test struct type as function parameter

struct Vector2D
    numeric x
    numeric y
end struct

-- Function that takes struct parameters
func addVectors(Vector2D a, Vector2D b)
    Vector2D result
    result.x = a.x + b.x
    result.y = a.y + b.y
    return result
end func

func main()
    Vector2D v1
    v1.x = 10
    v1.y = 20
    
    Vector2D v2
    v2.x = 5
    v2.y = 15
    
    Vector2D v3
    v3 = addVectors(v1, v2)
    
    print(v3.x)  -- Should print 15
    print(v3.y)  -- Should print 35
    print(999)   -- Final marker
    return 0
end func
