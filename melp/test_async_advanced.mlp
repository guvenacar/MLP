-- Advanced async/await test
-- Multiple async functions with await chains

async func multiply(numeric a, numeric b)
    return a * b
end func

async func add(numeric x, numeric y)
    return x + y
end func

async func calculate()
    numeric mult = await multiply(3, 4)
    numeric sum = await add(mult, 10)
    return sum
end func

-- Call async chain
numeric result = calculate()
print(result)

-- Direct await
numeric direct = await multiply(5, 6)
print(direct)
