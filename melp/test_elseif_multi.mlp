-- Test else if - multiple cases
numeric x = 15

if x > 10 then
    print(1)
else if x > 5 then
    print(2)
else if x > 2 then
    print(3)
else
    print(0)
end if

numeric y = 4

if y > 10 then
    print(10)
else if y > 5 then
    print(20)
else if y > 2 then
    print(30)
else
    print(40)
end if

numeric z = 1

if z > 10 then
    print(100)
else if z > 5 then
    print(200)
else if z > 2 then
    print(300)
else
    print(400)
end if

print(999)
