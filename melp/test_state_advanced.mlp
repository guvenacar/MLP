-- Advanced State Management Test (Phase 18)

-- Test multiple state variables
state numeric counter = 100
state numeric total = 0
state numeric multiplier = 5

-- Print initial values
print("=== Initial Values ===")
print(counter)
print(total)
print(multiplier)

-- Test assignment
counter = 200
print("=== After counter = 200 ===")
print(counter)

-- Test arithmetic with state
total = counter + multiplier
print("=== total = counter + multiplier ===")
print(total)

-- Test subtraction
counter = counter - 50
print("=== counter = counter - 50 ===")
print(counter)

-- Test multiplication
total = multiplier * 10
print("=== total = multiplier * 10 ===")
print(total)

-- Test division
total = total / 2
print("=== total = total / 2 ===")
print(total)

-- Test combining multiple state variables
total = counter + multiplier * 2
print("=== total = counter + multiplier * 2 ===")
print(total)

-- Test state in condition
print("=== Testing state in condition ===")
if counter > 100 then
    print("Counter is greater than 100")
else
    print("Counter is 100 or less")
end if

-- Test state in loop
print("=== Testing state in loop ===")
counter = 0
for i in range(1, 6)
    counter = counter + i
    print(counter)
end for

print("=== Final State Values ===")
print(counter)
print(total)
print(multiplier)

print("=== END ===")
