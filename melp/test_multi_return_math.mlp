-- Test: Multiple Return Values with Math Operations
-- Function that returns sum and difference

numeric a
numeric b
numeric sum_result
numeric diff_result

func math_ops(numeric x, numeric y) returns numeric, numeric
    numeric sum
    numeric diff
    
    sum = x + y
    diff = x - y
    
    return sum, diff
end func

a = 100
b = 30

sum_result, diff_result = math_ops(a, b)

print(sum_result)    -- Should print 130
print(diff_result)   -- Should print 70

-- Test with direct values
numeric result1
numeric result2
result1, result2 = math_ops(50, 20)

print(result1)  -- Should print 70
print(result2)  -- Should print 30

print(999)
