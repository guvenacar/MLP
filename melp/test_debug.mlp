-- Test debug features
-- Production'da bu satırlar silinmeli

numeric x = 5
print(x)

-- Debug label
debug mylabel

x = x + 1
print(x)

-- Debug pause (breakpoint)
debug pause

-- Normal if içinde debug goto
if x > 3 then
    print(100)
    debug goto mylabel
end if

-- Debug if bloğu
debug if x < 10 then
    print(999)
    debug goto mylabel  -- debug if içinde de debug yazmalı
debug end if

print(777)
