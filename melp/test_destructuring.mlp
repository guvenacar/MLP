-- Test destructuring (array and struct unpacking)

func main()
    -- Test 1: Array destructuring (3 elements)
    numeric[3] arr
    arr[0] = 10
    arr[1] = 20
    arr[2] = 30
    
    numeric a, b, c = arr
    print(a)  -- Should print 10
    print(b)  -- Should print 20
    print(c)  -- Should print 30
    
    -- Test 2: Partial array destructuring
    numeric[5] arr2
    arr2[0] = 100
    arr2[1] = 200
    arr2[2] = 300
    arr2[3] = 400
    arr2[4] = 500
    
    numeric x, y = arr2  -- Only unpack first 2 elements
    print(x)  -- Should print 100
    print(y)  -- Should print 200
    
    print(999)  -- Final marker
    return 0
end func
