-- Phase 20 Test: Bitwise Operations

-- Test band (AND): 12 & 10 = 8
-- 12 = 1100
-- 10 = 1010
-- AND= 1000 = 8
numeric a = band(12, 10)
print(a)  -- Should print 8

-- Test bor (OR): 12 | 10 = 14
-- 12 = 1100
-- 10 = 1010
-- OR = 1110 = 14
numeric b = bor(12, 10)
print(b)  -- Should print 14

-- Test bxor (XOR): 12 ^ 10 = 6
-- 12 = 1100
-- 10 = 1010
-- XOR= 0110 = 6
numeric c = bxor(12, 10)
print(c)  -- Should print 6

-- Test shl (shift left): 3 << 2 = 12
-- 3 = 11 -> 1100 = 12
numeric d = shl(3, 2)
print(d)  -- Should print 12

-- Test shr (shift right): 12 >> 2 = 3
-- 12 = 1100 -> 11 = 3
numeric e = shr(12, 2)
print(e)  -- Should print 3

-- Combined test
numeric val = 5
val = shl(val, 1)   -- 5 << 1 = 10
val = bor(val, 1)   -- 10 | 1 = 11
print(val)          -- Should print 11

print("Bitwise tests completed!")
