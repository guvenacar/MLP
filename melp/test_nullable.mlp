-- Test nullable types

-- Test 1: Nullable numeric with null initialization
numeric? maybe_num = null
if maybe_num == null then
    print(1)  -- Should print (is null)
end if

-- Test 2: Assign a value to nullable
maybe_num = 42
if maybe_num != null then
    print(maybe_num)  -- Should print 42
end if

-- Test 3: Nullable with initial value
numeric? another = 100
if another != null then
    print(another)  -- Should print 100
end if

-- Test 4: Reset to null
another = null
if another == null then
    print(2)  -- Should print (is null again)
end if

print(999)  -- Final marker
