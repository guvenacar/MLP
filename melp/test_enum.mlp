-- Test enum support

-- Define an enum
enum Status
    Pending = 0
    Active = 1
    Done = 2
end enum

-- Use enum values
numeric x = Status.Pending
print(x)  -- Should print 0

numeric y = Status.Active
print(y)  -- Should print 1

numeric z = Status.Done
print(z)  -- Should print 2

-- Use in conditions
if x == Status.Pending then
    print(10)  -- Should print
end if

if y == Status.Done then
    print(20)  -- Should NOT print
else
    print(30)  -- Should print
end if

-- Another enum
enum Color
    Red = 100
    Green = 200
    Blue = 300
end enum

numeric color = Color.Green
print(color)  -- Should print 200

print(999)  -- Final marker
