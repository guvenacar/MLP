-- TTO Double Arithmetic Test

print("=== Double + Double ===")
numeric a = 3.14159
numeric b = 2.71828
numeric c = a + b
print(c)

numeric d = a - b
print(d)

numeric e = a * b
print(e)

numeric f = a / b
print(f)

print("=== Int + Double (Mixed) ===")
numeric x = 10
numeric y = 2.5
numeric z = x + y
print(z)

numeric w = x * y
print(w)

numeric v = x / y
print(v)

print("=== Double + Int (Mixed) ===")
numeric p = 3.5
numeric q = 2
numeric r = p + q
print(r)

numeric s = p * q
print(s)

print("=== Complex Expression ===")
numeric result = 1.5 + 2.5 * 3.0
print(result)

print("TTO Double Arithmetic Complete!")
