-- Interface/Trait Module Test

-- Define a trait (interface)
trait Drawable
    function draw(self)
    function area(self): numeric
end trait

-- Implement trait for Circle
impl Drawable for Circle
    function draw(self)
        print "Drawing circle"
    end function
    function area(self): numeric
        return 3.14
    end function
end impl

-- Variables
numeric x = 42
text result = "trait test"
