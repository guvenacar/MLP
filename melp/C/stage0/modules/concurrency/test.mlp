-- Thread operations
spawn thread worker1 {
    print("Worker 1 running")
}
spawn thread worker2 {
    print("Worker 2 running")
}
join(worker1)
detach(worker2)

-- Go-style goroutine
go func() {
    print("Goroutine running")
}

-- Mutex operations
let m: Mutex = Mutex::new()
m.lock()
m.unlock()
m.try_lock()

-- Channel operations
let ch: Channel<numeric> = Channel::new()
ch.send(42)
ch.recv()

-- Atomic operations
let counter: Atomic<numeric> = Atomic::new(0)
counter.load()
counter.store(10)
counter.fetch_add(1)
counter.compare_exchange(10, 20)

-- Sync primitives
let sem: Semaphore = Semaphore::new(5)
let bar: Barrier = Barrier::new(3)
let cv: CondVar = CondVar::new()

-- Control structures
parallel_for i in range(0, 10) {
    process(i)
}

select {
    case msg = <- ch:
        handle(msg)
    default:
        skip()
}
