-- Lambda ve Closure Modülü
-- Anonim fonksiyonlar ve capture mekanizması

-- Lambda tipleri
numeric LAMBDA_SIMPLE = 0       -- Basit lambda (capture yok)
numeric LAMBDA_CLOSURE = 1      -- Closure (capture var)

-- Capture modları
numeric CAPTURE_BY_VALUE = 0    -- Değer ile capture (kopya)
numeric CAPTURE_BY_REF = 1      -- Referans ile capture (pointer)

-- Lambda syntax varyasyonları
numeric SYNTAX_PIPE = 0         -- |x, y| => expr
numeric SYNTAX_BRACKET = 1      -- [x, y](a, b) => expr
numeric SYNTAX_FN = 2           -- fn(x, y) => expr

-- Higher-order fonksiyonlar
numeric HOF_MAP = 0             -- map(collection, lambda)
numeric HOF_FILTER = 1          -- filter(collection, predicate)
numeric HOF_REDUCE = 2          -- reduce(collection, lambda, initial)
numeric HOF_FOREACH = 3         -- foreach(collection, lambda)
numeric HOF_ANY = 4             -- any(collection, predicate)
numeric HOF_ALL = 5             -- all(collection, predicate)

-- Closure özellikler
numeric CLOSURE_MUTABLE = 1     -- Capture edilenler değiştirilebilir
numeric CLOSURE_IMMUTABLE = 0   -- Capture edilenler salt okunur
