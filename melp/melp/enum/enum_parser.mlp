-- Enum Parser Modülü
-- Parse işlemleri sabitleri

-- Enum definition parse
numeric PARSE_ENUM_KEYWORD = 0       -- enum
numeric PARSE_ENUM_NAME = 1
numeric PARSE_ENUM_GENERIC = 2       -- <T> (optional)
numeric PARSE_ENUM_LBRACE = 3        -- {
numeric PARSE_ENUM_VARIANTS = 4
numeric PARSE_ENUM_RBRACE = 5        -- }

-- Variant parse
numeric PARSE_VAR_NAME = 0
numeric PARSE_VAR_LPAREN = 1         -- ( (tuple)
numeric PARSE_VAR_TUPLE_DATA = 2
numeric PARSE_VAR_RPAREN = 3         -- )
numeric PARSE_VAR_LBRACE = 4         -- { (struct)
numeric PARSE_VAR_STRUCT_FIELDS = 5
numeric PARSE_VAR_RBRACE = 6         -- }
numeric PARSE_VAR_EQUALS = 7         -- = (explicit discriminant)
numeric PARSE_VAR_DISC = 8
numeric PARSE_VAR_COMMA = 9          -- ,

-- Match parse
numeric PARSE_MATCH_KEYWORD = 0      -- match
numeric PARSE_MATCH_EXPR = 1
numeric PARSE_MATCH_LBRACE = 2       -- {
numeric PARSE_MATCH_ARMS = 3
numeric PARSE_MATCH_RBRACE = 4       -- }

-- Match arm parse
numeric PARSE_ARM_PATTERN = 0        -- Red, Some(x), _
numeric PARSE_ARM_ARROW = 1          -- =>
numeric PARSE_ARM_BODY = 2
numeric PARSE_ARM_COMMA = 3          -- ,
