-- Interface/Trait Codegen Modülü
-- Assembly üretimi sabitleri

-- Register kullanımı
numeric REG_TRAIT_OBJ = 0            -- rax: trait object pointer
numeric REG_VTABLE = 1               -- rbx: vtable pointer
numeric REG_DATA = 2                 -- rdi: data pointer (self)
numeric REG_METHOD_PTR = 3           -- rcx: method pointer

-- Trait object layout offsets
numeric OBJ_VTABLE_OFF = 0           -- 0: vtable pointer
numeric OBJ_DATA_OFF = 8             -- 8: data pointer
numeric OBJ_TRAIT_DEF_OFF = 16       -- 16: trait def pointer
numeric OBJ_TOTAL_SIZE = 24          -- 24 bytes total

-- VTable layout
numeric VTABLE_TRAIT_OFF = 0         -- Trait def pointer
numeric VTABLE_METHODS_OFF = 8       -- Method array start
numeric VTABLE_METHOD_SIZE = 8       -- 8 bytes per method

-- Calling convention (trait methods)
numeric PARAM_SELF = 0               -- rdi: self pointer
numeric PARAM_1 = 1                  -- rsi: param 1
numeric PARAM_2 = 2                  -- rdx: param 2
numeric PARAM_3 = 3                  -- rcx: param 3

-- Dispatch type
numeric DISPATCH_DIRECT = 0          -- Direct call (static)
numeric DISPATCH_VTABLE = 1          -- VTable lookup (dynamic)

-- Label tipleri
numeric LABEL_TRAIT_DEF = 0
numeric LABEL_TRAIT_IMPL = 1
numeric LABEL_VTABLE = 2
numeric LABEL_METHOD = 3
numeric LABEL_DISPATCH = 4
