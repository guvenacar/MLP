-- Switch/Match Modülü - Çoklu Dallanma
-- Switch (C-style) ve Match (pattern matching)

-- Case tipleri
numeric CASE_VALUE = 0          -- Değer eşleşmesi
numeric CASE_PATTERN = 1        -- Pattern eşleşmesi
numeric CASE_RANGE = 2          -- Aralık (1..10)
numeric CASE_CONDITION = 3      -- Koşul (when x > 5)
numeric CASE_DEFAULT = 4        -- Varsayılan (default/_)

-- Kontrol stratejileri
numeric STRATEGY_JUMP_TABLE = 0     -- Jump table (hızlı, ardışık değerler)
numeric STRATEGY_LINEAR = 1         -- Linear search (genel)
numeric STRATEGY_BINARY = 2         -- Binary search (sıralı değerler)
numeric STRATEGY_HASH = 3           -- Hash table (string değerler)

-- Match özellikleri
numeric MATCH_EXHAUSTIVE = 1        -- Tüm durumlar kapsamlı
numeric MATCH_PARTIAL = 0           -- Kısmi eşleşme

-- Fall-through davranışı
numeric FALLTHROUGH_NONE = 0        -- Fall-through yok (MLP default)
numeric FALLTHROUGH_EXPLICIT = 1    -- Açık fall-through (C-style)
