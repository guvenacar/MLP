-- Asenkron Programlama Parser Sabitleri
-- Async/await syntax parsing

-- Async function parse durumları
numeric PARSE_ASYNC_KEYWORD = 0     -- "async" keyword
numeric PARSE_ASYNC_FUNCTION = 1    -- "function" keyword
numeric PARSE_ASYNC_NAME = 2        -- Fonksiyon adı
numeric PARSE_ASYNC_PARAMS = 3      -- Parametreler
numeric PARSE_ASYNC_RETURN = 4      -- Return type (Future<T>)
numeric PARSE_ASYNC_BODY = 5        -- Fonksiyon gövdesi

-- Await expression parse durumları
numeric PARSE_AWAIT_KEYWORD = 10    -- "await" keyword
numeric PARSE_AWAIT_TARGET = 11     -- Beklenen hedef
numeric PARSE_AWAIT_TIMEOUT = 12    -- Opsiyonel timeout
numeric PARSE_AWAIT_CANCEL = 13     -- Opsiyonel cancel flag

-- Future.then() chain parse durumları
numeric PARSE_THEN_DOT = 20         -- "." operatörü
numeric PARSE_THEN_METHOD = 21      -- "then", "catch", "finally"
numeric PARSE_THEN_PAREN = 22       -- "(" açılış
numeric PARSE_THEN_CALLBACK = 23    -- Callback fonksiyonu
numeric PARSE_THEN_CLOSE = 24       -- ")" kapanış
numeric PARSE_THEN_NEXT = 25        -- Sonraki chain

-- Promise parse durumları
numeric PARSE_PROMISE_NEW = 30      -- "new Promise()"
numeric PARSE_PROMISE_VAR = 31      -- Promise değişkeni
numeric PARSE_PROMISE_DOT = 32      -- "." operatörü
numeric PARSE_PROMISE_METHOD = 33   -- "resolve", "reject", "get_future"
numeric PARSE_PROMISE_ARGS = 34     -- Method argümanları

-- Async generator parse durumları
numeric PARSE_GEN_ASYNC = 40        -- "async" keyword
numeric PARSE_GEN_FUNCTION = 41     -- "function*" keyword
numeric PARSE_GEN_NAME = 42         -- Generator adı
numeric PARSE_GEN_PARAMS = 43       -- Parametreler
numeric PARSE_GEN_BODY = 44         -- Generator gövdesi
numeric PARSE_GEN_YIELD = 45        -- "yield" statement

-- Await combinator parse durumları
numeric PARSE_AWAIT_ALL = 50        -- "await_all"
numeric PARSE_AWAIT_ANY = 51        -- "await_any"
numeric PARSE_AWAIT_RACE = 52       -- "await_race"
numeric PARSE_AWAIT_ARRAY_OPEN = 53 -- "[" açılış
numeric PARSE_AWAIT_ARRAY_ITEMS = 54 -- Future array elemanları
numeric PARSE_AWAIT_ARRAY_CLOSE = 55 -- "]" kapanış

-- Keyword tanıma
numeric KW_ASYNC = 100              -- "async"
numeric KW_AWAIT = 101              -- "await"
numeric KW_FUTURE = 102             -- "Future"
numeric KW_PROMISE = 103            -- "Promise"
numeric KW_YIELD = 104              -- "yield"
numeric KW_THEN = 105               -- "then"
numeric KW_CATCH = 106              -- "catch"
numeric KW_FINALLY = 107            -- "finally"
numeric KW_RESOLVE = 108            -- "resolve"
numeric KW_REJECT = 109             -- "reject"
numeric KW_AWAIT_ALL = 110          -- "await_all"
numeric KW_AWAIT_ANY = 111          -- "await_any"
numeric KW_AWAIT_RACE = 112         -- "await_race"

-- Syntax kontrol bayrakları
numeric SYNTAX_ASYNC_REQUIRED = 1   -- async keyword gerekli
numeric SYNTAX_AWAIT_IN_ASYNC = 1   -- await sadece async içinde
numeric SYNTAX_YIELD_IN_GEN = 1     -- yield sadece generator içinde
numeric SYNTAX_CHAIN_ALLOWED = 1    -- Chain'leme izin veriliyor

-- Parse hata kodları
numeric ERROR_NO_ASYNC = 1          -- async keyword eksik
numeric ERROR_AWAIT_OUTSIDE = 2     -- await async dışında kullanılmış
numeric ERROR_YIELD_OUTSIDE = 3     -- yield generator dışında
numeric ERROR_INVALID_FUTURE = 4    -- Geçersiz Future türü
numeric ERROR_INVALID_PROMISE = 5   -- Geçersiz Promise
numeric ERROR_CHAIN_SYNTAX = 6      -- Chain syntax hatası
numeric ERROR_MISSING_CALLBACK = 7  -- Callback eksik

-- Context tracking
numeric CTX_IN_ASYNC = 200          -- Async fonksiyon içinde
numeric CTX_IN_GENERATOR = 201      -- Generator içinde
numeric CTX_IN_AWAIT = 202          -- Await expression içinde
numeric CTX_IN_CHAIN = 203          -- Future chain içinde
