-- Asenkron Programlama Codegen Sabitleri
-- Assembly generation için sabitler

-- Register kullanımı
numeric REG_FUTURE_PTR = 0          -- rdi: Future pointer
numeric REG_PROMISE_PTR = 1         -- rsi: Promise pointer
numeric REG_VALUE = 2               -- rdx: Value
numeric REG_ERROR = 3               -- rcx: Error
numeric REG_CALLBACK = 4            -- r8: Callback function pointer
numeric REG_STATE = 5               -- al: State byte
numeric REG_TASK_PTR = 6            -- r9: Task pointer
numeric REG_RUNTIME_PTR = 7         -- r10: Runtime pointer

-- Stack frame layout (rbp offset'leri - pozitif değerler kullanılacak)
numeric STACK_FUTURE = 8            -- [rbp - 8]: Future pointer
numeric STACK_PROMISE = 16          -- [rbp - 16]: Promise pointer
numeric STACK_VALUE = 24            -- [rbp - 24]: Return value
numeric STACK_ERROR = 32            -- [rbp - 32]: Error value
numeric STACK_STATE = 40            -- [rbp - 40]: Async state
numeric STACK_CONTEXT = 296         -- [rbp - 296]: Context (256 bytes)
numeric STACK_TASK = 304            -- [rbp - 304]: Task pointer
numeric STACK_RUNTIME = 312         -- [rbp - 312]: Runtime pointer

-- Async state machine durumları (assembly içinde)
numeric STATE_INITIAL = 0           -- İlk çalıştırma
numeric STATE_SUSPENDED = 1         -- Suspend edilmiş
numeric STATE_RESUMED = 2           -- Resume edilmiş
numeric STATE_COMPLETED = 3         -- Tamamlanmış
numeric STATE_FAILED = 4            -- Başarısız

-- Label prefix'leri
numeric LABEL_ASYNC_FUNC = 0        -- .async_func_
numeric LABEL_INITIAL = 1           -- .initial
numeric LABEL_RESUME = 2            -- .resume
numeric LABEL_SUSPEND = 3           -- .suspend
numeric LABEL_DONE = 4              -- .done
numeric LABEL_AWAIT_READY = 5       -- .await_ready
numeric LABEL_AWAIT_SUSPEND = 6     -- .await_suspend
numeric LABEL_AWAIT_ALL = 7         -- .await_all_loop
numeric LABEL_AWAIT_ANY = 8         -- .await_any_loop
numeric LABEL_CALLBACK = 9          -- .then_callback, .catch_callback

-- Context save/restore
numeric CTX_SIZE = 256              -- Context boyutu (bytes)
numeric CTX_SAVE_REG_COUNT = 16     -- Kaydedilecek register sayısı
numeric CTX_SAVE_STACK_SIZE = 128   -- Stack save boyutu

-- Future operation function adları
numeric FN_FUTURE_CREATE = 0        -- future_create
numeric FN_FUTURE_FREE = 1          -- future_free
numeric FN_FUTURE_SET_VALUE = 2     -- future_set_value
numeric FN_FUTURE_SET_ERROR = 3     -- future_set_error
numeric FN_FUTURE_IS_READY = 4      -- future_is_ready
numeric FN_FUTURE_GET_VALUE = 5     -- future_get_value
numeric FN_FUTURE_THEN = 6          -- future_then
numeric FN_FUTURE_CATCH = 7         -- future_catch
numeric FN_FUTURE_FINALLY = 8       -- future_finally
numeric FN_FUTURE_ALL = 9           -- future_all
numeric FN_FUTURE_ANY = 10          -- future_any
numeric FN_FUTURE_RACE = 11         -- future_race

-- Promise operation function adları
numeric FN_PROMISE_CREATE = 0       -- promise_create
numeric FN_PROMISE_FREE = 1         -- promise_free
numeric FN_PROMISE_RESOLVE = 2      -- promise_resolve
numeric FN_PROMISE_REJECT = 3       -- promise_reject
numeric FN_PROMISE_GET_FUTURE = 4   -- promise_get_future

-- Task operation function adları
numeric FN_TASK_CREATE = 0          -- task_create
numeric FN_TASK_FREE = 1            -- task_free
numeric FN_TASK_RUN = 2             -- task_run
numeric FN_TASK_CANCEL = 3          -- task_cancel
numeric FN_TASK_ADD_CHILD = 4       -- task_add_child

-- Executor operation function adları
numeric FN_EXECUTOR_CREATE = 0      -- executor_create
numeric FN_EXECUTOR_FREE = 1        -- executor_free
numeric FN_EXECUTOR_SUBMIT = 2      -- executor_submit
numeric FN_EXECUTOR_RUN = 3         -- executor_run
numeric FN_EXECUTOR_STOP = 4        -- executor_stop

-- Event loop operation function adları
numeric FN_LOOP_CREATE = 0          -- event_loop_create
numeric FN_LOOP_FREE = 1            -- event_loop_free
numeric FN_LOOP_RUN = 2             -- event_loop_run
numeric FN_LOOP_STOP = 3            -- event_loop_stop
numeric FN_LOOP_ADD_TASK = 4        -- event_loop_add_task
numeric FN_LOOP_TICK = 5            -- event_loop_tick

-- Runtime operation function adları
numeric FN_RUNTIME_CREATE = 0       -- async_runtime_create
numeric FN_RUNTIME_FREE = 1         -- async_runtime_free
numeric FN_RUNTIME_INIT = 2         -- async_runtime_init
numeric FN_RUNTIME_SPAWN = 3        -- async_runtime_spawn
numeric FN_RUNTIME_BLOCK_ON = 4     -- async_runtime_block_on
numeric FN_RUNTIME_SHUTDOWN = 5     -- async_runtime_shutdown

-- Data section offset'leri
numeric DATA_ASYNC_STATE = 0        -- .async_state
numeric DATA_ASYNC_CTX = 1          -- .async_ctx
numeric DATA_RUNTIME = 2            -- .runtime
numeric DATA_EXECUTOR = 3           -- .executor
numeric DATA_EVENT_LOOP = 4         -- .event_loop

-- Suspend/resume mechanism
numeric SUSPEND_SAVE_REGS = 1       -- Register'ları kaydet
numeric SUSPEND_SAVE_STACK = 1      -- Stack'i kaydet
numeric RESUME_RESTORE_REGS = 1     -- Register'ları restore et
numeric RESUME_RESTORE_STACK = 1    -- Stack'i restore et

-- Callback türleri için jump table
numeric JUMP_THEN = 0               -- then callback jump
numeric JUMP_CATCH = 1              -- catch callback jump
numeric JUMP_FINALLY = 2            -- finally callback jump

-- Future combinator implementation
numeric IMPL_ALL_LINEAR = 0         -- await_all linear check
numeric IMPL_ANY_LINEAR = 1         -- await_any linear check
numeric IMPL_RACE_LINEAR = 2        -- await_race linear check

-- Optimization flags
numeric OPT_INLINE_AWAIT = 1        -- await'i inline et
numeric OPT_TAIL_CALL = 1           -- Tail call optimization
numeric OPT_STACK_REUSE = 1         -- Stack frame'i yeniden kullan
