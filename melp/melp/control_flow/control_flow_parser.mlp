-- MLP Self-Hosting: Control Flow Parser Module
-- Parses control flow statements: if, while, for, exit, continue
-- Corresponds to C modules/control_flow/control_flow_parser.c

numeric STMT_IF = 7
numeric STMT_WHILE = 8
numeric STMT_FOR = 9
numeric STMT_EXIT = 10
numeric STMT_CONTINUE = 11

function parse_body(parser, count)
    -- Parse statements in a body (between then...end if, while...end while, etc.)
    -- Returns array of Statement objects
    
    numeric capacity = 4
    -- Statement[] body = malloc(capacity)
    count = 0
    
    -- Loop until we hit END, ELSE, or EOF
    while parser.current_token != null and 
          parser.current_token.type != TOKEN_END and
          parser.current_token.type != TOKEN_ELSE and
          parser.current_token.type != TOKEN_EOF
        
        -- stmt will hold the parsed statement
        -- Statement* stmt = null
        
        if match(parser, TOKEN_IF) then
            -- Parse nested if statement
            -- stmt = parse_if_statement(parser)
            
        else if match(parser, TOKEN_WHILE) then
            -- Parse nested while statement
            -- stmt = parse_while_statement(parser)
            
        else if match(parser, TOKEN_FOR) then
            -- Parse nested for statement
            -- stmt = parse_for_statement(parser)
            
        else if match(parser, TOKEN_RETURN) then
            -- Return statement inside body
            advance(parser)  -- consume 'return'
            
            -- stmt = create_statement(STMT_RETURN)
            -- stmt.return_stmt.value = null
            
            -- Check if there's a return value
            if parser.current_token != null and
               parser.current_token.type != TOKEN_END and
               parser.current_token.type != TOKEN_ELSE and
               parser.current_token.type != TOKEN_EOF then
                
                -- Parse return expression
                -- Parser temp_parser
                -- temp_parser.lexer = parser.lexer
                -- temp_parser.current_token = parser.current_token
                -- Expression* value = expression_parse(temp_parser)
                -- parser.current_token = temp_parser.current_token
                -- stmt.return_stmt.value = value
            end if
            
        else if match(parser, TOKEN_EXIT) then
            -- Exit statement inside body (for loops)
            -- FIXED: Added TOKEN_EXIT case to parse_body
            advance(parser)  -- consume 'exit'
            -- stmt = create_statement(STMT_EXIT)
            
        else if match(parser, TOKEN_CONTINUE) then
            -- Continue statement inside body (for loops)
            -- FIXED: Added TOKEN_CONTINUE case to parse_body
            advance(parser)  -- consume 'continue'
            -- stmt = create_statement(STMT_CONTINUE)
            
        else if match(parser, TOKEN_NUMERIC) or 
                match(parser, TOKEN_BOOLEAN) or 
                match(parser, TOKEN_STRING) then
            -- Declaration inside body: numeric x = 5
            -- stmt = create_statement(STMT_DECLARATION)
            
            -- Save type token
            -- TokenType var_type = parser.current_token.type
            advance(parser)
            
            -- Get variable name
            if not match(parser, TOKEN_IDENTIFIER) then
                -- error("Expected identifier after type")
            end if
            
            -- string var_name = parser.current_token.value
            advance(parser)
            
            -- Check for assignment
            if match(parser, TOKEN_ASSIGN) then
                advance(parser)  -- consume '='
                -- Parse initializer expression
                -- Expression* init_value = expression_parse(parser)
                -- stmt.declaration.init_value = init_value
            end if
            
        else
            -- Try to parse as expression statement (assignment, function call, etc.)
            -- Parser temp_parser
            -- temp_parser.lexer = parser.lexer
            -- temp_parser.current_token = parser.current_token
            -- Expression* expr = expression_parse(temp_parser)
            -- parser.current_token = temp_parser.current_token
            
            -- stmt = create_statement(STMT_EXPRESSION)
            -- stmt.expression = expr
        end if
        
        -- Add statement to body array
        if stmt != null then
            -- Resize if needed
            if count >= capacity then
                capacity = capacity * 2
                -- body = realloc(body, capacity)
            end if
            
            -- body[count] = stmt
            count = count + 1
        end if
    end while
    
    return body
end function

function parse_if_statement(parser)
    -- Parse: if condition then body [else body] end if
    
    advance(parser)  -- consume 'if'
    
    -- Parse condition expression
    -- Parser temp_parser
    -- temp_parser.lexer = parser.lexer
    -- temp_parser.current_token = parser.current_token
    -- Expression* condition = expression_parse(temp_parser)
    -- parser.current_token = temp_parser.current_token
    
    -- Expect 'then'
    if not match(parser, TOKEN_THEN) then
        -- error("Expected 'then' after if condition")
    end if
    advance(parser)
    
    -- Parse then body (now properly handles exit/continue)
    numeric then_count = 0
    -- Statement[] then_body = parse_body(parser, then_count)
    
    -- Check for 'else' or 'else if'
    -- Statement[] else_body = null
    numeric else_count = 0
    
    if match(parser, TOKEN_ELSE) then
        advance(parser)
        
        if match(parser, TOKEN_IF) then
            -- else if - parse as nested if
            -- Statement* nested_if = parse_if_statement(parser)
            -- else_body = [nested_if]
            else_count = 1
        else
            -- Regular else block
            -- else_body = parse_body(parser, else_count)
        end if
    end if
    
    -- Expect 'end'
    if not match(parser, TOKEN_END) then
        -- error("Expected 'end' after if body")
    end if
    advance(parser)
    
    -- Expect 'if'
    if not match(parser, TOKEN_IF) then
        -- error("Expected 'if' after 'end'")
    end if
    advance(parser)
    
    -- Create if statement
    -- Statement* stmt = create_statement(STMT_IF)
    -- stmt.if_stmt.condition = condition
    -- stmt.if_stmt.then_body = then_body
    -- stmt.if_stmt.then_count = then_count
    -- stmt.if_stmt.else_body = else_body
    -- stmt.if_stmt.else_count = else_count
    
    return stmt
end function

function parse_while_statement(parser)
    -- Parse: while condition body end while
    
    advance(parser)  -- consume 'while'
    
    -- Parse condition
    -- Expression* condition = expression_parse(parser)
    
    -- Parse body (now properly handles exit/continue)
    numeric body_count = 0
    -- Statement[] body = parse_body(parser, body_count)
    
    -- Expect 'end'
    if not match(parser, TOKEN_END) then
        -- error("Expected 'end' after while body")
    end if
    advance(parser)
    
    -- Expect 'while'
    if not match(parser, TOKEN_WHILE) then
        -- error("Expected 'while' after 'end'")
    end if
    advance(parser)
    
    -- Create while statement
    -- Statement* stmt = create_statement(STMT_WHILE)
    -- stmt.while_stmt.condition = condition
    -- stmt.while_stmt.body = body
    -- stmt.while_stmt.body_count = body_count
    
    return stmt
end function

function parse_for_statement(parser)
    -- Parse: for var = start to end [step increment] body end for
    
    advance(parser)  -- consume 'for'
    
    -- Get loop variable name
    if not match(parser, TOKEN_IDENTIFIER) then
        -- error("Expected identifier after 'for'")
    end if
    -- string var_name = parser.current_token.value
    advance(parser)
    
    -- Expect '='
    if not match(parser, TOKEN_ASSIGN) then
        -- error("Expected '=' after for variable")
    end if
    advance(parser)
    
    -- Parse start expression
    -- Expression* start = expression_parse(parser)
    
    -- Expect 'to'
    if not match(parser, TOKEN_TO) then
        -- error("Expected 'to' after start value")
    end if
    advance(parser)
    
    -- Parse end expression
    -- Expression* end = expression_parse(parser)
    
    -- Optional: step
    -- Expression* step = null
    if match(parser, TOKEN_STEP) then
        advance(parser)
        -- step = expression_parse(parser)
    end if
    
    -- Parse body (now properly handles exit/continue)
    numeric body_count = 0
    -- Statement[] body = parse_body(parser, body_count)
    
    -- Expect 'end'
    if not match(parser, TOKEN_END) then
        -- error("Expected 'end' after for body")
    end if
    advance(parser)
    
    -- Expect 'for'
    if not match(parser, TOKEN_FOR) then
        -- error("Expected 'for' after 'end'")
    end if
    advance(parser)
    
    -- Create for statement
    -- Statement* stmt = create_statement(STMT_FOR)
    -- stmt.for_stmt.var_name = var_name
    -- stmt.for_stmt.start = start
    -- stmt.for_stmt.end = end
    -- stmt.for_stmt.step = step
    -- stmt.for_stmt.body = body
    -- stmt.for_stmt.body_count = body_count
    
    return stmt
end function

function match(parser, token_type)
    -- Check if current token matches given type
    if parser.current_token == null then
        return false
    end if
    return parser.current_token.type == token_type
end function

function advance(parser)
    -- Move to next token
    -- parser.current_token = lexer_next_token(parser.lexer)
end function

