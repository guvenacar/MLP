-- Preprocessor Parser Sabitleri
-- Directive ve macro parsing

-- Directive parse durumları
numeric PARSE_DIR_HASH = 0         -- # karakteri
numeric PARSE_DIR_KEYWORD = 1      -- define, include, if, vb.
numeric PARSE_DIR_ARGUMENT = 2     -- Direktif argümanı
numeric PARSE_DIR_COMPLETE = 3     -- Parse tamamlandı

-- Define parse durumları
numeric PARSE_DEF_HASH = 0         -- #
numeric PARSE_DEF_DEFINE = 1       -- define keyword
numeric PARSE_DEF_NAME = 2         -- Macro adı
numeric PARSE_DEF_LPAREN = 3       -- ( (function-like için)
numeric PARSE_DEF_PARAMS = 4       -- Parametreler
numeric PARSE_DEF_RPAREN = 5       -- )
numeric PARSE_DEF_BODY = 6         -- Macro gövdesi
numeric PARSE_DEF_COMPLETE = 7     -- Tanım tamamlandı

-- Include parse durumları
numeric PARSE_INC_HASH = 10        -- #
numeric PARSE_INC_INCLUDE = 11     -- include keyword
numeric PARSE_INC_QUOTE = 12       -- " veya <
numeric PARSE_INC_PATH = 13        -- Dosya yolu
numeric PARSE_INC_CLOSE = 14       -- " veya >

-- Conditional parse durumları
numeric PARSE_COND_HASH = 20       -- #
numeric PARSE_COND_KEYWORD = 21    -- if, ifdef, ifndef
numeric PARSE_COND_CONDITION = 22  -- Koşul
numeric PARSE_COND_COMPLETE = 23   -- Parse tamamlandı

-- Macro invocation parse durumları
numeric PARSE_INV_NAME = 30        -- Macro adı
numeric PARSE_INV_LPAREN = 31      -- (
numeric PARSE_INV_ARGS = 32        -- Argümanlar
numeric PARSE_INV_COMMA = 33       -- ,
numeric PARSE_INV_RPAREN = 34      -- )
numeric PARSE_INV_COMPLETE = 35    -- Çağrı tamamlandı

-- Token paste parse durumları
numeric PARSE_PASTE_LEFT = 40      -- Sol token
numeric PARSE_PASTE_OP = 41        -- ## operatörü
numeric PARSE_PASTE_RIGHT = 42     -- Sağ token

-- Stringification parse durumları
numeric PARSE_STR_HASH = 50        -- # operatörü
numeric PARSE_STR_TOKEN = 51       -- Token

-- Variadic args parse durumları
numeric PARSE_VAR_DOTS = 60        -- ... operatörü
numeric PARSE_VAR_NAME = 61        -- __VA_ARGS__
numeric PARSE_VAR_EXPAND = 62      -- Expansion

-- Pragma parse durumları
numeric PARSE_PRAGMA_HASH = 70     -- #
numeric PARSE_PRAGMA_KEYWORD = 71  -- pragma keyword
numeric PARSE_PRAGMA_TYPE = 72     -- once, pack, vb.
numeric PARSE_PRAGMA_ARGS = 73     -- Argümanlar

-- Error/Warning parse durumları
numeric PARSE_ERR_HASH = 80        -- #
numeric PARSE_ERR_KEYWORD = 81     -- error veya warning
numeric PARSE_ERR_MESSAGE = 82     -- Hata mesajı

-- Line parse durumları
numeric PARSE_LINE_HASH = 90       -- #
numeric PARSE_LINE_KEYWORD = 91    -- line keyword
numeric PARSE_LINE_NUMBER = 92     -- Satır numarası
numeric PARSE_LINE_FILE = 93       -- Opsiyonel dosya adı

-- Keyword tanıma
numeric KW_DEFINE = 100            -- define
numeric KW_UNDEF = 101             -- undef
numeric KW_INCLUDE = 102           -- include
numeric KW_IF = 103                -- if
numeric KW_IFDEF = 104             -- ifdef
numeric KW_IFNDEF = 105            -- ifndef
numeric KW_ELIF = 106              -- elif
numeric KW_ELSE = 107              -- else
numeric KW_ENDIF = 108             -- endif
numeric KW_ERROR = 109             -- error
numeric KW_WARNING = 110           -- warning
numeric KW_PRAGMA = 111            -- pragma
numeric KW_LINE = 112              -- line

-- Syntax kontrol bayrakları
numeric SYNTAX_HASH_REQUIRED = 1   -- # gerekli
numeric SYNTAX_PAREN_BALANCED = 1  -- Parantez dengelenmeli
numeric SYNTAX_QUOTE_BALANCED = 1  -- Tırnak dengelenmeli
numeric SYNTAX_NEWLINE_ENDS = 1    -- Newline ile biter

-- Parse hata kodları
numeric ERROR_NO_HASH = 1          -- # karakteri eksik
numeric ERROR_INVALID_KEYWORD = 2  -- Geçersiz keyword
numeric ERROR_MISSING_NAME = 3     -- Macro adı eksik
numeric ERROR_MISSING_BODY = 4     -- Macro body eksik
numeric ERROR_UNBALANCED_PAREN = 5 -- Parantez dengesiz
numeric ERROR_INVALID_PATH = 6     -- Geçersiz include path
numeric ERROR_MISSING_CONDITION = 7 -- Koşul eksik
numeric ERROR_UNEXPECTED_TOKEN = 8 -- Beklenmeyen token

-- Context tracking
numeric CTX_IN_MACRO_DEF = 200     -- Macro tanımı içinde
numeric CTX_IN_MACRO_INV = 201     -- Macro çağrısı içinde
numeric CTX_IN_CONDITIONAL = 202   -- Conditional içinde
numeric CTX_IN_INCLUDE = 203       -- Include işlemi içinde
