-- State Management Codegen Modülü
-- Assembly üretimi sabitleri

-- Register kullanımı
numeric REG_SM_PTR = 0          -- rax: state machine pointer
numeric REG_STATE_PTR = 1       -- rbx: current state pointer
numeric REG_EVENT_PTR = 2       -- rdi: event pointer
numeric REG_TRANS_PTR = 3       -- rsi: transition pointer

-- State machine layout
numeric SM_NAME_OFFSET = 0
numeric SM_STATES_OFFSET = 8
numeric SM_STATE_COUNT_OFFSET = 16
numeric SM_CURRENT_OFFSET = 24
numeric SM_INITIAL_OFFSET = 32

-- State layout
numeric STATE_NAME_OFFSET = 0
numeric STATE_DATA_OFFSET = 8
numeric STATE_DATA_SIZE_OFFSET = 16
numeric STATE_ON_ENTER_OFFSET = 24
numeric STATE_ON_EXIT_OFFSET = 32

-- Transition layout
numeric TRANS_FROM_OFFSET = 0
numeric TRANS_TO_OFFSET = 8
numeric TRANS_EVENT_OFFSET = 16
numeric TRANS_GUARD_OFFSET = 24
numeric TRANS_ACTION_OFFSET = 32

-- Event queue
numeric EQ_HEAD_OFFSET = 0
numeric EQ_TAIL_OFFSET = 8
numeric EQ_CAPACITY = 256
numeric EQ_WRAP_MASK = 255

-- Label tipleri
numeric LABEL_STATE = 0
numeric LABEL_TRANSITION = 1
numeric LABEL_EVENT_HANDLER = 2
numeric LABEL_QUEUE = 3
