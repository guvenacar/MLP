-- MLP Self-Hosting: Collections Parser Module
-- Parses Tuple <> and List () literals and access expressions
-- Corresponds to C modules/collections/collections_parser.c

-- Parse tuple literal: <expr1, expr2, expr3>
-- Heterogeneous, immutable, stack-allocated
function parse_tuple_literal(parser)
    -- Expect '<'
    if parser.current_token.type != TOKEN_LESS then
        -- error("Expected '<' to start tuple literal")
        return null
    end if
    advance(parser)  -- consume '<'
    
    -- Check for empty tuple: <>
    if parser.current_token.type == TOKEN_GREATER then
        advance(parser)  -- consume '>'
        -- TupleLiteral tuple
        -- tuple.count = 0
        -- tuple.elements = null
        -- tuple.element_types = null
        return tuple
    end if
    
    -- Parse elements
    numeric capacity = 4
    numeric count = 0
    -- void** elements = malloc(capacity * 8)
    -- VarType* types = malloc(capacity * 4)
    
    while true
        -- Resize if needed
        if count >= capacity then
            capacity = capacity * 2
            -- elements = realloc(elements, capacity * 8)
            -- types = realloc(types, capacity * 4)
        end if
        
        -- Parse expression
        -- elements[count] = parse_expression(parser)
        -- types[count] = infer_type(elements[count])
        count = count + 1
        
        -- Check for comma or end
        if parser.current_token.type == TOKEN_COMMA then
            advance(parser)  -- consume ','
        else if parser.current_token.type == TOKEN_GREATER then
            exit  -- End of tuple
        else
            -- error("Expected ',' or '>' in tuple literal")
            return null
        end if
    end while
    
    -- Expect '>'
    if parser.current_token.type != TOKEN_GREATER then
        -- error("Expected '>' to end tuple literal")
        return null
    end if
    advance(parser)  -- consume '>'
    
    -- Create tuple literal
    -- TupleLiteral* tuple = malloc(sizeof(TupleLiteral))
    -- tuple.count = count
    -- tuple.elements = elements
    -- tuple.element_types = types
    
    return tuple
end function

-- Parse list literal: (expr1, expr2, expr3)
-- Heterogeneous, mutable, heap-allocated
function parse_list_literal(parser)
    -- Expect '('
    if parser.current_token.type != TOKEN_LPAREN then
        -- error("Expected '(' to start list literal")
        return null
    end if
    advance(parser)  -- consume '('
    
    -- Check for empty list: ()
    if parser.current_token.type == TOKEN_RPAREN then
        advance(parser)  -- consume ')'
        -- ListLiteral list
        -- list.count = 0
        -- list.elements = null
        -- list.element_types = null
        return list
    end if
    
    -- Parse elements
    numeric capacity = 4
    numeric count = 0
    -- void** elements = malloc(capacity * 8)
    -- VarType* types = malloc(capacity * 4)
    
    while true
        -- Resize if needed
        if count >= capacity then
            capacity = capacity * 2
            -- elements = realloc(elements, capacity * 8)
            -- types = realloc(types, capacity * 4)
        end if
        
        -- Parse expression
        -- elements[count] = parse_expression(parser)
        -- types[count] = infer_type(elements[count])
        count = count + 1
        
        -- Check for comma or end
        if parser.current_token.type == TOKEN_COMMA then
            advance(parser)  -- consume ','
        else if parser.current_token.type == TOKEN_RPAREN then
            exit  -- End of list
        else
            -- error("Expected ',' or ')' in list literal")
            return null
        end if
    end while
    
    -- Expect ')'
    if parser.current_token.type != TOKEN_RPAREN then
        -- error("Expected ')' to end list literal")
        return null
    end if
    advance(parser)  -- consume ')'
    
    -- Create list literal
    -- ListLiteral* list = malloc(sizeof(ListLiteral))
    -- list.count = count
    -- list.elements = elements
    -- list.element_types = types
    
    return list
end function

-- Parse tuple access: tuple<index>
function parse_tuple_access(parser, tuple_expr)
    -- Expect '<'
    if parser.current_token.type != TOKEN_LESS then
        -- error("Expected '<' for tuple access")
        return null
    end if
    advance(parser)  -- consume '<'
    
    -- Parse index (must be compile-time constant)
    if parser.current_token.type != TOKEN_NUMBER then
        -- error("Tuple index must be compile-time constant")
        return null
    end if
    
    numeric index = to_numeric(parser.current_token.value)
    advance(parser)  -- consume number
    
    -- Expect '>'
    if parser.current_token.type != TOKEN_GREATER then
        -- error("Expected '>' after tuple index")
        return null
    end if
    advance(parser)  -- consume '>'
    
    -- Create tuple access
    -- TupleAccess* access = malloc(sizeof(TupleAccess))
    -- access.tuple_expr = tuple_expr
    -- access.index = index
    
    return access
end function

-- Parse list access: list(index)
function parse_list_access(parser, list_expr)
    -- Expect '('
    if parser.current_token.type != TOKEN_LPAREN then
        -- error("Expected '(' for list access")
        return null
    end if
    advance(parser)  -- consume '('
    
    -- Parse index expression (can be runtime)
    -- index_expr = parse_expression(parser)
    
    -- Expect ')'
    if parser.current_token.type != TOKEN_RPAREN then
        -- error("Expected ')' after list index")
        return null
    end if
    advance(parser)  -- consume ')'
    
    -- Create list access
    -- ListAccess* access = malloc(sizeof(ListAccess))
    -- access.list_expr = list_expr
    -- access.index_expr = index_expr
    
    return access
end function

-- Check if context is tuple literal (not comparison)
function is_tuple_literal_context(parser)
    -- Heuristic: < at start of expression/statement
    if parser.current_token.type != TOKEN_LESS then
        return false
    end if
    
    -- TODO: Implement proper lookahead
    -- For now, assume < at expression start is tuple
    return true
end function

-- Check if context is list literal (not function call)
function is_list_literal_context(parser)
    -- Heuristic: ( followed by expr, comma -> list
    -- ( followed by expr, ) -> grouping
    if parser.current_token.type != TOKEN_LPAREN then
        return false
    end if
    
    -- TODO: Implement proper lookahead
    -- Default to grouping for safety
    return false
end function

-- Helper functions
function advance(parser)
    -- Move to next token
    -- parser.current_token = lexer_next_token(parser.lexer)
end function

