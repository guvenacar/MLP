func main()
    numeric[5] squares = [0, 0, 0, 0, 0]
    
    for i = 0 to 4 step 1
        squares[i] = i * i
    end for
    
    for i = 0 to 4 step 1
        print(squares[i])
    end for
    
    numeric sum = 0
    for i = 0 to 4 step 1
        sum = sum + squares[i]
    end for
    
    print(sum)
    
    return 0
end func
