-- Test: Phase 11 - Union Types
-- Variables can be declared with multiple possible types
-- Syntax: type1 | type2 | type3 variable_name
-- Note: Runtime type checking not implemented; uses first type for storage

-- Test 1: Simple union type (numeric or boolean)
numeric | boolean flag

flag = 0  -- false
print(flag)  -- Expected: 0

flag = 100  -- truthy numeric value
print(flag)  -- Expected: 100

-- Test 2: Multi-type union
numeric | text | boolean data
data = 42
print(data)  -- Expected: 42

-- Test 3: Decimal or numeric
decimal | numeric measurement
measurement = 75
print(measurement)  -- Expected: 75

-- Test 4: Multiple variables with union types
numeric | boolean x
numeric | boolean y

x = 10
y = 1  -- true

print(x)  -- Expected: 10
print(y)  -- Expected: 1

-- Test 5: Union type with operations
numeric | decimal result
result = 50 + 25
print(result)  -- Expected: 75

print(999)  -- Success marker
