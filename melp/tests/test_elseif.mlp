-- Test: Phase 12 - Else If Chains
-- Tests multiple else-if clauses

-- Test 1: Grade calculator
numeric score
score = 85

if score >= 90 then
    print(90)  -- A grade
else if score >= 80 then
    print(80)  -- B grade (should print this)
else if score >= 70 then
    print(70)  -- C grade
else if score >= 60 then
    print(60)  -- D grade
else
    print(0)   -- F grade
end if

-- Test 2: Range checking with logical operators
numeric x
x = 15

if x < 10 then
    print(1)
else if x >= 10 and x < 20 then
    print(2)  -- Should print this
else if x >= 20 and x < 30 then
    print(3)
else
    print(4)
end if

-- Test 3: Nested else-if
numeric a
numeric b
a = 5
b = 10

if a > b then
    print(100)
else if a == b then
    print(200)
else if a < b then
    if b > 8 then
        print(300)  -- Should print this
    else
        print(400)
    end if
else
    print(500)
end if

-- Test 4: Multiple sequential else-if statements
numeric value
value = 42

if value == 10 then
    print(10)
else if value == 20 then
    print(20)
else if value == 30 then
    print(30)
else if value == 40 then
    print(40)
else if value == 42 then
    print(42)  -- Should print this
else if value == 50 then
    print(50)
else
    print(0)
end if

print(999)  -- Success marker
