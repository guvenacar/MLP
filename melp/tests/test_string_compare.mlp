-- Test string comparison operators
text a = "Hello"
text b = "Hello"
text c = "World"
text msg1 = "a equals b"
text msg2 = "a not equals c"
text msg3 = "b is Hello"
text msg4 = "c is not Hello"

if a == b then
    print(msg1)
end if

if a != c then
    print(msg2)
end if

if b == "Hello" then
    print(msg3)
end if

if c != "Hello" then
    print(msg4)
end if
