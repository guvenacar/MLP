func test_basic_try_catch()
    yaz("Testing basic try-catch...")
    
    try
        yaz("In try block")
        yaz("Try block continues")
    catch
        yaz("ERROR: Should not reach catch!")
    end try
    
    yaz("After try-catch")
end func

func test_throw()
    yaz("Testing throw...")
    
    try
        yaz("Before throw")
        throw 42
        yaz("ERROR: Should not execute after throw!")
    catch
        yaz("Caught error!")
    end try
end func

func test_nested_try()
    yaz("Testing nested try-catch...")
    
    try
        yaz("Outer try")
        try
            yaz("Inner try")
        catch
            yaz("Inner catch")
        end try
        yaz("After inner try-catch")
    catch
        yaz("Outer catch")
    end try
end func

yaz("=== Try-Catch Tests ===")
test_basic_try_catch()
yaz("")
test_throw()
yaz("")
test_nested_try()
yaz("=== All tests complete ===")
