func max<T>(T a, T b) returns T
    if a > b then
        return a
    end if
    return b
end func

func min<T>(T a, T b) returns T
    if a < b then
        return a
    end if
    return b
end func

func swap<T, U>(T x, U y) returns T
    return x
end func

func main() returns numeric
    numeric x = max<numeric>(5, 10)
    print(x)
    
    numeric y = min<numeric>(100, 50)
    print(y)
    
    decimal d1 = max<decimal>(3.14, 2.71)
    print(d1)
    
    decimal d2 = min<decimal>(9.99, 1.23)
    print(d2)
    
    return 0
end func
