-- MLP Self-Hosting Parser - Simple Declaration Parser
-- Parses: numeric x = 42

-- Simple parser for: numeric x = 42
func parse_simple()
    -- Token type constants (must match lexer)
    numeric TOKEN_EOF = 0
    numeric TOKEN_NUMERIC_KW = 1
    numeric TOKEN_TEXT_KW = 2
    numeric TOKEN_NUMBER = 3
    numeric TOKEN_IDENTIFIER = 5
    numeric TOKEN_ASSIGN = 20
    -- Read and tokenize source
    text source_code = read_file("compiler/test_simple.mlp")
    numeric source_len = str_length(source_code)
    
    -- Allocate token arrays
    numeric[] token_types = malloc(100)
    text[] token_values = malloc(100)
    numeric token_count = 0
    numeric pos = 0
    
    -- Inline tokenization (simplified from lexer)
    while pos < source_len
        text ch = charAt(source_code, pos)
        
        -- Skip whitespace
        if ch == " " then
            pos = pos + 1
        else
            if ch == "	" then
                pos = pos + 1
            else
                if str_length(ch) == 0 then
                    pos = pos + 1
                else
                    -- Check for numbers
                    numeric is_digit = 0
                    if ch == "0" then is_digit = 1 end if
                    if ch == "1" then is_digit = 1 end if
                    if ch == "2" then is_digit = 1 end if
                    if ch == "3" then is_digit = 1 end if
                    if ch == "4" then is_digit = 1 end if
                    if ch == "5" then is_digit = 1 end if
                    if ch == "6" then is_digit = 1 end if
                    if ch == "7" then is_digit = 1 end if
                    if ch == "8" then is_digit = 1 end if
                    if ch == "9" then is_digit = 1 end if
                    
                    if is_digit == 1 then
                        numeric start = pos
                        numeric done = 0
                        while done == 0
                            if pos >= source_len then
                                done = 1
                            else
                                text numch = charAt(source_code, pos)
                                numeric is_numchar = 0
                                if numch == "0" then is_numchar = 1 end if
                                if numch == "1" then is_numchar = 1 end if
                                if numch == "2" then is_numchar = 1 end if
                                if numch == "3" then is_numchar = 1 end if
                                if numch == "4" then is_numchar = 1 end if
                                if numch == "5" then is_numchar = 1 end if
                                if numch == "6" then is_numchar = 1 end if
                                if numch == "7" then is_numchar = 1 end if
                                if numch == "8" then is_numchar = 1 end if
                                if numch == "9" then is_numchar = 1 end if
                                
                                if is_numchar == 1 then
                                    pos = pos + 1
                                else
                                    done = 1
                                end if
                            end if
                        end while
                        
                        numeric num_len = pos - start
                        text num_str = substring(source_code, start, num_len)
                        token_types[token_count] = TOKEN_NUMBER
                        token_values[token_count] = num_str
                        token_count = token_count + 1
                    else
                        -- Check for identifiers
                        numeric idx = indexOf("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", ch)
                        if idx >= 0 then
                            numeric start = pos
                            numeric done = 0
                            while done == 0
                                if pos >= source_len then
                                    done = 1
                                else
                                    text idch = charAt(source_code, pos)
                                    numeric idx2 = indexOf("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789", idch)
                                    if idx2 >= 0 then
                                        pos = pos + 1
                                    else
                                        done = 1
                                    end if
                                end if
                            end while
                            
                            numeric id_len = pos - start
                            text word = substring(source_code, start, id_len)
                            
                            -- Check if keyword
                            if word == "numeric" then
                                token_types[token_count] = TOKEN_NUMERIC_KW
                                token_values[token_count] = word
                                token_count = token_count + 1
                            else
                                if word == "print" then
                                    token_types[token_count] = TOKEN_IDENTIFIER
                                    token_values[token_count] = word
                                    token_count = token_count + 1
                                else
                                    token_types[token_count] = TOKEN_IDENTIFIER
                                    token_values[token_count] = word
                                    token_count = token_count + 1
                                end if
                            end if
                        else
                            -- Operators
                            if ch == "=" then
                                token_types[token_count] = TOKEN_ASSIGN
                                token_values[token_count] = "="
                                token_count = token_count + 1
                                pos = pos + 1
                            else
                                if ch == "(" then
                                    pos = pos + 1
                                else
                                    if ch == ")" then
                                        pos = pos + 1
                                    else
                                        -- Unknown, skip
                                        pos = pos + 1
                                    end if
                                end if
                            end if
                        end if
                    end if
                end if
            end if
        end if
    end while
    
    -- EOF token
    token_types[token_count] = TOKEN_EOF
    token_values[token_count] = ""
    token_count = token_count + 1
    
    print("=== TOKENS ===")
    print("Count: ")
    print(token_count)
    print(" ")
    
    -- Now parse: numeric x = 42
    -- Expected sequence: TOKEN_NUMERIC_KW, TOKEN_IDENTIFIER, TOKEN_ASSIGN, TOKEN_NUMBER
    
    numeric tok_pos = 0
    
    -- Check first token: numeric
    if token_types[tok_pos] == TOKEN_NUMERIC_KW then
        print("Found type: ")
        print(token_values[tok_pos])
        print(" ")
        tok_pos = tok_pos + 1
        
        -- Check second token: identifier
        if token_types[tok_pos] == TOKEN_IDENTIFIER then
            print("Found variable: ")
            print(token_values[tok_pos])
            print(" ")
            text var_name = token_values[tok_pos]
            tok_pos = tok_pos + 1
            
            -- Check third token: =
            if token_types[tok_pos] == TOKEN_ASSIGN then
                print("Found assignment")
                print(" ")
                tok_pos = tok_pos + 1
                
                -- Check fourth token: number
                if token_types[tok_pos] == TOKEN_NUMBER then
                    print("Found value: ")
                    print(token_values[tok_pos])
                    print(" ")
                    
                    print("=== PARSE SUCCESS ===")
                    print("Declaration: numeric ")
                    print(var_name)
                    print(" = ")
                    print(token_values[tok_pos])
                    print(" ")
                    
                    return 1
                end if
            end if
        end if
    end if
    
    print("Parse error")
    print(" ")
    return 0
end func

func main()
    numeric result = parse_simple()
    return result
end func
