-- MLP Self-Hosting Lexer
-- Phase 1: Complete working lexer with inline approach
-- All state is local, no global variables

-- Token type constants
numeric TOKEN_EOF = 0
numeric TOKEN_NUMERIC = 1
numeric TOKEN_TEXT = 2
numeric TOKEN_NUMBER = 3
numeric TOKEN_STRING = 4
numeric TOKEN_IDENTIFIER = 5
numeric TOKEN_PRINT = 6
numeric TOKEN_IF = 7
numeric TOKEN_THEN = 8
numeric TOKEN_ELSE = 9
numeric TOKEN_END = 10
numeric TOKEN_WHILE = 11
numeric TOKEN_FOR = 12
numeric TOKEN_TO = 13
numeric TOKEN_STEP = 14
numeric TOKEN_FUNC = 15
numeric TOKEN_RETURN = 16
numeric TOKEN_ASSIGN = 20
numeric TOKEN_PLUS = 21
numeric TOKEN_MINUS = 22
numeric TOKEN_STAR = 23
numeric TOKEN_SLASH = 24
numeric TOKEN_LPAREN = 25
numeric TOKEN_RPAREN = 26
numeric TOKEN_EQ = 27
numeric TOKEN_NEQ = 28
numeric TOKEN_LT = 29
numeric TOKEN_LE = 30
numeric TOKEN_GT = 31
numeric TOKEN_GE = 32
numeric TOKEN_COMMA = 33
numeric TOKEN_SEMICOLON = 34

-- Helper: Check if character is digit
func is_digit(text c)
    if c == "0" then return 1 end if
    if c == "1" then return 1 end if
    if c == "2" then return 1 end if
    if c == "3" then return 1 end if
    if c == "4" then return 1 end if
    if c == "5" then return 1 end if
    if c == "6" then return 1 end if
    if c == "7" then return 1 end if
    if c == "8" then return 1 end if
    if c == "9" then return 1 end if
    return 0
end func

-- Helper: Check if character is alpha or underscore
func is_alpha(text c)
    numeric idx = indexOf("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
    if idx >= 0 then
        return 1
    end if
    return 0
end func

-- Helper: Check if character is alphanumeric
func is_alnum(text c)
    numeric d = is_digit(c)
    if d == 1 then
        return 1
    end if
    numeric a = is_alpha(c)
    if a == 1 then
        return 1
    end if
    return 0
end func

-- Helper: Check if character is whitespace
func is_whitespace(text c)
    if c == " " then return 1 end if
    if c == "\t" then return 1 end if
    if c == "\n" then return 1 end if
    if c == "\r" then return 1 end if
    return 0
end func

-- Helper: Check if word is a keyword
func keyword_type(text word)
    if word == "numeric" then return TOKEN_NUMERIC end if
    if word == "text" then return TOKEN_TEXT end if
    if word == "print" then return TOKEN_PRINT end if
    if word == "if" then return TOKEN_IF end if
    if word == "then" then return TOKEN_THEN end if
    if word == "else" then return TOKEN_ELSE end if
    if word == "end" then return TOKEN_END end if
    if word == "while" then return TOKEN_WHILE end if
    if word == "for" then return TOKEN_FOR end if
    if word == "to" then return TOKEN_TO end if
    if word == "step" then return TOKEN_STEP end if
    if word == "func" then return TOKEN_FUNC end if
    if word == "return" then return TOKEN_RETURN end if
    return TOKEN_IDENTIFIER
end func

-- Main tokenizer function
func tokenize(text source_code)
    numeric source_len = str_length(source_code)
    numeric pos = 0
    
    -- Allocate token arrays (1000 tokens max)
    numeric[] token_types = malloc(1000)
    text[] token_values = malloc(1000)
    numeric token_count = 0
    
    -- Main lexing loop
    while pos < source_len
        text ch = charAt(source_code, pos)
        
        -- Skip whitespace (inline)
        numeric is_ws = is_whitespace(ch)
        if is_ws == 1 then
            pos = pos + 1
        else
            -- Skip comments (inline)
            if ch == "-" then
                numeric next_pos = pos + 1
                if next_pos < source_len then
                    text next_ch = charAt(source_code, next_pos)
                    if next_ch == "-" then
                        -- Comment found, skip to end of line
                        pos = pos + 2
                        numeric comment_done = 0
                        while pos < source_len
                            text cch = charAt(source_code, pos)
                            if cch == "\n" then
                                comment_done = 1
                            end if
                            pos = pos + 1
                            if comment_done == 1 then
                                pos = source_len + 9999
                            end if
                        end while
                        if pos > source_len then
                            pos = pos - 9999
                        end if
                    end if
                end if
            end if
            
            -- Re-read character after possible comment skip
            if pos < source_len then
                ch = charAt(source_code, pos)
                is_ws = is_whitespace(ch)
            end if
            
            if is_ws == 0 then
                if pos < source_len then
                    -- Number literal
                    numeric is_d = is_digit(ch)
                    if is_d == 1 then
                        numeric start = pos
                        while pos < source_len
                            text numch = charAt(source_code, pos)
                            numeric is_numchar = is_digit(numch)
                            if is_numchar == 0 then
                                if numch != "." then
                                    pos = source_len + 9999
                                end if
                            end if
                            if pos < source_len + 9000 then
                                pos = pos + 1
                            end if
                        end while
                        if pos > source_len then
                            pos = pos - 9999
                        end if
                        
                        numeric num_len = pos - start
                        text num_str = substring(source_code, start, num_len)
                        token_types[token_count] = TOKEN_NUMBER
                        token_values[token_count] = num_str
                        token_count = token_count + 1
                    else
                        -- Identifier or keyword
                        numeric is_a = is_alpha(ch)
                        if is_a == 1 then
                            numeric start = pos
                            while pos < source_len
                                text idch = charAt(source_code, pos)
                                numeric is_idchar = is_alnum(idch)
                                if is_idchar == 0 then
                                    pos = source_len + 9999
                                end if
                                if pos < source_len + 9000 then
                                    pos = pos + 1
                                end if
                            end while
                            if pos > source_len then
                                pos = pos - 9999
                            end if
                            
                            numeric id_len = pos - start
                            text word = substring(source_code, start, id_len)
                            numeric tok_type = keyword_type(word)
                            token_types[token_count] = tok_type
                            token_values[token_count] = word
                            token_count = token_count + 1
                        else
                            -- Operators and punctuation
                            if ch == "=" then
                                numeric next_pos = pos + 1
                                if next_pos < source_len then
                                    text next_ch = charAt(source_code, next_pos)
                                    if next_ch == "=" then
                                        token_types[token_count] = TOKEN_EQ
                                        token_values[token_count] = "=="
                                        token_count = token_count + 1
                                        pos = pos + 2
                                    else
                                        token_types[token_count] = TOKEN_ASSIGN
                                        token_values[token_count] = "="
                                        token_count = token_count + 1
                                        pos = pos + 1
                                    end if
                                else
                                    token_types[token_count] = TOKEN_ASSIGN
                                    token_values[token_count] = "="
                                    token_count = token_count + 1
                                    pos = pos + 1
                                end if
                            else if ch == "+" then
                                token_types[token_count] = TOKEN_PLUS
                                token_values[token_count] = "+"
                                token_count = token_count + 1
                                pos = pos + 1
                            else if ch == "-" then
                                token_types[token_count] = TOKEN_MINUS
                                token_values[token_count] = "-"
                                token_count = token_count + 1
                                pos = pos + 1
                            else if ch == "*" then
                                token_types[token_count] = TOKEN_STAR
                                token_values[token_count] = "*"
                                token_count = token_count + 1
                                pos = pos + 1
                            else if ch == "/" then
                                token_types[token_count] = TOKEN_SLASH
                                token_values[token_count] = "/"
                                token_count = token_count + 1
                                pos = pos + 1
                            else if ch == "(" then
                                token_types[token_count] = TOKEN_LPAREN
                                token_values[token_count] = "("
                                token_count = token_count + 1
                                pos = pos + 1
                            else if ch == ")" then
                                token_types[token_count] = TOKEN_RPAREN
                                token_values[token_count] = ")"
                                token_count = token_count + 1
                                pos = pos + 1
                            else if ch == "," then
                                token_types[token_count] = TOKEN_COMMA
                                token_values[token_count] = ","
                                token_count = token_count + 1
                                pos = pos + 1
                            else if ch == ";" then
                                token_types[token_count] = TOKEN_SEMICOLON
                                token_values[token_count] = ";"
                                token_count = token_count + 1
                                pos = pos + 1
                            else if ch == "<" then
                                numeric next_pos = pos + 1
                                if next_pos < source_len then
                                    text next_ch = charAt(source_code, next_pos)
                                    if next_ch == "=" then
                                        token_types[token_count] = TOKEN_LE
                                        token_values[token_count] = "<="
                                        token_count = token_count + 1
                                        pos = pos + 2
                                    else
                                        token_types[token_count] = TOKEN_LT
                                        token_values[token_count] = "<"
                                        token_count = token_count + 1
                                        pos = pos + 1
                                    end if
                                else
                                    token_types[token_count] = TOKEN_LT
                                    token_values[token_count] = "<"
                                    token_count = token_count + 1
                                    pos = pos + 1
                                end if
                            else if ch == ">" then
                                numeric next_pos = pos + 1
                                if next_pos < source_len then
                                    text next_ch = charAt(source_code, next_pos)
                                    if next_ch == "=" then
                                        token_types[token_count] = TOKEN_GE
                                        token_values[token_count] = ">="
                                        token_count = token_count + 1
                                        pos = pos + 2
                                    else
                                        token_types[token_count] = TOKEN_GT
                                        token_values[token_count] = ">"
                                        token_count = token_count + 1
                                        pos = pos + 1
                                    end if
                                else
                                    token_types[token_count] = TOKEN_GT
                                    token_values[token_count] = ">"
                                    token_count = token_count + 1
                                    pos = pos + 1
                                end if
                            else if ch == "!" then
                                numeric next_pos = pos + 1
                                if next_pos < source_len then
                                    text next_ch = charAt(source_code, next_pos)
                                    if next_ch == "=" then
                                        token_types[token_count] = TOKEN_NEQ
                                        token_values[token_count] = "!="
                                        token_count = token_count + 1
                                        pos = pos + 2
                                    else
                                        -- Unknown character, skip
                                        pos = pos + 1
                                    end if
                                else
                                    pos = pos + 1
                                end if
                            else
                                -- Unknown character, skip
                                pos = pos + 1
                            end if
                            end if
                            end if
                            end if
                            end if
                            end if
                            end if
                            end if
                            end if
                            end if
                            end if
                            end if
                        end if
                    end if
                end if
            end if
        end if
    end while
    
    -- Add EOF token
    token_types[token_count] = TOKEN_EOF
    token_values[token_count] = ""
    token_count = token_count + 1
    
    return token_count
end func

-- Main entry point
func main()
    -- Read source file
    text source_code = read_file("compiler/test_simple.mlp")
    
    -- Tokenize
    numeric token_count = tokenize(source_code)
    
    -- Print results
    print("Token count: ")
    print(token_count)
    
    return 0
end func
