-- MELP Self-Hosting Compiler - Lexer (Simplified)
-- Basit lexer prototipi

-- Token type constants
numeric TOKEN_NUMERIC = 1
numeric TOKEN_IDENTIFIER = 2
numeric TOKEN_NUMBER = 3
numeric TOKEN_ASSIGN = 5
numeric TOKEN_PLUS = 8
numeric TOKEN_PRINT = 12
numeric TOKEN_EOF = 99

-- Test: Basit tokenization
func main()
    text code = "x=42"
    numeric len = str_length(code)
    
    print(len)
    
    text first = substring(code, 0, 1)
    print(first)
    
    numeric eq_pos = indexOf(code, "=")
    print(eq_pos)
    
    text num = substring(code, 2, 2)
    print(num)
    
    return 0
end func
