-- MLP Self-Hosting Parser - Ultra Simple Version
-- Just parse tokens without advanced features

func main()
    -- Token type constants
    numeric TOKEN_EOF = 0
    numeric TOKEN_NUMERIC_KW = 1
    numeric TOKEN_NUMBER = 3
    numeric TOKEN_IDENTIFIER = 5
    numeric TOKEN_ASSIGN = 20
    
    -- Simple test: manually create tokens for "numeric x = 42"
    numeric[] token_types = malloc(10)
    text[] token_values = malloc(10)
    
    token_types[0] = TOKEN_NUMERIC_KW
    token_values[0] = "numeric"
    
    token_types[1] = TOKEN_IDENTIFIER
    token_values[1] = "x"
    
    token_types[2] = TOKEN_ASSIGN
    token_values[2] = "="
    
    token_types[3] = TOKEN_NUMBER
    token_values[3] = "42"
    
    token_types[4] = TOKEN_EOF
    token_values[4] = ""
    
    numeric token_count = 5
    
    print("=== MANUAL TOKENS ===")
    print("Token 0: ")
    print(token_values[0])
    print(" ")
    print("Token 1: ")
    print(token_values[1])
    print(" ")
    print("Token 2: ")
    print(token_values[2])
    print(" ")
    print("Token 3: ")
    print(token_values[3])
    print(" ")
    
    -- Parse: numeric x = 42
    numeric tok_pos = 0
    
    if token_types[tok_pos] == TOKEN_NUMERIC_KW then
        print("✓ Found type declaration")
        print(" ")
        tok_pos = tok_pos + 1
        
        if token_types[tok_pos] == TOKEN_IDENTIFIER then
            text var_name = token_values[tok_pos]
            print("✓ Found variable: ")
            print(var_name)
            print(" ")
            tok_pos = tok_pos + 1
            
            if token_types[tok_pos] == TOKEN_ASSIGN then
                print("✓ Found assignment operator")
                print(" ")
                tok_pos = tok_pos + 1
                
                if token_types[tok_pos] == TOKEN_NUMBER then
                    text var_value = token_values[tok_pos]
                    print("✓ Found value: ")
                    print(var_value)
                    print(" ")
                    
                    print("=== PARSE SUCCESS ===")
                    print("Declaration: numeric ")
                    print(var_name)
                    print(" = ")
                    print(var_value)
                    print(" ")
                    
                    return 0
                end if
            end if
        end if
    end if
    
    print("Parse failed")
    print(" ")
    return 1
end func
