-- TTO Numeric Comprehensive Test

-- Test 1: Direct double literals
print("=== Double Literals ===")
numeric pi = 3.14159265358979
print(pi)

numeric e = 2.71828182845904
print(e)

numeric small = 0.001
print(small)

numeric large = 123456.789
print(large)

-- Test 2: Integer literals (should use int64)
print("=== Integer Literals ===")
numeric x = 42
print(x)

numeric big = 9223372036854775807
print(big)

-- Test 3: Simple arithmetic (integers)
print("=== Integer Arithmetic ===")
numeric a = 10
numeric b = 3
numeric sum_val = a + b
print(sum_val)

numeric diff = a - b
print(diff)

numeric prod = a * b
print(prod)

-- Test 4: Print double literals directly
print("=== Direct Double Prints ===")
print(1.5)
print(99.99)
print(0.0001)

print("TTO Comprehensive Test Complete!")
