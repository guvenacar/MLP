-- Test enum and switch with compound ends
enum Color
    RED = 1
    GREEN = 2
    BLUE = 3
end enum

function test_switch()
    numeric color = 2
    
    switch color
        case 1
            print "Red"
        end
        case 2
            print "Green"
        end
        case 3
            print "Blue"
        end
        default
            print "Unknown"
        end
    end switch
    
    return 0
end function

test_switch()
