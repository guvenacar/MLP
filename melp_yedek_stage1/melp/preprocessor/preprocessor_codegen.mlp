-- Preprocessor Codegen Sabitleri
-- Assembly generation için sabitler

-- Register kullanımı
numeric REG_MACRO_PTR = 0          -- rdi: Macro pointer
numeric REG_EXPANSION = 1          -- rsi: Expansion result
numeric REG_CONTEXT = 2            -- rdx: Preprocessor context
numeric REG_ARGUMENT = 3           -- rcx: Macro argument
numeric REG_CONDITION = 4          -- r8: Condition value
numeric REG_FILE_PTR = 5           -- r9: File pointer

-- Stack frame layout
numeric STACK_MACRO = 8            -- [rbp - 8]: Macro definition
numeric STACK_EXPANSION = 16       -- [rbp - 16]: Expansion result
numeric STACK_CONTEXT = 24         -- [rbp - 24]: Context
numeric STACK_ARGS = 32            -- [rbp - 32]: Arguments array
numeric STACK_CONDITION = 40       -- [rbp - 40]: Condition value
numeric STACK_BUFFER = 1024        -- [rbp - 1024]: Expansion buffer

-- Macro expansion states
numeric STATE_BEFORE_EXPAND = 0    -- Expansion öncesi
numeric STATE_EXPANDING = 1        -- Expansion devam ediyor
numeric STATE_AFTER_EXPAND = 2     -- Expansion tamamlandı
numeric STATE_ERROR = 3            -- Hata oluştu

-- Label prefix'leri
numeric LABEL_MACRO_DEF = 0        -- .macro_def_
numeric LABEL_EXPANSION = 1        -- .expand_
numeric LABEL_CONDITION = 2        -- .cond_
numeric LABEL_INCLUDE = 3          -- .include_
numeric LABEL_TOKEN_PASTE = 4      -- .paste_
numeric LABEL_STRINGIFY = 5        -- .stringify_

-- Built-in macro implementation
numeric BUILTIN_FILE_IMPL = 0      -- __FILE__ implementation
numeric BUILTIN_LINE_IMPL = 1      -- __LINE__ implementation
numeric BUILTIN_DATE_IMPL = 2      -- __DATE__ implementation
numeric BUILTIN_TIME_IMPL = 3      -- __TIME__ implementation

-- Data section offset'leri
numeric DATA_MACRO_TABLE = 0       -- .macro_table
numeric DATA_EXPANSION_BUF = 1     -- .expansion_buffer
numeric DATA_CONDITION_STACK = 2   -- .condition_stack
numeric DATA_INCLUDE_PATHS = 3     -- .include_paths
numeric DATA_FILE_NAME = 4         -- .current_file
numeric DATA_LINE_NUM = 5          -- .current_line

-- Expansion işlem türleri
numeric EXP_SIMPLE = 0             -- Basit expansion
numeric EXP_WITH_ARGS = 1          -- Argüman substitution ile
numeric EXP_WITH_PASTE = 2         -- Token paste ile
numeric EXP_WITH_STRINGIFY = 3     -- Stringification ile
numeric EXP_VARIADIC = 4           -- Variadic args ile

-- Conditional code generation
numeric COND_SKIP_CODE = 0         -- Kodu atla
numeric COND_INCLUDE_CODE = 1      -- Kodu dahil et
numeric COND_GENERATE_BOTH = 2     -- Her iki versiyonu üret

-- Token paste implementation
numeric PASTE_CONCATENATE = 0      -- String concatenation
numeric PASTE_TOKEN_JOIN = 1       -- Token join
numeric PASTE_SYMBOL_CREATE = 2    -- Yeni sembol oluştur

-- Stringification implementation
numeric STR_QUOTE_ADD = 0          -- Tırnak ekle
numeric STR_ESCAPE_SPECIAL = 1     -- Özel karakterleri escape et
numeric STR_TO_LITERAL = 2         -- Literal string'e çevir

-- Include file handling
numeric INC_READ_FILE = 0          -- Dosyayı oku
numeric INC_PROCESS_CONTENT = 1    -- İçeriği işle
numeric INC_MERGE_OUTPUT = 2       -- Output'a merge et

-- Macro table operations
numeric TABLE_LOOKUP = 0           -- Macro'yu bul
numeric TABLE_INSERT = 1           -- Yeni macro ekle
numeric TABLE_REMOVE = 2           -- Macro'yu sil
numeric TABLE_UPDATE = 3           -- Macro'yu güncelle

-- Function adları
numeric FN_MACRO_CREATE = 0        -- macro_definition_create
numeric FN_MACRO_FREE = 1          -- macro_definition_free
numeric FN_MACRO_EXPAND = 2        -- macro_invocation_expand
numeric FN_DIRECTIVE_CREATE = 3    -- directive_create
numeric FN_DIRECTIVE_EVAL = 4      -- directive_evaluate_condition
numeric FN_CONTEXT_FIND = 5        -- preprocessor_context_find_macro
numeric FN_CONTEXT_ADD = 6         -- preprocessor_context_add_macro
numeric FN_TOKEN_PASTE = 7         -- token_paste_execute
numeric FN_STRINGIFY = 8           -- stringification_execute
numeric FN_BUILTIN_VALUE = 9       -- get_builtin_macro_value

-- Condition stack operations
numeric STACK_OP_PUSH = 0          -- Stack'e push
numeric STACK_OP_POP = 1           -- Stack'ten pop
numeric STACK_OP_PEEK = 2          -- Tepedekine bak
numeric STACK_OP_IS_ACTIVE = 3     -- Aktif mi kontrol et

-- Error handling
numeric ERR_SET_ERROR = 0          -- Hata set et
numeric ERR_GET_MESSAGE = 1        -- Hata mesajı al
numeric ERR_CLEAR = 2              -- Hatayı temizle

-- Optimization flags
numeric OPT_INLINE_SIMPLE = 1      -- Basit macro'ları inline et
numeric OPT_CACHE_EXPANSION = 1    -- Expansion sonuçlarını cache'le
numeric OPT_SKIP_UNUSED = 1        -- Kullanılmayan macro'ları atla
numeric OPT_EARLY_EVAL = 1         -- Sabit ifadeleri erken değerlendir
