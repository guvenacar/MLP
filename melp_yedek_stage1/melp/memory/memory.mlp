-- Memory Modülü - Bellek Yönetimi
-- Dinamik bellek ayırma ve serbest bırakma

-- Ayırma stratejileri
numeric ALLOC_STACK = 0      -- Stack üzerinde (hızlı, otomatik temizlik)
numeric ALLOC_HEAP = 1       -- Heap üzerinde (manuel yönetim)
numeric ALLOC_STATIC = 2     -- Static/Global (program ömrü)

-- Bellek operasyonları
numeric MEM_OP_ALLOC = 0     -- Ayırma (malloc/new)
numeric MEM_OP_FREE = 1      -- Serbest bırakma (free/delete)
numeric MEM_OP_COPY = 2      -- Kopyalama (memcpy)
numeric MEM_OP_ZERO = 3      -- Sıfırlama (memset 0)
numeric MEM_OP_REALLOC = 4   -- Yeniden boyutlandırma (realloc)

-- Hizalama sabitleri
numeric MEM_ALIGN_1 = 1
numeric MEM_ALIGN_4 = 4
numeric MEM_ALIGN_8 = 8
numeric MEM_ALIGN_16 = 16
