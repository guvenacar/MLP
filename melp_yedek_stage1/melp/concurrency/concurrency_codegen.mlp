-- Concurrency Codegen Sabitleri
-- Thread ve synchronization için assembly generation

-- Register kullanımı
numeric REG_THREAD_PTR = 0         -- rdi: Thread pointer
numeric REG_MUTEX_PTR = 1          -- rsi: Mutex pointer
numeric REG_SEMAPHORE_PTR = 2      -- rdx: Semaphore pointer
numeric REG_CONDVAR_PTR = 3        -- rcx: Condition variable pointer
numeric REG_BARRIER_PTR = 4        -- r8: Barrier pointer
numeric REG_RWLOCK_PTR = 5         -- r9: RWLock pointer
numeric REG_TASK_FUNC = 6          -- r10: Task function
numeric REG_TASK_ARG = 7           -- r11: Task argument

-- Stack frame layout
numeric STACK_THREAD = 8           -- [rbp - 8]: Thread yapısı
numeric STACK_MUTEX = 16           -- [rbp - 16]: Mutex
numeric STACK_SEMAPHORE = 24       -- [rbp - 24]: Semaphore
numeric STACK_CONDVAR = 32         -- [rbp - 32]: Condition variable
numeric STACK_BARRIER = 40         -- [rbp - 40]: Barrier
numeric STACK_RWLOCK = 48          -- [rbp - 48]: RWLock
numeric STACK_POOL = 56            -- [rbp - 56]: Thread pool
numeric STACK_RETURN_VAL = 64      -- [rbp - 64]: Return value
numeric STACK_CONTEXT = 512        -- [rbp - 512]: Thread context

-- Thread state labels
numeric STATE_NEW = 0              -- .thread_new
numeric STATE_RUNNABLE = 1         -- .thread_runnable
numeric STATE_RUNNING = 2          -- .thread_running
numeric STATE_BLOCKED = 3          -- .thread_blocked
numeric STATE_WAITING = 4          -- .thread_waiting
numeric STATE_TERMINATED = 5       -- .thread_terminated

-- Label prefix'leri
numeric LABEL_THREAD = 0           -- .thread_
numeric LABEL_MUTEX = 1            -- .mutex_
numeric LABEL_SEMAPHORE = 2        -- .semaphore_
numeric LABEL_CONDVAR = 3          -- .condvar_
numeric LABEL_BARRIER = 4          -- .barrier_
numeric LABEL_RWLOCK = 5           -- .rwlock_
numeric LABEL_POOL = 6             -- .pool_
numeric LABEL_LOCK = 7             -- .lock_
numeric LABEL_UNLOCK = 8           -- .unlock_
numeric LABEL_CRITICAL = 9         -- .critical_section_

-- Data section offset'leri
numeric DATA_THREAD_TABLE = 0      -- .thread_table
numeric DATA_MUTEX_TABLE = 1       -- .mutex_table
numeric DATA_LOCK_STATE = 2        -- .lock_state
numeric DATA_WAIT_QUEUE = 3        -- .wait_queue
numeric DATA_TASK_QUEUE = 4        -- .task_queue
numeric DATA_THREAD_ID = 5         -- .thread_id_counter

-- Atomic instruction types
numeric ATOMIC_LOCK_PREFIX = 1     -- lock prefix kullan
numeric ATOMIC_XCHG = 2            -- xchg instruction
numeric ATOMIC_CMPXCHG = 3         -- cmpxchg instruction
numeric ATOMIC_XADD = 4            -- xadd instruction

-- Lock implementation strategy
numeric LOCK_IMPL_SPINLOCK = 0     -- Spinlock ile
numeric LOCK_IMPL_FUTEX = 1        -- Futex ile
numeric LOCK_IMPL_PTHREAD = 2      -- Pthread ile

-- Wait strategy
numeric WAIT_SPIN = 0              -- Spin wait
numeric WAIT_BLOCK = 1             -- Block wait
numeric WAIT_HYBRID = 2            -- Hybrid (spin then block)

-- Memory barrier types
numeric BARRIER_FULL = 0           -- mfence (full barrier)
numeric BARRIER_LOAD = 1           -- lfence (load barrier)
numeric BARRIER_STORE = 2          -- sfence (store barrier)

-- Function adları
numeric FN_THREAD_CREATE = 0       -- thread_create
numeric FN_THREAD_START = 1        -- thread_start
numeric FN_THREAD_JOIN = 2         -- thread_join
numeric FN_THREAD_EXIT = 3         -- thread_exit
numeric FN_MUTEX_LOCK = 4          -- mutex_lock
numeric FN_MUTEX_UNLOCK = 5        -- mutex_unlock
numeric FN_SEM_WAIT = 6            -- semaphore_wait
numeric FN_SEM_POST = 7            -- semaphore_post
numeric FN_CV_WAIT = 8             -- condvar_wait
numeric FN_CV_SIGNAL = 9           -- condvar_signal
numeric FN_CV_BROADCAST = 10       -- condvar_broadcast
numeric FN_BARRIER_WAIT = 11       -- barrier_wait
numeric FN_RW_RLOCK = 12           -- rwlock_read_lock
numeric FN_RW_WLOCK = 13           -- rwlock_write_lock
numeric FN_RW_RUNLOCK = 14         -- rwlock_read_unlock
numeric FN_RW_WUNLOCK = 15         -- rwlock_write_unlock
numeric FN_POOL_SUBMIT = 16        -- thread_pool_submit

-- Critical section handling
numeric CRIT_ENTER = 0             -- Critical section giriş
numeric CRIT_EXIT = 1              -- Critical section çıkış
numeric CRIT_TRY_ENTER = 2         -- Try enter

-- Scheduling hints
numeric SCHED_YIELD = 0            -- Yield CPU
numeric SCHED_PRIORITY = 1         -- Öncelik ayarla
numeric SCHED_AFFINITY = 2         -- CPU affinity

-- Thread local storage (TLS)
numeric TLS_OFFSET = 0             -- TLS offset
numeric TLS_SIZE = 1024            -- TLS area size

-- Lock-free implementation
numeric LOCKFREE_CAS_LOOP = 0      -- CAS loop kullan
numeric LOCKFREE_QUEUE = 1         -- Lock-free queue
numeric LOCKFREE_STACK = 2         -- Lock-free stack

-- Optimization flags
numeric OPT_INLINE_LOCK = 1        -- Lock'u inline et
numeric OPT_FAST_PATH = 1          -- Fast path optimize et
numeric OPT_ELIMINATE_LOCK = 1     -- Gereksiz lock'ları kaldır
numeric OPT_REDUCE_CONTENTION = 1  -- Contention'ı azalt
