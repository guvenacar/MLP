-- Concurrency Module Sabitleri
-- Thread ve synchronization için temel sabitler

-- Thread durumları
numeric THREAD_NEW = 0             -- Yeni oluşturuldu
numeric THREAD_RUNNABLE = 1        -- Çalışmaya hazır
numeric THREAD_RUNNING = 2         -- Çalışıyor
numeric THREAD_BLOCKED = 3         -- Bloke oldu
numeric THREAD_WAITING = 4         -- Bekleme durumunda
numeric THREAD_TERMINATED = 5      -- Sonlandı

-- Thread öncelik seviyeleri
numeric PRIORITY_LOW = 0           -- Düşük öncelik
numeric PRIORITY_NORMAL = 1        -- Normal öncelik
numeric PRIORITY_HIGH = 2          -- Yüksek öncelik
numeric PRIORITY_CRITICAL = 3      -- Kritik öncelik

-- Lock türleri
numeric LOCK_MUTEX = 0             -- Mutual exclusion
numeric LOCK_SPINLOCK = 1          -- Spin lock
numeric LOCK_RW_LOCK = 2           -- Read-write lock

-- Semaphore türleri
numeric SEMAPHORE_BINARY = 0       -- Binary semaphore
numeric SEMAPHORE_COUNTING = 1     -- Counting semaphore

-- Thread işlem sonuçları
numeric THREAD_SUCCESS = 0         -- Başarılı
numeric THREAD_ERROR = 1           -- Hata
numeric THREAD_TIMEOUT = 2         -- Timeout
numeric THREAD_CANCELLED = 3       -- İptal edildi

-- Lock durumları
numeric LOCK_UNLOCKED = 0          -- Kilitli değil
numeric LOCK_LOCKED = 1            -- Kilitli
numeric LOCK_CONTENDED = 2         -- Rekabet var

-- Wait sonuçları
numeric WAIT_SUCCESS = 0           -- Başarılı
numeric WAIT_TIMEOUT = 1           -- Timeout
numeric WAIT_INTERRUPTED = 2       -- Interrupt edildi

-- Signal türleri
numeric SIGNAL_ONE = 0             -- Bir thread'i uyandır
numeric SIGNAL_ALL = 1             -- Tüm thread'leri uyandır

-- Barrier durumları
numeric BARRIER_WAITING = 0        -- Bekliyor
numeric BARRIER_RELEASED = 1       -- Serbest bırakıldı
numeric BARRIER_BROKEN = 2         -- Bozuldu

-- RWLock access türleri
numeric ACCESS_READ = 0            -- Okuma erişimi
numeric ACCESS_WRITE = 1           -- Yazma erişimi

-- Thread pool durumları
numeric POOL_ACTIVE = 0            -- Aktif
numeric POOL_SHUTDOWN = 1          -- Kapatılıyor
numeric POOL_TERMINATED = 2        -- Sonlandırıldı

-- Atomic işlem türleri
numeric ATOMIC_INC = 0             -- Increment
numeric ATOMIC_DEC = 1             -- Decrement
numeric ATOMIC_ADD = 2             -- Add
numeric ATOMIC_SUB = 3             -- Subtract
numeric ATOMIC_CAS = 4             -- Compare-and-swap
numeric ATOMIC_EXCHANGE = 5        -- Exchange

-- Memory order (atomic operations)
numeric MEM_RELAXED = 0            -- Relaxed ordering
numeric MEM_ACQUIRE = 1            -- Acquire semantics
numeric MEM_RELEASE = 2            -- Release semantics
numeric MEM_SEQ_CST = 3            -- Sequentially consistent

-- Error kodları
numeric ERR_INVALID_THREAD = 1     -- Geçersiz thread
numeric ERR_THREAD_EXISTS = 2      -- Thread zaten var
numeric ERR_DEADLOCK = 3           -- Deadlock tespit edildi
numeric ERR_MUTEX_LOCKED = 4       -- Mutex zaten kilitli
numeric ERR_NOT_OWNER = 5          -- Owner değil
numeric ERR_BARRIER_BROKEN = 6     -- Barrier bozuk
numeric ERR_POOL_SHUTDOWN = 7      -- Pool kapatıldı
