-- Pattern Matching Codegen Modülü
-- Assembly üretimi sabitleri

-- Register kullanımı
numeric REG_MATCH_VALUE = 0     -- rbx: match değeri
numeric REG_PATTERN = 1         -- rax: pattern test result
numeric REG_FIELD_PTR = 2       -- rcx: struct field pointer
numeric REG_ARRAY_LEN = 3       -- rdx: array length

-- Stack layout
numeric STACK_MATCH_VALUE = 8
numeric STACK_TEMP_VALUE = 16
numeric STACK_BINDING_BASE = 32

-- Label tipleri
numeric LABEL_ARM = 0
numeric LABEL_ARM_GUARD = 1
numeric LABEL_ARM_BODY = 2
numeric LABEL_MATCH_END = 3
numeric LABEL_NO_MATCH = 4

-- Pattern test result
numeric TEST_RESULT_MATCH = 1
numeric TEST_RESULT_NO_MATCH = 0

-- Struct matching
numeric STRUCT_FIELD_OFFSET = 8     -- Field stride

-- Array matching
numeric ARRAY_LENGTH_OFFSET = 0
numeric ARRAY_DATA_OFFSET = 8
numeric ARRAY_ELEMENT_SIZE = 8

-- Range checking
numeric RANGE_INCLUSIVE = 0
numeric RANGE_EXCLUSIVE = 1

-- Exhaustiveness
numeric EXHAUST_ERROR_MSG = 0
