-- Lambda Codegen Modülü
-- Assembly üretimi sabitleri

-- Register kullanımı
numeric REG_LAMBDA_PTR = 0      -- rax: lambda fonksiyon pointer
numeric REG_CLOSURE_PTR = 1     -- r10: closure struct pointer
numeric REG_LAMBDA_ARG1 = 2     -- rdi: ilk argüman
numeric REG_LAMBDA_ARG2 = 3     -- rsi: ikinci argüman

-- Closure struct layout
numeric CLOSURE_HEADER_SIZE = 8     -- Function pointer
numeric CLOSURE_VAR_SIZE = 8        -- Her capture edilmiş değişken

-- Calling convention
numeric MAX_REG_ARGS = 6            -- rdi, rsi, rdx, rcx, r8, r9
numeric STACK_ALIGNMENT = 16        -- Stack hizalaması

-- Runtime fonksiyonları
numeric RUNTIME_MAP = 0
numeric RUNTIME_FILTER = 1
numeric RUNTIME_REDUCE = 2
numeric RUNTIME_FOREACH = 3

-- Lambda isimlendirme
numeric LAMBDA_NAME_PREFIX = 0      -- .lambda_
numeric CLOSURE_NAME_PREFIX = 1     -- .closure_
