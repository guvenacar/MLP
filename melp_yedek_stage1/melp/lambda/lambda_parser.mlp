-- Lambda Parser Modülü
-- Parse işlemleri sabitleri

-- Parse durumları
numeric PARSE_LAMBDA_START = 0
numeric PARSE_LAMBDA_CAPTURE = 1    -- [x, y] kısmı
numeric PARSE_LAMBDA_PARAMS = 2     -- (a, b) kısmı
numeric PARSE_LAMBDA_ARROW = 3      -- => işareti
numeric PARSE_LAMBDA_BODY = 4       -- Expression/block

-- Capture parse
numeric PARSE_CAPTURE_LBRACKET = 0
numeric PARSE_CAPTURE_VAR = 1
numeric PARSE_CAPTURE_MODE = 2      -- & işareti kontrolü
numeric PARSE_CAPTURE_COMMA = 3
numeric PARSE_CAPTURE_RBRACKET = 4

-- Higher-order parse
numeric PARSE_HOF_NAME = 0
numeric PARSE_HOF_LPAREN = 1
numeric PARSE_HOF_COLLECTION = 2
numeric PARSE_HOF_COMMA = 3
numeric PARSE_HOF_LAMBDA = 4
numeric PARSE_HOF_RPAREN = 5
