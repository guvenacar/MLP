-- lang: tr-TR
-- Final Test - MLP ile Fibonacci

İŞLEÇ fibonacci(n)
    EĞER n <= 1 İSE
        DÖNÜŞ n
    DEĞİLSE
        DÖNÜŞ fibonacci(n-1) + fibonacci(n-2)
    EĞER_SON
İŞLEÇ_SONu

SAYISAL i = 0;

DÖNGÜ
    EĞER i >= 10 İSE
        DÖNGÜ_BITIR
    EĞER_SON
    YAZDIR fibonacci(i)
    i = i + 1
DÖNGÜ_SON
