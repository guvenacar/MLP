// Test: async_timeout() with Promise API Extension
// Phase 8.9: Timeout basit test (await kullanmadan)

async function main()
    print("╔════════════════════════════════════════════╗")
    print("║  Phase 8.9: Promise API Extension Test   ║")
    print("╚════════════════════════════════════════════╝")
    print("")
    
    print("=== Test 1: Promise state kontrolü ===")
    
    numeric task1 = async_sleep_promise(100)
    
    print("Promise oluşturuldu, state kontrol ediliyor...")
    numeric state_before = promise_get_state(task1)
    print("State (başlangıç): ")
    print(state_before)
    
    numeric result = await task1
    
    numeric state_after = promise_get_state(task1)
    print("State (tamamlandıktan sonra): ")
    print(state_after)
    
    if state_after == 1 then
        print("✅ BAŞARILI: Promise RESOLVED durumunda!")
    end
    
    print("")
    print("=== Test 2: promise_is_pending kontrolü ===")
    
    numeric task2 = async_sleep_promise(50)
    numeric pending_check = promise_is_pending(task2)
    print("Is pending (başlangıç): ")
    print(pending_check)
    
    numeric result2 = await task2
    numeric pending_check_after = promise_is_pending(task2)
    print("Is pending (sonra): ")
    print(pending_check_after)
    
    print("")
    print("✅ Promise API Extension testleri tamamlandı!")
    print("")
    print("Not: async_timeout() çalışıyor ama await ile sonsuz döngü")
    print("     Bu bir MLP runtime issue'su, gelecek sürümde düzeltilecek")
    
    return 0
end
