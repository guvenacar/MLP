-- syntax: mlp

-- -----------------------------------------------------------------------------
-- MLP Self-Hosting Test - Ultra Minimal (No Structs)
-- -----------------------------------------------------------------------------

function add_numbers(numeric a, numeric b)
    numeric result
    result = a + b
    return result
end function

function main()
    print "=== MLP SELF-HOSTING TEST ==="
    print "Testing basic compilation..."
    print ""
    
    numeric x
    numeric y
    numeric sum
    
    x = 10
    y = 32
    
    print "x = "
    print x
    print "y = "
    print y
    
    sum = add_numbers(x, y)
    
    print "sum = "
    print sum
    
    print ""
    print "✓ Self-hosting compilation SUCCESS!"
    print "✓ Functions work"
    print "✓ Variables work"
    print "✓ Arithmetic works"
    
    return 0
end function

numeric result
result = main()
