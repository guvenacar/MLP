-- Test Range Syntax (Phase 5.8)

print "=== Range Syntax Tests ==="
print ""

-- Test 1: range(end) - 0 to end-1
print "Test 1: range(5)"
for i in range(5)
    print i
end for
print ""

-- Test 2: range(start, end)
print "Test 2: range(3, 8)"
for i in range(3, 8)
    print i
end for
print ""

-- Test 3: range(start, end, step)
print "Test 3: range(0, 10, 2)"
for i in range(0, 10, 2)
    print i
end for
print ""

-- Test 4: range with expressions
print "Test 4: range(2+3, 15-5)"
numeric start = 5
numeric finish = 10
for i in range(start, finish)
    print i
end for
print ""

-- Test 5: Nested range loops
print "Test 5: Nested loops"
for i in range(3)
    for j in range(2)
        print "i="
        print i
        print " j="
        print j
    end for
end for
print ""

-- Test 6: Range with break
print "Test 6: Range with break at 5"
for i in range(10)
    if i == 5 then
        break
    end
    print i
end for
print ""

print "=== All Range Tests Complete ==="
