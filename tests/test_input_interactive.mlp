-- Interactive Input Test
-- This program demonstrates read_input(), read_int(), num(), and str()

print "==============================================="
print "   MLP Input & Type Casting Demo"
print "==============================================="
print ""

-- Test 1: Read a string
print "Test 1: String Input"
print "Enter your name: "
string name = read_input()
print "Hello, " + name + "!"
print ""

-- Test 2: Read an integer using read_int()
print "Test 2: Integer Input (using read_int)"
print "Enter a number: "
numeric x = read_int()
print "You entered: " + str(x)
print "Double of that: " + str(x + x)
print ""

-- Test 3: Read a number as string, convert with num()
print "Test 3: String to Numeric Conversion"
print "Enter another number: "
string input_str = read_input()
numeric y = num(input_str)
print "Converted to numeric: " + str(y)
print "Plus 10: " + str(y + 10)
print ""

print "==============================================="
print "   All tests completed!"
print "==============================================="
