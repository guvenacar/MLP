// Simple HashMap Test

print "=== HashMap Simple Test ==="

// Test 1: Create map and add entries
map[string:numeric] ages = map()
ages.set("Alice", 30)
ages.set("Bob", 25)

print "Map size: "
print ages.size()

// Test 2: Get values
print "Alice's age: "
print ages.get("Alice")
print "Bob's age: "
print ages.get("Bob")

// Test 3: Has key
print "Has Alice: "
print ages.has("Alice")
print "Has Charlie: "
print ages.has("Charlie")

// Test 4: Update
ages.set("Alice", 31)
print "Alice's new age: "
print ages.get("Alice")

// Test 5: Remove
ages.remove("Bob")
print "Size after remove: "
print ages.size()
print "Has Bob: "
print ages.has("Bob")

// Test 6: Clear
ages.clear()
print "Size after clear: "
print ages.size()

print "=== Test Complete ==="
