function 计算和(int a, int b) then
    return a + b
end
for i = 1 to 5
    int 结果 = 计算和(i, i * 2)
    print "Sum of"
    print i
    print "and"
    print i * 2
    print "="
    print 结果
end for
end
int 计数 = 0
