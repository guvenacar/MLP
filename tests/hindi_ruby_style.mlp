-- lang: hi-IN
-- syntax: ruby
-- Test: Ruby-style syntax with Hindi keywords

पूर्णांक x = 25
पाठ संदेश = "नमस्ते Ruby-Style!"

अगर x > 20
    लिखो("X बड़ा है")
    लिखो(x)
अन्यथा
    लिखो("X छोटा है")
अंत

फलन गुणा(पूर्णांक a, पूर्णांक b)
    वापसी a * b
अंत

प्रत्येक i से 1 तक 5
    पूर्णांक परिणाम = गुणा(i, 3)
    लिखो("Product of")
    लिखो(i)
    लिखो("and 3 is")
    लिखो(परिणाम)
अंत

पूर्णांक गिनती = 0
जब_तक गिनती < 4
    लिखो("Count:")
    लिखो(गिनती)
    गिनती = गिनती + 1
अंत

लिखो("परीक्षण पूर्ण!")
