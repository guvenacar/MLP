-- lang: zh-CN
-- syntax: c
-- Test: C/Java-style syntax with Chinese keywords

整数 x = 20;
字符串 消息 = "你好 Java-Style!";

如果 (x > 10) {
    打印("X 很大");
    打印(x);
} 否则 {
    打印("X 很小");
}

整数 计算和(整数 a, 整数 b) {
    返回 a + b;
}

对于 (整数 i = 1; i <= 5; i++) {
    整数 结果 = 计算和(i, i * 2);
    打印("Sum of");
    打印(i);
    打印("and");
    打印(i * 2);
    打印("=");
    打印(结果);
}

整数 计数 = 0;
当 (计数 < 3) {
    打印("计数:");
    打印(计数);
    计数 = 计数 + 1;
}

打印("测试完成!");
