-- Test MLP string operations
-- This demonstrates layered runtime approach

-- MLP implementation of string_upper using existing C primitives
function mlp_string_upper(input) then
    numeric length = string_length(input)
    if length == 0 then
        return input
    end
    
    -- Build result character by character
    numeric i = 0
    string result = ""
    
    while i < length then
        string ch_str = string_char_at(input, i)
        numeric ch = char_code(ch_str)
        
        -- Check if lowercase letter (a-z is 97-122)
        if ch >= 97 then
            if ch <= 122 then
                ch = ch - 32
            end
        end
        
        string upper_ch = code_to_char(ch)
        result = string_concat(result, upper_ch)
        i = i + 1
    end
    
    return result
end

string test1 = "hello world"
string result1 = mlp_string_upper(test1)
print result1

string test2 = "MLP Runtime!"
string result2 = mlp_string_upper(test2)
print result2
