-- lang: ru-RU
-- syntax: python
-- Test: Python-style syntax with Russian keywords

x = 10
сообщение = "Привет Python-Style!"

если x > 5:
    печать("X большое")
    печать(x)

функция факториал(n):
    если n <= 1:
        вернуть 1
    вернуть n * факториал(n - 1)

для i в range(6):
    результат = факториал(i)
    печать("Факториал")
    печать(i)
    печать("=")
    печать(результат)

печать("Тест завершён!")
