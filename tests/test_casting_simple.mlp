-- Simple test for num() and str() functions

-- Test str() function
print "Testing str() function:"
numeric x = 42
string s = str(x)
print s

numeric y = 100
print str(y)

print ""

-- Test num() function
print "Testing num() function:"
string a = "123"
numeric n = num(a)
print "Converted: "
print n

string b = "456"
numeric m = num(b)
print m

print ""

-- Test round-trip conversion
print "Testing round-trip conversion:"
string original = "789"
numeric converted = num(original)
string back = str(converted)
print "Original: "
print original
print "Converted back: "
print back

print ""
print "All tests done!"
