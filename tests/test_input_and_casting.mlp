-- Test: Input Functions and Type Casting
-- Tests: read_input(), read_line(), read_int(), num(), str()

function test_str_function() then
    print "=== Testing str() function ==="
    
    -- Integer values
    numeric a = 42
    string s1 = str(a)
    print "str(42) = " + s1
    
    -- Another integer
    numeric b = 100
    string s2 = str(b)
    print "str(100) = " + s2
    
    -- Negative integer (using subtraction)
    numeric c = 0 - 10
    string s3 = str(c)
    print "str(-10) = " + s3
    
    -- Zero
    numeric d = 0
    string s4 = str(d)
    print "str(0) = " + s4
    
    print ""
end function

function test_num_function() then
    print "=== Testing num() function ==="
    
    -- Integer string
    numeric x = num("42")
    print "num(\"42\") = " + str(x)
    
    -- Another integer string  
    numeric y = num("999")
    print "num(\"999\") = " + str(y)
    
    -- Negative integer string
    numeric z = num("-10")
    print "num(\"-10\") = " + str(z)
    
    -- Zero string
    numeric w = num("0")
    print "num(\"0\") = " + str(w)
    
    print ""
end function

function test_conversions() then
    print "=== Testing Type Conversions ==="
    
    -- String to numeric and back
    string original = "123"
    numeric n = num(original)
    string converted = str(n)
    print "Original: " + original
    print "After num() + str(): " + converted
    
    -- Numeric operations
    numeric a = num("10")
    numeric b = num("20")
    numeric sum = a + b
    print "10 + 20 = " + str(sum)
    
    print ""
end function

function test_input_simulation() then
    print "=== Input Functions (would need stdin) ==="
    print "read_input() - Reads a line from stdin"
    print "read_line() - Alias for read_input()"
    print "read_int() - Reads an integer from stdin"
    print ""
    print "Example usage:"
    print "  print \"Enter your name: \""
    print "  string name = read_input()"
    print "  print \"Hello, \" + name"
    print ""
    print "  print \"Enter a number: \""
    print "  numeric x = read_int()"
    print "  print \"You entered: \" + str(x)"
    print ""
end function

-- Main test
print "╔════════════════════════════════════════╗"
print "║  MLP Input & Type Casting Tests       ║"
print "╚════════════════════════════════════════╝"
print ""

test_str_function()
test_num_function()
test_conversions()
test_input_simulation()

print "✅ All tests completed!"
