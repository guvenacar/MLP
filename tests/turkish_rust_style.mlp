-- lang: tr-TR
-- syntax: rust
-- Test: Rust-style syntax with Turkish keywords

TAMSAYI x = 45;
METIN mesaj = "Merhaba Rust-Style!";

eğer x > 40 {
    yazdir("X büyük");
    yazdir(x);
} yoksa {
    yazdir("X küçük");
}

fonksiyon çarp(a: TAMSAYI, b: TAMSAYI) -> TAMSAYI {
    dönüş a * b;
}

için i için 1..6 {
    TAMSAYI sonuç = çarp(i, 5);
    yazdir("Çarpım");
    yazdir(i);
    yazdir("ve 5 =");
    yazdir(sonuç);
}

TAMSAYI sayaç = 0;
iken sayaç < 3 {
    yazdir("Sayaç:");
    yazdir(sayaç);
    sayaç = sayaç + 1;
}

yazdir("Test tamamlandı!");
