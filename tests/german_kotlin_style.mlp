-- lang: de-DE
-- syntax: kotlin
-- Test: Kotlin-style syntax with German keywords

ganzzahl x = 35
zeichenkette nachricht = "Hallo Kotlin-Style!"

wenn (x > 30) {
    drucken("X ist groß")
    drucken(x)
} sonst {
    drucken("X ist klein")
}

funktion addieren(ganzzahl a, ganzzahl b): ganzzahl {
    zurück a + b
}

für (i = 1; i <= 5; i++) {
    ganzzahl ergebnis = addieren(i, 20)
    drucken("Summe von")
    drucken(i)
    drucken("und 20 ist")
    drucken(ergebnis)
}

ganzzahl zähler = 0
während (zähler < 3) {
    drucken("Zähler:")
    drucken(zähler)
    zähler = zähler + 1
}

drucken("Test abgeschlossen!")
