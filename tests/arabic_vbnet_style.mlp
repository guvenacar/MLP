-- lang: ar-SA
-- syntax: vbnet
-- Test: VB.NET-style syntax with Arabic keywords

صحيح x = 15
نص رسالة = "مرحبا VB.NET-Style!"

إذا x > 10 فإن
    اطبع("X كبير")
    اطبع(x)
وإلا
    اطبع("X صغير")
نهاية إذا

دالة مضاعفة(صحيح عدد) فإن
    إرجاع عدد * 2
نهاية دالة

لكل i = 1 إلى 5
    صحيح نتيجة = مضاعفة(i)
    اطبع("Double of")
    اطبع(i)
    اطبع("is")
    اطبع(نتيجة)
نهاية لكل

صحيح عداد = 0
بينما عداد < 3
    اطبع("Counter:")
    اطبع(عداد)
    عداد = عداد + 1
نهاية بينما

اطبع("الاختبار مكتمل!")
