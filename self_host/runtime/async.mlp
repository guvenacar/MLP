-- -----------------------------------------------------------------------------
-- Async function state machine
-- -----------------------------------------------------------------------------

struct AsyncState then
    numeric state_index
    numeric is_completed
    numeric result_value
    list[numeric] local_vars
    list[Promise] pending_promises
end struct

function async_state_create()
    AsyncState state
    state.state_index = 0
    state.is_completed = 0
    state.result_value = 0
    state.local_vars = list()
    state.pending_promises = list()
    return state
end function

function async_state_save_local(state, value)
    state.local_vars.add(value)
    return state
end function

function async_state_restore_local(state, index)
    if index < state.local_vars.size() then
        return state.local_vars.get(index)
    end if
    return 0
end function

function async_state_complete(state, result)
    state.is_completed = 1
    state.result_value = result
    return state
end function

-- -----------------------------------------------------------------------------
-- Async/Await helper macros (code generation support)
-- -----------------------------------------------------------------------------

function async_wrap_function(function_ptr)
    Promise p = promise_create()
    Task t = task_create(function_ptr)
    t = task_schedule(t)
    return p
end function

function await_expression(promise)
    return promise_await(promise)
end function

-- -----------------------------------------------------------------------------
-- Generator support (yield)
-- -----------------------------------------------------------------------------

struct Generator then
    numeric ptr
    numeric state_index
    numeric is_exhausted
    list[numeric] yielded_values
end struct

function generator_create()
    Generator g
    g.ptr = 0
    g.state_index = 0
    g.is_exhausted = 0
    g.yielded_values = list()
    return g
end function

function generator_next(g)
    if g.is_exhausted == 1 then
        return -1
    end if
    
    -- TODO: Resume generator and get next value
    if g.yielded_values.size() > 0 then
        return g.yielded_values.get(0)
    end if
    
    g.is_exhausted = 1
    return -1
end function

function generator_yield(g, value)
    g.yielded_values.add(value)
    return g
end function

