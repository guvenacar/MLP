-- -----------------------------------------------------------------------------
-- Runtime Async/Await Wrapper
-- -----------------------------------------------------------------------------
-- C runtime'daki async event loop fonksiyonlarını MLP'ye bağlar
-- -----------------------------------------------------------------------------

-- -----------------------------------------------------------------------------
-- External C runtime functions (will be linked)
-- -----------------------------------------------------------------------------

-- extern async_create_promise() -> pointer
-- extern async_resolve_promise(pointer promise, pointer value)
-- extern async_reject_promise(pointer promise, pointer error)
-- extern async_await_promise(pointer promise) -> pointer
-- extern async_create_task(pointer function_ptr) -> pointer
-- extern async_schedule_task(pointer task)
-- extern async_run_event_loop()
-- extern async_stop_event_loop()
-- extern async_yield()
-- extern async_sleep(numeric milliseconds) -> pointer

-- -----------------------------------------------------------------------------
-- Promise wrapper type
-- -----------------------------------------------------------------------------

struct Promise then
    numeric ptr
    numeric state
    numeric value
end struct

-- State constants
numeric PROMISE_PENDING = 0
numeric PROMISE_RESOLVED = 1
numeric PROMISE_REJECTED = 2

-- -----------------------------------------------------------------------------
-- Promise operations
-- -----------------------------------------------------------------------------

function promise_create()
    Promise p
    -- TODO: Call C runtime
    -- p.ptr = async_create_promise()
    p.ptr = 0
    p.state = PROMISE_PENDING
    p.value = 0
    return p
end function

function promise_resolve(p, value)
    -- TODO: Call C runtime
    -- async_resolve_promise(p.ptr, value)
    p.state = PROMISE_RESOLVED
    p.value = value
    return p
end function

function promise_reject(p, error)
    -- TODO: Call C runtime
    -- async_reject_promise(p.ptr, error)
    p.state = PROMISE_REJECTED
    p.value = error
    return p
end function

function promise_await(p)
    -- TODO: Call C runtime
    -- return async_await_promise(p.ptr)
    return p.value
end function

-- -----------------------------------------------------------------------------
-- Task wrapper type
-- -----------------------------------------------------------------------------

struct Task then
    numeric ptr
    numeric function_ptr
    numeric state
end struct

-- Task state constants
numeric TASK_PENDING = 0
numeric TASK_RUNNING = 1
numeric TASK_COMPLETED = 2
numeric TASK_FAILED = 3

-- -----------------------------------------------------------------------------
-- Task operations
-- -----------------------------------------------------------------------------

function task_create(function_ptr)
    Task t
    -- TODO: Call C runtime
    -- t.ptr = async_create_task(function_ptr)
    t.ptr = 0
    t.function_ptr = function_ptr
    t.state = TASK_PENDING
    return t
end function

function task_schedule(t)
    -- TODO: Call C runtime
    -- async_schedule_task(t.ptr)
    t.state = TASK_RUNNING
    return t
end function

