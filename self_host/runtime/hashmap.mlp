-- lang: en-US
-- syntax: mlp

-- -----------------------------------------------------------------------------
-- Runtime HashMap Wrapper
-- -----------------------------------------------------------------------------
-- C runtime'daki HashMap fonksiyonlarını MLP'ye bağlar
-- -----------------------------------------------------------------------------

-- -----------------------------------------------------------------------------
-- External C runtime functions (will be linked)
-- -----------------------------------------------------------------------------

-- extern hashmap_create(numeric capacity) -> pointer
-- extern hashmap_set(pointer map, pointer key, pointer value)
-- extern hashmap_get(pointer map, pointer key) -> pointer
-- extern hashmap_has(pointer map, pointer key) -> numeric
-- extern hashmap_remove(pointer map, pointer key) -> numeric
-- extern hashmap_size(pointer map) -> numeric
-- extern hashmap_keys(pointer map) -> pointer
-- extern hashmap_values(pointer map) -> pointer
-- extern hashmap_clear(pointer map)
-- extern hashmap_free(pointer map)

-- -----------------------------------------------------------------------------
-- HashMap wrapper type
-- -----------------------------------------------------------------------------

struct HashMap then
    numeric ptr
end struct

-- -----------------------------------------------------------------------------
-- Constructors
-- -----------------------------------------------------------------------------

function hashmap_create_wrapper(capacity)
    HashMap map
    -- TODO: Call C runtime
    -- map.ptr = hashmap_create(capacity)
    map.ptr = 0
    return map
end function

function hashmap_new()
    return hashmap_create_wrapper(16)
end function

-- -----------------------------------------------------------------------------
-- Operations
-- -----------------------------------------------------------------------------

function hashmap_set_wrapper(map, key, value)
    -- TODO: Call C runtime
    -- hashmap_set(map.ptr, key, value)
    return map
end function

function hashmap_get_wrapper(map, key)
    -- TODO: Call C runtime
    -- return hashmap_get(map.ptr, key)
    return 0
end function

function hashmap_has_wrapper(map, key)
    -- TODO: Call C runtime
    -- return hashmap_has(map.ptr, key)
    return 0
end function

function hashmap_remove_wrapper(map, key)
    -- TODO: Call C runtime
    -- return hashmap_remove(map.ptr, key)
    return 0
end function

function hashmap_size_wrapper(map)
    -- TODO: Call C runtime
    -- return hashmap_size(map.ptr)
    return 0
end function

function hashmap_keys_wrapper(map)
    -- TODO: Call C runtime
    -- numeric keys_ptr = hashmap_keys(map.ptr)
    list[string] keys = list()
    return keys
end function

function hashmap_values_wrapper(map)
    -- TODO: Call C runtime
    -- numeric values_ptr = hashmap_values(map.ptr)
    list[numeric] values = list()
    return values
end function

function hashmap_clear_wrapper(map)
    -- TODO: Call C runtime
    -- hashmap_clear(map.ptr)
    return map
end function

-- -----------------------------------------------------------------------------
-- Memory management
-- -----------------------------------------------------------------------------

function hashmap_destroy(map)
    -- TODO: Call C runtime
    -- hashmap_free(map.ptr)
    map.ptr = 0
    return map
end function

-- -----------------------------------------------------------------------------
-- Set wrapper (implemented using HashMap with dummy values)
-- -----------------------------------------------------------------------------

struct Set then
    HashMap internal_map
end struct

function set_create_wrapper(capacity)
    Set s
    s.internal_map = hashmap_create_wrapper(capacity)
    return s
end function

function set_new()
    return set_create_wrapper(16)
end function

function set_add_wrapper(s, element)
    s.internal_map = hashmap_set_wrapper(s.internal_map, element, 1)
    return s
end function

function set_has_wrapper(s, element)
    return hashmap_has_wrapper(s.internal_map, element)
end function

function set_remove_wrapper(s, element)
    return hashmap_remove_wrapper(s.internal_map, element)
end function

function set_size_wrapper(s)
    return hashmap_size_wrapper(s.internal_map)
end function

function set_values_wrapper(s)
    return hashmap_keys_wrapper(s.internal_map)
end function

function set_clear_wrapper(s)
    s.internal_map = hashmap_clear_wrapper(s.internal_map)
    return s
end function

function set_destroy(s)
    s.internal_map = hashmap_destroy(s.internal_map)
    return s
end function
