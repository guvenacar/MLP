# -----------------------------------------------------------------------------
# Helper: int to string conversion
# -----------------------------------------------------------------------------

function int_to_string(n)
    if n == 0 then return "0" end if
    if n == 1 then return "1" end if
    if n == 2 then return "2" end if
    if n == 3 then return "3" end if
    if n == 4 then return "4" end if
    if n == 5 then return "5" end if
    if n == 6 then return "6" end if
    if n == 7 then return "7" end if
    if n == 8 then return "8" end if
    if n == 9 then return "9" end if
    if n == 10 then return "10" end if
    
    string result = ""
    numeric temp = n
    numeric is_negative = 0
    
    if temp < 0 then
        is_negative = 1
        temp = -temp
    end if
    
    while temp > 0
        numeric digit = temp % 10
        temp = temp / 10
        
        if digit == 0 then result = "0" + result end if
        if digit == 1 then result = "1" + result end if
        if digit == 2 then result = "2" + result end if
        if digit == 3 then result = "3" + result end if
        if digit == 4 then result = "4" + result end if
        if digit == 5 then result = "5" + result end if
        if digit == 6 then result = "6" + result end if
        if digit == 7 then result = "7" + result end if
        if digit == 8 then result = "8" + result end if
        if digit == 9 then result = "9" + result end if
    end while
    
    if is_negative == 1 then
        result = "-" + result
    end if
    
    return result
end function

# -----------------------------------------------------------------------------
# Helper: string to int conversion
# -----------------------------------------------------------------------------

function string_to_int(str)
    numeric result = 0
    numeric is_negative = 0
    numeric start_index = 0
    
    if str.length() == 0 then
        return 0
    end if
    
    # Check for negative sign
    string first_char = str.substring(0, 1)
    if first_char == "-" then
        is_negative = 1
        start_index = 1
    end if
    
    # Parse digits
    for i = start_index to str.length() - 1 do
        string char = str.substring(i, i + 1)
        numeric digit = 0
        
        if char == "0" then digit = 0 end if
        if char == "1" then digit = 1 end if
        if char == "2" then digit = 2 end if
        if char == "3" then digit = 3 end if
        if char == "4" then digit = 4 end if
        if char == "5" then digit = 5 end if
        if char == "6" then digit = 6 end if
        if char == "7" then digit = 7 end if
        if char == "8" then digit = 8 end if
        if char == "9" then digit = 9 end if
        
        result = result * 10 + digit
    end for
    
    if is_negative == 1 then
        result = -result
    end if
    
    return result
end function
