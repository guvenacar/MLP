# lang: en-US
# syntax: mlp

# -----------------------------------------------------------------------------
# Runtime BigDecimal Wrapper
# -----------------------------------------------------------------------------
# C runtime'daki BigDecimal fonksiyonlarını MLP'ye bağlar
# Tüm numeric operasyonlar bu modül üzerinden yapılır
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# External C runtime functions (will be linked)
# -----------------------------------------------------------------------------

# extern bigdecimal_create(string value) -> pointer
# extern bigdecimal_add(pointer a, pointer b) -> pointer
# extern bigdecimal_subtract(pointer a, pointer b) -> pointer
# extern bigdecimal_multiply(pointer a, pointer b) -> pointer
# extern bigdecimal_divide(pointer a, pointer b) -> pointer
# extern bigdecimal_modulo(pointer a, pointer b) -> pointer
# extern bigdecimal_compare(pointer a, pointer b) -> numeric
# extern bigdecimal_to_string(pointer bd) -> string
# extern bigdecimal_free(pointer bd)

# -----------------------------------------------------------------------------
# BigDecimal wrapper type
# -----------------------------------------------------------------------------

struct BigDecimal then
    numeric ptr
end struct

# -----------------------------------------------------------------------------
# Constructors
# -----------------------------------------------------------------------------

function bigdecimal_from_string(value)
    BigDecimal bd
    # TODO: Call C runtime
    # bd.ptr = bigdecimal_create(value)
    bd.ptr = 0
    return bd
end function

function bigdecimal_from_int(value)
    string str_value = int_to_string(value)
    return bigdecimal_from_string(str_value)
end function

function bigdecimal_zero()
    return bigdecimal_from_string("0")
end function

function bigdecimal_one()
    return bigdecimal_from_string("1")
end function

