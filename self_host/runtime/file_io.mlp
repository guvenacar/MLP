-- -----------------------------------------------------------------------------
-- Path operations
-- -----------------------------------------------------------------------------

function path_join(parts)
    metin result = ""
    numeric count = parts.size()
    
    for i = 0 to count - 1 do
        result = result + parts.get(i)
        if i < count - 1 then
            result = result + "/"
        end_if
    end_for
    
    return result
end_function

function path_basename(filepath)
    numeric len = string_length(filepath)
    numeric last_slash = -1
    
    numeric i = 0
    while i < len do
        metin c = string_substring(filepath, i, i + 1)
        if c == "/" then
            last_slash = i
        end_if
        i = i + 1
    end_while
    
    if last_slash < 0 then
        return filepath
    end_if
    
    return string_substring(filepath, last_slash + 1, len - (last_slash + 1))
end_function

function path_dirname(filepath)
    numeric len = string_length(filepath)
    numeric last_slash = -1
    
    numeric i = 0
    while i < len do
        metin c = string_substring(filepath, i, i + 1)
        if c == "/" then
            last_slash = i
        end_if
        i = i + 1
    end_while
    
    if last_slash < 0 then
        return "."
    end_if
    
    return string_substring(filepath, 0, last_slash)
end_function

function path_extension(filepath)
    numeric len = string_length(filepath)
    numeric last_dot = -1
    
    numeric i = 0
    while i < len do
        metin c = string_substring(filepath, i, i + 1)
        if c == "." then
            last_dot = i
        end_if
        i = i + 1
    end_while
    
    if last_dot < 0 then
        return ""
    end_if
    
    return string_substring(filepath, last_dot, len - last_dot)
end_function
