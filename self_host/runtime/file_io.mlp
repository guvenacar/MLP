# lang: en-US
# syntax: mlp

# -----------------------------------------------------------------------------
# Runtime File I/O Wrapper
# -----------------------------------------------------------------------------
# C runtime'daki file I/O fonksiyonlarını MLP'ye bağlar
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# External C runtime functions (will be linked)
# -----------------------------------------------------------------------------

# extern fopen(pointer filename, pointer mode) -> pointer
# extern fclose(pointer file)
# extern fread(pointer buffer, numeric size, numeric count, pointer file) -> numeric
# extern fwrite(pointer buffer, numeric size, numeric count, pointer file) -> numeric
# extern fseek(pointer file, numeric offset, numeric whence) -> numeric
# extern ftell(pointer file) -> numeric
# extern feof(pointer file) -> numeric
# extern ferror(pointer file) -> numeric
# extern fgets(pointer buffer, numeric size, pointer file) -> pointer
# extern fputs(pointer str, pointer file) -> numeric

# -----------------------------------------------------------------------------
# File wrapper type
# -----------------------------------------------------------------------------

struct File then
    numeric ptr
    string path
    string mode
    numeric is_open
end struct

# File mode constants
string FILE_READ = "r"
string FILE_WRITE = "w"
string FILE_APPEND = "a"
string FILE_READ_WRITE = "r+"
string FILE_WRITE_READ = "w+"
string FILE_APPEND_READ = "a+"

# Seek constants
numeric SEEK_SET = 0
numeric SEEK_CUR = 1
numeric SEEK_END = 2

# -----------------------------------------------------------------------------
# File operations
# -----------------------------------------------------------------------------

function file_open(filepath, mode)
    File f
    f.path = filepath
    f.mode = mode
    # TODO: Call C runtime
    # f.ptr = fopen(filepath, mode)
    f.ptr = 0
    f.is_open = 1
    return f
end function

function file_close(f)
    if f.is_open == 1 then
        # TODO: Call C runtime
        # fclose(f.ptr)
        f.is_open = 0
    end if
    return f
end function

function file_read(f, size)
    if f.is_open == 0 then
        return ""
    end if
    
    # TODO: Call C runtime
    # numeric buffer = gc_malloc(size)
    # numeric bytes_read = fread(buffer, 1, size, f.ptr)
    
    return ""
end function

function file_write(f, content)
    if f.is_open == 0 then
        return 0
    end if
    
    # TODO: Call C runtime
    # numeric bytes_written = fwrite(content, 1, string_length(content), f.ptr)
    
    return 0
end function

function file_read_line(f)
    if f.is_open == 0 then
        return ""
    end if
    
    # TODO: Call C runtime
    # numeric buffer = gc_malloc(4096)
    # numeric result = fgets(buffer, 4096, f.ptr)
    
    return ""
end function

function file_write_line(f, line)
    if f.is_open == 0 then
        return 0
    end if
    
    # TODO: Call C runtime
    # numeric result = fputs(line, f.ptr)
    
    return 0
end function

# -----------------------------------------------------------------------------
# File positioning
# -----------------------------------------------------------------------------

function file_seek(f, offset, whence)
    if f.is_open == 0 then
        return -1
    end if
    
    # TODO: Call C runtime
    # return fseek(f.ptr, offset, whence)
    
    return 0
end function

function file_tell(f)
    if f.is_open == 0 then
        return -1
    end if
    
    # TODO: Call C runtime
    # return ftell(f.ptr)
    
    return 0
end function

function file_rewind(f)
    return file_seek(f, 0, SEEK_SET)
end function

# -----------------------------------------------------------------------------
# File status
# -----------------------------------------------------------------------------

function file_eof(f)
    if f.is_open == 0 then
        return 1
    end if
    
    # TODO: Call C runtime
    # return feof(f.ptr)
    
    return 0
end function

function file_error(f)
    if f.is_open == 0 then
        return 1
    end if
    
    # TODO: Call C runtime
    # return ferror(f.ptr)
    
    return 0
end function

# -----------------------------------------------------------------------------
# High-level file operations
# -----------------------------------------------------------------------------

function read_file(filepath)
    File f = file_open(filepath, FILE_READ)
    
    if f.ptr == 0 then
        return ""
    end if
    
    # Get file size
    file_seek(f, 0, SEEK_END)
    numeric size = file_tell(f)
    file_rewind(f)
    
    # Read entire file
    string content = file_read(f, size)
    
    file_close(f)
    return content
end function

function write_file(filepath, content)
    File f = file_open(filepath, FILE_WRITE)
    
    if f.ptr == 0 then
        return 0
    end if
    
    numeric bytes_written = file_write(f, content)
    
    file_close(f)
    return bytes_written
end function

function append_file(filepath, content)
    File f = file_open(filepath, FILE_APPEND)
    
    if f.ptr == 0 then
        return 0
    end if
    
    numeric bytes_written = file_write(f, content)
    
    file_close(f)
    return bytes_written
end function

function file_exists(filepath)
    File f = file_open(filepath, FILE_READ)
    
    if f.ptr == 0 then
        return 0
    end if
    
    file_close(f)
    return 1
end function

# -----------------------------------------------------------------------------
# Line-based file operations
# -----------------------------------------------------------------------------

function read_lines(filepath)
    File f = file_open(filepath, FILE_READ)
    
    if f.ptr == 0 then
        list[string] empty = list()
        return empty
    end if
    
    list[string] lines = list()
    
    string line = file_read_line(f)
    while line != "" do
        lines.add(line)
        line = file_read_line(f)
    end while
    
    file_close(f)
    return lines
end function

function write_lines(filepath, lines)
    File f = file_open(filepath, FILE_WRITE)
    
    if f.ptr == 0 then
        return 0
    end if
    
    numeric count = 0
    for line in lines do
        file_write_line(f, line)
        count = count + 1
    end for
    
    file_close(f)
    return count
end function

