# -----------------------------------------------------------------------------
# Path operations
# -----------------------------------------------------------------------------

function path_join(parts)
    string result = ""
    numeric count = parts.size()
    
    for i = 0, count do
        result = result + parts.get(i)
        if i < count - 1 then
            result = result + "/"
        end if
    end for
    
    return result
end function

function path_basename(filepath)
    numeric last_slash = filepath.last_index_of("/")
    
    if last_slash < 0 then
        return filepath
    end if
    
    return filepath.substring(last_slash + 1)
end function

function path_dirname(filepath)
    numeric last_slash = filepath.last_index_of("/")
    
    if last_slash < 0 then
        return "."
    end if
    
    return filepath.substring(0, last_slash)
end function

function path_extension(filepath)
    numeric last_dot = filepath.last_index_of(".")
    
    if last_dot < 0 then
        return ""
    end if
    
    return filepath.substring(last_dot)
end function
