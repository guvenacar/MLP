# extern bigstring_contains(pointer str, pointer substr) -> numeric
# extern bigstring_index_of(pointer str, pointer substr) -> numeric
# extern bigstring_to_cstring(pointer str) -> string
# extern bigstring_free(pointer str)

# -----------------------------------------------------------------------------
# BigString wrapper type
# -----------------------------------------------------------------------------

struct BigString then
    numeric ptr
end struct

# -----------------------------------------------------------------------------
# Constructors
# -----------------------------------------------------------------------------

function bigstring_from_cstring(value)
    BigString bs
    # TODO: Call C runtime
    # bs.ptr = bigstring_create(value)
    bs.ptr = 0
    return bs
end function

function bigstring_empty()
    return bigstring_from_cstring("")
end function

# -----------------------------------------------------------------------------
# String operations
# -----------------------------------------------------------------------------

function bigstring_concat_op(a, b)
    BigString result
    # TODO: Call C runtime
    # result.ptr = bigstring_concat(a.ptr, b.ptr)
    result.ptr = 0
    return result
end function

function bigstring_substring_op(str, start_pos, end_pos)
    BigString result
    # TODO: Call C runtime
    # result.ptr = bigstring_substring(str.ptr, start_pos, end_pos)
    result.ptr = 0
    return result
end function

function bigstring_length_op(str)
    # TODO: Call C runtime
    # return bigstring_length(str.ptr)
    return 0
end function

# -----------------------------------------------------------------------------
# Comparison operations
# -----------------------------------------------------------------------------

function bigstring_equals_op(a, b)
    # TODO: Call C runtime
    # return bigstring_equals(a.ptr, b.ptr)
    return 0
end function

function bigstring_compare_op(a, b)
    # TODO: Call C runtime
    # return bigstring_compare(a.ptr, b.ptr)
    return 0
end function

function bigstring_less_than(a, b)
    numeric cmp = bigstring_compare_op(a, b)
    if cmp < 0 then
        return 1
    end if
    return 0
end function

function bigstring_greater_than(a, b)
    numeric cmp = bigstring_compare_op(a, b)
    if cmp > 0 then
        return 1
    end if
    return 0
end function

