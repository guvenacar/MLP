# -----------------------------------------------------------------------------
# External C runtime functions (will be linked)
# -----------------------------------------------------------------------------

# extern bigstring_create(string value) -> pointer
# extern bigstring_concat(pointer a, pointer b) -> pointer
# extern bigstring_substring(pointer str, numeric start, numeric end) -> pointer
# extern bigstring_length(pointer str) -> numeric
