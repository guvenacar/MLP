-- -----------------------------------------------------------------------------
-- Memory management
-- -----------------------------------------------------------------------------

function bigstring_destroy(bs)
    -- TODO: Call C runtime
    -- bigstring_free(bs.ptr)
    bs.ptr = 0
    return bs
end_function

-- -----------------------------------------------------------------------------
-- String interpolation support
-- -----------------------------------------------------------------------------

function bigstring_interpolate(parts, values)
    BigString result = bigstring_empty()
    
    numeric part_count = parts.size()
    numeric value_count = values.size()
    
    for i = 0 to part_count - 1 do
        metin part = parts.get(i)
        BigString part_str = bigstring_from_cstring(part)
        result = bigstring_concat_op(result, part_str)
        
        if i < value_count then
            -- Convert value to metin
            numeric value = values.get(i)
            metin value_str = numeric_to_metin(value)
            BigString value_bigstr = bigstring_from_cstring(value_str)
            result = bigstring_concat_op(result, value_bigstr)
        end_if
    end_for
    
    return result
end_function

-- -----------------------------------------------------------------------------
-- Helper: numeric to metin conversion
-- -----------------------------------------------------------------------------

function numeric_to_metin(n)
    if n == 0 then return "0" end_if
    if n == 1 then return "1" end_if
    if n == 2 then return "2" end_if
    if n == 3 then return "3" end_if
    if n == 4 then return "4" end_if
    if n == 5 then return "5" end_if
    if n == 6 then return "6" end_if
    if n == 7 then return "7" end_if
    if n == 8 then return "8" end_if
    if n == 9 then return "9" end_if
    if n == 10 then return "10" end_if
    
    metin result = ""
    numeric temp = n
    numeric is_negative = 0
    
    if temp < 0 then
        is_negative = 1
        temp = -temp
    end_if
    
    while temp > 0
        numeric digit = temp % 10
        temp = temp / 10
        
        if digit == 0 then result = "0" + result end_if
        if digit == 1 then result = "1" + result end_if
        if digit == 2 then result = "2" + result end_if
        if digit == 3 then result = "3" + result end_if
        if digit == 4 then result = "4" + result end_if
        if digit == 5 then result = "5" + result end_if
        if digit == 6 then result = "6" + result end_if
        if digit == 7 then result = "7" + result end_if
        if digit == 8 then result = "8" + result end_if
        if digit == 9 then result = "9" + result end_if
    end_while
    
    if is_negative == 1 then
        result = "-" + result
    end_if
    
    return result
end_function

