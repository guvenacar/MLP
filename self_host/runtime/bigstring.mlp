-- -----------------------------------------------------------------------------
-- BigString wrapper type
-- -----------------------------------------------------------------------------

struct BigString then
    numeric ptr
end_struct

-- -----------------------------------------------------------------------------
-- Constructors
-- -----------------------------------------------------------------------------

function bigstring_from_cstring(value)
    BigString bs
    -- TODO: Call C runtime
    -- bs.ptr = bigstring_create(value)
    bs.ptr = 0
    return bs
end_function

function bigstring_empty()
    return bigstring_from_cstring("")
end_function

-- -----------------------------------------------------------------------------
-- String operations
-- -----------------------------------------------------------------------------

function bigstring_concat_op(a, b)
    BigString result
    -- TODO: Call C runtime
    -- result.ptr = bigstring_concat(a.ptr, b.ptr)
    result.ptr = 0
    return result
end_function

function bigstring_substring_op(str_val, start_pos, end_pos)
    BigString result
    -- TODO: Call C runtime
