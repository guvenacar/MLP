import "compiler_core/token_types.mlp"
import "compiler_core/ast/ast_nodes.mlp"
import "compiler_core/function_registry.mlp"
import "compiler_core/lexer.mlp"
import "compiler_core/parser.mlp"
import "compiler_core/parser_functions.mlp"
import "compiler_core/parser_structures.mlp"
import "compiler_core/parser_advanced.mlp"
import "compiler_core/scope_manager.mlp"
import "compiler_core/codegen.mlp"
import "compiler_core/codegen_functions.mlp"
import "compiler_core/codegen_structures.mlp"
import "compiler_core/codegen_control.mlp"
import "compiler_core/import_handler.mlp"

-- Import runtime wrappers (for file I/O, etc.)
-- import "runtime/file_io.mlp" -- TEMP DISABLED

-- -----------------------------------------------------------------------------
-- Compiler Options
-- -----------------------------------------------------------------------------

struct CompilerOptions
    String input_file
    String output_file
    Numeric verbose
    Numeric debug_tokens
    Numeric debug_ast
    Numeric debug_scope
    Numeric optimize_level
    Numeric show_help
    Numeric show_version
end_struct

function options_create()
    CompilerOptions opts
    opts.input_file = ""
    opts.output_file = "output.asm"
    opts.verbose = 0
    opts.debug_tokens = 0
    opts.debug_ast = 0
    opts.debug_scope = 0
    opts.optimize_level = 0
    opts.show_help = 0
    opts.show_version = 0
    return opts
end_function

-- -----------------------------------------------------------------------------
-- Help and Version
-- -----------------------------------------------------------------------------

function print_help()
    print "MLP Self-Hosting Compiler v1.0"
    print ""
    print "Usage: mlpc [options] <input.mlp>"
    print ""
    print "Options:"
    print "  -o, --output <file>    Output assembly file (default: output.asm)"
    print "  -v, --version          Show version information"
    print "  -h, --help             Show this help message"
    print "  --verbose              Verbose output"
    print "  --debug-tokens         Print token stream"
    print "  --debug-ast            Print AST structure"
    print "  --debug-scope          Print scope information"
    print ""
    print "Examples:"
    print "  mlpc program.mlp -o program.asm"
    print "  mlpc --verbose --debug-tokens input.mlp"
end_function

function print_version()
    print "MLP Self-Hosting Compiler v1.0.0"
    print "Build: 2025-11-24"
    print "Target: x86-64 Linux"
end_function

-- -----------------------------------------------------------------------------
-- Main Entry Point (Simple version for now)
-- -----------------------------------------------------------------------------

function main()
    print "=== MLP Self-Hosting Compiler ==="
    print "Version 1.0.0"
    print ""
    
    -- For now, just test that imports work
    print "✓ Token types loaded"
    print "✓ AST nodes loaded"
    print "✓ Lexer loaded"
    print "✓ Parser loaded"
    print "✓ Code generator loaded"
    print ""
    print "Compiler initialized successfully!"
    print "Ready for compilation pipeline implementation."
    
    return 0
end_function

-- Run
Numeric result = main()
