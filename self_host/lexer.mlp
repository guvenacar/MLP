-- MLP Self-Hosting Lexer v1.2
-- String karşılaştırma için string_karsilastir kullanır

int TOKEN_EOF = 0;
int TOKEN_SAYI = 1;
int TOKEN_IDENTIFIER = 3;
int TOKEN_INT = 10;
int TOKEN_PRINT = 20;
int TOKEN_SEMICOLON = 48;
int TOKEN_ASSIGN = 50;
int TOKEN_PLUS = 51;

list<int> token_types = list<int>();
int token_count = 0;

string source = "int x = 10;
print x + 5";

int pos = 0;
int src_len = string_length(source);

print "=== MLP Lexer v1.2 ==="
print src_len

while pos < src_len do
    string ch = string_substring(source, pos, 1);
    
    int is_space = string_karsilastir(ch, " ");
    int is_newline = string_karsilastir(ch, "\n");
    int is_eq = string_karsilastir(ch, "=");
    int is_plus = string_karsilastir(ch, "+");
    int is_semi = string_karsilastir(ch, ";");
    int is_i = string_karsilastir(ch, "i");
    int is_p = string_karsilastir(ch, "p");
    int is_x = string_karsilastir(ch, "x");
    int is_1 = string_karsilastir(ch, "1");
    int is_5 = string_karsilastir(ch, "5");
    int is_0 = string_karsilastir(ch, "0");
    
    if is_space == 0 then
        pos = pos + 1
    else
        if is_newline == 0 then
            pos = pos + 1
        else
            if is_eq == 0 then
                token_types.add(TOKEN_ASSIGN)
                token_count = token_count + 1
                print "= (ASSIGN)"
                pos = pos + 1
            else
                if is_plus == 0 then
                    token_types.add(TOKEN_PLUS)
                    token_count = token_count + 1
                    print "+ (PLUS)"
                    pos = pos + 1
                else
                    if is_semi == 0 then
                        token_types.add(TOKEN_SEMICOLON)
                        token_count = token_count + 1
                        print "; (SEMICOLON)"
                        pos = pos + 1
                    else
                        if is_1 == 0 then
                            token_types.add(TOKEN_SAYI)
                            token_count = token_count + 1
                            print "10 (NUMBER)"
                            pos = pos + 1
                            -- Skip '0'
                            if pos < src_len then
                                string next = string_substring(source, pos, 1);
                                int is_zero = string_karsilastir(next, "0");
                                if is_zero == 0 then
                                    pos = pos + 1
                                end
                            end
                        else
                            if is_5 == 0 then
                                token_types.add(TOKEN_SAYI)
                                token_count = token_count + 1
                                print "5 (NUMBER)"
                                pos = pos + 1
                            else
                                if is_i == 0 then
                                    -- Check "int"
                                    if pos + 2 < src_len then
                                        string c2 = string_substring(source, pos + 1, 1);
                                        string c3 = string_substring(source, pos + 2, 1);
                                        int is_n = string_karsilastir(c2, "n");
                                        int is_t = string_karsilastir(c3, "t");
                                        if is_n == 0 then
                                            if is_t == 0 then
                                                token_types.add(TOKEN_INT)
                                                token_count = token_count + 1
                                                print "int (INT)"
                                                pos = pos + 3
                                            else
                                                pos = pos + 1
                                            end
                                        else
                                            pos = pos + 1
                                        end
                                    else
                                        pos = pos + 1
                                    end
                                else
                                    if is_p == 0 then
                                        token_types.add(TOKEN_PRINT)
                                        token_count = token_count + 1
                                        print "print (PRINT)"
                                        pos = pos + 5
                                    else
                                        if is_x == 0 then
                                            token_types.add(TOKEN_IDENTIFIER)
                                            token_count = token_count + 1
                                            print "x (IDENTIFIER)"
                                            pos = pos + 1
                                        else
                                            pos = pos + 1
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

token_types.add(TOKEN_EOF)
token_count = token_count + 1

print "---"
print "Toplam token:"
print token_count

print "Token tipleri:"
int idx = 0;
while idx < token_count do
    print token_types.get(idx)
    idx = idx + 1
end

print "Lexer OK!"
