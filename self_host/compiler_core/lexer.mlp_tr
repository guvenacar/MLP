-- lang: en-US
-- syntax: mlp

-- -----------------------------------------------------------------------------
-- Lexer Module - Tam Entegre
-- -----------------------------------------------------------------------------
-- C bootstrap derleyicisindeki lexer mantığını MLP'ye taşır.
-- UTF-8, metin interpolation, multi-line strings, line continuation desteği.
-- -----------------------------------------------------------------------------

import "compiler_core/token_types.mlp"

-- -----------------------------------------------------------------------------
-- Lexer durumu
-- -----------------------------------------------------------------------------

yapı LexerState ise
    metin source_code
    sayısal position
    sayısal length
    sayısal line
    sayısal column
    sayısal eof_reached
son_yapı

fonksiyon lexer_state_create(source_code)
    LexerState state
    state.source_code = source_code
    state.position = 0
    state.length = string_length(source_code)
    state.line = 1
    state.column = 1
    state.eof_reached = 0
    döndür state
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Karakter yardımcıları
-- -----------------------------------------------------------------------------

fonksiyon char_at(state, offset)
    sayısal pos = state.position + offset
    eğer pos >= state.length ise
        döndür ""
    son_eğer
    döndür string_substring(state.source_code, pos, 1)
son_fonksiyon

fonksiyon current_char(state)
    döndür char_at(state, 0)
son_fonksiyon

fonksiyon peek_char(state, offset)
    döndür char_at(state, offset)
son_fonksiyon

fonksiyon is_eof(state)
    eğer state.position >= state.length ise
        döndür 1
    son_eğer
    döndür 0
son_fonksiyon

fonksiyon advance(state)
    eğer is_eof(state) == 1 ise
        döndür state
    son_eğer

    metin ch = ""
    ch = current_char(state)
    
    eğer ch == "\n" ise
        state.line = state.line + 1
        state.column = 1
    değilse
        state.column = state.column + 1
    son_eğer
    
    state.position = state.position + 1
    döndür state
son_fonksiyon

fonksiyon is_digit(ch)
    eğer ch >= "0" ise
        eğer ch <= "9" ise
            döndür 1
        son_eğer
    son_eğer
    döndür 0
son_fonksiyon

fonksiyon is_alpha(ch)
    eğer ch >= "a" ise
        eğer ch <= "z" ise
            döndür 1
        son_eğer
    son_eğer
    eğer ch >= "A" ise
        eğer ch <= "Z" ise
            döndür 1
        son_eğer
    son_eğer
    eğer ch == "_" ise
        döndür 1
    son_eğer
    döndür 0
son_fonksiyon

fonksiyon is_alnum(ch)
    eğer is_alpha(ch) == 1 ise
        döndür 1
    son_eğer
    eğer is_digit(ch) == 1 ise
        döndür 1
    son_eğer
    döndür 0
son_fonksiyon

fonksiyon is_whitespace(ch)
    eğer ch == " " ise döndür 1 son_eğer
    eğer ch == "\t" ise döndür 1 son_eğer
    eğer ch == "\n" ise döndür 1 son_eğer
    eğer ch == "\r" ise döndür 1 son_eğer
    döndür 0
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Boşluk ve yorum atlama
-- -----------------------------------------------------------------------------

fonksiyon skip_whitespace(state)
    döngü is_eof(state) == 0
        metin ch = ""
        ch = current_char(state)
        eğer is_whitespace(ch) == 0 ise
            break
        son_eğer
        state = advance(state)
    son
    döndür state
son_fonksiyon

fonksiyon skip_line_comment(state)
    döngü is_eof(state) == 0
        metin ch = ""
        ch = current_char(state)
        eğer ch == "\n" ise
            break
        son_eğer
        state = advance(state)
    son
    döndür state
son_fonksiyon

fonksiyon skip_block_comment(state)
    state = advance(state)
    state = advance(state)
    
    döngü is_eof(state) == 0
        metin ch = ""
        ch = current_char(state)
        metin next = ""
        next = peek_char(state, 1)
        
        eğer ch == "-" ise
            eğer next == "}" ise
                state = advance(state)
                state = advance(state)
                break
            son_eğer
        son_eğer
        
        state = advance(state)
    son
    
    döndür state
son_fonksiyon

fonksiyon skip_whitespace_and_comments(state)
    döngü is_eof(state) == 0
        state = skip_whitespace(state)
        
        eğer is_eof(state) == 1 ise
            break
        son_eğer
        
        metin ch = ""
        ch = current_char(state)
        metin next = ""
        next = peek_char(state, 1)
        
        eğer ch == "-" ise
            eğer next == "-" ise
                state = skip_line_comment(state)
            değilse
                break
            son_eğer
        değilse
            eğer ch == "{" ise
                eğer next == "-" ise
                    state = skip_block_comment(state)
                değilse
                    break
                son_eğer
            değilse
                break
            son_eğer
        son_eğer
    son
    
    döndür state
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Sayı okuma
-- -----------------------------------------------------------------------------

fonksiyon read_number(state)
    sayısal start = state.position
    
    döngü is_eof(state) == 0
        metin ch = ""
        ch = current_char(state)
        eğer is_digit(ch) == 0 ise
            break
        son_eğer
        state = advance(state)
    son
    
    sayısal len = state.position - start
    metin value = ""
    value = string_substring(state.source_code, start, len)
    
    Token token
    token = make_token(TOKEN_NUMBER, value, state.line, state.column)
    döndür token
son_fonksiyon

-- -----------------------------------------------------------------------------
-- String okuma (UTF-8, interpolation, triple-quote desteği)
-- -----------------------------------------------------------------------------

fonksiyon read_metin(state, delimiter)
    state = advance(state)
    sayısal start = state.position
    liste parts = liste()
    metin current_part = ""
    
    döngü is_eof(state) == 0
        metin ch = ""
        ch = current_char(state)
        
        eğer ch == delimiter ise
            eğer string_length(current_part) > 0 ise
                mlp_list_add(parts, current_part)
            son_eğer
            state = advance(state)
            break
        son_eğer
        
        eğer ch == "{" ise
            eğer string_length(current_part) > 0 ise
                mlp_list_add(parts, current_part)
                current_part = ""
            son_eğer
            
            state = advance(state)
            sayısal var_start = state.position
            
            döngü is_eof(state) == 0
                metin vch = ""
                vch = current_char(state)
                eğer vch == "}" ise
                    break
                son_eğer
                state = advance(state)
            son
            
            sayısal var_len = state.position - var_start
            metin var_name = ""
            var_name = string_substring(state.source_code, var_start, var_len)
            mlp_list_add(parts, "{" + var_name + "}")
            
            state = advance(state)
        değilse
            current_part = current_part + ch
            state = advance(state)
        son_eğer
    son
    
    eğer string_length(current_part) > 0 ise
        mlp_list_add(parts, current_part)
    son_eğer
    
    sayısal part_count = 0
    part_count = mlp_list_length(parts)
    eğer part_count > 1 ise
        Token token
        token = make_token(TOKEN_INTERPOLATED_STRING, "", state.line, state.column)
        token.interpolation_parts = parts
        döndür token
    değilse
        metin final_value = ""
        eğer part_count == 1 ise
            final_value = mlp_list_get(parts, 0)
        son_eğer
        Token token
        token = make_token(TOKEN_STRING, final_value, state.line, state.column)
        döndür token
    son_eğer
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Identifier ve keyword okuma
-- -----------------------------------------------------------------------------

fonksiyon read_identifier(state)
    sayısal start = state.position
    
    döngü is_eof(state) == 0
        metin ch = ""
        ch = current_char(state)
        eğer is_alnum(ch) == 0 ise
            break
        son_eğer
        state = advance(state)
    son
    
    sayısal len = state.position - start
    metin value = ""
    value = string_substring(state.source_code, start, len)
    
    TokenType token_type
    token_type = check_keyword(value)
    
    Token token
    token = make_token(token_type, value, state.line, state.column)
    döndür token
son_fonksiyon

fonksiyon check_keyword(word)
    eğer word == "sayısal" ise döndür TOKEN_TYPE_NUMERIC son_eğer
    eğer word == "metin" ise döndür TOKEN_TYPE_STRING son_eğer
    eğer word == "boolean" ise döndür TOKEN_TYPE_BOOLEAN son_eğer
    eğer word == "const" ise döndür TOKEN_CONST son_eğer
    eğer word == "typeof" ise döndür TOKEN_TYPEOF son_eğer
    eğer word == "import" ise döndür TOKEN_IMPORT son_eğer
    eğer word == "lambda" ise döndür TOKEN_LAMBDA son_eğer
    eğer word == "in" ise döndür TOKEN_IN son_eğer
    eğer word == "range" ise döndür TOKEN_RANGE son_eğer
    eğer word == "yaz" ise döndür TOKEN_PRINT son_eğer
    eğer word == "eğer" ise döndür TOKEN_IF son_eğer
    eğer word == "ise" ise döndür TOKEN_THEN son_eğer
    eğer word == "değilse" ise döndür TOKEN_ELSE son_eğer
    eğer word == "fonksiyon" ise döndür TOKEN_FUNCTION son_eğer
    eğer word == "döndür" ise döndür TOKEN_RETURN son_eğer
    eğer word == "döngü" ise döndür TOKEN_WHILE son_eğer
    eğer word == "do" ise döndür TOKEN_YAPI_DO son_eğer
    eğer word == "için" ise döndür TOKEN_FOR son_eğer
    eğer word == "için" ise döndür TOKEN_TO son_eğer
    eğer word == "adım" ise döndür TOKEN_STEP son_eğer
    eğer word == "break" ise döndür TOKEN_BREAK son_eğer
    eğer word == "continue" ise döndür TOKEN_CONTINUE son_eğer
    eğer word == "son" ise döndür TOKEN_END son_eğer
    eğer word == "true" ise döndür TOKEN_TRUE son_eğer
    eğer word == "false" ise döndür TOKEN_FALSE son_eğer
    eğer word == "null" ise döndür TOKEN_NULL son_eğer
    eğer word == "and" ise döndür TOKEN_AND son_eğer
    eğer word == "or" ise döndür TOKEN_OR son_eğer
    eğer word == "not" ise döndür TOKEN_NOT son_eğer
    eğer word == "yapı" ise döndür TOKEN_YAPI_STRUCT son_eğer
    eğer word == "liste" ise döndür TOKEN_LIST son_eğer
    eğer word == "optional" ise döndür TOKEN_OPTIONAL son_eğer
    eğer word == "map" ise döndür TOKEN_MAP son_eğer
    eğer word == "sıralı" ise döndür TOKEN_YAPI_ENUM son_eğer
    eğer word == "switch" ise döndür TOKEN_YAPI_SWITCH son_eğer
    eğer word == "case" ise döndür TOKEN_YAPI_CASE son_eğer
    eğer word == "default" ise döndür TOKEN_YAPI_DEFAULT son_eğer
    eğer word == "async" ise döndür TOKEN_ASYNC son_eğer
    eğer word == "await" ise döndür TOKEN_AWAIT son_eğer
    eğer word == "stop" ise döndür TOKEN_STOP son_eğer
    eğer word == "goto" ise döndür TOKEN_GOTO son_eğer
    
    döndür TOKEN_IDENTIFIER
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Operatör okuma
-- -----------------------------------------------------------------------------

fonksiyon read_operator(state)
    metin ch = ""
    ch = current_char(state)
    metin next = ""
    next = peek_char(state, 1)
    
    eğer ch == "=" ise
        eğer next == "=" ise
            state = advance(state)
            state = advance(state)
            döndür make_token(TOKEN_EQUAL_EQUAL, "==", state.line, state.column)
        değilse
            state = advance(state)
            döndür make_token(TOKEN_ASSIGN, "=", state.line, state.column)
        son_eğer
    son_eğer
    
    eğer ch == "!" ise
        eğer next == "=" ise
            state = advance(state)
            state = advance(state)
            döndür make_token(TOKEN_NOT_EQUAL, "!=", state.line, state.column)
        son_eğer
    son_eğer
    
    eğer ch == ">" ise
        eğer next == "=" ise
            state = advance(state)
            state = advance(state)
            döndür make_token(TOKEN_GTE, ">=", state.line, state.column)
        değilse
            eğer next == ">" ise
                state = advance(state)
                state = advance(state)
                döndür make_token(TOKEN_RSHIFT, ">>", state.line, state.column)
            değilse
                state = advance(state)
                döndür make_token(TOKEN_GT, ">", state.line, state.column)
            son_eğer
        son_eğer
    son_eğer
    
    eğer ch == "<" ise
        eğer next == "=" ise
            state = advance(state)
            state = advance(state)
            döndür make_token(TOKEN_LTE, "<=", state.line, state.column)
        değilse
            eğer next == "<" ise
                state = advance(state)
                state = advance(state)
                döndür make_token(TOKEN_LSHIFT, "<<", state.line, state.column)
            değilse
                state = advance(state)
                döndür make_token(TOKEN_LT, "<", state.line, state.column)
            son_eğer
        son_eğer
    son_eğer
    
    eğer ch == "+" ise
        eğer next == "=" ise
            state = advance(state)
            state = advance(state)
            döndür make_token(TOKEN_PLUS_ASSIGN, "+=", state.line, state.column)
        değilse
            eğer next == "+" ise
                state = advance(state)
                state = advance(state)
                döndür make_token(TOKEN_INCREMENT, "++", state.line, state.column)
            değilse
                state = advance(state)
                döndür make_token(TOKEN_PLUS, "+", state.line, state.column)
            son_eğer
        son_eğer
    son_eğer
    
    eğer ch == "-" ise
        eğer next == "=" ise
            state = advance(state)
            state = advance(state)
            döndür make_token(TOKEN_MINUS_ASSIGN, "-=", state.line, state.column)
        değilse
            eğer next == "-" ise
                state = advance(state)
                state = advance(state)
                döndür make_token(TOKEN_DECREMENT, "--", state.line, state.column)
            değilse
                state = advance(state)
                döndür make_token(TOKEN_MINUS, "-", state.line, state.column)
            son_eğer
        son_eğer
    son_eğer
    
    eğer ch == "*" ise
        eğer next == "=" ise
            state = advance(state)
            state = advance(state)
            döndür make_token(TOKEN_MUL_ASSIGN, "*=", state.line, state.column)
        değilse
            state = advance(state)
            döndür make_token(TOKEN_MUL, "*", state.line, state.column)
        son_eğer
    son_eğer
    
    eğer ch == "/" ise
        eğer next == "=" ise
            state = advance(state)
            state = advance(state)
            döndür make_token(TOKEN_DIV_ASSIGN, "/=", state.line, state.column)
        değilse
            state = advance(state)
            döndür make_token(TOKEN_DIV, "/", state.line, state.column)
        son_eğer
    son_eğer
    
    eğer ch == "%" ise
        state = advance(state)
        döndür make_token(TOKEN_MOD, "%", state.line, state.column)
    son_eğer
    
    eğer ch == "&" ise
        state = advance(state)
        döndür make_token(TOKEN_BITWISE_AND, "&", state.line, state.column)
    son_eğer
    
    eğer ch == "|" ise
        state = advance(state)
        döndür make_token(TOKEN_BITWISE_OR, "|", state.line, state.column)
    son_eğer
    
    eğer ch == "^" ise
        state = advance(state)
        döndür make_token(TOKEN_BITWISE_XOR, "^", state.line, state.column)
    son_eğer
    
    eğer ch == "~" ise
        state = advance(state)
        döndür make_token(TOKEN_BITWISE_NOT, "~", state.line, state.column)
    son_eğer
    
    eğer ch == "(" ise
        state = advance(state)
        döndür make_token(TOKEN_LEFT_PAREN, "(", state.line, state.column)
    son_eğer
    
    eğer ch == ")" ise
        state = advance(state)
        döndür make_token(TOKEN_RIGHT_PAREN, ")", state.line, state.column)
    son_eğer
    
    eğer ch == "[" ise
        state = advance(state)
        döndür make_token(TOKEN_LEFT_BRACKET, "[", state.line, state.column)
    son_eğer
    
    eğer ch == "]" ise
        state = advance(state)
        döndür make_token(TOKEN_RIGHT_BRACKET, "]", state.line, state.column)
    son_eğer
    
    eğer ch == "," ise
        state = advance(state)
        döndür make_token(TOKEN_COMMA, ",", state.line, state.column)
    son_eğer
    
    eğer ch == ";" ise
        state = advance(state)
        döndür make_token(TOKEN_SEMICOLON, ";", state.line, state.column)
    son_eğer
    
    eğer ch == "." ise
        state = advance(state)
        döndür make_token(TOKEN_DOT, ".", state.line, state.column)
    son_eğer
    
    eğer ch == ":" ise
        state = advance(state)
        döndür make_token(TOKEN_COLON, ":", state.line, state.column)
    son_eğer
    
    eğer ch == "?" ise
        state = advance(state)
        döndür make_token(TOKEN_TERNARY_QUESTION, "?", state.line, state.column)
    son_eğer
    
    state = advance(state)
    döndür make_token(TOKEN_EOF, "", state.line, state.column)
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Ana tokenizer
-- -----------------------------------------------------------------------------

fonksiyon get_next_token(state)
    eğer state.eof_reached == 1 ise
        döndür make_token(TOKEN_EOF, "", state.line, state.column)
    son_eğer
    
    state = skip_whitespace_and_comments(state)
    
    eğer is_eof(state) == 1 ise
        state.eof_reached = 1
        döndür make_token(TOKEN_EOF, "", state.line, state.column)
    son_eğer
    
    metin ch = ""
    ch = current_char(state)
    
    eğer is_digit(ch) == 1 ise
        döndür read_number(state)
    son_eğer
    
    eğer ch == "\"" ise
        döndür read_metin(state, "\"")
    son_eğer
    
    eğer ch == "'" ise
        döndür read_metin(state, "'")
    son_eğer
    
    eğer is_alpha(ch) == 1 ise
        döndür read_identifier(state)
    son_eğer
    
    döndür read_operator(state)
son_fonksiyon

fonksiyon tokenize(source_code)
    LexerState state
    state = lexer_state_create(source_code)
    TokenStream stream
    stream = token_stream_create(liste())
    
    döngü state.eof_reached == 0
        Token token
        token = get_next_token(state)
        mlp_list_add(stream.tokens, token)
        
        eğer token.type == TOKEN_EOF ise
            break
        son_eğer
    son
    
    döndür stream
son_fonksiyon
