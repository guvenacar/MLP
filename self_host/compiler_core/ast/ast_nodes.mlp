end struct

struct ASTVariableDeclarationData then
    numeric node_id
    string type_name
    string identifier
    numeric value_id
    numeric is_const
end struct

struct ASTAssignmentData then
    numeric node_id
    string identifier
    numeric value_id
end struct

struct ASTPrintData then
    numeric node_id
    numeric expression_id
end struct

struct ASTReturnData then
    numeric node_id
    numeric expression_id
end struct

struct ASTIfData then
    numeric node_id
    numeric condition_id
    numeric then_block_id
    numeric else_block_id
end struct

struct ASTWhileData then
    numeric node_id
    numeric condition_id
    numeric body_block_id
end struct

struct ASTForData then
    numeric node_id
    string iterator_name
    numeric start_expr_id
    numeric end_expr_id
    numeric step_expr_id
    numeric body_block_id
end struct

struct ASTForInRangeData then
    numeric node_id
    string iterator_name
    numeric start_expr_id
    numeric end_expr_id
    numeric step_expr_id
    numeric body_block_id
end struct

struct ASTForEachData then
    numeric node_id
    string iterator_name
    numeric iterable_expr_id
    numeric body_block_id
end struct

struct ASTLoopControlData then
    numeric node_id
    string label_name
end struct

struct ASTFunctionParameter then
    string name
    numeric is_array
