end_struct

struct ASTFunctionParameter then
    metin name
    Numeric is_array
    Numeric default_value_id
end_struct

struct ASTFunctionData then
    Numeric node_id
    metin name
    list parameters
    Numeric body_block_id
    metin return_type
    Numeric is_async
    Numeric is_generator
end_struct

struct ASTLambdaData then
    Numeric node_id
