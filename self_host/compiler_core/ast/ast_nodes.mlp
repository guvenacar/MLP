    Numeric size_expr_id
end_struct

struct ASTArrayAccessData then
    Numeric node_id
    metin identifier
    Numeric index_expr_id
end_struct

struct ASTArrayAssignmentData then
    Numeric node_id
    metin identifier
    Numeric index_expr_id
    Numeric value_expr_id
end_struct

struct ASTArrayLiteralData then
    Numeric node_id
    list element_ids
end_struct

struct ASTStructDeclarationData then
    Numeric node_id
