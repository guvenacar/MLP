-- lang: en-US
-- syntax: mlp

-- -----------------------------------------------------------------------------
-- AST Module
-- -----------------------------------------------------------------------------
-- Canonical AST node enumerations plus lightweight record types that will be used
-- by the future lexer/parser/codegen pipeline. Each specialized struct references
-- other nodes through numeric identifiers so parser implementations can store
-- nodes inside arena-style lists without relying on pointers.
-- -----------------------------------------------------------------------------

enum ASTNodeType
    AST_BLOK
    AST_SAYI
    AST_METIN
    AST_INTERPOLATED_STRING
    AST_IMPORT
    AST_DEGISKEN
    AST_IKILI_ISLEM
    AST_VARIABLE_DECLARATION
    AST_ASSIGNMENT_KOMUTU
    AST_PRINT_STATEMENT
    AST_IF_STATEMENT_KOMUTU
    AST_WHILE_LOOP_KOMUTU
    AST_FOR_KOMUTU
    AST_FOR_IN_RANGE
    AST_FOR_EACH
    AST_WHILE_LOOP_BITIR_KOMUTU
    AST_WHILE_LOOP_DEVAM_KOMUTU
    AST_FUNCTION_DECLARATION
    AST_RETURN_STATEMENT_KOMUTU
    AST_ISLEC_CAGIRMA
    AST_TYPEOF_EXPR
    AST_ARRAY_TANIMLAMA
    AST_ARRAY_ERISIM
    AST_ARRAY_ATAMA
    AST_ARRAY_LITERAL
    AST_STRUCT_DECLARATION
    AST_STRUCT_FIELD_ACCESS
    AST_STRUCT_FIELD_ATAMA
    AST_STRUCT_VARIABLE
    AST_LIST_TANIMLAMA
    AST_LIST_LITERAL
    AST_LIST_ADD
    AST_LIST_GET
    AST_LIST_SET
    AST_LIST_REMOVE
    AST_LIST_INSERT
    AST_LIST_SIZE
    AST_LIST_CLEAR
    AST_OPTIONAL_TANIMLAMA
    AST_OPTIONAL_SOME
    AST_OPTIONAL_HAS_VALUE
    AST_OPTIONAL_VALUE
    AST_OPTIONAL_VALUE_OR
    AST_BUILTIN_CALL
    AST_MAP_TANIMLAMA
    AST_MAP_SET
    AST_MAP_GET
    AST_MAP_HAS
    AST_MAP_REMOVE
    AST_MAP_SIZE
    AST_MAP_CLEAR
    AST_ENUM_DECLARATION
    AST_ENUM_VALUE
    AST_SWITCH_KOMUTU
    AST_CASE_KOMUTU
    AST_BUILTIN_ARGC
    AST_ARGV_GET
    AST_TERNARY
    AST_BREAK
    AST_CONTINUE
    AST_STOP
    AST_GOTO
    AST_LABEL
    AST_LAMBDA
    AST_ASYNC_FUNCTION
    AST_AWAIT_EXPR
end enum

enum ASTLiteralKind
    AST_LITERAL_NUMBER
    AST_LITERAL_STRING
    AST_LITERAL_BOOLEAN
    AST_LITERAL_NULL
    AST_LITERAL_INTERPOLATED
end enum

enum ASTListOperation
    AST_LIST_OP_ADD
    AST_LIST_OP_GET
    AST_LIST_OP_SET
    AST_LIST_OP_REMOVE
    AST_LIST_OP_INSERT
    AST_LIST_OP_SIZE
    AST_LIST_OP_CLEAR
end enum

enum ASTOptionalOperation
    AST_OPTIONAL_OP_SOME
    AST_OPTIONAL_OP_HAS_VALUE
    AST_OPTIONAL_OP_VALUE
    AST_OPTIONAL_OP_VALUE_OR
end enum

enum ASTMapOperation
    AST_MAP_OP_SET
    AST_MAP_OP_GET
    AST_MAP_OP_HAS
    AST_MAP_OP_REMOVE
    AST_MAP_OP_SIZE
    AST_MAP_OP_CLEAR
end enum

struct ASTLocation then
    string file_path
    numeric line
    numeric column
end struct

struct ASTNode then
    numeric id
    ASTNodeType type
    ASTLocation location
    string debug_label
end struct

struct ASTArena then
    list[ASTNode] nodes
    numeric next_id
end struct

struct ASTArenaInsertResult then
    ASTArena arena
    numeric node_id
end struct

function ast_location(file_path, line, column)
    ASTLocation location
    location.file_path = file_path
    location.line = line
    location.column = column
    return location
end function

function ast_location_unknown()
    return ast_location("<unknown>", 0, 0)
end function

function ast_node_create(node_type, location, debug_label)
    ASTNode node
    node.id = 0
    node.type = node_type
    node.location = location
    node.debug_label = debug_label
    return node
end function

function ast_arena_init()
    ASTArena arena
    arena.nodes = list()
    arena.next_id = 0
    return arena
end function

function ast_arena_insert(arena, node)
    ASTArenaInsertResult result

    ASTNode stored_node
    stored_node = node
    stored_node.id = arena.next_id
    arena.next_id = arena.next_id + 1
    mlp_list_add(arena.nodes, stored_node)

    result.arena = arena
    result.node_id = stored_node.id
    return result
end function

function ast_arena_get(arena, node_id)
    if node_id < 0 then
        panic("ast_arena_get: negative node id")
    end if

    if node_id >= mlp_list_length(arena.nodes) then
        panic("ast_arena_get: node id out of range")
    end if

    return mlp_list_get(arena.nodes, node_id)
end function

-- -----------------------------------------------------------------------------
-- Specialized data carriers
-- -----------------------------------------------------------------------------

struct ASTBlockData then
    numeric node_id
    list[numeric] statement_ids
end struct

struct ASTLiteralData then
    numeric node_id
    ASTLiteralKind kind
    string raw_value
    list[string] interpolation_parts
end struct

struct ASTImportData then
    numeric node_id
    string file_path
end struct

struct ASTIdentifierData then
    numeric node_id
    string name
end struct

struct ASTBinaryData then
    numeric node_id
    numeric left_id
    numeric right_id
