-- lang: en-US
-- syntax: mlp

-- -----------------------------------------------------------------------------
-- AST Module
-- -----------------------------------------------------------------------------
-- Canonical AST node enumerations plus lightweight record types that will be used
-- by the future lexer/parser/codegen pipeline. Each specialized struct references
-- other nodes through numeric identifiers so parser implementations can store
-- nodes inside arena-style lists without relying on pointers.
-- -----------------------------------------------------------------------------

enum ASTNodeType
    AST_BLOK
    AST_SAYI
    AST_METIN
    AST_INTERPOLATED_STRING
    AST_IMPORT
    AST_DEGISKEN
    AST_IKILI_ISLEM
    AST_VARIABLE_DECLARATION
    AST_ASSIGNMENT_KOMUTU
    AST_PRINT_STATEMENT
    AST_IF_STATEMENT_KOMUTU
    AST_WHILE_LOOP_KOMUTU
    AST_FOR_KOMUTU
    AST_FOR_IN_RANGE
    AST_FOR_EACH
    AST_WHILE_LOOP_BITIR_KOMUTU
    AST_WHILE_LOOP_DEVAM_KOMUTU
    AST_FUNCTION_DECLARATION
    AST_RETURN_STATEMENT_KOMUTU
    AST_ISLEC_CAGIRMA
    AST_TYPEOF_EXPR
    AST_ARRAY_TANIMLAMA
    AST_ARRAY_ERISIM
    AST_ARRAY_ATAMA
    AST_ARRAY_LITERAL
    AST_STRUCT_DECLARATION
    AST_STRUCT_FIELD_ACCESS
    AST_STRUCT_FIELD_ATAMA
    AST_STRUCT_VARIABLE
    AST_LIST_TANIMLAMA
    AST_LIST_LITERAL
    AST_LIST_ADD
    AST_LIST_GET
    AST_LIST_SET
    AST_LIST_REMOVE
    AST_LIST_INSERT
    AST_LIST_SIZE
    AST_LIST_CLEAR
    AST_OPTIONAL_TANIMLAMA
    AST_OPTIONAL_SOME
    AST_OPTIONAL_HAS_VALUE
    AST_OPTIONAL_VALUE
    AST_OPTIONAL_VALUE_OR
    AST_BUILTIN_CALL
    AST_MAP_TANIMLAMA
    AST_MAP_SET
    AST_MAP_GET
    AST_MAP_HAS
    AST_MAP_REMOVE
    AST_MAP_SIZE
    AST_MAP_CLEAR
    AST_ENUM_DECLARATION
    AST_ENUM_VALUE
    AST_SWITCH_KOMUTU
    AST_CASE_KOMUTU
    AST_BUILTIN_ARGC
    AST_ARGV_GET
    AST_TERNARY
    AST_BREAK
    AST_CONTINUE
    AST_STOP
    AST_GOTO
    AST_LABEL
    AST_LAMBDA
    AST_ASYNC_FUNCTION
    AST_AWAIT_EXPR
end_enum

enum ASTLiteralKind
    AST_LITERAL_NUMBER
    AST_LITERAL_STRING
    AST_LITERAL_BOOLEAN
    AST_LITERAL_NULL
    AST_LITERAL_INTERPOLATED
end_enum

enum ASTListOperation
    AST_LIST_OP_ADD
    AST_LIST_OP_GET
    AST_LIST_OP_SET
    AST_LIST_OP_REMOVE
    AST_LIST_OP_INSERT
    AST_LIST_OP_SIZE
    AST_LIST_OP_CLEAR
end_enum

enum ASTOptionalOperation
    AST_OPTIONAL_OP_SOME
    AST_OPTIONAL_OP_HAS_VALUE
    AST_OPTIONAL_OP_VALUE
    AST_OPTIONAL_OP_VALUE_OR
end_enum

enum ASTMapOperation
    AST_MAP_OP_SET
    AST_MAP_OP_GET
    AST_MAP_OP_HAS
    AST_MAP_OP_REMOVE
    AST_MAP_OP_SIZE
    AST_MAP_OP_CLEAR
end_enum

struct ASTLocation then
    metin file_path
    Numeric line
    Numeric column
end_struct

struct ASTNode then
    Numeric id
    ASTNodeType type
    ASTLocation location
    metin debug_label
end_struct

struct ASTArena then
    list nodes
    list node_data
    Numeric next_id
end_struct

struct ASTArenaInsertResult then
    ASTArena arena
    Numeric node_id
end_struct

function ast_location(file_path, line, column)
    ASTLocation location
    location.file_path = file_path
    location.line = line
    location.column = column
    return location
end_function

function ast_location_unknown()
    return ast_location("<unknown>", 0, 0)
end_function

function ast_node_create(node_type, location, debug_label)
    ASTNode node
    node.id = 0
    node.type = node_type
    node.location = location
    node.debug_label = debug_label
    return node
end_function

function ast_arena_init()
    ASTArena arena
    arena.nodes = list()
    arena.node_data = list()
    arena.next_id = 0
    return arena
end_function

function ast_arena_insert(arena, node)
    ASTArenaInsertResult result

    ASTNode stored_node
    stored_node = node
    stored_node.id = arena.next_id
    arena.next_id = arena.next_id + 1
    mlp_list_add(arena.nodes, stored_node)
    mlp_list_add(arena.node_data, 0)

    result.arena = arena
    result.node_id = stored_node.id
    return result
end_function

function ast_arena_get(arena, node_id)
    if node_id < 0 then
        panic("ast_arena_get: negative node id")
    end_if

    if node_id >= mlp_list_length(arena.nodes) then
        panic("ast_arena_get: node id out of range")
    end_if

    return mlp_list_get(arena.nodes, node_id)
end_function

function ast_arena_set_data(arena, node_id, data)
    mlp_list_set(arena.node_data, node_id, data)
    return arena
end_function

function ast_arena_get_data(arena, node_id)
    return mlp_list_get(arena.node_data, node_id)
end_function

-- -----------------------------------------------------------------------------
-- Specialized data carriers
-- -----------------------------------------------------------------------------

struct ASTBlockData then
    Numeric node_id
    list statement_ids
end_struct

struct ASTLiteralData then
    Numeric node_id
    ASTLiteralKind kind
    metin raw_value
    list interpolation_parts
end_struct

struct ASTImportData then
    Numeric node_id
    metin file_path
end_struct

struct ASTIdentifierData then
    Numeric node_id
    metin name
end_struct

struct ASTBinaryData then
    Numeric node_id
    Numeric left_id
    Numeric right_id
    TokenType operator_type
end_struct

struct ASTVariableDeclarationData then
    Numeric node_id
    metin type_name
    metin identifier
    Numeric value_id
    Numeric is_const
end_struct

struct ASTAssignmentData then
    Numeric node_id
    metin identifier
    Numeric value_id
end_struct

struct ASTPrintData then
    Numeric node_id
    Numeric expression_id
end_struct

struct ASTReturnData then
    Numeric node_id
    Numeric expression_id
end_struct

struct ASTIfData then
    Numeric node_id
    Numeric condition_id
    Numeric then_block_id
    Numeric else_block_id
end_struct

struct ASTWhileData then
    Numeric node_id
    Numeric condition_id
    Numeric body_block_id
end_struct

struct ASTForData then
    Numeric node_id
    metin iterator_name
    Numeric start_expr_id
    Numeric end_expr_id
    Numeric step_expr_id
    Numeric body_block_id
end_struct

struct ASTForInRangeData then
    Numeric node_id
    metin iterator_name
    Numeric start_expr_id
    Numeric end_expr_id
    Numeric step_expr_id
    Numeric body_block_id
end_struct

struct ASTForEachData then
    Numeric node_id
    metin iterator_name
    Numeric iterable_expr_id
    Numeric body_block_id
end_struct

struct ASTLoopControlData then
    Numeric node_id
