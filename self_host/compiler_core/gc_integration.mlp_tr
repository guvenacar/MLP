-- lang: en-US
-- syntax: mlp

-- gc_integration.mlp - Garbage Collection Integration için MELP Compiler
-- Port of gc.c/gc.h C implementation için MELP
-- Phase 9.1 - Core Infrastructure
-- Date: 24 Kasım 2025

-- Global GC state tracking
let gc_enabled = 1
let gc_collection_count = 0
let gc_malloc_count = 0

-- Object type constants (match GC_TYPE_* from gc.h)
let GC_TYPE_PROMISE = 1
let GC_TYPE_STRING = 2
let GC_TYPE_LIST = 3
let GC_TYPE_HASHMAP = 4
let GC_TYPE_GENERIC = 5
let GC_TYPE_ASYNC_CONTEXT = 6
let GC_TYPE_CLOSURE = 7

-- External C runtime functions (will be linked from gc.c)
external fonksiyon gc_init() son_fonksiyon
external fonksiyon gc_shutdown() son_fonksiyon
external fonksiyon gc_malloc(size: sayısal, type: sayısal) -> sayısal son_fonksiyon
external fonksiyon gc_calloc(count: sayısal, size: sayısal, type: sayısal) -> sayısal son_fonksiyon
external fonksiyon gc_realloc(ptr: sayısal, new_size: sayısal, type: sayısal) -> sayısal son_fonksiyon
external fonksiyon gc_strdup(s: metin) -> sayısal son_fonksiyon
external fonksiyon gc_add_root(ptr_addr: sayısal) son_fonksiyon
external fonksiyon gc_remove_root(ptr_addr: sayısal) son_fonksiyon
external fonksiyon gc_collect() son_fonksiyon
external fonksiyon gc_set_enabled(enabled: sayısal) son_fonksiyon
external fonksiyon gc_is_enabled() -> sayısal son_fonksiyon
external fonksiyon gc_set_threshold(threshold: sayısal) son_fonksiyon
external fonksiyon gc_get_threshold() -> sayısal son_fonksiyon
external fonksiyon gc_get_stats(stats_ptr: sayısal) son_fonksiyon
external fonksiyon gc_print_stats() son_fonksiyon
external fonksiyon gc_is_managed(ptr: sayısal) -> sayısal son_fonksiyon
external fonksiyon gc_get_size(ptr: sayısal) -> sayısal son_fonksiyon
external fonksiyon gc_get_type(ptr: sayısal) -> sayısal son_fonksiyon

-- ============================================================================
-- Code Generation Helpers
-- ============================================================================

-- Generate GC initialization in program entry point
fonksiyon generate_gc_init()
    emit("    ; GC initialization")
    emit("    call gc_init")
    emit("")
son_fonksiyon

-- Generate GC shutdown before program exit
fonksiyon generate_gc_shutdown()
    emit("    ; GC shutdown")
    emit("    call gc_shutdown")
    emit("")
son_fonksiyon

-- Generate GC-managed allocation (replaces malloc)
fonksiyon generate_gc_malloc(size_reg: metin, type_constant: sayısal, result_reg: metin)
    -- size_reg: Register containing size (e.g., "rax")
    -- type_constant: GC_TYPE_* constant
    -- result_reg: Register için store result pointer (e.g., "rax")
    
    emit("    ; GC allocation (type=" + str(type_constant) + ")")
    emit("    mov rdi, " + size_reg + "       ; size")
    emit("    mov rsi, " + str(type_constant) + "       ; type")
    emit("    call gc_malloc")
    
    eğer result_reg != "rax"
        emit("    mov " + result_reg + ", rax   ; store result")
    son_eğer
    emit("")
    
    gc_malloc_count = gc_malloc_count + 1
son_fonksiyon

-- Generate GC root registration için global variable
fonksiyon generate_gc_add_root(var_label: metin)
    emit("    ; Register GC root: " + var_label)
    emit("    lea rdi, [" + var_label + "]    ; address of pointer")
    emit("    call gc_add_root")
    emit("")
son_fonksiyon

-- Generate GC root unregistration
fonksiyon generate_gc_remove_root(var_label: metin)
    emit("    ; Unregister GC root: " + var_label)
    emit("    lea rdi, [" + var_label + "]    ; address of pointer")
    emit("    call gc_remove_root")
    emit("")
son_fonksiyon

-- Generate explicit GC collection call
fonksiyon generate_gc_collect()
    emit("    ; Trigger garbage collection")
    emit("    call gc_collect")
    emit("")
    
    gc_collection_count = gc_collection_count + 1
son_fonksiyon

-- Generate GC-managed metin duplication
fonksiyon generate_gc_strdup(str_reg: metin, result_reg: metin)
    -- str_reg: Register containing source metin pointer
    -- result_reg: Register için store result pointer
    
    emit("    ; GC metin duplication")
    emit("    mov rdi, " + str_reg + "        ; source metin")
    emit("    call gc_strdup")
    
    eğer result_reg != "rax"
        emit("    mov " + result_reg + ", rax   ; store result")
    son_eğer
    emit("")
son_fonksiyon

-- ============================================================================
-- Scope-Based Root Management
-- ============================================================================

-- Track local variables that need GC root registration
let gc_local_roots = []
let gc_root_stack_depth = 0

-- Enter a new scope (fonksiyon or block)
fonksiyon gc_enter_scope()
    gc_root_stack_depth = gc_root_stack_depth + 1
    
    -- Push empty root liste için this scope
    gc_local_roots[gc_root_stack_depth] = []
son_fonksiyon

-- Exit scope and unregister roots
fonksiyon gc_exit_scope()
    eğer gc_root_stack_depth <= 0
        döndür
    son_eğer
    
    -- Get roots için current scope
    let roots = gc_local_roots[gc_root_stack_depth]
    
    -- Generate unregister calls için each root
    için i = 0 için len(roots) - 1
        let root_label = roots[i]
        generate_gc_remove_root(root_label)
    son
    
    -- Pop scope
    gc_local_roots[gc_root_stack_depth] = []
    gc_root_stack_depth = gc_root_stack_depth - 1
son_fonksiyon

-- Register a local variable as GC root in current scope
fonksiyon gc_register_local_root(var_label: metin)
    eğer gc_root_stack_depth <= 0
        -- No active scope - register as global root
        generate_gc_add_root(var_label)
        döndür
    son_eğer
    
    -- Add için current scope's root liste
    let roots = gc_local_roots[gc_root_stack_depth]
    roots[len(roots)] = var_label
    gc_local_roots[gc_root_stack_depth] = roots
    
    -- Generate registration code
    generate_gc_add_root(var_label)
son_fonksiyon

-- ============================================================================
-- Type-Specific Allocation Helpers
-- ============================================================================

-- Allocate GC-managed promise
fonksiyon generate_promise_allocation(result_reg: metin)
    -- Promise size from simple_runtime.c: sizeof(Promise) ~= 64 bytes
    emit("    ; Allocate promise (GC-managed)")
    emit("    mov rdi, 64                     ; sizeof(Promise)")
    emit("    mov rsi, " + str(GC_TYPE_PROMISE) + "                     ; GC_TYPE_PROMISE")
    emit("    call gc_malloc")
    
    eğer result_reg != "rax"
        emit("    mov " + result_reg + ", rax")
    son_eğer
    emit("")
    
    gc_malloc_count = gc_malloc_count + 1
son_fonksiyon

-- Allocate GC-managed metin buffer
fonksiyon generate_string_allocation(size_reg: metin, result_reg: metin)
    generate_gc_malloc(size_reg, GC_TYPE_STRING, result_reg)
son_fonksiyon

-- Allocate GC-managed liste/array
fonksiyon generate_list_allocation(element_count_reg: metin, result_reg: metin)
    -- List structure: items pointer + count + capacity
    -- Size = (count * 8) + 16
    emit("    ; Allocate liste (GC-managed)")
    emit("    mov rax, " + element_count_reg)
    emit("    imul rax, 8                     ; count * sizeof(void*)")
    emit("    add rax, 16                      ; + metadata")
    emit("    mov rdi, rax")
    emit("    mov rsi, " + str(GC_TYPE_LIST) + "                     ; GC_TYPE_LIST")
    emit("    call gc_malloc")
    
    eğer result_reg != "rax"
        emit("    mov " + result_reg + ", rax")
    son_eğer
    emit("")
    
    gc_malloc_count = gc_malloc_count + 1
son_fonksiyon

-- Allocate GC-managed closure context
fonksiyon generate_closure_allocation(capture_count: sayısal, result_reg: metin)
    -- Closure yapı: [0-7] func_ptr, [8+] captured variables
    let closure_size
    closure_size = 8 + (capture_count * 8)
    
    emit("    ; Allocate closure (GC-managed, " + str(capture_count) + " captures)")
    emit("    mov rdi, " + str(closure_size) + "                    ; closure size")
    emit("    mov rsi, " + str(GC_TYPE_CLOSURE) + "                     ; GC_TYPE_CLOSURE")
    emit("    call gc_malloc")
    
    eğer result_reg != "rax"
        emit("    mov " + result_reg + ", rax")
    son_eğer
    emit("")
    
    gc_malloc_count = gc_malloc_count + 1
son_fonksiyon

-- ============================================================================
-- Codegen Integration
-- ============================================================================

-- Replace malloc calls with gc_malloc in existing codegen
fonksiyon replace_malloc_with_gc_malloc(malloc_line: metin, gc_type: sayısal) -> metin
    -- Example input: "    call malloc"
    -- Example output: "    mov rsi, 1; call gc_malloc"
    
    -- Extract size setup (should be in rdi already)
    let gc_line
    gc_line = "    mov rsi, " + str(gc_type) + "    ; GC type\n"
    gc_line = gc_line + "    call gc_malloc"
    
    döndür gc_line
son_fonksiyon

-- Check eğer a variable needs GC root registration
fonksiyon should_register_as_root(var_name: metin, var_type: metin) -> sayısal
    -- Register heap-allocated types as roots
    eğer var_type == "promise" or var_type == "Promise"
        döndür 1
    son_eğer
    
    eğer var_type == "metin" or var_type == "String"
        döndür 1
    son_eğer
    
    eğer var_type == "liste" or var_type == "List" or var_type == "array"
        döndür 1
    son_eğer
    
    eğer var_type == "map" or var_type == "HashMap"
        döndür 1
    son_eğer
    
    eğer var_type == "closure" or var_type == "lambda"
        döndür 1
    son_eğer
    
    döndür 0  -- Primitive types don't need GC tracking
son_fonksiyon

-- ============================================================================
-- Statistics & Debugging
-- ============================================================================

fonksiyon print_gc_stats()
    yaz("=== GC Statistics ===")
    yaz("GC enabled: " + str(gc_enabled))
    yaz("Allocations: " + str(gc_malloc_count))
    yaz("Collections: " + str(gc_collection_count))
    yaz("")
    
    -- Call C runtime için yaz detailed stats
    emit("    call gc_print_stats")
son_fonksiyon

-- ============================================================================
-- Assembly Directives
-- ============================================================================

-- Generate .data section için GC initialization flag
fonksiyon generate_gc_data_section()
    emit("section .data")
    emit("    gc_initialized: dq 0    ; GC init flag")
    emit("")
son_fonksiyon

-- Generate .bss section için GC statistics
fonksiyon generate_gc_bss_section()
    emit("section .bss")
    emit("    gc_stats: resb 64       ; GC statistics buffer")
    emit("")
son_fonksiyon

-- ============================================================================
-- Example Usage in Codegen
-- ============================================================================

-- Example: Generate promise creation with GC
fonksiyon example_promise_create_with_gc()
    emit("    ; Example: Promise creation (GC-managed)")
    generate_promise_allocation("rax")
    emit("    ; rax now contains GC-managed promise pointer")
    emit("")
    
    -- Register as root eğer storing in global
    emit("    mov [global_promise], rax")
    generate_gc_add_root("global_promise")
son_fonksiyon

-- Example: Generate fonksiyon with scope-based GC roots
fonksiyon example_function_with_gc_scope()
    emit("example_function:")
    emit("    push rbp")
    emit("    mov rbp, rsp")
    emit("")
    
    -- Enter GC scope
    gc_enter_scope()
    
    -- Allocate local variable (GC-managed)
    emit("    ; Allocate local promise")
    generate_promise_allocation("rax")
    emit("    mov [rbp-8], rax        ; store local")
    
    -- Register local as root
    gc_register_local_root("rbp-8")
    
    -- ... fonksiyon body ...
    
    -- Exit GC scope (auto-unregisters roots)
    gc_exit_scope()
    
    emit("    mov rsp, rbp")
    emit("    pop rbp")
    emit("    ret")
    emit("")
son_fonksiyon

-- ============================================================================
-- Initialization
-- ============================================================================

yaz("GC Integration Module Loaded")
yaz("GC Types: Promise=" + str(GC_TYPE_PROMISE) + ", String=" + str(GC_TYPE_STRING) + ", List=" + str(GC_TYPE_LIST))
