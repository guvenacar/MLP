-- lang: en-US
-- syntax: mlp

-- -----------------------------------------------------------------------------
-- Parser Module - Tam Entegre (Part 1: Core)
-- -----------------------------------------------------------------------------
-- C bootstrap derleyicisindeki parser mantığını MLP'ye taşır.
-- Pratt parsing, AST oluşturma, scope yönetimi.
-- -----------------------------------------------------------------------------

import "compiler_core/token_types.mlp"
import "compiler_core/ast/ast_nodes.mlp"
import "compiler_core/function_registry.mlp"

-- -----------------------------------------------------------------------------
-- Parser durumu
-- -----------------------------------------------------------------------------

yapı ParserState ise
    TokenStream stream
    sayısal current_index
    Token current_token
    ASTArena arena
    FunctionRegistry registry
    sayısal scope_level
    liste scope_stack_offsets
son_yapı

fonksiyon parser_state_create(stream)
    ParserState state
    state.stream = stream
    state.current_index = 0
    state.current_token = token_stream_peek(stream)
    state.arena = ast_arena_init()
    state.registry = function_registry_create()
    state.scope_level = 0
    state.scope_stack_offsets = liste()
    döndür state
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Token navigation
-- -----------------------------------------------------------------------------

fonksiyon parser_advance(state)
    TokenStreamTakeResult result
    result = token_stream_take(state.stream)
    state.stream = result.stream
    state.current_token = result.token
    state.current_index = state.current_index + 1
    döndür state
son_fonksiyon

fonksiyon parser_peek(state)
    döndür state.current_token
son_fonksiyon

fonksiyon parser_check(state, expected_type)
    Token current_token
    current_token = state.current_token
    eğer current_token.type == expected_type ise
        döndür 1
    son_eğer
    döndür 0
son_fonksiyon

fonksiyon parser_expect(state, expected_type)
    eğer parser_check(state, expected_type) == 0 ise
        Token current_token
        current_token = state.current_token
        yaz "Parser error: Expected token type "
        yaz expected_type
        yaz " but got "
        yaz current_token.type
        yaz " at line "
        yaz current_token.line
        panic("parser_expect: token mismatch")
    son_eğer
    
    state = parser_advance(state)
    döndür state
son_fonksiyon

fonksiyon parser_match(state, token_type)
    eğer parser_check(state, token_type) == 1 ise
        state = parser_advance(state)
        döndür 1
    son_eğer
    döndür 0
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Scope yönetimi
-- -----------------------------------------------------------------------------

fonksiyon parser_enter_scope(state)
    mlp_list_add(state.scope_stack_offsets, 0)
    state.scope_level = state.scope_level + 1
    döndür state
son_fonksiyon

fonksiyon parser_exit_scope(state)
    eğer state.scope_level > 0 ise
        state.scope_level = state.scope_level - 1
        sayısal size = 0
        size = mlp_list_length(state.scope_stack_offsets)
        eğer size > 0 ise
            mlp_list_remove(state.scope_stack_offsets, size - 1)
        son_eğer
    son_eğer
    döndür state
son_fonksiyon

-- -----------------------------------------------------------------------------
-- AST node creation helpers
-- -----------------------------------------------------------------------------

fonksiyon parser_create_node(state, node_type, debug_label)
    Token current_token
    current_token = state.current_token
    ASTLocation location
    location = ast_location(
        "<source>",
        current_token.line,
        current_token.column
    )
    
    ASTNode node
    node = ast_node_create(node_type, location, debug_label)
    ASTArenaInsertResult result
    result = ast_arena_insert(state.arena, node)
    
    state.arena = result.arena
    döndür result.node_id
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Expression parsing (Pratt-style precedence climbing)
-- -----------------------------------------------------------------------------

fonksiyon get_precedence(token_type)
    eğer token_type == TOKEN_OR ise döndür 10 son_eğer
    eğer token_type == TOKEN_AND ise döndür 20 son_eğer
    eğer token_type == TOKEN_BITWISE_OR ise döndür 30 son_eğer
    eğer token_type == TOKEN_BITWISE_XOR ise döndür 40 son_eğer
    eğer token_type == TOKEN_BITWISE_AND ise döndür 50 son_eğer
    eğer token_type == TOKEN_EQUAL_EQUAL ise döndür 60 son_eğer
    eğer token_type == TOKEN_NOT_EQUAL ise döndür 60 son_eğer
    eğer token_type == TOKEN_LT ise döndür 70 son_eğer
    eğer token_type == TOKEN_GT ise döndür 70 son_eğer
    eğer token_type == TOKEN_LTE ise döndür 70 son_eğer
    eğer token_type == TOKEN_GTE ise döndür 70 son_eğer
    eğer token_type == TOKEN_LSHIFT ise döndür 80 son_eğer
    eğer token_type == TOKEN_RSHIFT ise döndür 80 son_eğer
    eğer token_type == TOKEN_PLUS ise döndür 90 son_eğer
    eğer token_type == TOKEN_MINUS ise döndür 90 son_eğer
    eğer token_type == TOKEN_MUL ise döndür 100 son_eğer
    eğer token_type == TOKEN_DIV ise döndür 100 son_eğer
    eğer token_type == TOKEN_MOD ise döndür 100 son_eğer
    döndür 0
son_fonksiyon

fonksiyon is_binary_operator(token_type)
    sayısal prec = 0
    prec = get_precedence(token_type)
    eğer prec > 0 ise
        döndür 1
    son_eğer
    döndür 0
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Forward declarations (diğer modüllerden import edilecek)
-- -----------------------------------------------------------------------------
-- parser_functions.mlp: parse_function_call, parse_postfix_expression, parse_lambda_expression
-- parser_structures.mlp: parse_list_literal, parse_hashmap_literal, parse_for_loop
-- parser_advanced.mlp: parse_import_statement, parse_try_catch, parse_unary_expression

-- -----------------------------------------------------------------------------
-- Primary expressions (literals, identifiers, parenthesized expressions)
-- -----------------------------------------------------------------------------

fonksiyon parse_primary(state)
    Token token
    token = parser_peek(state)
    
    eğer token.type == TOKEN_NUMBER ise
        sayısal node_id = 0
        node_id = parser_create_node(state, AST_SAYI, "number_literal")
        state = parser_advance(state)
        
        ASTLiteralData data
        data.node_id = node_id
        data.kind = AST_LITERAL_NUMBER
        data.raw_value = token.lexeme
        data.interpolation_parts = liste()
        
        state.arena = ast_arena_set_data(state.arena, node_id, data)
        
        döndür node_id
    son_eğer
    
    eğer token.type == TOKEN_STRING ise
        sayısal node_id = 0
        node_id = parser_create_node(state, AST_METIN, "string_literal")
        state = parser_advance(state)
        
        ASTLiteralData data
        data.node_id = node_id
        data.kind = AST_LITERAL_STRING
        data.raw_value = token.lexeme
        data.interpolation_parts = liste()
        
        state.arena = ast_arena_set_data(state.arena, node_id, data)
        
        döndür node_id
    son_eğer
    
    eğer token.type == TOKEN_INTERPOLATED_STRING ise
        sayısal node_id = 0
        node_id = parser_create_node(state, AST_INTERPOLATED_STRING, "interpolated_string")
        state = parser_advance(state)
        
        ASTLiteralData data
        data.node_id = node_id
        data.kind = AST_LITERAL_INTERPOLATED
        data.raw_value = ""
        data.interpolation_parts = token.interpolation_parts
        
        state.arena = ast_arena_set_data(state.arena, node_id, data)
        
        döndür node_id
    son_eğer
    
    eğer token.type == TOKEN_TRUE ise
        sayısal node_id = 0
        node_id = parser_create_node(state, AST_SAYI, "boolean_true")
        state = parser_advance(state)
        döndür node_id
    son_eğer
    
    eğer token.type == TOKEN_FALSE ise
        sayısal node_id = 0
        node_id = parser_create_node(state, AST_SAYI, "boolean_false")
        state = parser_advance(state)
        döndür node_id
    son_eğer
    
    eğer token.type == TOKEN_NULL ise
        sayısal node_id = 0
        node_id = parser_create_node(state, AST_SAYI, "null_literal")
        state = parser_advance(state)
        döndür node_id
    son_eğer
    
    eğer token.type == TOKEN_IDENTIFIER ise
        sayısal node_id = 0
        node_id = parser_create_node(state, AST_DEGISKEN, "identifier")
        state = parser_advance(state)
        
        ASTIdentifierData data
        data.node_id = node_id
        data.name = token.lexeme
        
        state.arena = ast_arena_set_data(state.arena, node_id, data)
        
        döndür node_id
    son_eğer
    
    eğer token.type == TOKEN_LEFT_PAREN ise
        state = parser_advance(state)
        sayısal expr_id = 0
        expr_id = parse_expression(state, 0)
        state = parser_expect(state, TOKEN_RIGHT_PAREN)
        döndür expr_id
    son_eğer
    
    eğer token.type == TOKEN_LEFT_BRACKET ise
        döndür parse_list_literal(state)
    son_eğer
    
    eğer token.type == TOKEN_LEFT_BRACE ise
        döndür parse_hashmap_literal(state)
    son_eğer
    
    eğer token.type == TOKEN_LAMBDA ise
        döndür parse_lambda_expression(state)
    son_eğer
    
    eğer token.type == TOKEN_AWAIT ise
        döndür parse_await_expression(state)
    son_eğer
    
    yaz "Parser error: Unexpected token in primary expression"
    yaz "Token type: "
    yaz token.type
    yaz " at line "
    yaz token.line
    panic("parse_primary: unexpected token")
    
    döndür -1
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Binary expression parsing (precedence climbing)
-- -----------------------------------------------------------------------------

fonksiyon parse_expression(state, min_precedence)
    sayısal left_id = 0
    left_id = parse_primary(state)
    
    döngü 1 == 1
        Token op_token
        op_token = parser_peek(state)
        
        eğer is_binary_operator(op_token.type) == 0 ise
            break
        son_eğer
        
        sayısal op_prec = 0
        op_prec = get_precedence(op_token.type)
        eğer op_prec < min_precedence ise
            break
        son_eğer
        
        TokenType op_type
        op_type = op_token.type
        state = parser_advance(state)
        
        sayısal right_id = 0
        right_id = parse_expression(state, op_prec + 1)
        
        sayısal binary_id = 0
        binary_id = parser_create_node(state, AST_IKILI_ISLEM, "binary_op")
        
        ASTBinaryData data
        data.node_id = binary_id
        data.left_id = left_id
        data.right_id = right_id
        data.operator_type = op_type
        
        state.arena = ast_arena_set_data(state.arena, binary_id, data)
        
        left_id = binary_id
    son
    
    döndür left_id
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Statement parsing
-- -----------------------------------------------------------------------------

fonksiyon parse_print_statement(state)
    state = parser_expect(state, TOKEN_PRINT)
    sayısal expr_id = 0
    expr_id = parse_expression(state, 0)
    
    sayısal print_id = 0
    print_id = parser_create_node(state, AST_PRINT_STATEMENT, "yaz")
    
    ASTPrintData data
    data.node_id = print_id
    data.expression_id = expr_id
    
    state.arena = ast_arena_set_data(state.arena, print_id, data)
    
    döndür print_id
son_fonksiyon

fonksiyon parse_return_statement(state)
    state = parser_expect(state, TOKEN_RETURN)
    sayısal expr_id = 0
    expr_id = parse_expression(state, 0)
    
    sayısal return_id = 0
    return_id = parser_create_node(state, AST_RETURN_STATEMENT_KOMUTU, "döndür")
    
    ASTReturnData data
    data.node_id = return_id
    data.expression_id = expr_id
    
    state.arena = ast_arena_set_data(state.arena, return_id, data)
    
    döndür return_id
son_fonksiyon

fonksiyon parse_variable_declaration(state)
    Token type_token
    type_token = parser_peek(state)
    state = parser_advance(state)
    
    Token name_token
    name_token = parser_peek(state)
    state = parser_expect(state, TOKEN_IDENTIFIER)
    
    sayısal value_id = -1
    eğer parser_match(state, TOKEN_ASSIGN) == 1 ise
        value_id = parse_expression(state, 0)
    son_eğer
    
    sayısal decl_id = 0
    decl_id = parser_create_node(state, AST_VARIABLE_DECLARATION, "var_decl")
    
    ASTVariableDeclarationData data
    data.node_id = decl_id
    data.type_name = type_token.lexeme
    data.identifier = name_token.lexeme
    data.value_id = value_id
    data.is_const = 0
    
    state.arena = ast_arena_set_data(state.arena, decl_id, data)
    
    döndür decl_id
son_fonksiyon

fonksiyon parse_assignment(state)
    Token name_token
    name_token = parser_peek(state)
    state = parser_expect(state, TOKEN_IDENTIFIER)
    state = parser_expect(state, TOKEN_ASSIGN)
    
    sayısal value_id = 0
    value_id = parse_expression(state, 0)
    
    sayısal assign_id = 0
    assign_id = parser_create_node(state, AST_ASSIGNMENT_KOMUTU, "assignment")
    
    ASTAssignmentData data
    data.node_id = assign_id
    data.identifier = name_token.lexeme
    data.value_id = value_id
    
    state.arena = ast_arena_set_data(state.arena, assign_id, data)
    
    döndür assign_id
son_fonksiyon

fonksiyon parse_if_statement(state)
    state = parser_expect(state, TOKEN_IF)
    sayısal condition_id = 0
    condition_id = parse_expression(state, 0)
    state = parser_expect(state, TOKEN_THEN)
    
    state = parser_enter_scope(state)
    sayısal then_block_id = 0
    then_block_id = parse_block(state, TOKEN_END, TOKEN_ELSE)
    state = parser_exit_scope(state)
    
    sayısal else_block_id = -1
    eğer parser_match(state, TOKEN_ELSE) == 1 ise
        state = parser_enter_scope(state)
        else_block_id = parse_block(state, TOKEN_END)
        state = parser_exit_scope(state)
    son_eğer
    
    state = parser_expect(state, TOKEN_END)
    
    sayısal if_id = 0
    if_id = parser_create_node(state, AST_IF_STATEMENT_KOMUTU, "if_stmt")
    
    ASTIfData data
    data.node_id = if_id
    data.condition_id = condition_id
    data.then_block_id = then_block_id
    data.else_block_id = else_block_id
    
    state.arena = ast_arena_set_data(state.arena, if_id, data)
    
    döndür if_id
son_fonksiyon

fonksiyon parse_while_statement(state)
    state = parser_expect(state, TOKEN_WHILE)
    sayısal condition_id = 0
    condition_id = parse_expression(state, 0)
    state = parser_expect(state, TOKEN_DO)
    
    state = parser_enter_scope(state)
    sayısal body_id = 0
    body_id = parse_block(state, TOKEN_END)
    state = parser_exit_scope(state)
    
    state = parser_expect(state, TOKEN_END)
    
    sayısal while_id = 0
    while_id = parser_create_node(state, AST_WHILE_LOOP_KOMUTU, "while_loop")
    
    ASTWhileData data
    data.node_id = while_id
    data.condition_id = condition_id
    data.body_block_id = body_id
    
    state.arena = ast_arena_set_data(state.arena, while_id, data)
    
    döndür while_id
son_fonksiyon

fonksiyon parse_statement(state)
    Token token
    token = parser_peek(state)
    
    eğer token.type == TOKEN_IMPORT ise
        döndür parse_import_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_FUNCTION ise
        döndür parse_function_declaration(state)
    son_eğer
    
    eğer token.type == TOKEN_ASYNC ise
        döndür parse_async_function(state)
    son_eğer
    
    eğer token.type == TOKEN_STRUCT ise
        döndür parse_struct_definition(state)
    son_eğer
    
    eğer token.type == TOKEN_ENUM ise
        döndür parse_enum_definition(state)
    son_eğer
    
    eğer token.type == TOKEN_PRINT ise
        döndür parse_print_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_RETURN ise
        döndür parse_return_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_TYPE_NUMERIC ise
        döndür parse_variable_declaration(state)
    son_eğer
    
    eğer token.type == TOKEN_TYPE_STRING ise
        döndür parse_variable_declaration(state)
    son_eğer
    
    eğer token.type == TOKEN_TYPE_BOOLEAN ise
        döndür parse_variable_declaration(state)
    son_eğer
    
    eğer token.type == TOKEN_IF ise
        döndür parse_if_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_WHILE ise
        döndür parse_while_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_FOR ise
        döndür parse_for_loop(state)
    son_eğer
    
    eğer token.type == TOKEN_TRY ise
        döndür parse_try_catch(state)
    son_eğer
    
    eğer token.type == TOKEN_THROW ise
        döndür parse_throw_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_BREAK ise
        döndür parse_break_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_CONTINUE ise
        döndür parse_continue_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_DEFER ise
        döndür parse_defer_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_WITH ise
        döndür parse_with_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_MATCH ise
        döndür parse_match_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_TYPE ise
        döndür parse_type_alias(state)
    son_eğer
    
    eğer token.type == TOKEN_PANIC ise
        döndür parse_panic_statement(state)
    son_eğer
    
    eğer token.type == TOKEN_IDENTIFIER ise
        döndür parse_assignment(state)
    son_eğer
    
    yaz "Parser error: Unexpected statement token"
    yaz "Token type: "
    yaz token.type
    panic("parse_statement: unexpected token")
    
    döndür -1
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Block parsing (overload için multiple son tokens)
-- -----------------------------------------------------------------------------

fonksiyon parse_block(state, end_token1)
    döndür parse_block_multi(state, end_token1, TOKEN_EOF)
son_fonksiyon

fonksiyon parse_block_multi(state, end_token1, end_token2)
    liste statement_ids = liste()
    
    döngü 1 == 1
        Token token
        token = parser_peek(state)
        
        eğer token.type == TOKEN_EOF ise
            break
        son_eğer
        
        eğer token.type == end_token1 ise
            break
        son_eğer
        
        eğer token.type == end_token2 ise
            break
        son_eğer
        
        sayısal stmt_id = 0
        stmt_id = parse_statement(state)
        mlp_list_add(statement_ids, stmt_id)
    son
    
    sayısal block_id = 0
    block_id = parser_create_node(state, AST_BLOK, "block")
    
    ASTBlockData data
    data.node_id = block_id
    data.statement_ids = statement_ids
    
    state.arena = ast_arena_set_data(state.arena, block_id, data)
    
    döndür block_id
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Top-level parsing
-- -----------------------------------------------------------------------------

fonksiyon parse(source_code)
    TokenStream stream
    stream = tokenize(source_code)
    ParserState state
    state = parser_state_create(stream)
    
    sayısal root_id = 0
    root_id = parse_block(state, TOKEN_EOF)
    
    döndür state.arena
son_fonksiyon
