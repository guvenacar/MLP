-- Comprehensive struct test: multiple structs, nested fields

struct Point then
    int x;
    int y;
end

struct Rectangle then
    int width;
    int height;
end

Point p1;
Point p2;
Rectangle r;

p1.x = 10
p1.y = 20

p2.x = 30
p2.y = 40

r.width = 100
r.height = 50

print "Point 1:"
print p1.x
print p1.y

print "Point 2:"
print p2.x
print p2.y

print "Rectangle:"
print r.width
print r.height
