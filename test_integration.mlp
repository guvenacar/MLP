// ============================================================================
// MLP Phase 8 - Integration Test Suite
// Comprehensive test combining: promise_all, race, timeout, async I/O, errors
// ============================================================================

function test_parallel_race_combo()
    print "=== Test 1: Parallel + Race Combination ==="
    
    // Three tasks with different speeds
    numeric task1 = async_sleep(50)
    numeric task2 = async_sleep(100)
    numeric task3 = async_sleep(150)
    
    // Race to find fastest
    numeric winner = promise_race_simple(task1, task2, task3)
    numeric status = promise_await_safe(winner)
    
    print "Race winner status (expect 0):"
    print status
    print ""
end

function test_timeout_with_race()
    print "=== Test 2: Timeout + Race ==="
    
    // Fast task vs slow task with timeout
    numeric fast = async_sleep(50)
    numeric slow = async_sleep(300)
    numeric timed = async_timeout(slow, 100)
    
    numeric winner = promise_race_simple(fast, timed, fast)
    numeric status = promise_await_safe(winner)
    
    print "Timeout race status (expect 0):"
    print status
    print ""
end

function test_allsettled_with_rejection()
    print "=== Test 3: AllSettled with Mixed Results ==="
    
    // One success, one failure, one success
    numeric p1 = async_sleep(30)
    numeric p2 = promise_new()
    promise_reject_with_error(p2, "Intentional failure")
    numeric p3 = async_sleep(40)
    
    numeric result = promise_allSettled_simple(p1, p2, p3)
    numeric status = promise_await_safe(result)
    
    print "AllSettled status (expect 0):"
    print status
    print ""
end

function test_any_with_failures()
    print "=== Test 4: Any with Some Failures ==="
    
    // Two failures, one success
    numeric p1 = promise_new()
    promise_reject_with_error(p1, "Error 1")
    
    numeric p2 = async_sleep(50)
    
    numeric p3 = promise_new()
    promise_reject_with_error(p3, "Error 2")
    
    numeric result = promise_any_simple(p1, p2, p3)
    numeric status = promise_await_safe(result)
    
    print "Any with failures status (expect 0):"
    print status
    print ""
end

function test_nested_timeout()
    print "=== Test 5: Nested Timeouts ==="
    
    // Task with timeout, wrapped in another timeout
    numeric task = async_sleep(200)
    numeric inner = async_timeout(task, 150)
    numeric outer = async_timeout(inner, 100)
    
    numeric status = promise_await_safe(outer)
    
    print "Nested timeout status (expect -1 = 4294967295):"
    print status
    print ""
end

function test_immediate_operations()
    print "=== Test 6: Immediate Promise Operations ==="
    
    // Pre-resolved promise in race
    numeric immediate = promise_new()
    promise_resolve_numeric(immediate, 999)
    
    numeric slow1 = async_sleep(100)
    numeric slow2 = async_sleep(200)
    
    numeric winner = promise_race_simple(immediate, slow1, slow2)
    numeric status = promise_await_safe(winner)
    numeric value = promise_get_numeric_value(winner)
    
    print "Immediate race status (expect 0):"
    print status
    print "Immediate race value (expect 999):"
    print value
    print ""
end

function test_large_parallel_set()
    print "=== Test 7: Large Parallel Execution (5 tasks) ==="
    
    numeric t1 = async_sleep(20)
    numeric t2 = async_sleep(30)
    numeric t3 = async_sleep(40)
    numeric t4 = async_sleep(50)
    numeric t5 = async_sleep(60)
    
    // Wait for all
    numeric s1 = promise_await_safe(t1)
    numeric s2 = promise_await_safe(t2)
    numeric s3 = promise_await_safe(t3)
    numeric s4 = promise_await_safe(t4)
    numeric s5 = promise_await_safe(t5)
    
    numeric total = s1 + s2 + s3 + s4 + s5
    
    print "All 5 tasks status sum (expect 0):"
    print total
    print ""
end

function test_error_chain()
    print "=== Test 8: Error Propagation Chain ==="
    
    // Reject a promise and check error
    numeric p = promise_new()
    promise_reject_with_error(p, "Test error message")
    
    numeric status = promise_await_safe(p)
    numeric has_err = promise_has_error(p)
    numeric is_rej = promise_is_rejected(p)
    
    print "Rejected status (expect -1 = 4294967295):"
    print status
    print "Has error (expect 1):"
    print has_err
    print "Is rejected (expect 1):"
    print is_rej
    print ""
end

function test_state_transitions()
    print "=== Test 9: State Transition Tracking ==="
    
    // Track state from pending to resolved
    numeric p = async_sleep(50)
    
    numeric pend_before = promise_is_pending(p)
    numeric comp_before = promise_is_completed(p)
    
    print "Before await - pending (expect 1):"
    print pend_before
    print "Before await - completed (expect 0):"
    print comp_before
    
    numeric status = promise_await_safe(p)
    
    numeric pend_after = promise_is_pending(p)
    numeric comp_after = promise_is_completed(p)
    numeric resolved = promise_is_resolved(p)
    
    print "After await - pending (expect 0):"
    print pend_after
    print "After await - completed (expect 1):"
    print comp_after
    print "After await - resolved (expect 1):"
    print resolved
    print ""
end

function test_complex_scenario()
    print "=== Test 10: Complex Real-World Scenario ==="
    
    // Simulate: Try 3 servers, use fastest, with 500ms timeout
    numeric server1 = async_sleep(80)
    numeric server2 = async_sleep(120)
    numeric server3 = async_sleep(300)
    
    // Race for fastest response
    numeric fastest = promise_race_simple(server1, server2, server3)
    
    // Apply timeout
    numeric with_timeout = async_timeout(fastest, 500)
    
    numeric status = promise_await_safe(with_timeout)
    
    print "Complex scenario status (expect 0):"
    print status
    print ""
end

function main()
    print "================================================"
    print "MLP Phase 8 - Integration Test Suite"
    print "Testing: All async features working together"
    print "================================================"
    print ""
    
    test_parallel_race_combo()
    test_timeout_with_race()
    test_allsettled_with_rejection()
    test_any_with_failures()
    test_nested_timeout()
    test_immediate_operations()
    test_large_parallel_set()
    test_error_chain()
    test_state_transitions()
    test_complex_scenario()
    
    print "================================================"
    print "Integration Tests Complete!"
    print "All async utilities work together correctly"
    print "================================================"
    
    return 0
end
