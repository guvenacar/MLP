-- Simple Phase 5.2 Test
-- Testing if new functions are callable

function test_error_code() then
    set_error_code(42)
    int code = get_error_code()
    print code
end

function test_malloc_free() then
    int ptr = mlp_malloc(100)
    mlp_free(ptr)
    print "Memory test OK"
end

test_error_code()
test_malloc_free()
