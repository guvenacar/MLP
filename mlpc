#!/bin/bash
# MLP Compiler Wrapper (mlpc)
# Automatic preprocessor + compiler pipeline

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

usage() {
    echo "MLP Compiler (mlpc) - Multi-Language Programming Compiler"
    echo ""
    echo "Usage: mlpc <input.mlp> [options]"
    echo ""
    echo "Options:"
    echo "  -o <output>     Output executable name (default: input name)"
    echo "  --lang=<id>     Force language (e.g., tr-TR, ru-RU)"
    echo "  --keep-asm      Keep assembly file"
    echo "  --keep-prep     Keep preprocessed file"
    echo "  --no-prep       Skip preprocessor (English-only source)"
    echo "  --verbose       Show all compilation steps"
    echo ""
    echo "Examples:"
    echo "  mlpc program.mlp"
    echo "  mlpc program.mlp -o myapp"
    echo "  mlpc turkish.mlp --lang=tr-TR"
    echo "  mlpc english.mlp --no-prep"
    exit 1
}

# Parse arguments
INPUT_FILE=""
OUTPUT_NAME=""
LANGUAGE=""
KEEP_ASM=false
KEEP_PREP=false
NO_PREP=false
VERBOSE=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -o)
            OUTPUT_NAME="$2"
            shift 2
            ;;
        --lang=*)
            LANGUAGE="${1#*=}"
            shift
            ;;
        --keep-asm)
            KEEP_ASM=true
            shift
            ;;
        --keep-prep)
            KEEP_PREP=true
            shift
            ;;
        --no-prep)
            NO_PREP=true
            shift
            ;;
        --verbose)
            VERBOSE=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            if [[ -z "$INPUT_FILE" ]]; then
                INPUT_FILE="$1"
            else
                echo -e "${RED}Error: Unknown argument '$1'${NC}"
                exit 1
            fi
            shift
            ;;
    esac
done

if [[ -z "$INPUT_FILE" ]]; then
    usage
fi

if [[ ! -f "$INPUT_FILE" ]]; then
    echo -e "${RED}Error: File not found: $INPUT_FILE${NC}"
    exit 1
fi

# Determine output name
BASENAME=$(basename "$INPUT_FILE" .mlp)
BASENAME=$(basename "$BASENAME" .tyd)
if [[ -z "$OUTPUT_NAME" ]]; then
    OUTPUT_NAME="$BASENAME"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREP_FILE="${BASENAME}.preprocessed.mlp"
ASM_FILE="${BASENAME}.asm"
OBJ_FILE="${BASENAME}.o"

echo -e "${GREEN}=== MLP Compiler Pipeline ===${NC}"
echo "Input:  $INPUT_FILE"
echo "Output: $OUTPUT_NAME"
echo ""

# STAGE 1: Preprocessor
if [[ "$NO_PREP" == false ]]; then
    echo -e "${YELLOW}[1/4] Preprocessing...${NC}"

    LANG_ARG=""
    if [[ -n "$LANGUAGE" ]]; then
        LANG_ARG="--lang=$LANGUAGE"
    fi

    if [[ "$VERBOSE" == true ]]; then
        "$SCRIPT_DIR/mlp_preprocessor" "$INPUT_FILE" $LANG_ARG "$PREP_FILE"
    else
        "$SCRIPT_DIR/mlp_preprocessor" "$INPUT_FILE" $LANG_ARG "$PREP_FILE" > /dev/null
    fi

    COMPILE_INPUT="$PREP_FILE"
    echo -e "${GREEN}      ✓ Preprocessed${NC}"
else
    echo -e "${YELLOW}[1/4] Skipping preprocessor (--no-prep)${NC}"
    COMPILE_INPUT="$INPUT_FILE"
fi
echo ""

# STAGE 2: Compile to Assembly
echo -e "${YELLOW}[2/4] Compiling to assembly...${NC}"
if [[ "$VERBOSE" == true ]]; then
    "$SCRIPT_DIR/c_compiler/compiler_test" "$COMPILE_INPUT" "$ASM_FILE"
else
    "$SCRIPT_DIR/c_compiler/compiler_test" "$COMPILE_INPUT" "$ASM_FILE" 2>&1 | grep -E "(Derleniyor|Başarıyla|HATA|ERROR)" || true
fi
echo -e "${GREEN}      ✓ Assembly generated${NC}"
echo ""

# STAGE 3: Assemble to Object
echo -e "${YELLOW}[3/4] Assembling...${NC}"
nasm -f elf64 "$ASM_FILE" -o "$OBJ_FILE"
echo -e "${GREEN}      ✓ Object file created${NC}"
echo ""

# STAGE 4: Link
echo -e "${YELLOW}[4/4] Linking...${NC}"
gcc "$OBJ_FILE" "$SCRIPT_DIR/runtime/runtime.o" -o "$OUTPUT_NAME" -no-pie
echo -e "${GREEN}      ✓ Executable created${NC}"
echo ""

# Cleanup
if [[ "$KEEP_PREP" == false && "$NO_PREP" == false ]]; then
    rm -f "$PREP_FILE"
fi

if [[ "$KEEP_ASM" == false ]]; then
    rm -f "$ASM_FILE"
fi

rm -f "$OBJ_FILE"

echo -e "${GREEN}=== Compilation Successful! ===${NC}"
echo "Executable: $OUTPUT_NAME"
echo ""
echo "Run with: ./$OUTPUT_NAME"
