// Phase 8.8: Promise.all() Test
// Tests parallel async operations - Simplified version

async function main()
    print("=== Promise.all() Parallel Test ===")
    print("")
    
    print("Starting 3 parallel sleep operations...")
    print("Each will take 1 second")
    print("")
    
    // Create 3 promises manually
    numeric p1 = async_sleep(1000)
    numeric p2 = async_sleep(1000) 
    numeric p3 = async_sleep(1000)
    
    // For now, test them sequentially to verify they work
    numeric r1 = await p1
    print("Sleep 1 completed")
    
    numeric r2 = await p2
    print("Sleep 2 completed")
    
    numeric r3 = await p3
    print("Sleep 3 completed")
    
    print("")
    print("=== Test Complete ===")
    print("Note: Promise.all requires array support")
    return 0
end
