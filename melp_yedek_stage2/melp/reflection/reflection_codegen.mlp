-- Reflection Codegen Sabitleri
-- Runtime type information için assembly generation

-- Register kullanımı
numeric REG_TYPE_INFO = 0          -- rdi: TypeInfo pointer
numeric REG_FIELD_INFO = 1         -- rsi: FieldInfo pointer
numeric REG_METHOD_INFO = 2        -- rdx: MethodInfo pointer
numeric REG_INSTANCE = 3           -- rcx: Instance pointer
numeric REG_VALUE = 4              -- r8: Value pointer
numeric REG_REGISTRY = 5           -- r9: Type registry

-- Stack frame layout
numeric STACK_TYPE_INFO = 8        -- [rbp - 8]: TypeInfo
numeric STACK_FIELD_INFO = 16      -- [rbp - 16]: FieldInfo
numeric STACK_METHOD_INFO = 24     -- [rbp - 24]: MethodInfo
numeric STACK_INSTANCE = 32        -- [rbp - 32]: Instance
numeric STACK_ATTRIBUTES = 40      -- [rbp - 40]: Attributes
numeric STACK_RESULT = 48          -- [rbp - 48]: Result

-- Type info structure offsets
numeric OFF_TYPE_NAME = 0          -- name offset
numeric OFF_TYPE_CATEGORY = 8      -- category offset
numeric OFF_TYPE_SIZE = 16         -- size offset
numeric OFF_TYPE_ALIGNMENT = 24    -- alignment offset
numeric OFF_TYPE_FLAGS = 32        -- flags offset
numeric OFF_TYPE_DATA = 40         -- category data offset

-- Field info structure offsets
numeric OFF_FIELD_NAME = 0         -- name offset
numeric OFF_FIELD_TYPE = 8         -- type_info offset
numeric OFF_FIELD_OFFSET = 16      -- offset offset
numeric OFF_FIELD_SIZE = 24        -- size offset
numeric OFF_FIELD_FLAGS = 32       -- flags offset

-- Method info structure offsets
numeric OFF_METHOD_NAME = 0        -- name offset
numeric OFF_METHOD_RETURN = 8      -- return_type offset
numeric OFF_METHOD_PARAMS = 16     -- param_types offset
numeric OFF_METHOD_COUNT = 24      -- param_count offset
numeric OFF_METHOD_PTR = 32        -- function_ptr offset

-- Label prefix'leri
numeric LABEL_TYPE = 0             -- .type_
numeric LABEL_FIELD = 1            -- .field_
numeric LABEL_METHOD = 2           -- .method_
numeric LABEL_ATTRIBUTE = 3        -- .attribute_
numeric LABEL_REGISTRY = 4         -- .registry_
numeric LABEL_TYPEOF = 5           -- .typeof_
numeric LABEL_CAST = 6             -- .cast_
numeric LABEL_CHECK = 7            -- .check_

-- Data section offset'leri
numeric DATA_TYPE_TABLE = 0        -- .type_table
numeric DATA_FIELD_TABLE = 1       -- .field_table
numeric DATA_METHOD_TABLE = 2      -- .method_table
numeric DATA_ATTRIBUTE_TABLE = 3   -- .attribute_table
numeric DATA_REGISTRY = 4          -- .global_type_registry

-- Type operation codegen
numeric OP_TYPEOF = 0              -- typeof operation
numeric OP_TYPE_ASSERT = 1         -- Type assertion (as)
numeric OP_TYPE_CHECK = 2          -- Type check (is)
numeric OP_GET_FIELD = 3           -- Get field value
numeric OP_SET_FIELD = 4           -- Set field value
numeric OP_INVOKE_METHOD = 5       -- Invoke method

-- Cast implementation strategy
numeric CAST_DIRECT = 0            -- Direct pointer cast
numeric CAST_WITH_CHECK = 1        -- Cast with type check
numeric CAST_DYNAMIC = 2           -- Dynamic cast with vtable

-- Field access strategy
numeric ACCESS_DIRECT = 0          -- Direct offset access
numeric ACCESS_REFLECTION = 1      -- Via reflection API
numeric ACCESS_VIRTUAL = 2         -- Virtual property access

-- Method invocation strategy
numeric INVOKE_DIRECT = 0          -- Direct function call
numeric INVOKE_REFLECTION = 1      -- Via reflection API
numeric INVOKE_VIRTUAL = 2         -- Virtual method call

-- Function adları
numeric FN_TYPE_INFO_CREATE = 0    -- type_info_create
numeric FN_TYPE_INFO_GET = 1       -- type_info_get_by_name
numeric FN_FIELD_GET = 2           -- type_info_get_field
numeric FN_FIELD_GET_VAL = 3       -- field_info_get_value
numeric FN_FIELD_SET_VAL = 4       -- field_info_set_value
numeric FN_METHOD_GET = 5          -- type_info_get_method
numeric FN_METHOD_INVOKE = 6       -- method_info_invoke
numeric FN_INSTANCE_TYPE = 7       -- instance_get_type
numeric FN_INSTANCE_CLONE = 8      -- instance_clone
numeric FN_INSTANCE_EQUALS = 9     -- instance_equals
numeric FN_INSTANCE_HASH = 10      -- instance_hash
numeric FN_TYPE_CAST = 11          -- type_cast
numeric FN_TYPE_COMPAT = 12        -- type_info_is_compatible
numeric FN_REGISTRY_REGISTER = 13  -- type_registry_register
numeric FN_REGISTRY_LOOKUP = 14    -- type_registry_lookup

-- Type metadata generation
numeric META_GENERATE_INFO = 0     -- TypeInfo data oluştur
numeric META_GENERATE_FIELDS = 1   -- Field metadata oluştur
numeric META_GENERATE_METHODS = 2  -- Method metadata oluştur
numeric META_GENERATE_ATTRS = 3    -- Attribute metadata oluştur

-- Runtime support
numeric RT_INIT_REGISTRY = 0       -- Registry initialization
numeric RT_REGISTER_TYPES = 1      -- Register all types
numeric RT_BUILD_VTABLES = 2       -- Build vtables

-- Optimization flags
numeric OPT_CACHE_TYPEINFO = 1     -- TypeInfo'yu cache'le
numeric OPT_INLINE_FIELD_ACCESS = 1 -- Field access'i inline et
numeric OPT_ELIMINATE_CHECKS = 1   -- Gereksiz kontrolleri kaldır
numeric OPT_DEVIRTUALIZE = 1       -- Method çağrılarını devirtualize et
