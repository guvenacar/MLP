-- Enum Codegen Modülü
-- Assembly üretimi sabitleri

-- Register kullanımı
numeric REG_ENUM_PTR = 0             -- rax: enum pointer
numeric REG_TAG = 1                  -- edi: tag value
numeric REG_DATA_PTR = 2             -- rsi: data pointer
numeric REG_VARIANT_PTR = 3          -- rdx: variant pointer

-- Enum layout (tagged union)
numeric ENUM_TAG_OFFSET = 0          -- Tag ilk 4 byte
numeric ENUM_DATA_OFFSET = 4         -- Data tag'den sonra
numeric ENUM_HEADER_SIZE = 4         -- Tag size

-- Variant constructor calling convention
numeric CTOR_PARAM_DATA = 0          -- rdi: variant data
numeric CTOR_RETURN = 1              -- rax: enum pointer

-- Match dispatch
numeric MATCH_LINEAR = 0             -- Linear search
numeric MATCH_JUMP_TABLE = 1         -- Jump table (dense tags)
numeric MATCH_BINARY_SEARCH = 2      -- Binary search (sparse tags)

-- Cast result
numeric CAST_SUCCESS = 1
numeric CAST_FAILURE = 0

-- Label tipleri
numeric LABEL_VARIANT_CTOR = 0       -- Constructor label
numeric LABEL_VARIANT_DTOR = 1       -- Destructor label
numeric LABEL_MATCH_ARM = 2          -- Match arm label
numeric LABEL_CAST_CHECK = 3         -- Cast check label
