-- JSON Lexer v5.0 - WITH DYNAMIC LISTS
-- Uses list[Token] for unlimited token storage
-- Self-hosting ready!

-- Token struct definition
struct Token then
    string type;
    string value;
end

-- Helper: Check if character is whitespace
function is_whitespace(ch) then
    int code = char_code(ch);

    if code == 32 then
        return 1
    end
    if code == 9 then
        return 1
    end
    if code == 10 then
        return 1
    end
    if code == 13 then
        return 1
    end
    return 0
end

-- Helper: Check if character is digit
function is_digit(ch) then
    int code = char_code(ch);

    if code >= 48 then
        if code <= 57 then
            return 1
        end
    end
    return 0
end

-- Helper: Skip whitespace and return new position
function skip_whitespace(text, pos) then
    int len = string_length(text);
    string ch = "";

    while
        if pos >= len then
            break
        end
        ch = substring(text, pos, 1)
        if is_whitespace(ch) == 0 then
            return pos
        end
        pos = pos + 1
    end

    return pos
end

-- Helper: Scan string literal, return end position
function scan_string(text, start_pos) then
    int pos = start_pos + 1;
    int len = string_length(text);
    string ch = "";

    while
        if pos >= len then
            break
        end
        ch = substring(text, pos, 1)
        if ch == "\"" then
            return pos + 1
        end
        pos = pos + 1
    end

    print "ERROR: Unclosed string"
    return pos
end

-- Helper: Scan number, return end position
function scan_number(text, start_pos) then
    int pos = start_pos;
    int len = string_length(text);
    string ch = "";

    while
        if pos >= len then
            break
        end
        ch = substring(text, pos, 1)
        if is_digit(ch) == 0 then
            return pos
        end
        pos = pos + 1
    end

    return pos
end

-- Main lexer function - returns list of tokens
function lex(text) then
    list[Token] tokens = list();;
    int pos = 0;
    int len = string_length(text);
    int end_pos = 0;
    string ch = "";
    string value = "";
    string word = "";
    string word5 = "";
    Token tok;

    while
        if pos >= len then
            break
        end

        pos = skip_whitespace(text, pos)

        if pos >= len then
            break
        end

        ch = substring(text, pos, 1)

        -- Left brace {
        if ch == "{" then
            tok.type = "LBRACE"
            tok.value = "{"
            tokens.add(tok)
            pos = pos + 1
        else
            -- Right brace }
            if ch == "}" then
                tok.type = "RBRACE"
                tok.value = "}"
                tokens.add(tok)
                pos = pos + 1
            else
                -- Left bracket [
                if ch == "[" then
                    tok.type = "LBRACKET"
                    tok.value = "["
                    tokens.add(tok)
                    pos = pos + 1
                else
                    -- Right bracket ]
                    if ch == "]" then
                        tok.type = "RBRACKET"
                        tok.value = "]"
                        tokens.add(tok)
                        pos = pos + 1
                    else
                        -- Colon :
                        if ch == ":" then
                            tok.type = "COLON"
                            tok.value = ":"
                            tokens.add(tok)
                            pos = pos + 1
                        else
                            -- Comma ,
                            if ch == "," then
                                tok.type = "COMMA"
                                tok.value = ","
                                tokens.add(tok)
                                pos = pos + 1
                            else
                                -- String "..."
                                if ch == "\"" then
                                    end_pos = scan_string(text, pos)
                                    value = substring(text, pos, end_pos - pos)
                                    tok.type = "STRING"
                                    tok.value = value
                                    tokens.add(tok)
                                    pos = end_pos
                                else
                                    -- Number
                                    if is_digit(ch) == 1 then
                                        end_pos = scan_number(text, pos)
                                        value = substring(text, pos, end_pos - pos)
                                        tok.type = "NUMBER"
                                        tok.value = value
                                        tokens.add(tok)
                                        pos = end_pos
                                    else
                                        -- Keywords: true, false, null
                                        word = substring(text, pos, 4)

                                        if word == "true" then
                                            tok.type = "TRUE"
                                            tok.value = "true"
                                            tokens.add(tok)
                                            pos = pos + 4
                                        else
                                            word5 = substring(text, pos, 5)
                                            if word5 == "false" then
                                                tok.type = "FALSE"
                                                tok.value = "false"
                                                tokens.add(tok)
                                                pos = pos + 5
                                            else
                                                if word == "null" then
                                                    tok.type = "NULL"
                                                    tok.value = "null"
                                                    tokens.add(tok)
                                                    pos = pos + 4
                                                else
                                                    -- Unknown character, skip
                                                    print "ERROR: Unknown character at pos "
                                                    print pos
                                                    pos = pos + 1
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return tokens
end

-- Test function
function test_lexer() then
    string json = "{\"name\":\"Alice\",\"age\":25}";
    list[Token] tokens = list();;
    int count = 0;
    int i = 0;
    Token t;

    print "Testing JSON Lexer with Lists"
    print "Input: "
    print json
    print ""
    print "Tokens:"

    tokens = lex(json)

    count = tokens.size()
    print "Token count: "
    print count
    print ""

    i = 0
    while
        if i >= count then
            break
        end

        t = tokens.get(i)
        print t.type
        print " = "
        print t.value

        i = i + 1
    end

    print ""
    print "Lexer test complete!"
end

-- Run test
test_lexer()
