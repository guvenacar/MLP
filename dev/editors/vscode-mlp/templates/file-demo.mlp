// MLP File I/O Demo Project
// Reading and writing files

print "File I/O Demo"
print "============="

// Write to a file
string message = "Hello from MLP!\nThis is a test file.\nMulti-line content works!"
write_file("test_output.txt", message)
print "Written to test_output.txt"

// Read from the file
string content = read_file("test_output.txt")
print "Read from file:"
print content

// String operations
print "String length: "
print string_length(content)

print "File demo complete!"
