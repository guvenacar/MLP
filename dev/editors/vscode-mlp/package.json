{
  "name": "mlp-language",
  "displayName": "MLP Language Support",
  "description": "Syntax highlighting for MLP (Multi-Language Programming) - Multi-language syntax support for Turkish, English, Russian, Chinese, Hindi",
  "version": "1.1.0",
  "publisher": "mlp-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/guvenacar/MLP"
  },
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "mlp",
    "multi-language",
    "turkish",
    "programming",
    "snippets",
    "templates"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mlp",
        "aliases": ["MLP", "mlp", "Multi-Language Programming"],
        "extensions": [".mlp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mlp",
        "scopeName": "source.mlp",
        "path": "./syntaxes/mlp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mlp",
        "path": "./snippets/mlp.json"
      }
    ]
  }
}
