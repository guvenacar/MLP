{
  "MLP Hello World": {
    "prefix": "mlp-hello",
    "body": [
      "// MLP Hello World",
      "print \"Merhaba Dünya!\"",
      "$0"
    ],
    "description": "Create a simple Hello World program"
  },
  "MLP Main Function": {
    "prefix": "mlp-main",
    "body": [
      "int main() {",
      "    $0",
      "    return 0;",
      "}"
    ],
    "description": "Create a main function"
  },
  "MLP Function": {
    "prefix": "mlp-func",
    "body": [
      "${1:int} ${2:functionName}(${3:int param}) {",
      "    $0",
      "    return ${4:0};",
      "}"
    ],
    "description": "Create a function"
  },
  "MLP If Statement": {
    "prefix": "mlp-if",
    "body": [
      "if ${1:condition} then",
      "    $0",
      "end"
    ],
    "description": "Create an if statement"
  },
  "MLP If-Else Statement": {
    "prefix": "mlp-ifelse",
    "body": [
      "if ${1:condition} then",
      "    ${2:// true branch}",
      "else",
      "    ${3:// false branch}",
      "end"
    ],
    "description": "Create an if-else statement"
  },
  "MLP While Loop": {
    "prefix": "mlp-while",
    "body": [
      "while ${1:condition} do",
      "    $0",
      "end"
    ],
    "description": "Create a while loop"
  },
  "MLP For Loop": {
    "prefix": "mlp-for",
    "body": [
      "for ${1:i} = ${2:0} to ${3:10} do",
      "    $0",
      "end"
    ],
    "description": "Create a for loop"
  },
  "MLP List": {
    "prefix": "mlp-list",
    "body": [
      "list<${1:int}> ${2:myList} = list<${1:int}>();",
      "${2:myList}.add(${3:value});",
      "$0"
    ],
    "description": "Create a List<T> with add operation"
  },
  "MLP Struct": {
    "prefix": "mlp-struct",
    "body": [
      "struct ${1:MyStruct} {",
      "    ${2:int} ${3:field1};",
      "    ${4:string} ${5:field2};",
      "}"
    ],
    "description": "Create a struct"
  },
  "MLP Enum": {
    "prefix": "mlp-enum",
    "body": [
      "enum ${1:MyEnum} {",
      "    ${2:VALUE1},",
      "    ${3:VALUE2},",
      "    ${4:VALUE3}",
      "}"
    ],
    "description": "Create an enum"
  },
  "MLP Switch": {
    "prefix": "mlp-switch",
    "body": [
      "switch ${1:variable} {",
      "    case ${2:value1}:",
      "        ${3:// code}",
      "        break;",
      "    case ${4:value2}:",
      "        ${5:// code}",
      "        break;",
      "    default:",
      "        ${6:// default code}",
      "}"
    ],
    "description": "Create a switch statement"
  },
  "MLP File Read": {
    "prefix": "mlp-fileread",
    "body": [
      "string content = read_file(\"${1:filename.txt}\");",
      "print content;",
      "$0"
    ],
    "description": "Read a file"
  },
  "MLP File Write": {
    "prefix": "mlp-filewrite",
    "body": [
      "write_file(\"${1:output.txt}\", \"${2:content}\");",
      "$0"
    ],
    "description": "Write to a file"
  },
  "MLP Turkish Hello": {
    "prefix": "mlp-tr-hello",
    "body": [
      "// Türkçe Örnek",
      "YAZDIR \"Merhaba Dünya!\"",
      "$0"
    ],
    "description": "Turkish Hello World"
  },
  "MLP Turkish Function": {
    "prefix": "mlp-tr-func",
    "body": [
      "SAYISAL ${1:fonksiyonAdi}(SAYISAL ${2:parametre}) {",
      "    $0",
      "    DÖNÜŞ ${3:0};",
      "}"
    ],
    "description": "Turkish function"
  }
}
