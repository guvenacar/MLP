{
  "version": "1.0",
  "description": "MLP Base Syntax Rules - Language agnostic",
  
  "keywords": [
    "function", "async", "await",
    "if", "then", "else",
    "while", "do", "for", "to", "step", "in",
    "return", "break", "continue",
    "struct", "enum", "switch", "case", "default",
    "import", "const", "lambda",
    "numeric", "string", "boolean",
    "true", "false", "null",
    "print", "typeof", "range",
    "optional", "list", "map",
    "and", "or", "not"
  ],
  
  "block_terminators": {
    "function": "end_function",
    "if": "end_if",
    "while": "end_while",
    "for": "end_for",
    "struct": "end_struct",
    "enum": "end_enum",
    "switch": "end_switch"
  },
  
  "operators": {
    "arithmetic": ["+", "-", "*", "/", "%"],
    "comparison": ["==", "!=", "<", ">", "<=", ">="],
    "logical": ["and", "or", "not"],
    "bitwise": ["&", "|", "^", "~", "<<", ">>"],
    "assignment": ["=", "+=", "-=", "*=", "/="],
    "member_access": [".", "->"],
    "lambda": ["=>"]
  },
  
  "punctuation": {
    "parentheses": ["(", ")"],
    "brackets": ["[", "]"],
    "braces": ["{", "}"],
    "separators": [",", ";"],
    "string_delimiters": ["\"", "'", "\"\"\""]
  },
  
  "syntax_rules": {
    "block_style": "end_keyword",
    "statement_terminator": "optional_semicolon",
    "indentation": "not_significant",
    "case_sensitivity": "true",
    "comment_single_line": "--",
    "comment_multi_line": ["/*", "*/"]
  },
  
  "naming_conventions": {
    "keywords": "lowercase_underscore",
    "identifiers": "snake_case_recommended",
    "constants": "UPPER_SNAKE_CASE_recommended"
  },
  
  "reserved_patterns": {
    "end_*": "Reserved for block terminators",
    "__*": "Reserved for internal use"
  }
}
