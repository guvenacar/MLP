-- lang: tr-TR
-- syntax: c

-- Test: Turkish keywords + C-style syntax
TAMSAYI x = 0;

eğer (x > 0) {
    YAZDIR "pozitif";
} değilse {
    YAZDIR "negatif veya sıfır";
}

için (TAMSAYI i = 0; i < 10; i++) {
    YAZDIR i;
}

döngü (x < 100) {
    x = x + 1;
    eğer (x > 50) {
        kır;
    }
}

YAZDIR "Bitti!";
