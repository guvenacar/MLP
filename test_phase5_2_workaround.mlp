-- Phase 5.2 Test - Workaround Version
-- Using built-ins as expressions (assign to dummy variable)

function test_error_code() then
    int dummy1 = 0;
    int code = 0;
    
    print "Testing error code..."
    
    -- Workaround: assign to dummy variable
    dummy1 = set_error_code(42)
    code = get_error_code()
    
    print "Error code: "
    print code
    
    return 0
end

function test_malloc_free() then
    int ptr = 0;
    int dummy2 = 0;
    
    print "Testing malloc/free..."
    
    ptr = mlp_malloc(100)
    print "Allocated 100 bytes"
    
    dummy2 = mlp_free(ptr)
    print "Freed memory"
    
    return 0
end

function run_tests() then
    int result1 = 0;
    int result2 = 0;
    
    print "=== Phase 5.2 Quick Test ==="
    print ""

    result1 = test_error_code()
    print ""

    result2 = test_malloc_free()
    print ""

    print "=== Tests Complete ==="
    
    return 0
end

run_tests()
