-- ===============================================
-- MLP Parser (Syntax Analyzer)
-- ===============================================
-- Transpiled from: TYD-MLP/src/parser.py
-- Date: 2025-11-14
-- Takes Token list from Lexer ve builds AST (Abstract Syntax Tree)

KULLAN lexer.tokens
KULLAN ast.ast_nodes

SINIF Parser
    -- Takes token list from Lexer ve constructs AST

    lexer DİNAMİK
    mevcut_token DİNAMİK

    KURUCU(lexer)
        BU.lexer = lexer
        BU.mevcut_token = BU.lexer.sonraki_tokeni_al()  -- Get first token
    KURUCU SON

    IŞLEÇ hata(mesaj)
        -- Throws parser error
        HATA_FIRLAT YENİ İSTİSNA("[Sözdizimi Hatası] " + mesaj + ". Bulunan: " + METIN(BU.mevcut_token))
    IŞLEÇ SON

    IŞLEÇ tuket(token_tipi)
        -- Consumes current token EĞER it matches expected type
        -- Otherwise throws error
        EĞER BU.mevcut_token.tip == token_tipi İSE
            BU.mevcut_token = BU.lexer.sonraki_tokeni_al()
        DEĞILSE
            BU.hata("Beklenen token: " + token_tipi)
        EĞER SON
    IŞLEÇ SON

    -- ===============================================
    -- Grammar Rules
    -- ===============================================

    IŞLEÇ faktor() -> dynamic
        -- Highest precedence: Numbers, Strings, Variables, Parentheses,
        -- Function Calls, Array Access, Dictionary Access
        VAR token = BU.mevcut_token

        EĞER token.tip == TOKEN_TIPLERI["INTEGER"] veya token.tip == TOKEN_TIPLERI["FLOAT"]
            BU.tuket(token.tip)
            DÖNÜŞ YENİ Sayi(token)
        SON

        EĞER token.tip == TOKEN_TIPLERI["STRING"]
            BU.tuket(TOKEN_TIPLERI["STRING"])
            DÖNÜŞ YENİ Metin(token)
        SON

        EĞER token.tip == TOKEN_TIPLERI["IDENTIFIER"]
            BU.tuket(TOKEN_TIPLERI["IDENTIFIER"])  -- 'd', 'liste', veya 'topla'

            EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["LEFT_PAREN"]
                -- Function call (topla())
                DÖNÜŞ BU.islec_cagirma(token)
            SON

            EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["LEFT_BRACKET"]
                -- Array access (liste[])
                DÖNÜŞ BU.dizi_erisimi(token)
            SON

            EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["LEFT_BRACE"]
                -- Dictionary access (d{})
                DÖNÜŞ BU.sozluk_erisimi(token)
            SON

            -- Normal variable reference
            DÖNÜŞ YENİ Degisken(token)
        SON

        EĞER token.tip == TOKEN_TIPLERI["LEFT_PAREN"]
            BU.tuket(TOKEN_TIPLERI["LEFT_PAREN"])
            VAR dugum = BU.ifade()
            BU.tuket(TOKEN_TIPLERI["RIGHT_PAREN"])
            DÖNÜŞ dugum
        SON

        BU.hata("Beklenmedik ifade başlangıcı: " + token.tip)
    SON

    IŞLEÇ islec_cagirma(hedef_token) -> IslecCagirma
        -- Parses function call arguments
        -- Grammar: '(' [ifade (COMMA ifade)*]? ')'
        VAR argumanlar = []
        BU.tuket(TOKEN_TIPLERI["LEFT_PAREN"])  -- '('

        -- If first token is not ')', there are arguments
        EĞER BU.mevcut_token.tip != TOKEN_TIPLERI["RIGHT_PAREN"]
            -- First argument (can be complex expression like '5 + 2')
            argumanlar.push(BU.ifade())

            -- Remaining arguments (comma-separated)
            DÖNGÜ BU.mevcut_token.tip == TOKEN_TIPLERI["COMMA"] İSE
                BU.tuket(TOKEN_TIPLERI["COMMA"])  -- ','
                argumanlar.push(BU.ifade())
            SON
        SON

        BU.tuket(TOKEN_TIPLERI["RIGHT_PAREN"])  -- ')'
        DÖNÜŞ YENİ IslecCagirma(hedef_token, argumanlar)
    SON

    IŞLEÇ dizi_erisimi(hedef_token) -> DiziErisim
        -- Grammar: '[' ifade ']'
        BU.tuket(TOKEN_TIPLERI["LEFT_BRACKET"])  -- '['

        -- Index can be complex expression like '5 + 2'
        VAR indeks_ifadesi = BU.ifade()

        BU.tuket(TOKEN_TIPLERI["RIGHT_BRACKET"])  -- ']'

        VAR hedef_node = YENİ Degisken(hedef_token)
        DÖNÜŞ YENİ DiziErisim(hedef_node, indeks_ifadesi)
    SON

    IŞLEÇ sozluk_erisimi(hedef_token) -> SozlukErisim
        -- Grammar: '{' ifade '}'
        BU.tuket(TOKEN_TIPLERI["LEFT_BRACE"])  -- '{'

        -- Key can be complex expression
        VAR anahtar_ifadesi = BU.ifade()

        BU.tuket(TOKEN_TIPLERI["RIGHT_BRACE"])  -- '}'

        VAR hedef_node = YENİ Degisken(hedef_token)
        DÖNÜŞ YENİ SozlukErisim(hedef_node, anahtar_ifadesi)
    SON

    IŞLEÇ terim() -> dynamic
        -- Medium precedence: Multiplication ve Division
        -- Grammar: faktor ((MUL | DIV | POWER) faktor)*
        VAR sol_dugum = BU.faktor()

        -- Continue as long as *, /, veya ** appears
        DÖNGÜ BU.mevcut_token.tip == TOKEN_TIPLERI["MUL"] veya İSE
              BU.mevcut_token.tip == TOKEN_TIPLERI["DIV"] veya
              BU.mevcut_token.tip == TOKEN_TIPLERI["POWER"]

            VAR operator = BU.mevcut_token
            BU.tuket(operator.tip)
            VAR sag_dugum = BU.faktor()

            -- Update left node with YENİ operation node
            sol_dugum = YENİ IkiliIslem(sol_dugum, operator, sag_dugum)
        SON

        DÖNÜŞ sol_dugum
    SON

    IŞLEÇ ifade() -> dynamic
        -- Lowest precedence: Addition, Subtraction, Comparisons
        -- Grammar: terim ((PLUS | MINUS | comparisons) terim)*
        VAR sol_dugum = BU.terim()

        DÖNGÜ BU.mevcut_token.tip == TOKEN_TIPLERI["PLUS"] veya İSE
              BU.mevcut_token.tip == TOKEN_TIPLERI["MINUS"] veya
              BU.mevcut_token.tip == TOKEN_TIPLERI["OP_ESIT_KARSILASTIRMA"] veya
              BU.mevcut_token.tip == TOKEN_TIPLERI["GT"] veya
              BU.mevcut_token.tip == TOKEN_TIPLERI["LT"] veya
              BU.mevcut_token.tip == TOKEN_TIPLERI["GTE"] veya
              BU.mevcut_token.tip == TOKEN_TIPLERI["LTE"]

            VAR operator = BU.mevcut_token
            BU.tuket(operator.tip)
            VAR sag_dugum = BU.terim()
            sol_dugum = YENİ IkiliIslem(sol_dugum, operator, sag_dugum)
        SON

        DÖNÜŞ sol_dugum
    SON

    -- ===============================================
    -- Statement Parsing
    -- ===============================================

    IŞLEÇ komut() -> dynamic
        -- Parses a single statement
        VAR token = BU.mevcut_token

        -- 0. Phase 8: SINIF definition?
        EĞER token.tip == TOKEN_TIPLERI["OOP_SINIF"]
            DÖNÜŞ BU.sinif_tanimlama()
        SON

        -- 1. MLP SYNTAX: DEĞIŞKEN name: TYPE = value;
        EĞER token.tip == TOKEN_TIPLERI["TANIMLA_DEGISKEN"]
            DÖNÜŞ BU.mlp_degisken_tanimlama()
        SON

        -- 2. Starts with TYPE?
        EĞER token.tip == TOKEN_TIPLERI["TANIMLA_SAYI"] veya
           token.tip == TOKEN_TIPLERI["TANIMLA_METIN"] veya
           token.tip == TOKEN_TIPLERI["TANIMLA_BOOL"]
            DÖNÜŞ BU.tip_ile_baslayan_komut()
        SON

        -- 3. Starts with IŞLEÇ?
        EĞER token.tip == TOKEN_TIPLERI["YAPI_ISLEC"]
            DÖNÜŞ BU.islec_tanimlama(HİÇLİK)
        SON

        -- 4. EĞER block?
        EĞER token.tip == TOKEN_TIPLERI["YAPI_KOSUL_EGER"]
            DÖNÜŞ BU.eger_blogu()
        SON

        -- 5. YAZDIR statement?
        EĞER token.tip == TOKEN_TIPLERI["YAPI_YAZDIR"]
            DÖNÜŞ BU.yazdir_komutu()
        SON

        -- 6. DÖNGÜ block? İSE
        EĞER token.tip == TOKEN_TIPLERI["YAPI_DONGU"]
            DÖNÜŞ BU.dongu_blogu()
        SON

        -- 7. DÖNGÜ_BITIR statement?
        EĞER token.tip == TOKEN_TIPLERI["YAPI_DONGU_BITIR"]
            DÖNÜŞ BU.dongu_bitir_komutu()
        SON

        -- 8. DÖNÜŞ statement?
        EĞER token.tip == TOKEN_TIPLERI["YAPI_DONUS"]
            DÖNÜŞ BU.donus_komutu()
        SON

        -- 9. Assignment OR Function call statement?
        EĞER token.tip == TOKEN_TIPLERI["IDENTIFIER"]
            VAR ifade_dugumu = BU.ifade()

            -- Case 1: Assignment (s = 10; veya d{"key"} = 30;)
            EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["ASSIGN"]
                -- Check EĞER target is valid (Degisken, DiziErisim, veya SozlukErisim)
                EĞER not (TYPE_OF(ifade_dugumu) == "Degisken" veya
                        TYPE_OF(ifade_dugumu) == "DiziErisim" veya
                        TYPE_OF(ifade_dugumu) == "SozlukErisim")
                    BU.hata("Atama hedefi geçersiz. Hedef bir değişken, dizi elemanı veya sözlük elemanı olmalıdır.")
                SON

                BU.tuket(TOKEN_TIPLERI["ASSIGN"])  -- '='
                VAR atanan_deger_ifadesi = BU.ifade()
                BU.tuket(TOKEN_TIPLERI["SEMICOLON"])  -- ';'
                DÖNÜŞ YENİ AtamaKomutu(ifade_dugumu, atanan_deger_ifadesi)
            SON

            -- Case 2: Function call statement (SOZLUK_OLUSTUR(10);)
            EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["SEMICOLON"]
                BU.tuket(TOKEN_TIPLERI["SEMICOLON"])  -- ';'
                EĞER TYPE_OF(ifade_dugumu) == "IslecCagirma"
                    DÖNÜŞ YENİ IfadeKomutu(ifade_dugumu)
                DEĞILSE
                    BU.hata("Bu ifade tek başına bir komut olamaz: " + string(ifade_dugumu))
                SON
            SON

            BU.hata("Komutun sonunda ';' veya '=' bekleniyordu")
        SON

        -- 10. Otherwise it's an error
        BU.hata("Tanınmayan komut başlangıcı: " + string(token))
    SON

    IŞLEÇ degisken_tanimlama(tip_token, ad_token) -> DegiskenTanimlama
        -- Grammar: (tip_token ve ad_token already consumed) ASSIGN ifade SEMICOLON
        BU.tuket(TOKEN_TIPLERI["ASSIGN"])
        VAR ifade_node = BU.ifade()
        BU.tuket(TOKEN_TIPLERI["SEMICOLON"])
        DÖNÜŞ YENİ DegiskenTanimlama(tip_token, ad_token, ifade_node)
    SON

    IŞLEÇ mlp_degisken_tanimlama() -> DegiskenTanimlama
        -- MLP Syntax: DEĞIŞKEN name: TYPE = value;
        BU.tuket(TOKEN_TIPLERI["TANIMLA_DEGISKEN"])  -- 'DEĞIŞKEN'

        -- Get name
        VAR ad_token = BU.mevcut_token
        BU.tuket(TOKEN_TIPLERI["IDENTIFIER"])

        -- Expect ':'
        BU.tuket(TOKEN_TIPLERI["COLON"])

        -- Get type
        VAR tip_token = BU.mevcut_token
        EĞER tip_token.tip == TOKEN_TIPLERI["TANIMLA_SAYI"] veya
           tip_token.tip == TOKEN_TIPLERI["TANIMLA_METIN"] veya
           tip_token.tip == TOKEN_TIPLERI["TANIMLA_BOOL"] veya
           tip_token.tip == TOKEN_TIPLERI["IDENTIFIER"]
            BU.tuket(tip_token.tip)
        DEĞILSE
            BU.hata("Tip anotasyonu bekleniyor")
        SON

        -- Optional initial value
        VAR ifade_node = HİÇLİK
        EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["ASSIGN"]
            BU.tuket(TOKEN_TIPLERI["ASSIGN"])
            ifade_node = BU.ifade()
        SON

        BU.tuket(TOKEN_TIPLERI["SEMICOLON"])
        DÖNÜŞ YENİ DegiskenTanimlama(tip_token, ad_token, ifade_node)
    SON

    IŞLEÇ eger_blogu() -> EgerBlogu
        -- EĞER condition İSE statements [DEĞİLSE statements] SON
        BU.tuket(TOKEN_TIPLERI["YAPI_KOSUL_EGER"])  -- 'EĞER'
        VAR kosul = BU.ifade()
        BU.tuket(TOKEN_TIPLERI["YAPI_KOSUL_ISE"])  -- 'İSE'

        -- True block
        VAR dogru_blok = YENİ Blok()
        DÖNGÜ BU.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] ve İSE
              BU.mevcut_token.tip != TOKEN_TIPLERI["YAPI_KOSUL_DEGILSE"] ve
              BU.mevcut_token.tip != TOKEN_TIPLERI["EOF"]
            dogru_blok.komutlar.push(BU.komut())
        SON

        VAR yanlis_blok = HİÇLİK

        -- DEĞİLSE block?
        EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["YAPI_KOSUL_DEGILSE"]
            BU.tuket(TOKEN_TIPLERI["YAPI_KOSUL_DEGILSE"])
            yanlis_blok = YENİ Blok()
            DÖNGÜ BU.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] ve İSE
                  BU.mevcut_token.tip != TOKEN_TIPLERI["EOF"]
                yanlis_blok.komutlar.push(BU.komut())
            SON
        SON

        BU.tuket(TOKEN_TIPLERI["YAPI_SON"])  -- 'SON'
        DÖNÜŞ YENİ EgerBlogu(kosul, dogru_blok, yanlis_blok)
    SON

    IŞLEÇ yazdir_komutu() -> YazdirKomutu
        -- YAZDIR expression;
        BU.tuket(TOKEN_TIPLERI["YAPI_YAZDIR"])
        VAR ifade = BU.ifade()
        BU.tuket(TOKEN_TIPLERI["SEMICOLON"])
        DÖNÜŞ YENİ YazdirKomutu(ifade)
    SON

    IŞLEÇ dongu_blogu() -> DonguBlogu
        -- DÖNGÜ statements SON İSE
        BU.tuket(TOKEN_TIPLERI["YAPI_DONGU"])

        VAR blok = YENİ Blok()
        DÖNGÜ BU.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] ve İSE
              BU.mevcut_token.tip != TOKEN_TIPLERI["EOF"]
            blok.komutlar.push(BU.komut())
        SON

        BU.tuket(TOKEN_TIPLERI["YAPI_SON"])
        DÖNÜŞ YENİ DonguBlogu(blok)
    SON

    IŞLEÇ dongu_bitir_komutu() -> DonguBitirKomutu
        -- DÖNGÜ_BITIR;
        BU.tuket(TOKEN_TIPLERI["YAPI_DONGU_BITIR"])
        BU.tuket(TOKEN_TIPLERI["SEMICOLON"])
        DÖNÜŞ YENİ DonguBitirKomutu()
    SON

    IŞLEÇ donus_komutu() -> DonusKomutu
        -- DÖNÜŞ expression;
        BU.tuket(TOKEN_TIPLERI["YAPI_DONUS"])
        VAR ifade = BU.ifade()
        BU.tuket(TOKEN_TIPLERI["SEMICOLON"])
        DÖNÜŞ YENİ DonusKomutu(ifade)
    SON

    IŞLEÇ tip_ile_baslayan_komut() -> dynamic
        -- Distinguishes commands starting with type (SAYISAL, METİN...)
        -- - SAYISAL İŞLEÇ topla...
        -- - SAYISAL liste[10];
        -- - SAYISAL s = 10;
        VAR tip_token = BU.mevcut_token
        BU.tuket(tip_token.tip)

        -- Case 1: SAYISAL İŞLEÇ ...
        EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["YAPI_ISLEC"]
            DÖNÜŞ BU.islec_tanimlama(tip_token)
        SON

        -- Case 2 & 3: SAYISAL s ... (Variable veya Array)
        EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["IDENTIFIER"]
            VAR ad_token = BU.mevcut_token
            BU.tuket(TOKEN_TIPLERI["IDENTIFIER"])

            -- Case 2: SAYISAL liste[ ...
            EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["LEFT_BRACKET"]
                DÖNÜŞ BU.dizi_tanimlama(tip_token, ad_token)
            SON

            -- Case 3: SAYISAL s = ...
            EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["ASSIGN"]
                DÖNÜŞ BU.degisken_tanimlama(tip_token, ad_token)
            SON

            BU.hata("Değişken adından sonra '[' veya '=' bekleniyordu")
        SON

        BU.hata("Tip tanımından sonra 'İŞLEÇ' veya değişken adı bekleniyordu")
    SON

    IŞLEÇ dizi_tanimlama(tip_token, ad_token) -> DiziTanimlama
        -- Grammar: (tip_token ve ad_token already consumed) '[' ifade ']' SEMICOLON
        BU.tuket(TOKEN_TIPLERI["LEFT_BRACKET"])
        VAR boyut_ifadesi = BU.ifade()
        BU.tuket(TOKEN_TIPLERI["RIGHT_BRACKET"])
        BU.tuket(TOKEN_TIPLERI["SEMICOLON"])
        DÖNÜŞ YENİ DiziTanimlama(tip_token, ad_token, boyut_ifadesi)
    SON

    IŞLEÇ parametre_listesi() -> array
        -- ( [TYPE IDENTIFIER (COMMA TYPE IDENTIFIER)*]? )
        VAR parametreler = []
        BU.tuket(TOKEN_TIPLERI["LEFT_PAREN"])  -- '('

        -- If first token is not ')', there are parameters
        EĞER BU.mevcut_token.tip != TOKEN_TIPLERI["RIGHT_PAREN"]
            -- First parameter
            VAR tip_token = BU.mevcut_token
            EĞER tip_token.tip != TOKEN_TIPLERI["TANIMLA_SAYI"] ve
               tip_token.tip != TOKEN_TIPLERI["TANIMLA_METIN"] ve
               tip_token.tip != TOKEN_TIPLERI["TANIMLA_BOOL"]
                BU.hata("Parametre tipi bekleniyordu (SAYISAL, METİN vb.)")
            SON
            BU.tuket(tip_token.tip)

            VAR ad_token = BU.mevcut_token
            BU.tuket(TOKEN_TIPLERI["IDENTIFIER"])
            parametreler.push(YENİ Parametre(tip_token, ad_token))

            -- Remaining parameters (comma-separated)
            DÖNGÜ BU.mevcut_token.tip == TOKEN_TIPLERI["COMMA"] İSE
                BU.tuket(TOKEN_TIPLERI["COMMA"])

                tip_token = BU.mevcut_token
                EĞER tip_token.tip != TOKEN_TIPLERI["TANIMLA_SAYI"] ve
                   tip_token.tip != TOKEN_TIPLERI["TANIMLA_METIN"] ve
                   tip_token.tip != TOKEN_TIPLERI["TANIMLA_BOOL"]
                    BU.hata("Parametre tipi bekleniyordu")
                SON
                BU.tuket(tip_token.tip)

                ad_token = BU.mevcut_token
                BU.tuket(TOKEN_TIPLERI["IDENTIFIER"])
                parametreler.push(YENİ Parametre(tip_token, ad_token))
            SON
        SON

        BU.tuket(TOKEN_TIPLERI["RIGHT_PAREN"])  -- ')'
        DÖNÜŞ parametreler
    SON

    IŞLEÇ islec_tanimlama(donus_tipi_token) -> IslecTanimlama
        -- [TYPE]? İŞLEÇ IDENTIFIER ( parameters ) statements SON
        BU.tuket(TOKEN_TIPLERI["YAPI_ISLEC"])  -- 'İŞLEÇ'

        VAR ad_token = BU.mevcut_token
        BU.tuket(TOKEN_TIPLERI["IDENTIFIER"])

        VAR parametreler = BU.parametre_listesi()

        -- Function body
        VAR govde = YENİ Blok()
        DÖNGÜ BU.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] ve İSE
              BU.mevcut_token.tip != TOKEN_TIPLERI["EOF"]
            govde.komutlar.push(BU.komut())
        SON

        BU.tuket(TOKEN_TIPLERI["YAPI_SON"])  -- 'SON'
        DÖNÜŞ YENİ IslecTanimlama(ad_token, parametreler, govde, donus_tipi_token)
    SON

    IŞLEÇ parse() -> Blok
        -- Parses entire program ve returns AST root (a Block)
        VAR ana_blok = YENİ Blok()

        -- Read all statements until EOF
        DÖNGÜ BU.mevcut_token.tip != TOKEN_TIPLERI["EOF"] İSE
            ana_blok.komutlar.push(BU.komut())
        SON

        DÖNÜŞ ana_blok
    SON

    -- ===============================================
    -- Phase 8: OOP Support
    -- ===============================================

    IŞLEÇ sinif_tanimlama() -> SinifTanimlama
        -- Parses SINIF definition
        BU.tuket(TOKEN_TIPLERI["OOP_SINIF"])  -- 'SINIF'

        VAR sinif_adi = BU.mevcut_token
        BU.tuket(TOKEN_TIPLERI["IDENTIFIER"])

        VAR ozellikler = []
        VAR kurucu = HİÇLİK
        VAR metodlar = []

        -- Parse SINIF body (until SON)
        DÖNGÜ BU.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] ve İSE
              BU.mevcut_token.tip != TOKEN_TIPLERI["EOF"]

            -- ÖZELLIK definition?
            EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["OOP_OZELLIK"]
                ozellikler.push(BU.ozellik_tanimlama())
            SON

            -- KURUCU definition?
            EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["OOP_KURUCU"]
                kurucu = BU.kurucu_tanimlama()
            SON

            -- IŞLEÇ (method) definition?
            EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["TANIMLA_SAYI"] veya
               BU.mevcut_token.tip == TOKEN_TIPLERI["TANIMLA_METIN"] veya
               BU.mevcut_token.tip == TOKEN_TIPLERI["TANIMLA_BOOL"]
                VAR tip_token = BU.mevcut_token
                BU.tuket(BU.mevcut_token.tip)

                EĞER BU.mevcut_token.tip == TOKEN_TIPLERI["YAPI_ISLEC"]
                    metodlar.push(BU.islec_tanimlama(tip_token))
                DEĞILSE
                    BU.hata("SINIF içinde tip token'dan sonra IŞLEÇ bekleniyor")
                SON
            SON
        SON

        BU.tuket(TOKEN_TIPLERI["YAPI_SON"])  -- 'SON'
        DÖNÜŞ YENİ SinifTanimlama(sinif_adi, ozellikler, kurucu, metodlar)
    SON

    IŞLEÇ ozellik_tanimlama() -> OzellikTanimlama
        -- Parses ÖZELLIK TYPE name; format
        BU.tuket(TOKEN_TIPLERI["OOP_OZELLIK"])  -- 'ÖZELLIK'

        VAR tip_token = BU.mevcut_token
        EĞER BU.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_SAYI"] ve
           BU.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_METIN"] ve
           BU.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_BOOL"]
            BU.hata("ÖZELLIK'ten sonra tip bekleniyor")
        SON
        BU.tuket(BU.mevcut_token.tip)

        VAR ad_token = BU.mevcut_token
        BU.tuket(TOKEN_TIPLERI["IDENTIFIER"])
        BU.tuket(TOKEN_TIPLERI["SEMICOLON"])

        DÖNÜŞ YENİ OzellikTanimlama(tip_token, ad_token, HİÇLİK)
    SON

    IŞLEÇ kurucu_tanimlama() -> KurucuTanimlama
        -- Parses KURUCU(parameters) ... SON format
        BU.tuket(TOKEN_TIPLERI["OOP_KURUCU"])  -- 'KURUCU'
        BU.tuket(TOKEN_TIPLERI["LEFT_PAREN"])  -- '('

        VAR parametreler = []
        EĞER BU.mevcut_token.tip != TOKEN_TIPLERI["RIGHT_PAREN"]
            parametreler.push(BU.parametre())

            DÖNGÜ BU.mevcut_token.tip == TOKEN_TIPLERI["COMMA"] İSE
                BU.tuket(TOKEN_TIPLERI["COMMA"])
                parametreler.push(BU.parametre())
            SON
        SON

        BU.tuket(TOKEN_TIPLERI["RIGHT_PAREN"])  -- ')'

        -- Constructor body
        VAR govde = YENİ Blok()
        DÖNGÜ BU.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] ve İSE
              BU.mevcut_token.tip != TOKEN_TIPLERI["EOF"]
            govde.komutlar.push(BU.komut())
        SON

        BU.tuket(TOKEN_TIPLERI["YAPI_SON"])  -- 'SON'
        DÖNÜŞ YENİ KurucuTanimlama(parametreler, govde)
    SON

    IŞLEÇ parametre() -> Parametre
        -- Parses TYPE name format (function parameter)
        VAR tip_token = BU.mevcut_token
        EĞER BU.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_SAYI"] ve
           BU.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_METIN"] ve
           BU.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_BOOL"]
            BU.hata("Parametre tipinde SAYISAL, METIN veya ZITLIK bekleniyor")
        SON
        BU.tuket(BU.mevcut_token.tip)

        VAR ad_token = BU.mevcut_token
        BU.tuket(TOKEN_TIPLERI["IDENTIFIER"])
        DÖNÜŞ YENİ Parametre(tip_token, ad_token)
    SON
SON
