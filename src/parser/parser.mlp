-- ===============================================
-- MLP Parser (Syntax Analyzer)
-- ===============================================
-- Transpiled from: TYD-MLP/src/parser.py
-- Date: 2025-11-14
-- Takes Token list from Lexer and builds AST (Abstract Syntax Tree)

KULLAN lexer.tokens
KULLAN ast.ast_nodes

class Parser
    -- Takes token list from Lexer and constructs AST

    lexer dynamic
    mevcut_token dynamic

    constructor(lexer)
        this.lexer = lexer
        this.mevcut_token = this.lexer.sonraki_tokeni_al()  -- Get first token
    end

    method hata(mesaj)
        -- Throws parser error
        throw new Exception("[Sözdizimi Hatası] " + mesaj + ". Bulunan: " + string(this.mevcut_token))
    end

    method tuket(token_tipi)
        -- Consumes current token if it matches expected type
        -- Otherwise throws error
        if this.mevcut_token.tip == token_tipi
            this.mevcut_token = this.lexer.sonraki_tokeni_al()
        else
            this.hata("Beklenen token: " + token_tipi)
        end
    end

    -- ===============================================
    -- Grammar Rules
    -- ===============================================

    method faktor() -> dynamic
        -- Highest precedence: Numbers, Strings, Variables, Parentheses,
        -- Function Calls, Array Access, Dictionary Access
        token;
        token = this.mevcut_token

        if token.tip == TOKEN_TIPLERI["INTEGER"] or token.tip == TOKEN_TIPLERI["FLOAT"]
            this.tuket(token.tip)
            return new Sayi(token)
        end

        if token.tip == TOKEN_TIPLERI["STRING"]
            this.tuket(TOKEN_TIPLERI["STRING"])
            return new Metin(token)
        end

        if token.tip == TOKEN_TIPLERI["IDENTIFIER"]
            this.tuket(TOKEN_TIPLERI["IDENTIFIER"])  -- 'd', 'liste', or 'topla'

            if this.mevcut_token.tip == TOKEN_TIPLERI["LEFT_PAREN"]
                -- Function call (topla())
                return this.islec_cagirma(token)
            end

            if this.mevcut_token.tip == TOKEN_TIPLERI["LEFT_BRACKET"]
                -- Array access (liste[])
                return this.dizi_erisimi(token)
            end

            if this.mevcut_token.tip == TOKEN_TIPLERI["LEFT_BRACE"]
                -- Dictionary access (d{})
                return this.sozluk_erisimi(token)
            end

            -- Normal variable reference
            return new Degisken(token)
        end

        if token.tip == TOKEN_TIPLERI["LEFT_PAREN"]
            this.tuket(TOKEN_TIPLERI["LEFT_PAREN"])
            dugum;
            dugum = this.ifade()
            this.tuket(TOKEN_TIPLERI["RIGHT_PAREN"])
            return dugum
        end

        this.hata("Beklenmedik ifade başlangıcı: " + token.tip)
    end

    method islec_cagirma(hedef_token) -> IslecCagirma
        -- Parses function call arguments
        -- Grammar: '(' [ifade (COMMA ifade)*]? ')'
        argumanlar;
        argumanlar = []
        this.tuket(TOKEN_TIPLERI["LEFT_PAREN"])  -- '('

        -- If first token is not ')', there are arguments
        if this.mevcut_token.tip != TOKEN_TIPLERI["RIGHT_PAREN"]
            -- First argument (can be complex expression like '5 + 2')
            argumanlar.push(this.ifade())

            -- Remaining arguments (comma-separated)
            while this.mevcut_token.tip == TOKEN_TIPLERI["COMMA"]
                this.tuket(TOKEN_TIPLERI["COMMA"])  -- ','
                argumanlar.push(this.ifade())
            end
        end

        this.tuket(TOKEN_TIPLERI["RIGHT_PAREN"])  -- ')'
        return new IslecCagirma(hedef_token, argumanlar)
    end

    method dizi_erisimi(hedef_token) -> DiziErisim
        -- Grammar: '[' ifade ']'
        this.tuket(TOKEN_TIPLERI["LEFT_BRACKET"])  -- '['

        -- Index can be complex expression like '5 + 2'
        indeks_ifadesi;
        indeks_ifadesi = this.ifade()

        this.tuket(TOKEN_TIPLERI["RIGHT_BRACKET"])  -- ']'

        hedef_node;
        hedef_node = new Degisken(hedef_token)
        return new DiziErisim(hedef_node, indeks_ifadesi)
    end

    method sozluk_erisimi(hedef_token) -> SozlukErisim
        -- Grammar: '{' ifade '}'
        this.tuket(TOKEN_TIPLERI["LEFT_BRACE"])  -- '{'

        -- Key can be complex expression
        anahtar_ifadesi;
        anahtar_ifadesi = this.ifade()

        this.tuket(TOKEN_TIPLERI["RIGHT_BRACE"])  -- '}'

        hedef_node;
        hedef_node = new Degisken(hedef_token)
        return new SozlukErisim(hedef_node, anahtar_ifadesi)
    end

    method terim() -> dynamic
        -- Medium precedence: Multiplication and Division
        -- Grammar: faktor ((MUL | DIV | POWER) faktor)*
        sol_dugum;
        sol_dugum = this.faktor()

        -- Continue as long as *, /, or ** appears
        while this.mevcut_token.tip == TOKEN_TIPLERI["MUL"] or
              this.mevcut_token.tip == TOKEN_TIPLERI["DIV"] or
              this.mevcut_token.tip == TOKEN_TIPLERI["POWER"]

            operator;
            operator = this.mevcut_token
            this.tuket(operator.tip)
            sag_dugum;
            sag_dugum = this.faktor()

            -- Update left node with new operation node
            sol_dugum = new IkiliIslem(sol_dugum, operator, sag_dugum)
        end

        return sol_dugum
    end

    method ifade() -> dynamic
        -- Lowest precedence: Addition, Subtraction, Comparisons
        -- Grammar: terim ((PLUS | MINUS | comparisons) terim)*
        sol_dugum;
        sol_dugum = this.terim()

        while this.mevcut_token.tip == TOKEN_TIPLERI["PLUS"] or
              this.mevcut_token.tip == TOKEN_TIPLERI["MINUS"] or
              this.mevcut_token.tip == TOKEN_TIPLERI["OP_ESIT_KARSILASTIRMA"] or
              this.mevcut_token.tip == TOKEN_TIPLERI["GT"] or
              this.mevcut_token.tip == TOKEN_TIPLERI["LT"] or
              this.mevcut_token.tip == TOKEN_TIPLERI["GTE"] or
              this.mevcut_token.tip == TOKEN_TIPLERI["LTE"]

            operator;
            operator = this.mevcut_token
            this.tuket(operator.tip)
            sag_dugum;
            sag_dugum = this.terim()
            sol_dugum = new IkiliIslem(sol_dugum, operator, sag_dugum)
        end

        return sol_dugum
    end

    -- ===============================================
    -- Statement Parsing
    -- ===============================================

    method komut() -> dynamic
        -- Parses a single statement
        token;
        token = this.mevcut_token

        -- 0. Phase 8: SINIF definition?
        if token.tip == TOKEN_TIPLERI["OOP_SINIF"]
            return this.sinif_tanimlama()
        end

        -- 1. MLP SYNTAX: DEĞIŞKEN name: TYPE = value;
        if token.tip == TOKEN_TIPLERI["TANIMLA_DEGISKEN"]
            return this.mlp_degisken_tanimlama()
        end

        -- 2. Starts with TYPE?
        if token.tip == TOKEN_TIPLERI["TANIMLA_SAYI"] or
           token.tip == TOKEN_TIPLERI["TANIMLA_METIN"] or
           token.tip == TOKEN_TIPLERI["TANIMLA_BOOL"]
            return this.tip_ile_baslayan_komut()
        end

        -- 3. Starts with IŞLEÇ?
        if token.tip == TOKEN_TIPLERI["YAPI_ISLEC"]
            return this.islec_tanimlama(null)
        end

        -- 4. EĞER block?
        if token.tip == TOKEN_TIPLERI["YAPI_KOSUL_EGER"]
            return this.eger_blogu()
        end

        -- 5. YAZDIR statement?
        if token.tip == TOKEN_TIPLERI["YAPI_YAZDIR"]
            return this.yazdir_komutu()
        end

        -- 6. DÖNGÜ block?
        if token.tip == TOKEN_TIPLERI["YAPI_DONGU"]
            return this.dongu_blogu()
        end

        -- 7. DÖNGÜ_BITIR statement?
        if token.tip == TOKEN_TIPLERI["YAPI_DONGU_BITIR"]
            return this.dongu_bitir_komutu()
        end

        -- 8. DÖNÜŞ statement?
        if token.tip == TOKEN_TIPLERI["YAPI_DONUS"]
            return this.donus_komutu()
        end

        -- 9. Assignment OR Function call statement?
        if token.tip == TOKEN_TIPLERI["IDENTIFIER"]
            ifade_dugumu;
            ifade_dugumu = this.ifade()

            -- Case 1: Assignment (s = 10; or d{"key"} = 30;)
            if this.mevcut_token.tip == TOKEN_TIPLERI["ASSIGN"]
                -- Check if target is valid (Degisken, DiziErisim, or SozlukErisim)
                if not (TYPE_OF(ifade_dugumu) == "Degisken" or
                        TYPE_OF(ifade_dugumu) == "DiziErisim" or
                        TYPE_OF(ifade_dugumu) == "SozlukErisim")
                    this.hata("Atama hedefi geçersiz. Hedef bir değişken, dizi elemanı veya sözlük elemanı olmalıdır.")
                end

                this.tuket(TOKEN_TIPLERI["ASSIGN"])  -- '='
                atanan_deger_ifadesi;
                atanan_deger_ifadesi = this.ifade()
                this.tuket(TOKEN_TIPLERI["SEMICOLON"])  -- ';'
                return new AtamaKomutu(ifade_dugumu, atanan_deger_ifadesi)
            end

            -- Case 2: Function call statement (SOZLUK_OLUSTUR(10);)
            if this.mevcut_token.tip == TOKEN_TIPLERI["SEMICOLON"]
                this.tuket(TOKEN_TIPLERI["SEMICOLON"])  -- ';'
                if TYPE_OF(ifade_dugumu) == "IslecCagirma"
                    return new IfadeKomutu(ifade_dugumu)
                else
                    this.hata("Bu ifade tek başına bir komut olamaz: " + string(ifade_dugumu))
                end
            end

            this.hata("Komutun sonunda ';' veya '=' bekleniyordu")
        end

        -- 10. Otherwise it's an error
        this.hata("Tanınmayan komut başlangıcı: " + string(token))
    end

    method degisken_tanimlama(tip_token, ad_token) -> DegiskenTanimlama
        -- Grammar: (tip_token and ad_token already consumed) ASSIGN ifade SEMICOLON
        this.tuket(TOKEN_TIPLERI["ASSIGN"])
        ifade_node;
        ifade_node = this.ifade()
        this.tuket(TOKEN_TIPLERI["SEMICOLON"])
        return new DegiskenTanimlama(tip_token, ad_token, ifade_node)
    end

    method mlp_degisken_tanimlama() -> DegiskenTanimlama
        -- MLP Syntax: DEĞIŞKEN name: TYPE = value;
        this.tuket(TOKEN_TIPLERI["TANIMLA_DEGISKEN"])  -- 'DEĞIŞKEN'

        -- Get name
        ad_token;
        ad_token = this.mevcut_token
        this.tuket(TOKEN_TIPLERI["IDENTIFIER"])

        -- Expect ':'
        this.tuket(TOKEN_TIPLERI["COLON"])

        -- Get type
        tip_token;
        tip_token = this.mevcut_token
        if tip_token.tip == TOKEN_TIPLERI["TANIMLA_SAYI"] or
           tip_token.tip == TOKEN_TIPLERI["TANIMLA_METIN"] or
           tip_token.tip == TOKEN_TIPLERI["TANIMLA_BOOL"] or
           tip_token.tip == TOKEN_TIPLERI["IDENTIFIER"]
            this.tuket(tip_token.tip)
        else
            this.hata("Tip anotasyonu bekleniyor")
        end

        -- Optional initial value
        ifade_node;
        ifade_node = null
        if this.mevcut_token.tip == TOKEN_TIPLERI["ASSIGN"]
            this.tuket(TOKEN_TIPLERI["ASSIGN"])
            ifade_node = this.ifade()
        end

        this.tuket(TOKEN_TIPLERI["SEMICOLON"])
        return new DegiskenTanimlama(tip_token, ad_token, ifade_node)
    end

    method eger_blogu() -> EgerBlogu
        -- EĞER condition İSE statements [DEĞİLSE statements] SON
        this.tuket(TOKEN_TIPLERI["YAPI_KOSUL_EGER"])  -- 'EĞER'
        kosul;
        kosul = this.ifade()
        this.tuket(TOKEN_TIPLERI["YAPI_KOSUL_ISE"])  -- 'İSE'

        -- True block
        dogru_blok;
        dogru_blok = new Blok()
        while this.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] and
              this.mevcut_token.tip != TOKEN_TIPLERI["YAPI_KOSUL_DEGILSE"] and
              this.mevcut_token.tip != TOKEN_TIPLERI["EOF"]
            dogru_blok.komutlar.push(this.komut())
        end

        yanlis_blok;
        yanlis_blok = null

        -- DEĞİLSE block?
        if this.mevcut_token.tip == TOKEN_TIPLERI["YAPI_KOSUL_DEGILSE"]
            this.tuket(TOKEN_TIPLERI["YAPI_KOSUL_DEGILSE"])
            yanlis_blok = new Blok()
            while this.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] and
                  this.mevcut_token.tip != TOKEN_TIPLERI["EOF"]
                yanlis_blok.komutlar.push(this.komut())
            end
        end

        this.tuket(TOKEN_TIPLERI["YAPI_SON"])  -- 'SON'
        return new EgerBlogu(kosul, dogru_blok, yanlis_blok)
    end

    method yazdir_komutu() -> YazdirKomutu
        -- YAZDIR expression;
        this.tuket(TOKEN_TIPLERI["YAPI_YAZDIR"])
        ifade;
        ifade = this.ifade()
        this.tuket(TOKEN_TIPLERI["SEMICOLON"])
        return new YazdirKomutu(ifade)
    end

    method dongu_blogu() -> DonguBlogu
        -- DÖNGÜ statements SON
        this.tuket(TOKEN_TIPLERI["YAPI_DONGU"])

        blok;
        blok = new Blok()
        while this.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] and
              this.mevcut_token.tip != TOKEN_TIPLERI["EOF"]
            blok.komutlar.push(this.komut())
        end

        this.tuket(TOKEN_TIPLERI["YAPI_SON"])
        return new DonguBlogu(blok)
    end

    method dongu_bitir_komutu() -> DonguBitirKomutu
        -- DÖNGÜ_BITIR;
        this.tuket(TOKEN_TIPLERI["YAPI_DONGU_BITIR"])
        this.tuket(TOKEN_TIPLERI["SEMICOLON"])
        return new DonguBitirKomutu()
    end

    method donus_komutu() -> DonusKomutu
        -- DÖNÜŞ expression;
        this.tuket(TOKEN_TIPLERI["YAPI_DONUS"])
        ifade;
        ifade = this.ifade()
        this.tuket(TOKEN_TIPLERI["SEMICOLON"])
        return new DonusKomutu(ifade)
    end

    method tip_ile_baslayan_komut() -> dynamic
        -- Distinguishes commands starting with type (SAYISAL, METİN...)
        -- - SAYISAL İŞLEÇ topla...
        -- - SAYISAL liste[10];
        -- - SAYISAL s = 10;
        tip_token;
        tip_token = this.mevcut_token
        this.tuket(tip_token.tip)

        -- Case 1: SAYISAL İŞLEÇ ...
        if this.mevcut_token.tip == TOKEN_TIPLERI["YAPI_ISLEC"]
            return this.islec_tanimlama(tip_token)
        end

        -- Case 2 & 3: SAYISAL s ... (Variable or Array)
        if this.mevcut_token.tip == TOKEN_TIPLERI["IDENTIFIER"]
            ad_token;
            ad_token = this.mevcut_token
            this.tuket(TOKEN_TIPLERI["IDENTIFIER"])

            -- Case 2: SAYISAL liste[ ...
            if this.mevcut_token.tip == TOKEN_TIPLERI["LEFT_BRACKET"]
                return this.dizi_tanimlama(tip_token, ad_token)
            end

            -- Case 3: SAYISAL s = ...
            if this.mevcut_token.tip == TOKEN_TIPLERI["ASSIGN"]
                return this.degisken_tanimlama(tip_token, ad_token)
            end

            this.hata("Değişken adından sonra '[' veya '=' bekleniyordu")
        end

        this.hata("Tip tanımından sonra 'İŞLEÇ' veya değişken adı bekleniyordu")
    end

    method dizi_tanimlama(tip_token, ad_token) -> DiziTanimlama
        -- Grammar: (tip_token and ad_token already consumed) '[' ifade ']' SEMICOLON
        this.tuket(TOKEN_TIPLERI["LEFT_BRACKET"])
        boyut_ifadesi;
        boyut_ifadesi = this.ifade()
        this.tuket(TOKEN_TIPLERI["RIGHT_BRACKET"])
        this.tuket(TOKEN_TIPLERI["SEMICOLON"])
        return new DiziTanimlama(tip_token, ad_token, boyut_ifadesi)
    end

    method parametre_listesi() -> array
        -- ( [TYPE IDENTIFIER (COMMA TYPE IDENTIFIER)*]? )
        parametreler;
        parametreler = []
        this.tuket(TOKEN_TIPLERI["LEFT_PAREN"])  -- '('

        -- If first token is not ')', there are parameters
        if this.mevcut_token.tip != TOKEN_TIPLERI["RIGHT_PAREN"]
            -- First parameter
            tip_token;
            tip_token = this.mevcut_token
            if tip_token.tip != TOKEN_TIPLERI["TANIMLA_SAYI"] and
               tip_token.tip != TOKEN_TIPLERI["TANIMLA_METIN"] and
               tip_token.tip != TOKEN_TIPLERI["TANIMLA_BOOL"]
                this.hata("Parametre tipi bekleniyordu (SAYISAL, METİN vb.)")
            end
            this.tuket(tip_token.tip)

            ad_token;
            ad_token = this.mevcut_token
            this.tuket(TOKEN_TIPLERI["IDENTIFIER"])
            parametreler.push(new Parametre(tip_token, ad_token))

            -- Remaining parameters (comma-separated)
            while this.mevcut_token.tip == TOKEN_TIPLERI["COMMA"]
                this.tuket(TOKEN_TIPLERI["COMMA"])

                tip_token = this.mevcut_token
                if tip_token.tip != TOKEN_TIPLERI["TANIMLA_SAYI"] and
                   tip_token.tip != TOKEN_TIPLERI["TANIMLA_METIN"] and
                   tip_token.tip != TOKEN_TIPLERI["TANIMLA_BOOL"]
                    this.hata("Parametre tipi bekleniyordu")
                end
                this.tuket(tip_token.tip)

                ad_token = this.mevcut_token
                this.tuket(TOKEN_TIPLERI["IDENTIFIER"])
                parametreler.push(new Parametre(tip_token, ad_token))
            end
        end

        this.tuket(TOKEN_TIPLERI["RIGHT_PAREN"])  -- ')'
        return parametreler
    end

    method islec_tanimlama(donus_tipi_token) -> IslecTanimlama
        -- [TYPE]? İŞLEÇ IDENTIFIER ( parameters ) statements SON
        this.tuket(TOKEN_TIPLERI["YAPI_ISLEC"])  -- 'İŞLEÇ'

        ad_token;
        ad_token = this.mevcut_token
        this.tuket(TOKEN_TIPLERI["IDENTIFIER"])

        parametreler;
        parametreler = this.parametre_listesi()

        -- Function body
        govde;
        govde = new Blok()
        while this.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] and
              this.mevcut_token.tip != TOKEN_TIPLERI["EOF"]
            govde.komutlar.push(this.komut())
        end

        this.tuket(TOKEN_TIPLERI["YAPI_SON"])  -- 'SON'
        return new IslecTanimlama(ad_token, parametreler, govde, donus_tipi_token)
    end

    method parse() -> Blok
        -- Parses entire program and returns AST root (a Block)
        ana_blok;
        ana_blok = new Blok()

        -- Read all statements until EOF
        while this.mevcut_token.tip != TOKEN_TIPLERI["EOF"]
            ana_blok.komutlar.push(this.komut())
        end

        return ana_blok
    end

    -- ===============================================
    -- Phase 8: OOP Support
    -- ===============================================

    method sinif_tanimlama() -> SinifTanimlama
        -- Parses SINIF definition
        this.tuket(TOKEN_TIPLERI["OOP_SINIF"])  -- 'SINIF'

        sinif_adi;
        sinif_adi = this.mevcut_token
        this.tuket(TOKEN_TIPLERI["IDENTIFIER"])

        ozellikler;
        ozellikler = []
        kurucu;
        kurucu = null
        metodlar;
        metodlar = []

        -- Parse SINIF body (until SON)
        while this.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] and
              this.mevcut_token.tip != TOKEN_TIPLERI["EOF"]

            -- ÖZELLIK definition?
            if this.mevcut_token.tip == TOKEN_TIPLERI["OOP_OZELLIK"]
                ozellikler.push(this.ozellik_tanimlama())
            end

            -- KURUCU definition?
            if this.mevcut_token.tip == TOKEN_TIPLERI["OOP_KURUCU"]
                kurucu = this.kurucu_tanimlama()
            end

            -- IŞLEÇ (method) definition?
            if this.mevcut_token.tip == TOKEN_TIPLERI["TANIMLA_SAYI"] or
               this.mevcut_token.tip == TOKEN_TIPLERI["TANIMLA_METIN"] or
               this.mevcut_token.tip == TOKEN_TIPLERI["TANIMLA_BOOL"]
                tip_token;
                tip_token = this.mevcut_token
                this.tuket(this.mevcut_token.tip)

                if this.mevcut_token.tip == TOKEN_TIPLERI["YAPI_ISLEC"]
                    metodlar.push(this.islec_tanimlama(tip_token))
                else
                    this.hata("SINIF içinde tip token'dan sonra IŞLEÇ bekleniyor")
                end
            end
        end

        this.tuket(TOKEN_TIPLERI["YAPI_SON"])  -- 'SON'
        return new SinifTanimlama(sinif_adi, ozellikler, kurucu, metodlar)
    end

    method ozellik_tanimlama() -> OzellikTanimlama
        -- Parses ÖZELLIK TYPE name; format
        this.tuket(TOKEN_TIPLERI["OOP_OZELLIK"])  -- 'ÖZELLIK'

        tip_token;
        tip_token = this.mevcut_token
        if this.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_SAYI"] and
           this.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_METIN"] and
           this.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_BOOL"]
            this.hata("ÖZELLIK'ten sonra tip bekleniyor")
        end
        this.tuket(this.mevcut_token.tip)

        ad_token;
        ad_token = this.mevcut_token
        this.tuket(TOKEN_TIPLERI["IDENTIFIER"])
        this.tuket(TOKEN_TIPLERI["SEMICOLON"])

        return new OzellikTanimlama(tip_token, ad_token, null)
    end

    method kurucu_tanimlama() -> KurucuTanimlama
        -- Parses KURUCU(parameters) ... SON format
        this.tuket(TOKEN_TIPLERI["OOP_KURUCU"])  -- 'KURUCU'
        this.tuket(TOKEN_TIPLERI["LEFT_PAREN"])  -- '('

        parametreler;
        parametreler = []
        if this.mevcut_token.tip != TOKEN_TIPLERI["RIGHT_PAREN"]
            parametreler.push(this.parametre())

            while this.mevcut_token.tip == TOKEN_TIPLERI["COMMA"]
                this.tuket(TOKEN_TIPLERI["COMMA"])
                parametreler.push(this.parametre())
            end
        end

        this.tuket(TOKEN_TIPLERI["RIGHT_PAREN"])  -- ')'

        -- Constructor body
        govde;
        govde = new Blok()
        while this.mevcut_token.tip != TOKEN_TIPLERI["YAPI_SON"] and
              this.mevcut_token.tip != TOKEN_TIPLERI["EOF"]
            govde.komutlar.push(this.komut())
        end

        this.tuket(TOKEN_TIPLERI["YAPI_SON"])  -- 'SON'
        return new KurucuTanimlama(parametreler, govde)
    end

    method parametre() -> Parametre
        -- Parses TYPE name format (function parameter)
        tip_token;
        tip_token = this.mevcut_token
        if this.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_SAYI"] and
           this.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_METIN"] and
           this.mevcut_token.tip != TOKEN_TIPLERI["TANIMLA_BOOL"]
            this.hata("Parametre tipinde SAYISAL, METIN veya ZITLIK bekleniyor")
        end
        this.tuket(this.mevcut_token.tip)

        ad_token;
        ad_token = this.mevcut_token
        this.tuket(TOKEN_TIPLERI["IDENTIFIER"])
        return new Parametre(tip_token, ad_token)
    end
end
