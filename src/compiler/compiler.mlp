-- ===============================================
-- MLP Compiler Main Entry Point
-- ===============================================
-- Transpiled from: TYD-MLP/src/compiler.py
-- Date: 2025-11-14
-- Main compiler orchestration: Lexer → Parser → Generator

KULLAN std.io
KULLAN std.args
KULLAN lexer.lexer
KULLAN parser.parser
KULLAN ast.ast_nodes
KULLAN codegen.generator

-- ===============================================
-- AST Debug Printing (for debugging)
-- ===============================================
method ast_yazdir(node, girinti)
    -- Visualizes AST structure
    -- Currently not called in calistir, but can be used for debugging

    if TYPE_OF(node) == "Blok"
        YAZDIR(girinti + "Blok:")
        for komut in node.komutlar
            ast_yazdir(komut, girinti + "  ")
        end
    end

    if TYPE_OF(node) == "DegiskenTanimlama"
        YAZDIR(girinti + "DegiskenTanimlama: Tip=" + node.tip.deger + ", Ad=" + node.ad.deger)
        YAZDIR(girinti + "  Atanan Deger:")
        ast_yazdir(node.ifade, girinti + "    ")
    end

    if TYPE_OF(node) == "DiziTanimlama"
        YAZDIR(girinti + "Dizi Tanımlama: " + node.ad.deger + " (Tip: " + node.tip.deger + ")")
        YAZDIR(girinti + "  Boyut:")
        ast_yazdir(node.boyut, girinti + "    ")
    end

    if TYPE_OF(node) == "AtamaKomutu"
        YAZDIR(girinti + "Atama Komutu:")
        YAZDIR(girinti + "  Hedef (Değişken):")
        ast_yazdir(node.hedef, girinti + "    ")
        YAZDIR(girinti + "  Atanan Deger (İfade):")
        ast_yazdir(node.ifade, girinti + "    ")
    end

    if TYPE_OF(node) == "EgerBlogu"
        YAZDIR(girinti + "EGER Blogu:")
        YAZDIR(girinti + "  Kosul:")
        ast_yazdir(node.kosul, girinti + "    ")
        YAZDIR(girinti + "  Dogruysa Yapilacaklar (IF):")
        ast_yazdir(node.dogru_blok, girinti + "    ")
        if node.yanlis_blok != null
            YAZDIR(girinti + "  Degilse Yapilacaklar (ELSE):")
            ast_yazdir(node.yanlis_blok, girinti + "    ")
        end
    end

    if TYPE_OF(node) == "DonguBlogu"
        YAZDIR(girinti + "DÖNGÜ Blogu:")
        YAZDIR(girinti + "  Döngü İçi Komutlar:")
        ast_yazdir(node.blok, girinti + "    ")
    end

    if TYPE_OF(node) == "DonguBitirKomutu"
        YAZDIR(girinti + "DÖNGÜ_BITIR Komutu (break)")
    end

    if TYPE_OF(node) == "YazdirKomutu"
        YAZDIR(girinti + "YAZDIR Komutu:")
        YAZDIR(girinti + "  Yazdırılacak İfade:")
        ast_yazdir(node.ifade, girinti + "    ")
    end

    if TYPE_OF(node) == "IfadeKomutu"
        YAZDIR(girinti + "İfade Komutu (Procedure Call):")
        ast_yazdir(node.ifade, girinti + "    ")
    end

    if TYPE_OF(node) == "IslecTanimlama"
        donus_tipi;
        donus_tipi = node.donus_tipi != null ? node.donus_tipi.deger : "HİÇLİK"
        YAZDIR(girinti + "İŞLEÇ Tanımlama: " + node.ad.deger + " (Dönüş Tipi: " + donus_tipi + ")")
        YAZDIR(girinti + "  Parametreler:")
        if UZUNLUK(node.parametreler) == 0
            YAZDIR(girinti + "    (Yok)")
        else
            for param in node.parametreler
                ast_yazdir(param, girinti + "    ")
            end
        end
        YAZDIR(girinti + "  Gövde:")
        ast_yazdir(node.govde, girinti + "    ")
    end

    if TYPE_OF(node) == "Parametre"
        YAZDIR(girinti + "Parametre: " + node.ad.deger + " (Tip: " + node.tip.deger + ")")
    end

    if TYPE_OF(node) == "DonusKomutu"
        YAZDIR(girinti + "DÖNÜŞ Komutu:")
        YAZDIR(girinti + "  Döndürülecek İfade:")
        ast_yazdir(node.ifade, girinti + "    ")
    end

    if TYPE_OF(node) == "IslecCagirma"
        YAZDIR(girinti + "İŞLEÇ Çağırma: " + node.hedef_token.deger)
        YAZDIR(girinti + "  Argümanlar:")
        if UZUNLUK(node.argumanlar) == 0
            YAZDIR(girinti + "    (Yok)")
        else
            for arg in node.argumanlar
                ast_yazdir(arg, girinti + "    ")
            end
        end
    end

    if TYPE_OF(node) == "DiziErisim"
        YAZDIR(girinti + "Dizi Erişimi:")
        YAZDIR(girinti + "  Hedef:")
        ast_yazdir(node.hedef, girinti + "    ")
        YAZDIR(girinti + "  İndeks:")
        ast_yazdir(node.indeks, girinti + "    ")
    end

    if TYPE_OF(node) == "Sayi"
        YAZDIR(girinti + "Sayi: " + string(node.deger))
    end

    if TYPE_OF(node) == "Metin"
        YAZDIR(girinti + "Metin: " + node.deger)
    end

    if TYPE_OF(node) == "Degisken"
        YAZDIR(girinti + "DegiskenReferansi: " + node.ad)
    end

    if TYPE_OF(node) == "IkiliIslem"
        YAZDIR(girinti + "Islem: " + node.operator.tip)
        YAZDIR(girinti + "  Sol:")
        ast_yazdir(node.sol, girinti + "    ")
        YAZDIR(girinti + "  Sag:")
        ast_yazdir(node.sag, girinti + "    ")
    end

    -- If none of the above, unknown node
    YAZDIR(girinti + "Bilinmeyen Dugum: " + TYPE_OF(node))
end

-- ===============================================
-- Main Compiler Function
-- ===============================================
method calistir(dosya_adi, dil_json_yolu, dil_kodu)
    -- Main compiler pipeline: File → Lexer → Parser → Generator → Assembly

    -- File Reading
    kaynak_kodu;
    kaynak_kodu = ""
    try
        kaynak_kodu = DOSYA_OKU(dosya_adi)
    catch e
        YAZDIR("HATA: Dosya okunamadı: " + string(e))
        CIKIS(1)
    end

    YAZDIR("--- KAYNAK KOD (" + dosya_adi + ") ---")
    YAZDIR(kaynak_kodu)
    YAZDIR("----------------------------------------")

    -- 1. Lexer (Tokenization)
    lexer;
    lexer = null
    try
        lexer = new Lexer(kaynak_kodu, dil_json_yolu, dil_kodu)
    catch e
        YAZDIR("HATA (Lexer): " + string(e))
        CIKIS(1)
    end

    -- 2. Parser (AST Generation)
    YAZDIR("\n--- PARSER (AST) ---")
    ast;
    ast = null
    try
        parser;
        parser = new Parser(lexer)
        ast = parser.parse()
        YAZDIR("✅ Ayrıştırma Başarılı!")
    catch e
        YAZDIR("\n!!! HATA (Parser): " + string(e))
        CIKIS(1)
    end

    -- 3. Generator (Assembly Code Generation)
    YAZDIR("\n--- GENERATOR (ASM) ---")
    try
        generator;
        generator = new Generator(ast)
        asm_kodu;
        asm_kodu = generator.generate()

        YAZDIR(asm_kodu)  -- Print generated Assembly code

        output_asm_file;
        output_asm_file = "build/output.asm"

        -- Ensure 'build' directory exists
        DIZIN_OLUSTUR("build")

        -- Write Assembly code to file
        DOSYA_YAZ(output_asm_file, asm_kodu)

        YAZDIR("\n✅ Assembly Kodu Başarıyla Üretildi -> " + output_asm_file)
    catch e
        YAZDIR("\n!!! HATA (Generator): " + string(e))
        CIKIS(1)
    end
end

-- ===============================================
-- Command Line Entry Point
-- ===============================================
method main()
    -- Parse command line arguments and run compiler

    args;
    args = PROGRAM_ARGS()

    -- Simple argument parsing (MLP doesn't have argparse, so manual)
    if UZUNLUK(args) < 2
        YAZDIR("Kullanım: mlp <kaynak.tyd> [diller.json] [--dil-kodu tr-TR]")
        YAZDIR("")
        YAZDIR("Örnek:")
        YAZDIR("  mlp test.tyd")
        YAZDIR("  mlp test.tyd kurallar/diller.json")
        YAZDIR("  mlp test.tyd kurallar/diller.json --dil-kodu tr-TR")
        CIKIS(1)
    end

    dosya_adi;
    dosya_adi = args[1]
    dil_json_yolu;
    dil_json_yolu = "kurallar/diller.json"
    dil_kodu;
    dil_kodu = "tr-TR"

    -- Parse optional arguments
    if UZUNLUK(args) >= 3
        dil_json_yolu = args[2]
    end

    if UZUNLUK(args) >= 5 and args[3] == "--dil-kodu"
        dil_kodu = args[4]
    end

    -- Run compiler
    calistir(dosya_adi, dil_json_yolu, dil_kodu)
end

-- Run main if this is the entry point
main()
