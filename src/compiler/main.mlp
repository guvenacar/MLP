-- ===============================================
-- MLP Compiler Entry Point
-- ===============================================
-- This is the main entry point for the MLP compiler
-- Written in MLP itself (self-hosting!)

KULLAN lexer;
KULLAN parser;
KULLAN semantic;
KULLAN optimizer;
KULLAN codegen;
KULLAN std.io;
KULLAN std.args;

IŞLEÇ main(DİZİ<METIN> args) -> SAYISAL
    -- Parse command line arguments
    EĞER UZUNLUK args < 2 İSE
        print_usage();
        DÖNÜŞ 1;
    EĞER SON

    METIN input_file = args[1];
    METIN output_file = "output";

    -- Parse optional flags
    config = parse_flags(args);

    YAZDIR "MLP Compiler v0.1.0";
    YAZDIR "Compiling: " + input_file;

    -- Stage 1: Lexical Analysis
    YAZDIR "[1/5] Lexical analysis...";
    DİZİ<Token> tokens = lexer.tokenize_file(input_file);

    EĞER config.verbose İSE
        YAZDIR "  Tokens: " + UZUNLUK tokens;
    EĞER SON

    -- Stage 2: Parsing
    YAZDIR "[2/5] Parsing...";
    AST ast = parser.parse(tokens);

    EĞER config.dump_ast İSE
        ast.print_debug();
    EĞER SON

    -- Stage 3: Semantic Analysis
    YAZDIR "[3/5] Semantic analysis...";
    semantic.analyze(ast);

    -- Stage 4: Optimization
    EĞER config.optimize İSE
        YAZDIR "[4/5] Optimizing...";
        ast = optimizer.optimize(ast);
    DEĞILSE
        YAZDIR "[4/5] Optimization skipped";
    EĞER SON

    -- Stage 5: Code Generation
    YAZDIR "[5/5] Generating code...";
    METIN code = codegen.generate(ast, config.backend);

    -- Write output
    io.write_file(output_file + ".asm", code);

    YAZDIR "✅ Compilation successful!";
    YAZDIR "Output: " + output_file + ".asm";

    DÖNÜŞ 0;
IŞLEÇ SON

IŞLEÇ print_usage()
    YAZDIR "Usage: mlp <input-file> [options]";
    YAZDIR "";
    YAZDIR "Options:";
    YAZDIR "  -o <file>       Output file name";
    YAZDIR "  -O              Enable optimization";
    YAZDIR "  --backend=asm   Code generation backend (asm|llvm|wasm)";
    YAZDIR "  --dump-ast      Print AST for debugging";
    YAZDIR "  --verbose       Verbose output";
    YAZDIR "  --help          Show this help";
IŞLEÇ SON

YAPI CompilerConfig
    METIN backend;
    ZITLIK optimize;
    ZITLIK verbose;
    ZITLIK dump_ast;
YAPI SON

IŞLEÇ parse_flags(DİZİ<METIN> args) -> CompilerConfig
    config = CompilerConfig{
        backend: "asm",
        optimize: YANLIŞ,
        verbose: YANLIŞ,
        dump_ast: YANLIŞ
    };

    HER (index, arg) İÇİNDE args
        EĞER index < 2 İSE
            DÖNGÜ_DEVAM;  -- Skip program name and input file
        EĞER SON

        EŞLEŞTIR arg
            DURUM "-O"
                config.optimize = DOĞRU;
            DURUM "--verbose"
                config.verbose = DOĞRU;
            DURUM "--dump-ast"
                config.dump_ast = DOĞRU;
            VARSAYILAN
                EĞER arg.starts_with("--backend=") İSE
                    config.backend = arg.substring(10);
                EĞER SON
        EŞLEŞTIR SON
    HER SON

    DÖNÜŞ config;
IŞLEÇ SON

-- Entry point
main(std.args.get());
