-- ===============================================
-- MLP AST Node Definitions
-- ===============================================
-- Transpiled from: TYD-MLP/src/ast_nodes.py
-- Date: 2025-11-14
-- All AST node types for the MLP compiler

-- ===============================================
-- Base AST Node
-- ===============================================
class ASTNode
    -- Base class for all AST nodes
    -- No fields needed - just for inheritance
end

-- ===============================================
-- Expressions (produce values)
-- ===============================================

class Sayi : ASTNode
    -- Represents a numeric value (10, 3.14)
    token dynamic
    deger dynamic

    constructor(token)
        this.token = token
        this.deger = token.deger
    end
end

class Metin : ASTNode
    -- Represents a string value ("hello")
    token dynamic
    deger dynamic

    constructor(token)
        this.token = token
        this.deger = token.deger
    end
end

class Degisken : ASTNode
    -- Represents variable usage (a, topla)
    token dynamic
    ad string

    constructor(token)
        this.token = token
        this.ad = token.deger
    end
end

class IkiliIslem : ASTNode
    -- Represents binary operation (a + b, s > 10)
    sol dynamic     -- Left side (ASTNode)
    operator dynamic -- Operator token (+, -, >, ESIT)
    sag dynamic     -- Right side (ASTNode)

    constructor(sol, operator_token, sag)
        this.sol = sol
        this.operator = operator_token
        this.sag = sag
    end
end

-- ===============================================
-- Statements (perform actions)
-- ===============================================

class DegiskenTanimlama : ASTNode
    -- Variable declaration (SAYISAL s = 10;)
    tip dynamic      -- Type token (SAYISAL, METIN, etc.)
    ad string        -- Variable name ('s')
    ifade dynamic    -- Assigned value AST (10)

    constructor(tip_token, degisken_adi_token, ifade_node)
        this.tip = tip_token
        this.ad = degisken_adi_token.deger
        this.ifade = ifade_node
    end
end

class Blok : ASTNode
    -- Block containing multiple statements ({ ... })
    komutlar array

    constructor()
        this.komutlar = []
    end
end

class EgerBlogu : ASTNode
    -- IF condition THEN block [ELSE block] END
    kosul dynamic        -- Condition node
    dogru_blok dynamic   -- True block
    yanlis_blok dynamic  -- False block (can be null)

    constructor(kosul_node, dogru_blok_node, yanlis_blok_node)
        this.kosul = kosul_node
        this.dogru_blok = dogru_blok_node
        this.yanlis_blok = yanlis_blok_node
    end
end

class YazdirKomutu : ASTNode
    -- PRINT expression; statement
    ifade dynamic

    constructor(ifade_node)
        this.ifade = ifade_node
    end
end

class AtamaKomutu : ASTNode
    -- Assignment to existing variable (s = s + 1;)
    hedef dynamic    -- Target variable
    ifade dynamic    -- Assigned expression

    constructor(hedef_node, ifade_node)
        this.hedef = hedef_node
        this.ifade = ifade_node
    end
end

class DonguBlogu : ASTNode
    -- LOOP ... END block
    blok dynamic

    constructor(blok_node)
        this.blok = blok_node
    end
end

class DonguBitirKomutu : ASTNode
    -- BREAK; statement
    -- No additional data needed
    constructor()
    end
end

class Parametre : ASTNode
    -- Single parameter in function definition (SAYISAL a)
    tip dynamic
    ad dynamic

    constructor(tip_token, ad_token)
        this.tip = tip_token
        this.ad = ad_token
    end
end

class IslecTanimlama : ASTNode
    -- Function definition (ISLEC ... END)
    ad dynamic              -- Function name token
    parametreler array      -- Parameter list
    govde dynamic           -- Body block
    donus_tipi dynamic      -- Optional return type

    constructor(ad_token, parametreler_list, govde_node, donus_tipi_token)
        this.ad = ad_token
        this.parametreler = parametreler_list
        this.govde = govde_node
        this.donus_tipi = donus_tipi_token
    end
end

class DonusKomutu : ASTNode
    -- RETURN expression; statement
    ifade dynamic

    constructor(ifade_node)
        this.ifade = ifade_node
    end
end

class IslecCagirma : ASTNode
    -- Function call (topla(5, 10))
    hedef_token dynamic     -- Function name token
    argumanlar array        -- Argument list

    constructor(hedef_token, argumanlar_listesi)
        this.hedef_token = hedef_token
        this.argumanlar = argumanlar_listesi
    end
end

class IfadeKomutu : ASTNode
    -- Expression as statement (selam_ver();)
    ifade dynamic

    constructor(ifade_node)
        this.ifade = ifade_node
    end
end

class DiziTanimlama : ASTNode
    -- Array declaration (SAYISAL liste[10];)
    tip dynamic
    ad dynamic
    boyut dynamic

    constructor(tip_token, ad_token, boyut_node)
        this.tip = tip_token
        this.ad = ad_token
        this.boyut = boyut_node
    end
end

class DiziErisim : ASTNode
    -- Array element access (liste[3])
    hedef dynamic    -- Array variable
    indeks dynamic   -- Index expression

    constructor(hedef_node, indeks_node)
        this.hedef = hedef_node
        this.indeks = indeks_node
    end
end

class SozlukErisim : ASTNode
    -- Dictionary element access (sozluk{"key"})
    hedef dynamic     -- Dictionary variable
    anahtar dynamic   -- Key expression

    constructor(hedef_node, anahtar_node)
        this.hedef = hedef_node
        this.anahtar = anahtar_node
    end

    override method toString() -> string
        return "SozlukErisim(hedef=" + this.hedef.ad + ", anahtar=" + string(this.anahtar) + ")"
    end
end

-- ===============================================
-- OOP Structures (Phase 8)
-- ===============================================

class OzellikTanimlama : ASTNode
    -- Class field definition (ÖZELLIK tip ad;)
    tip dynamic              -- Type token (SAYISAL, METIN, etc.)
    ad string                -- Field name
    varsayilan_deger dynamic -- Optional default value

    constructor(tip_token, ad_token, varsayilan_deger)
        this.tip = tip_token
        this.ad = ad_token.deger
        this.varsayilan_deger = varsayilan_deger
    end
end

class KurucuTanimlama : ASTNode
    -- Constructor definition (KURUCU(params) ... SON)
    parametreler array   -- Parameter list
    govde dynamic        -- Body block

    constructor(parametreler_list, govde_node)
        this.parametreler = parametreler_list
        this.govde = govde_node
    end
end

class SinifTanimlama : ASTNode
    -- Class definition (SINIF ad ... SON)
    ad string            -- Class name
    ozellikler array     -- OzellikTanimlama list
    kurucu dynamic       -- KurucuTanimlama (optional)
    metodlar array       -- IslecTanimlama list (methods)

    constructor(ad_token, ozellikler_list, kurucu_node, metodlar_list)
        this.ad = ad_token.deger
        this.ozellikler = ozellikler_list
        this.kurucu = kurucu_node
        this.metodlar = metodlar_list
    end
end
