-- ===============================================
-- MLP AST Node Definitions
-- ===============================================
-- Transpiled from: TYD-MLP/src/ast_nodes.py
-- Date: 2025-11-14
-- All AST node types for the MLP compiler

-- ===============================================
-- Base AST Node
-- ===============================================
SINIF ASTNode
    -- Base SINIF for all AST nodes
    -- No fields needed - just for inheritance
SON

-- ===============================================
-- Expressions (produce values)
-- ===============================================

SINIF Sayi : ASTNode
    -- Represents a numeric value (10, 3.14)
    token DİNAMİK
    deger DİNAMİK

    KURUCU(token)
        BU.token = token
        BU.deger = token.deger
    SON
SON

SINIF Metin : ASTNode
    -- Represents a METIN value ("hello")
    token DİNAMİK
    deger DİNAMİK

    KURUCU(token)
        BU.token = token
        BU.deger = token.deger
    SON
SON

SINIF Degisken : ASTNode
    -- Represents variable usage (a, topla)
    token DİNAMİK
    ad METIN

    KURUCU(token)
        BU.token = token
        BU.ad = token.deger
    SON
SON

SINIF IkiliIslem : ASTNode
    -- Represents binary operation (a + b, s > 10)
    sol DİNAMİK     -- Left side (ASTNode)
    operator DİNAMİK -- Operator token (+, -, >, ESIT)
    sag DİNAMİK     -- Right side (ASTNode)

    KURUCU(sol, operator_token, sag)
        BU.sol = sol
        BU.operator = operator_token
        BU.sag = sag
    SON
SON

-- ===============================================
-- Statements (perform actions)
-- ===============================================

SINIF DegiskenTanimlama : ASTNode
    -- Variable declaration (SAYISAL s = 10;)
    tip DİNAMİK      -- Type token (SAYISAL, METIN, etc.)
    ad METIN        -- Variable name ('s')
    ifade DİNAMİK    -- Assigned value AST (10)

    KURUCU(tip_token, degisken_adi_token, ifade_node)
        BU.tip = tip_token
        BU.ad = degisken_adi_token.deger
        BU.ifade = ifade_node
    SON
SON

SINIF Blok : ASTNode
    -- Block containing multiple statements ({ ... })
    komutlar DİZİ

    KURUCU()
        BU.komutlar = []
    SON
SON

SINIF EgerBlogu : ASTNode
    -- IF condition THEN block [ELSE block] END
    kosul DİNAMİK        -- Condition node
    dogru_blok DİNAMİK   -- True block
    yanlis_blok DİNAMİK  -- False block (can be HİÇLİK)

    KURUCU(kosul_node, dogru_blok_node, yanlis_blok_node)
        BU.kosul = kosul_node
        BU.dogru_blok = dogru_blok_node
        BU.yanlis_blok = yanlis_blok_node
    SON
SON

SINIF YazdirKomutu : ASTNode
    -- PRINT expression; statement
    ifade DİNAMİK

    KURUCU(ifade_node)
        BU.ifade = ifade_node
    SON
SON

SINIF AtamaKomutu : ASTNode
    -- Assignment to existing variable (s = s + 1;)
    hedef DİNAMİK    -- Target variable
    ifade DİNAMİK    -- Assigned expression

    KURUCU(hedef_node, ifade_node)
        BU.hedef = hedef_node
        BU.ifade = ifade_node
    SON
SON

SINIF DonguBlogu : ASTNode
    -- LOOP ... END block
    blok DİNAMİK

    KURUCU(blok_node)
        BU.blok = blok_node
    SON
SON

SINIF DonguBitirKomutu : ASTNode
    -- BREAK; statement
    -- No additional data needed
    KURUCU()
    SON
SON

SINIF Parametre : ASTNode
    -- Single parameter in function definition (SAYISAL a)
    tip DİNAMİK
    ad DİNAMİK

    KURUCU(tip_token, ad_token)
        BU.tip = tip_token
        BU.ad = ad_token
    SON
SON

SINIF IslecTanimlama : ASTNode
    -- Function definition (ISLEC ... END)
    ad DİNAMİK              -- Function name token
    parametreler DİZİ      -- Parameter list
    govde DİNAMİK           -- Body block
    donus_tipi DİNAMİK      -- Optional DÖNÜŞ type

    KURUCU(ad_token, parametreler_list, govde_node, donus_tipi_token)
        BU.ad = ad_token
        BU.parametreler = parametreler_list
        BU.govde = govde_node
        BU.donus_tipi = donus_tipi_token
    SON
SON

SINIF DonusKomutu : ASTNode
    -- RETURN expression; statement
    ifade DİNAMİK

    KURUCU(ifade_node)
        BU.ifade = ifade_node
    SON
SON

SINIF IslecCagirma : ASTNode
    -- Function call (topla(5, 10))
    hedef_token DİNAMİK     -- Function name token
    argumanlar DİZİ        -- Argument list

    KURUCU(hedef_token, argumanlar_listesi)
        BU.hedef_token = hedef_token
        BU.argumanlar = argumanlar_listesi
    SON
SON

SINIF IfadeKomutu : ASTNode
    -- Expression as statement (selam_ver();)
    ifade DİNAMİK

    KURUCU(ifade_node)
        BU.ifade = ifade_node
    SON
SON

SINIF DiziTanimlama : ASTNode
    -- Array declaration (SAYISAL liste[10];)
    tip DİNAMİK
    ad DİNAMİK
    boyut DİNAMİK

    KURUCU(tip_token, ad_token, boyut_node)
        BU.tip = tip_token
        BU.ad = ad_token
        BU.boyut = boyut_node
    SON
SON

SINIF DiziErisim : ASTNode
    -- Array element access (liste[3])
    hedef DİNAMİK    -- Array variable
    indeks DİNAMİK   -- Index expression

    KURUCU(hedef_node, indeks_node)
        BU.hedef = hedef_node
        BU.indeks = indeks_node
    SON
SON

SINIF SozlukErisim : ASTNode
    -- Dictionary element access (sozluk{"key"})
    hedef DİNAMİK     -- Dictionary variable
    anahtar DİNAMİK   -- Key expression

    KURUCU(hedef_node, anahtar_node)
        BU.hedef = hedef_node
        BU.anahtar = anahtar_node
    SON

    ÜZERİNE_YAZ IŞLEÇ toString() -> METIN
        DÖNÜŞ "SozlukErisim(hedef=" + BU.hedef.ad + ", anahtar=" + METIN(BU.anahtar) + ")"
    SON
SON

-- ===============================================
-- OOP Structures (Phase 8)
-- ===============================================

SINIF OzellikTanimlama : ASTNode
    -- Class field definition (ÖZELLIK tip ad;)
    tip DİNAMİK              -- Type token (SAYISAL, METIN, etc.)
    ad METIN                -- Field name
    varsayilan_deger DİNAMİK -- Optional default value

    KURUCU(tip_token, ad_token, varsayilan_deger)
        BU.tip = tip_token
        BU.ad = ad_token.deger
        BU.varsayilan_deger = varsayilan_deger
    SON
SON

SINIF KurucuTanimlama : ASTNode
    -- Constructor definition (KURUCU(params) ... SON)
    parametreler DİZİ   -- Parameter list
    govde DİNAMİK        -- Body block

    KURUCU(parametreler_list, govde_node)
        BU.parametreler = parametreler_list
        BU.govde = govde_node
    SON
SON

SINIF SinifTanimlama : ASTNode
    -- Class definition (SINIF ad ... SON)
    ad METIN            -- Class name
    ozellikler DİZİ     -- OzellikTanimlama list
    kurucu DİNAMİK       -- KurucuTanimlama (optional)
    metodlar DİZİ       -- IslecTanimlama list (methods)

    KURUCU(ad_token, ozellikler_list, kurucu_node, metodlar_list)
        BU.ad = ad_token.deger
        BU.ozellikler = ozellikler_list
        BU.kurucu = kurucu_node
        BU.metodlar = metodlar_list
    SON
SON
