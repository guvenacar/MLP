-- ===============================================
-- Token Class
-- ===============================================
SINIF Token
    -- Represents a single word or symbol in our language
    tip METIN
    deger DİNAMİK  -- Can be null, string, or number

    KURUCU(tip, deger)
        BU.tip = tip
        BU.deger = deger
    KURUCU SON

    -- String representation for debugging
    ÜZERİNE_YAZ IŞLEÇ toString() -> METIN
        EĞER BU.deger != HİÇLİK İSE
            DÖNÜŞ "<" + BU.tip + ": " + METIN(BU.deger) + ">"
        EĞER SON
        DÖNÜŞ "<" + BU.tip + ">"
    IŞLEÇ SON
SINIF SON

