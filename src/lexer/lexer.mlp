-- ===============================================
-- MLP Lexer (Tokenizer)
-- ===============================================
-- Transpiled from: TYD-MLP/src/lexer.py
-- Date: 2025-11-14
-- NOTE: Ensure this file is saved as UTF-8!
-- "Pragmatic Core" Philosophy: Keywords dynamic, Symbols hard-coded

KULLAN std.io
KULLAN std.strings
KULLAN lexer.tokens

SINIF Lexer
    -- Reads TYD source code and converts it to Token list
    -- Works based on language profile loaded from JSON

    kaynak_kodu METIN
    konum SAYISAL
    mevcut_karakter METIN  -- Can be null
    anahtar_kelimeler SÖZLÜK

    KURUCU(kaynak_kodu, dil_json_yolu, dil_kodu)
        BU.kaynak_kodu = kaynak_kodu
        BU.konum = 0

        EĞER UZUNLUK(BU.kaynak_kodu) > 0 İSE
            BU.mevcut_karakter = KARAKTER_AL(BU.kaynak_kodu, 0)
        DEĞILSE
            BU.mevcut_karakter = HİÇLİK
        EĞER SON

        -- Load keywords from JSON
        BU.anahtar_kelimeler = BU.dil_yukle(dil_json_yolu, dil_kodu)
    KURUCU SON

    -- ===============================================
    -- Normalization & Loading
    -- ===============================================

    IŞLEÇ _normalize_key(text) -> METIN
        -- Converts a keyword to standard (canonical) format for comparison
        -- Handles Turkish character normalization
        VAR normalized_text = text.casefold()
        normalized_text = METIN_DEGISTIR(normalized_text, "ı", "i")
        normalized_text = METIN_DEGISTIR(normalized_text, "İ", "i")
        normalized_text = METIN_DEGISTIR(normalized_text, "i̇", "i")
        DÖNÜŞ normalized_text
    IŞLEÇ SON

    IŞLEÇ dil_yukle(json_yolu, dil_kodu) -> SÖZLÜK
        -- Loads language profile from JSON
        -- ONLY loads keywords to map

        VAR diller = HİÇLİK
        DENE
            VAR json_content = DOSYA_OKU(json_yolu)
            diller = JSON_PARSE(json_content)
        YAKALA e
            HATA_FIRLAT YENİ İSTİSNA("Dil JSON dosyası okunamadı: " + json_yolu + ". Hata: " + METIN(e))
        DENE SON

        EĞER dil_kodu İÇİNDE_DEĞİL diller["dil_profili"] İSE
            HATA_FIRLAT YENİ İSTİSNA("Dil profili '" + dil_kodu + "' JSON'da bulunamadı.")
        EĞER SON

        VAR profil = diller["dil_profili"][dil_kodu]

        VAR anahtar_kelime_haritasi = {}
        HER soyut_tip, somut_kelime İÇİNDE profil
            EĞER soyut_tip İÇİNDE TOKEN_TIPLERI İSE
                VAR anahtar = BU._normalize_key(somut_kelime)
                anahtar_kelime_haritasi[anahtar] = soyut_tip
            EĞER SON
        HER SON

        YAZDIR("[Lexer] Dil profili yüklendi: " + dil_kodu + ". " + METIN(UZUNLUK(anahtar_kelime_haritasi)) + " anahtar kelime tanındı.")

        DÖNÜŞ anahtar_kelime_haritasi
    IŞLEÇ SON

    -- ===============================================
    -- Navigation & Helper Functions
    -- ===============================================

    IŞLEÇ ilerle(miktar)
        -- Moves forward by 'miktar' characters in text
        BU.konum = BU.konum + miktar
        EĞER BU.konum >= UZUNLUK(BU.kaynak_kodu) İSE
            BU.mevcut_karakter = HİÇLİK  -- End of File (EOF)
        DEĞILSE
            BU.mevcut_karakter = KARAKTER_AL(BU.kaynak_kodu, BU.konum)
        EĞER SON
    IŞLEÇ SON

    IŞLEÇ peek(miktar) -> METIN
        -- Peeks at next character without advancing
        VAR peek_konum = BU.konum + miktar
        EĞER peek_konum >= UZUNLUK(BU.kaynak_kodu) İSE
            DÖNÜŞ HİÇLİK
        EĞER SON
        DÖNÜŞ KARAKTER_AL(BU.kaynak_kodu, peek_konum)
    IŞLEÇ SON

    IŞLEÇ mevcut_dilim(uzunluk) -> METIN
        -- Gets text slice of 'uzunluk' length from current position
        EĞER BU.konum + uzunluk > UZUNLUK(BU.kaynak_kodu) İSE
            DÖNÜŞ HİÇLİK
        EĞER SON
        DÖNÜŞ ALT_METIN(BU.kaynak_kodu, BU.konum, uzunluk)
    IŞLEÇ SON

    -- ===============================================
    -- Comment Skipping Functions
    -- ===============================================

    IŞLEÇ bosluk_atla()
        DÖNGÜ BU.mevcut_karakter != HİÇLİK ve IS_WHITESPACE(BU.mevcut_karakter) İSE
            BU.ilerle(1)
        DÖNGÜ SON
    IŞLEÇ SON

    IŞLEÇ tek_satirli_yorum_atla()
        DÖNGÜ BU.mevcut_karakter != HİÇLİK ve BU.mevcut_karakter != "\n" İSE
            BU.ilerle(1)
        DÖNGÜ SON
        EĞER BU.mevcut_karakter == "\n" İSE
            BU.ilerle(1)  -- Skip newline too
        EĞER SON
    IŞLEÇ SON

    IŞLEÇ cok_satirli_yorum_atla()
        -- Skips until '---' is found
        DÖNGÜ BU.mevcut_karakter != HİÇLİK İSE
            EĞER BU.mevcut_dilim(3) == "---" İSE
                BU.ilerle(3)  -- Skip closing symbol
                DÖNÜŞ  -- Exit comment
            EĞER SON

            EĞER BU.mevcut_karakter == HİÇLİK İSE
                DÖNGÜ_BITIR
            EĞER SON
            BU.ilerle(1)
        DÖNGÜ SON

        HATA_FIRLAT YENİ İSTİSNA("Dosya sonuna ulaşıldı, ancak '---' yorum bloğu kapatılmadı.")
    IŞLEÇ SON

    -- ===============================================
    -- Token Reading Functions
    -- ===============================================

    IŞLEÇ sayi_oku() -> Token
        VAR sayi_str = ""
        VAR nokta_kullanildi = YANLIŞ

        DÖNGÜ BU.mevcut_karakter != HİÇLİK ve (IS_DIGIT(BU.mevcut_karakter) veya BU.mevcut_karakter == ".") İSE
            EĞER BU.mevcut_karakter == "." İSE
                EĞER nokta_kullanildi İSE
                    HATA_FIRLAT YENİ İSTİSNA("Sayı formatı hatalı: " + sayi_str + ".")
                EĞER SON
                nokta_kullanildi = DOĞRU
            EĞER SON

            sayi_str = sayi_str + BU.mevcut_karakter
            BU.ilerle(1)
        DÖNGÜ SON

        EĞER nokta_kullanildi İSE
            DÖNÜŞ YENİ Token(TOKEN_TIPLERI["FLOAT"], PARSE_FLOAT(sayi_str))
        DEĞILSE
            DÖNÜŞ YENİ Token(TOKEN_TIPLERI["INTEGER"], PARSE_INT(sayi_str))
        EĞER SON
    IŞLEÇ SON

    IŞLEÇ metin_oku() -> Token
        VAR metin = ""
        BU.ilerle(1)  -- Skip opening quote

        DÖNGÜ BU.mevcut_karakter != HİÇLİK ve BU.mevcut_karakter != "\"" İSE
            metin = metin + BU.mevcut_karakter
            BU.ilerle(1)
        DÖNGÜ SON

        EĞER BU.mevcut_karakter == HİÇLİK İSE
            HATA_FIRLAT YENİ İSTİSNA("Metin (string) kapatılmadı.")
        EĞER SON

        BU.ilerle(1)  -- Skip closing quote
        DÖNÜŞ YENİ Token(TOKEN_TIPLERI["STRING"], metin)
    IŞLEÇ SON

    IŞLEÇ kelime_oku() -> Token
        VAR kelime = ""

        DÖNGÜ BU.mevcut_karakter != HİÇLİK ve (IS_ALNUM(BU.mevcut_karakter) veya BU.mevcut_karakter == "_") İSE
            kelime = kelime + BU.mevcut_karakter
            BU.ilerle(1)
        DÖNGÜ SON

        VAR kelime_kontrol_formati = BU._normalize_key(kelime)

        EĞER kelime_kontrol_formati İÇİNDE BU.anahtar_kelimeler İSE
            VAR token_tipi = BU.anahtar_kelimeler[kelime_kontrol_formati]
            DÖNÜŞ YENİ Token(token_tipi, kelime_kontrol_formati)
        DEĞILSE
            DÖNÜŞ YENİ Token(TOKEN_TIPLERI["IDENTIFIER"], kelime)
        EĞER SON
    IŞLEÇ SON

    -- ===============================================
    -- Main Tokenization Engine (Pragmatic Core)
    -- ===============================================

    IŞLEÇ sonraki_tokeni_al() -> Token
        -- Finds and returns next Token from source
        -- Symbols ('+', '{', '==', '--') are HARD-CODED

        DÖNGÜ BU.mevcut_karakter != HİÇLİK İSE

            -- 1. Whitespace
            EĞER IS_WHITESPACE(BU.mevcut_karakter) İSE
                BU.bosluk_atla()
                DÖNGÜ_DEVAM
            EĞER SON

            -- 2. Keywords/Identifiers (Dynamic Map)
            EĞER IS_ALPHA(BU.mevcut_karakter) veya BU.mevcut_karakter == "_" İSE
                DÖNÜŞ BU.kelime_oku()
            EĞER SON

            -- 3. Numbers (Fixed Rule)
            EĞER IS_DIGIT(BU.mevcut_karakter) İSE
                DÖNÜŞ BU.sayi_oku()
            EĞER SON

            -- 4. Strings (Fixed Rule)
            EĞER BU.mevcut_karakter == "\"" İSE
                DÖNÜŞ BU.metin_oku()
            EĞER SON

            -- 5. SYMBOLS, OPERATORS, COMMENTS (Hard-coded Core)

            -- Comments (---, --, -)
            EĞER BU.mevcut_karakter == "-" İSE
                EĞER BU.peek(1) == "-" İSE
                    BU.ilerle(1)
                    BU.ilerle(1)  -- Skip two '-'
                    EĞER BU.mevcut_karakter == "-" İSE
                        BU.ilerle(1)  -- Skip third '-'
                        BU.cok_satirli_yorum_atla()
                        DÖNGÜ_DEVAM
                    DEĞILSE
                        BU.tek_satirli_yorum_atla()
                        DÖNGÜ_DEVAM
                    EĞER SON
                DEĞILSE
                    BU.ilerle(1)
                    DÖNÜŞ YENİ Token(TOKEN_TIPLERI["MINUS"], "-")
                EĞER SON
            EĞER SON

            -- Power (**)
            EĞER BU.mevcut_karakter == "*" İSE
                EĞER BU.peek(1) == "*" İSE
                    BU.ilerle(1)
                    BU.ilerle(1)
                    DÖNÜŞ YENİ Token(TOKEN_TIPLERI["POWER"], "**")
                DEĞILSE
                    BU.ilerle(1)
                    DÖNÜŞ YENİ Token(TOKEN_TIPLERI["MUL"], "*")
                EĞER SON
            EĞER SON

            -- Comparisons (==, >=, <=)
            EĞER BU.mevcut_karakter == "=" İSE
                EĞER BU.peek(1) == "=" İSE
                    BU.ilerle(1)
                    BU.ilerle(1)
                    DÖNÜŞ YENİ Token(TOKEN_TIPLERI["OP_ESIT_KARSILASTIRMA"], "==")
                DEĞILSE
                    BU.ilerle(1)
                    DÖNÜŞ YENİ Token(TOKEN_TIPLERI["ASSIGN"], "=")
                EĞER SON
            EĞER SON

            EĞER BU.mevcut_karakter == ">" İSE
                EĞER BU.peek(1) == "=" İSE
                    BU.ilerle(1)
                    BU.ilerle(1)
                    DÖNÜŞ YENİ Token(TOKEN_TIPLERI["GTE"], ">=")
                DEĞILSE
                    BU.ilerle(1)
                    DÖNÜŞ YENİ Token(TOKEN_TIPLERI["GT"], ">")
                EĞER SON
            EĞER SON

            EĞER BU.mevcut_karakter == "<" İSE
                EĞER BU.peek(1) == "=" İSE
                    BU.ilerle(1)
                    BU.ilerle(1)
                    DÖNÜŞ YENİ Token(TOKEN_TIPLERI["LTE"], "<=")
                DEĞILSE
                    BU.ilerle(1)
                    DÖNÜŞ YENİ Token(TOKEN_TIPLERI["LT"], "<")
                EĞER SON
            EĞER SON

            -- Single Character Symbols

            EĞER BU.mevcut_karakter == "+" İSE
                BU.ilerle(1)
                DÖNÜŞ YENİ Token(TOKEN_TIPLERI["PLUS"], "+")
            EĞER SON

            EĞER BU.mevcut_karakter == "/" İSE
                BU.ilerle(1)
                DÖNÜŞ YENİ Token(TOKEN_TIPLERI["DIV"], "/")
            EĞER SON

            EĞER BU.mevcut_karakter == "(" İSE
                BU.ilerle(1)
                DÖNÜŞ YENİ Token(TOKEN_TIPLERI["LEFT_PAREN"], "(")
            EĞER SON

            EĞER BU.mevcut_karakter == ")" İSE
                BU.ilerle(1)
                DÖNÜŞ YENİ Token(TOKEN_TIPLERI["RIGHT_PAREN"], ")")
            EĞER SON

            EĞER BU.mevcut_karakter == "[" İSE
                BU.ilerle(1)
                DÖNÜŞ YENİ Token(TOKEN_TIPLERI["LEFT_BRACKET"], "[")
            EĞER SON

            EĞER BU.mevcut_karakter == "]" İSE
                BU.ilerle(1)
                DÖNÜŞ YENİ Token(TOKEN_TIPLERI["RIGHT_BRACKET"], "]")
            EĞER SON

            EĞER BU.mevcut_karakter == ";" İSE
                BU.ilerle(1)
                DÖNÜŞ YENİ Token(TOKEN_TIPLERI["SEMICOLON"], ";")
            EĞER SON

            EĞER BU.mevcut_karakter == ":" İSE
                BU.ilerle(1)
                DÖNÜŞ YENİ Token(TOKEN_TIPLERI["COLON"], ":")
            EĞER SON

            EĞER BU.mevcut_karakter == "," İSE
                BU.ilerle(1)
                DÖNÜŞ YENİ Token(TOKEN_TIPLERI["COMMA"], ",")
            EĞER SON

            -- Dictionary Syntax
            EĞER BU.mevcut_karakter == "{" İSE
                BU.ilerle(1)
                DÖNÜŞ YENİ Token(TOKEN_TIPLERI["LEFT_BRACE"], "{")
            EĞER SON

            EĞER BU.mevcut_karakter == "}" İSE
                BU.ilerle(1)
                DÖNÜŞ YENİ Token(TOKEN_TIPLERI["RIGHT_BRACE"], "}")
            EĞER SON

            -- 6. Error (Unrecognized character)
            HATA_FIRLAT YENİ İSTİSNA("Tanınmayan karakter: '" + BU.mevcut_karakter + "'")
        DÖNGÜ SON

        -- Loop ended, end of file
        DÖNÜŞ YENİ Token(TOKEN_TIPLERI["EOF"], HİÇLİK)
    IŞLEÇ SON
SINIF SON
