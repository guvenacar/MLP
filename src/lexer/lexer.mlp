-- ===============================================
-- MLP Lexer (Tokenizer)
-- ===============================================
-- Transpiled from: TYD-MLP/src/lexer.py
-- Date: 2025-11-14
-- NOTE: Ensure this file is saved as UTF-8!
-- "Pragmatic Core" Philosophy: Keywords dynamic, Symbols hard-coded

KULLAN std.io
KULLAN std.strings
KULLAN lexer.tokens

class Lexer
    -- Reads TYD source code and converts it to Token list
    -- Works based on language profile loaded from JSON

    kaynak_kodu string
    konum number
    mevcut_karakter string  -- Can be null
    anahtar_kelimeler dict

    constructor(kaynak_kodu, dil_json_yolu, dil_kodu)
        this.kaynak_kodu = kaynak_kodu
        this.konum = 0

        if UZUNLUK(this.kaynak_kodu) > 0
            this.mevcut_karakter = KARAKTER_AL(this.kaynak_kodu, 0)
        else
            this.mevcut_karakter = null
        end

        -- Load keywords from JSON
        this.anahtar_kelimeler = this.dil_yukle(dil_json_yolu, dil_kodu)
    end

    -- ===============================================
    -- Normalization & Loading
    -- ===============================================

    method _normalize_key(text) -> string
        -- Converts a keyword to standard (canonical) format for comparison
        -- Handles Turkish character normalization
        var normalized_text = text.casefold()
        normalized_text = METIN_DEGISTIR(normalized_text, "ı", "i")
        normalized_text = METIN_DEGISTIR(normalized_text, "İ", "i")
        normalized_text = METIN_DEGISTIR(normalized_text, "i̇", "i")
        return normalized_text
    end

    method dil_yukle(json_yolu, dil_kodu) -> dict
        -- Loads language profile from JSON
        -- ONLY loads keywords to map

        var diller = null
        try
            var json_content = DOSYA_OKU(json_yolu)
            diller = JSON_PARSE(json_content)
        catch e
            throw new Exception("Dil JSON dosyası okunamadı: " + json_yolu + ". Hata: " + string(e))
        end

        if dil_kodu not in diller["dil_profili"]
            throw new Exception("Dil profili '" + dil_kodu + "' JSON'da bulunamadı.")
        end

        var profil = diller["dil_profili"][dil_kodu]

        var anahtar_kelime_haritasi = {}
        for soyut_tip, somut_kelime in profil
            if soyut_tip in TOKEN_TIPLERI
                var anahtar = this._normalize_key(somut_kelime)
                anahtar_kelime_haritasi[anahtar] = soyut_tip
            end
        end

        YAZDIR("[Lexer] Dil profili yüklendi: " + dil_kodu + ". " + string(UZUNLUK(anahtar_kelime_haritasi)) + " anahtar kelime tanındı.")

        return anahtar_kelime_haritasi
    end

    -- ===============================================
    -- Navigation & Helper Functions
    -- ===============================================

    method ilerle(miktar)
        -- Moves forward by 'miktar' characters in text
        this.konum = this.konum + miktar
        if this.konum >= UZUNLUK(this.kaynak_kodu)
            this.mevcut_karakter = null  -- End of File (EOF)
        else
            this.mevcut_karakter = KARAKTER_AL(this.kaynak_kodu, this.konum)
        end
    end

    method peek(miktar) -> string
        -- Peeks at next character without advancing
        var peek_konum = this.konum + miktar
        if peek_konum >= UZUNLUK(this.kaynak_kodu)
            return null
        end
        return KARAKTER_AL(this.kaynak_kodu, peek_konum)
    end

    method mevcut_dilim(uzunluk) -> string
        -- Gets text slice of 'uzunluk' length from current position
        if this.konum + uzunluk > UZUNLUK(this.kaynak_kodu)
            return null
        end
        return ALT_METIN(this.kaynak_kodu, this.konum, uzunluk)
    end

    -- ===============================================
    -- Comment Skipping Functions
    -- ===============================================

    method bosluk_atla()
        while this.mevcut_karakter != null and IS_WHITESPACE(this.mevcut_karakter)
            this.ilerle(1)
        end
    end

    method tek_satirli_yorum_atla()
        while this.mevcut_karakter != null and this.mevcut_karakter != "\n"
            this.ilerle(1)
        end
        if this.mevcut_karakter == "\n"
            this.ilerle(1)  -- Skip newline too
        end
    end

    method cok_satirli_yorum_atla()
        -- Skips until '---' is found
        while this.mevcut_karakter != null
            if this.mevcut_dilim(3) == "---"
                this.ilerle(3)  -- Skip closing symbol
                return  -- Exit comment
            end

            if this.mevcut_karakter == null
                break
            end
            this.ilerle(1)
        end

        throw new Exception("Dosya sonuna ulaşıldı, ancak '---' yorum bloğu kapatılmadı.")
    end

    -- ===============================================
    -- Token Reading Functions
    -- ===============================================

    method sayi_oku() -> Token
        var sayi_str = ""
        var nokta_kullanildi = false

        while this.mevcut_karakter != null and (IS_DIGIT(this.mevcut_karakter) or this.mevcut_karakter == ".")
            if this.mevcut_karakter == "."
                if nokta_kullanildi
                    throw new Exception("Sayı formatı hatalı: " + sayi_str + ".")
                end
                nokta_kullanildi = true
            end

            sayi_str = sayi_str + this.mevcut_karakter
            this.ilerle(1)
        end

        if nokta_kullanildi
            return new Token(TOKEN_TIPLERI["FLOAT"], PARSE_FLOAT(sayi_str))
        else
            return new Token(TOKEN_TIPLERI["INTEGER"], PARSE_INT(sayi_str))
        end
    end

    method metin_oku() -> Token
        var metin = ""
        this.ilerle(1)  -- Skip opening quote

        while this.mevcut_karakter != null and this.mevcut_karakter != "\""
            metin = metin + this.mevcut_karakter
            this.ilerle(1)
        end

        if this.mevcut_karakter == null
            throw new Exception("Metin (string) kapatılmadı.")
        end

        this.ilerle(1)  -- Skip closing quote
        return new Token(TOKEN_TIPLERI["STRING"], metin)
    end

    method kelime_oku() -> Token
        var kelime = ""

        while this.mevcut_karakter != null and (IS_ALNUM(this.mevcut_karakter) or this.mevcut_karakter == "_")
            kelime = kelime + this.mevcut_karakter
            this.ilerle(1)
        end

        var kelime_kontrol_formati = this._normalize_key(kelime)

        if kelime_kontrol_formati in this.anahtar_kelimeler
            var token_tipi = this.anahtar_kelimeler[kelime_kontrol_formati]
            return new Token(token_tipi, kelime_kontrol_formati)
        else
            return new Token(TOKEN_TIPLERI["IDENTIFIER"], kelime)
        end
    end

    -- ===============================================
    -- Main Tokenization Engine (Pragmatic Core)
    -- ===============================================

    method sonraki_tokeni_al() -> Token
        -- Finds and returns next Token from source
        -- Symbols ('+', '{', '==', '--') are HARD-CODED

        while this.mevcut_karakter != null

            -- 1. Whitespace
            if IS_WHITESPACE(this.mevcut_karakter)
                this.bosluk_atla()
                continue
            end

            -- 2. Keywords/Identifiers (Dynamic Map)
            if IS_ALPHA(this.mevcut_karakter) or this.mevcut_karakter == "_"
                return this.kelime_oku()
            end

            -- 3. Numbers (Fixed Rule)
            if IS_DIGIT(this.mevcut_karakter)
                return this.sayi_oku()
            end

            -- 4. Strings (Fixed Rule)
            if this.mevcut_karakter == "\""
                return this.metin_oku()
            end

            -- 5. SYMBOLS, OPERATORS, COMMENTS (Hard-coded Core)

            -- Comments (---, --, -)
            if this.mevcut_karakter == "-"
                if this.peek(1) == "-"
                    this.ilerle(1)
                    this.ilerle(1)  -- Skip two '-'
                    if this.mevcut_karakter == "-"
                        this.ilerle(1)  -- Skip third '-'
                        this.cok_satirli_yorum_atla()
                        continue
                    else
                        this.tek_satirli_yorum_atla()
                        continue
                    end
                else
                    this.ilerle(1)
                    return new Token(TOKEN_TIPLERI["MINUS"], "-")
                end
            end

            -- Power (**)
            if this.mevcut_karakter == "*"
                if this.peek(1) == "*"
                    this.ilerle(1)
                    this.ilerle(1)
                    return new Token(TOKEN_TIPLERI["POWER"], "**")
                else
                    this.ilerle(1)
                    return new Token(TOKEN_TIPLERI["MUL"], "*")
                end
            end

            -- Comparisons (==, >=, <=)
            if this.mevcut_karakter == "="
                if this.peek(1) == "="
                    this.ilerle(1)
                    this.ilerle(1)
                    return new Token(TOKEN_TIPLERI["OP_ESIT_KARSILASTIRMA"], "==")
                else
                    this.ilerle(1)
                    return new Token(TOKEN_TIPLERI["ASSIGN"], "=")
                end
            end

            if this.mevcut_karakter == ">"
                if this.peek(1) == "="
                    this.ilerle(1)
                    this.ilerle(1)
                    return new Token(TOKEN_TIPLERI["GTE"], ">=")
                else
                    this.ilerle(1)
                    return new Token(TOKEN_TIPLERI["GT"], ">")
                end
            end

            if this.mevcut_karakter == "<"
                if this.peek(1) == "="
                    this.ilerle(1)
                    this.ilerle(1)
                    return new Token(TOKEN_TIPLERI["LTE"], "<=")
                else
                    this.ilerle(1)
                    return new Token(TOKEN_TIPLERI["LT"], "<")
                end
            end

            -- Single Character Symbols

            if this.mevcut_karakter == "+"
                this.ilerle(1)
                return new Token(TOKEN_TIPLERI["PLUS"], "+")
            end

            if this.mevcut_karakter == "/"
                this.ilerle(1)
                return new Token(TOKEN_TIPLERI["DIV"], "/")
            end

            if this.mevcut_karakter == "("
                this.ilerle(1)
                return new Token(TOKEN_TIPLERI["LEFT_PAREN"], "(")
            end

            if this.mevcut_karakter == ")"
                this.ilerle(1)
                return new Token(TOKEN_TIPLERI["RIGHT_PAREN"], ")")
            end

            if this.mevcut_karakter == "["
                this.ilerle(1)
                return new Token(TOKEN_TIPLERI["LEFT_BRACKET"], "[")
            end

            if this.mevcut_karakter == "]"
                this.ilerle(1)
                return new Token(TOKEN_TIPLERI["RIGHT_BRACKET"], "]")
            end

            if this.mevcut_karakter == ";"
                this.ilerle(1)
                return new Token(TOKEN_TIPLERI["SEMICOLON"], ";")
            end

            if this.mevcut_karakter == ":"
                this.ilerle(1)
                return new Token(TOKEN_TIPLERI["COLON"], ":")
            end

            if this.mevcut_karakter == ","
                this.ilerle(1)
                return new Token(TOKEN_TIPLERI["COMMA"], ",")
            end

            -- Dictionary Syntax
            if this.mevcut_karakter == "{"
                this.ilerle(1)
                return new Token(TOKEN_TIPLERI["LEFT_BRACE"], "{")
            end

            if this.mevcut_karakter == "}"
                this.ilerle(1)
                return new Token(TOKEN_TIPLERI["RIGHT_BRACE"], "}")
            end

            -- 6. Error (Unrecognized character)
            throw new Exception("Tanınmayan karakter: '" + this.mevcut_karakter + "'")
        end

        -- Loop ended, end of file
        return new Token(TOKEN_TIPLERI["EOF"], null)
    end
end
