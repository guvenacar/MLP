-- ===============================================
-- MLP Code Generator (Assembly Generator)
-- ===============================================
-- Transpiled from: TYD-MLP/src/generator.py
-- Date: 2025-11-14
-- "GOLD COPY" - Array + Heap Supported, Unrefactored Stable Version
-- Walks AST and generates x86-64 Assembly code

KULLAN ast.ast_nodes
KULLAN lexer.tokens
KULLAN codegen.c_arayuzu

class Generator
    -- Walks AST and generates complete Assembly code

    ast_koku dynamic
    code array              -- Generated code (entire output)
    data array              -- .data section (constants, strings)
    main_kodu array         -- Instructions inside main function

    -- Scope Management
    degisken_haritalari array  -- Stack of variable maps (global + local scopes)
    stack_offset number

    label_sayaci number
    dongu_cikis_etiketleri array

    islec_haritasi dict
    mevcut_islec dynamic
    c_arayuzu dynamic

    -- Phase 8: OOP Support
    sinif_haritasi dict
    c_structs array         -- C struct definitions
    c_functions array       -- C function definitions (constructors, methods)

    constructor(ast_koku)
        this.ast_koku = ast_koku
        this.code = []
        this.data = []
        this.main_kodu = []

        this.degisken_haritalari = [{}]  -- Start with global scope (main)
        this.stack_offset = 0

        this.label_sayaci = 0
        this.dongu_cikis_etiketleri = []

        this.islec_haritasi = {}
        this.mevcut_islec = null

        -- NEW: Initialize C Interface Layer
        this.c_arayuzu = new CArayuzu(this)

        -- Phase 8: OOP Support
        this.sinif_haritasi = {}
        this.c_structs = []
        this.c_functions = []
    end

    -- ===============================================
    -- Code Generation Helpers
    -- ===============================================

    method emit(instruction)
        this.main_kodu.push("    " + instruction)
    end

    method emit_data(data_line)
        this.data.push("    " + data_line)
    end

    method _yeni_etiket() -> string
        this.label_sayaci = this.label_sayaci + 1
        return "_etiket_" + string(this.label_sayaci)
    end

    -- ===============================================
    -- Scope and Memory Helpers
    -- ===============================================

    method _kapsam_gir()
        this.degisken_haritalari.push({})
        this.stack_offset = 0
    end

    method _kapsam_cik()
        if UZUNLUK(this.degisken_haritalari) > 1
            this.degisken_haritalari.pop()
        end
        this.stack_offset = 0
    end

    method _degisken_adres_bul(degisken_adi) -> dict
        -- Returns variable's address/size dictionary
        var mevcut_kapsam = this.degisken_haritalari[UZUNLUK(this.degisken_haritalari) - 1]
        if degisken_adi in mevcut_kapsam
            return mevcut_kapsam[degisken_adi]
        end
        if degisken_adi in this.degisken_haritalari[0]
            return this.degisken_haritalari[0][degisken_adi]
        end
        throw new Exception("[Generator] Tanımlanmamış değişken: " + degisken_adi)
    end

    method _degisken_yer_ayir(degisken_adi, adres, boyut) -> dict
        -- Allocates space on stack for variable/array
        -- Stores info as {'adres': '...', 'boyut': X}
        var mevcut_kapsam = this.degisken_haritalari[UZUNLUK(this.degisken_haritalari) - 1]

        if degisken_adi in mevcut_kapsam
            throw new Exception("[Generator] Değişken '" + degisken_adi + "' bu kapsamda zaten tanımlı.")
        end

        if adres == null
            -- LOCAL VARIABLE or ARRAY
            var toplam_byte_boyutu = boyut * 8
            this.stack_offset = this.stack_offset - toplam_byte_boyutu
            adres = "[rbp" + string(this.stack_offset) + "]"
            this.emit("sub rsp, " + string(toplam_byte_boyutu) + "  ; '" + degisken_adi + "' için yığında " + string(toplam_byte_boyutu) + " byte yer aç")
        end

        mevcut_kapsam[degisken_adi] = {
            "adres": adres,
            "boyut": boyut
        }
        return mevcut_kapsam[degisken_adi]
    end

    -- ===============================================
    -- Main Generation Functions
    -- ===============================================

    method generate() -> string
        -- Walks entire AST and returns complete Assembly code

        -- C library setup (now comes from C_Arayuzu)
        var extern_decls = this.c_arayuzu.generate_extern_bildirimleri()
        for decl in extern_decls
            this.code.push(decl)
        end

        this.emit_data('format_sayi db "%d", 10, 0')
        this.emit_data('format_metin db "%s", 10, 0')

        this.visit(this.ast_koku)

        -- Phase 8: OOP - Add C Struct and Function definitions
        if UZUNLUK(this.c_structs) > 0 or UZUNLUK(this.c_functions) > 0
            this.code.insert(0, "; ========================================")
            this.code.insert(1, "; Phase 8: OOP - C Code Generation")
            this.code.insert(2, "; ========================================")
            this.code.insert(3, ";")

            if UZUNLUK(this.c_structs) > 0
                this.code.insert(4, "; --- C Struct Definitions ---")
                for i = 0 to UZUNLUK(this.c_structs) - 1
                    this.code.insert(5 + i, "; " + this.c_structs[i])
                end
                this.code.insert(5 + UZUNLUK(this.c_structs), ";")
            end

            if UZUNLUK(this.c_functions) > 0
                var insert_pos = 5 + UZUNLUK(this.c_structs) + 1
                this.code.insert(insert_pos, "; --- C Function Definitions ---")
                for i = 0 to UZUNLUK(this.c_functions) - 1
                    this.code.insert(insert_pos + 1 + i, "; " + this.c_functions[i])
                end
                this.code.insert(insert_pos + 1 + UZUNLUK(this.c_functions), ";")
            end

            this.code.push("; ========================================")
            this.code.push("")
        end

        this.code.push("\nsection .data")
        for line in this.data
            this.code.push(line)
        end

        this.code.push("\nsection .text")
        this.code.push("global main")
        this.code.push("main:")
        this.code.push("    push rbp")
        this.code.push("    mov rbp, rsp")

        for line in this.main_kodu
            this.code.push(line)
        end

        this.code.push("    mov rsp, rbp")
        this.code.push("    pop rbp")
        this.code.push("    ret")

        return STRING_JOIN(this.code, "\n")
    end

    method visit(node)
        -- Visitor pattern dispatcher

        -- 0. SinifTanimlama? (Phase 8: OOP)
        if TYPE_OF(node) == "SinifTanimlama"
            this.visit_SinifTanimlama(node)
            return
        end

        -- 1. IslecTanimlama?
        if TYPE_OF(node) == "IslecTanimlama"
            this.visit_IslecTanimlama(node)
            return
        end

        -- 2. DiziTanimlama?
        if TYPE_OF(node) == "DiziTanimlama"
            this.visit_DiziTanimlama(node)
            return
        end

        -- 3. Call method by name (e.g., visit_DegiskenTanimlama)
        var method_name = "visit_" + TYPE_OF(node)
        if HAS_METHOD(this, method_name)
            return CALL_METHOD(this, method_name, node)
        else
            return this.visit_bilinmeyen(node)
        end
    end

    method visit_bilinmeyen(node)
        throw new Exception("[Generator] Tanınmayan AST Düğümü: " + TYPE_OF(node))
    end

    -- ===============================================
    -- Visitor Functions (Statements)
    -- ===============================================

    method visit_Blok(node)
        for komut in node.komutlar
            this.visit(komut)
        end
    end

    method visit_DegiskenTanimlama(node)
        var degisken_adi = node.ad
        this.emit("; --- DegiskenTanimlama: " + degisken_adi + " ---")
        this.visit(node.ifade)  -- Calculate value (rax)
        var adres_bilgisi = this._degisken_yer_ayir(degisken_adi, null, 1)
        var adres = adres_bilgisi["adres"]
        this.emit("mov " + adres + ", rax")
    end

    method visit_DiziTanimlama(node)
        var degisken_adi = node.ad.deger
        if TYPE_OF(node.boyut) != "Sayi"
            throw new Exception("Dizi boyutu şimdilik sadece sabit bir sayı olmalıdır.")
        end
        var boyut = PARSE_INT(string(node.boyut.deger))
        if boyut <= 0
            throw new Exception("Dizi boyutu pozitif olmalıdır.")
        end
        this.emit("; --- Dizi Tanımlama: " + degisken_adi + "[" + string(boyut) + "] ---")
        this._degisken_yer_ayir(degisken_adi, null, boyut)
    end

    method visit_AtamaKomutu(node)
        this.emit("; --- AtamaKomutu ---")

        -- 1. Calculate assigned value (right side) and save to stack
        this.visit(node.ifade)
        this.emit("push rax  ; Atanacak değeri koru")

        -- 2. Determine target (left side)

        if TYPE_OF(node.hedef) == "Degisken"
            -- Target: Simple Variable
            this.emit("pop rax")
            var degisken_adi = node.hedef.ad
            var adres_bilgisi = this._degisken_adres_bul(degisken_adi)
            var adres = adres_bilgisi["adres"]
            this.emit("mov " + adres + ", rax  ; " + degisken_adi + " = (sonuç)")
        end

        if TYPE_OF(node.hedef) == "DiziErisim"
            -- Target: Array Access
            this.emit("; --- Dizi Erişimi (Yazma) [ ] ---")

            var dizi_adi = node.hedef.hedef.ad
            var adres_bilgisi = this._degisken_adres_bul(dizi_adi)
            var dizi_baslangic_adresi_str = adres_bilgisi["adres"]

            this.visit(node.hedef.indeks)
            this.emit("mov rdi, rax")
            this.emit("shl rdi, 3")
            this.emit("lea rax, " + dizi_baslangic_adresi_str)
            this.emit("add rax, rdi  ; RAX = Elemanın Tam Adresi")

            this.emit("mov rdi, rax  ; Hedef adresi RDI'a taşı")
            this.emit("pop rax       ; Atanacak değeri yığından geri al")
            this.emit("mov [rdi], rax")
        end

        if TYPE_OF(node.hedef) == "SozlukErisim"
            -- Target: Dictionary Access
            this.emit("; --- Sözlük Erişimi (Yazma) {{ }} ---")
            this.emit("pop rsi ; Atanacak değeri RSI'a al")
            this.c_arayuzu.visit(node.hedef.anahtar)
            this.emit("mov rdi, rax ; Anahtarı RDI'a al")
            this.emit("mov rax, 0")
            this.emit("call sozluk_ekle")
        end
    end

    method visit_EgerBlogu(node)
        var degilse_etiketi = this._yeni_etiket()
        var son_etiket = this._yeni_etiket()
        this.visit(node.kosul)
        this.emit("cmp rax, 0")
        var hedef_etiket = node.yanlis_blok != null ? degilse_etiketi : son_etiket
        this.emit("je " + hedef_etiket)
        this.visit(node.dogru_blok)
        if node.yanlis_blok != null
            this.emit("jmp " + son_etiket)
            this.emit(degilse_etiketi + ":")
            this.visit(node.yanlis_blok)
        end
        this.emit(son_etiket + ":")
    end

    method visit_DonguBlogu(node)
        var basi_etiketi = this._yeni_etiket()
        var sonu_etiketi = this._yeni_etiket()
        this.dongu_cikis_etiketleri.push(sonu_etiketi)
        this.emit(basi_etiketi + ":")
        this.visit(node.blok)
        this.emit("jmp " + basi_etiketi)
        this.emit(sonu_etiketi + ":")
        this.dongu_cikis_etiketleri.pop()
    end

    method visit_DonguBitirKomutu(node)
        if UZUNLUK(this.dongu_cikis_etiketleri) == 0
            throw new Exception("[Generator] 'DÖNGÜ_BITIR' komutu bir 'DÖNGÜ' bloğu içinde olmalıdır.")
        end
        this.emit("jmp " + this.dongu_cikis_etiketleri[UZUNLUK(this.dongu_cikis_etiketleri) - 1])
    end

    method visit_IslecTanimlama(node)
        var islec_adi = node.ad.deger
        var asm_etiketi = "_islec_" + islec_adi
        this.islec_haritasi[islec_adi] = asm_etiketi

        var islec_kodu = []
        islec_kodu.push("\n; --- İŞLEÇ Tanımı: " + islec_adi + " ---")
        islec_kodu.push(asm_etiketi + ":")
        islec_kodu.push("    push rbp")
        islec_kodu.push("    mov rbp, rsp")

        this._kapsam_gir()
        this.mevcut_islec = node

        for i = 0 to UZUNLUK(node.parametreler) - 1
            var param = node.parametreler[i]
            var param_adi = param.ad.deger
            var adres = "[rbp+" + string(16 + i * 8) + "]"
            this._degisken_yer_ayir(param_adi, adres, 1)
        end

        var eski_main_kodu = this.main_kodu
        this.main_kodu = islec_kodu
        this.visit(node.govde)
        this.main_kodu = eski_main_kodu

        islec_kodu.push("; " + islec_adi + " için örtük epilog")
        islec_kodu.push("    mov rsp, rbp")
        islec_kodu.push("    pop rbp")
        islec_kodu.push("    ret")

        for line in islec_kodu
            this.code.push(line)
        end

        this.mevcut_islec = null
        this._kapsam_cik()
    end

    method visit_DonusKomutu(node)
        if this.mevcut_islec == null
            throw new Exception("'DÖNÜŞ' komutu sadece İŞLEÇ içinde kullanılabilir.")
        end
        this.visit(node.ifade)
        this.emit("    mov rsp, rbp")
        this.emit("    pop rbp")
        this.emit("    ret")
    end

    method visit_IfadeKomutu(node)
        this.visit(node.ifade)
    end

    method visit_YazdirKomutu(node)
        this.emit("; --- YAZDIR Başlangıç (C Arayüzüne delege edildi) ---")
        this.c_arayuzu.generate_c_call("YAZDIR", node)
    end

    -- ===============================================
    -- Expression Visitors
    -- ===============================================

    method visit_Sayi(node)
        this.emit("mov rax, " + string(node.deger))
    end

    method visit_Metin(node)
        var data_label = "str_" + string(UZUNLUK(this.data))
        this.emit_data(data_label + ' db "' + node.deger + '", 0')
        this.emit("mov rax, " + data_label)
    end

    method visit_Degisken(node)
        var degisken_adi = node.ad
        var adres_bilgisi = this._degisken_adres_bul(degisken_adi)
        if adres_bilgisi["boyut"] > 1
            throw new Exception("HATA: '" + degisken_adi + "' bir dizidir. Elemanına ([i]) erişin.")
        end
        var adres = adres_bilgisi["adres"]
        this.emit("mov rax, " + adres)
    end

    method visit_DiziErisim(node)
        this.emit("; --- Dizi Erişimi (Okuma) [ ] ---")

        var dizi_adi = node.hedef.ad
        var adres_bilgisi = this._degisken_adres_bul(dizi_adi)
        var dizi_baslangic_adresi_str = adres_bilgisi["adres"]

        this.visit(node.indeks)
        this.emit("mov rdi, rax")
        this.emit("shl rdi, 3")
        this.emit("lea rax, " + dizi_baslangic_adresi_str)
        this.emit("add rax, rdi")
        this.emit("mov rax, [rax]")
    end

    method visit_SozlukErisim(node)
        this.emit("; --- Sözlük Erişimi (Okuma) {{ }} ---")
        this.c_arayuzu.generate_sozluk_getir(node.anahtar)
    end

    method visit_IslecCagirma(node)
        var islec_adi = node.hedef_token.deger
        this.emit("; --- İŞLEÇ Çağırma: " + islec_adi + " ---")

        -- 1. Is this a magic C function?
        if this.c_arayuzu.is_c_function(islec_adi)
            this.c_arayuzu.generate_c_call(islec_adi, node)
            return
        end

        -- 2. Is this a TYD-MLP function we defined?
        if islec_adi in this.islec_haritasi
            var asm_etiketi = this.islec_haritasi[islec_adi]

            -- Prepare arguments for TYD-MLP protocol (stack)
            var arg_sayisi = UZUNLUK(node.argumanlar)
            for i = arg_sayisi - 1 to 0 step -1
                this.visit(node.argumanlar[i])
                this.emit("push rax")
            end

            this.emit("call " + asm_etiketi)

            -- Clean stack
            if arg_sayisi > 0
                this.emit("add rsp, " + string(arg_sayisi * 8) + "  ; Yığını temizle")
            end
            return
        end

        -- 3. Not found
        throw new Exception("Tanımsız İŞLEÇ çağrıldı: " + islec_adi)
    end

    method visit_IkiliIslem(node)
        this.visit(node.sag)
        this.emit("push rax")
        this.visit(node.sol)
        this.emit("pop rbx")

        var op = node.operator.tip

        if op == TOKEN_TIPLERI["PLUS"] or op == TOKEN_TIPLERI["OP_ARTI"]
            this.emit("add rax, rbx")
        end

        if op == TOKEN_TIPLERI["MINUS"] or op == TOKEN_TIPLERI["OP_EKSI"]
            this.emit("sub rax, rbx")
        end

        if op == TOKEN_TIPLERI["MUL"] or op == TOKEN_TIPLERI["OP_CARP"]
            this.emit("imul rax, rbx")
        end

        if op == TOKEN_TIPLERI["DIV"] or op == TOKEN_TIPLERI["OP_BOL"]
            this.emit("xor rdx, rdx")
            this.emit("idiv rbx")
        end

        if op == TOKEN_TIPLERI["OP_ESIT"] or op == TOKEN_TIPLERI["OP_GT"] or op == TOKEN_TIPLERI["OP_LT"]
            this.emit("cmp rax, rbx")
            if op == TOKEN_TIPLERI["OP_ESIT"]
                this.emit("sete al")
            end
            if op == TOKEN_TIPLERI["OP_GT"]
                this.emit("setg al")
            end
            if op == TOKEN_TIPLERI["OP_LT"]
                this.emit("setl al")
            end
            this.emit("movzx rax, al")
        end
    end

    -- ===============================================
    -- Phase 8: OOP Support
    -- ===============================================

    method visit_SinifTanimlama(node)
        -- SINIF → C Struct + Constructor + Methods
        var sinif_adi = node.ad
        this.emit("; --- SINIF Tanımı: " + sinif_adi + " ---")

        this.sinif_haritasi[sinif_adi] = {
            "ozellikler": node.ozellikler,
            "kurucu": node.kurucu,
            "metodlar": node.metodlar
        }

        -- STEP 1: Generate C Struct Definition
        this._generate_c_struct(sinif_adi, node.ozellikler)

        -- STEP 2: Generate Constructor Function
        if node.kurucu != null
            this._generate_constructor(sinif_adi, node.kurucu)
        end

        -- STEP 3: Generate Method Functions
        for metod in node.metodlar
            this._generate_method(sinif_adi, metod)
        end
    end

    method _generate_c_struct(sinif_adi, ozellikler)
        -- Generates C struct definition
        this.c_structs.push("// SINIF: " + sinif_adi)
        this.c_structs.push("typedef struct {")

        for ozellik in ozellikler
            var tip_deger = HAS_PROPERTY(ozellik.tip, "deger") ? ozellik.tip.deger : ozellik.tip
            var c_tip = this._tyd_tip_to_c_tip(tip_deger)
            this.c_structs.push("    " + c_tip + " " + ozellik.ad + ";")
        end

        this.c_structs.push("} " + sinif_adi + ";")
        this.c_structs.push("")

        this.emit("; C struct '" + sinif_adi + "' tanımlandı")
    end

    method _generate_constructor(sinif_adi, kurucu)
        -- Generates constructor function: ClassName_new()
        var func_name = sinif_adi + "_new"

        var params = []
        for param in kurucu.parametreler
            var c_tip = this._tyd_tip_to_c_tip(HAS_PROPERTY(param.tip, "deger") ? param.tip.deger : param.tip)
            var param_name = HAS_PROPERTY(param.ad, "deger") ? param.ad.deger : param.ad
            params.push(c_tip + " " + param_name)
        end

        var params_str = STRING_JOIN(params, ", ")
        this.c_functions.push("// KURUCU: " + sinif_adi)
        this.c_functions.push(sinif_adi + "* " + func_name + "(" + params_str + ") {")
        this.c_functions.push("    " + sinif_adi + "* self = (" + sinif_adi + "*)mlp_alloc(sizeof(" + sinif_adi + "));")

        this.c_functions.push("    // Field initialization from constructor")
        for komut in kurucu.govde.komutlar
            if TYPE_OF(komut) == "AtamaKomutu"
                var field_name = HAS_PROPERTY(komut.hedef, "ad") ? komut.hedef.ad : string(komut.hedef)
                var value = this._stringify_expression(komut.ifade)
                this.c_functions.push("    self->" + field_name + " = " + value + ";")
            end
        end

        this.c_functions.push("    return self;")
        this.c_functions.push("}")
        this.c_functions.push("")

        this.emit("; Constructor '" + func_name + "' tanımlandı")
    end

    method _generate_method(sinif_adi, metod)
        -- Generates method function: ClassName_methodname(ClassName* self, ...)
        var metod_adi = HAS_PROPERTY(metod.ad, "deger") ? metod.ad.deger : metod.ad
        var func_name = sinif_adi + "_" + metod_adi

        var return_tip = "void"
        if metod.donus_tipi != null
            return_tip = this._tyd_tip_to_c_tip(HAS_PROPERTY(metod.donus_tipi, "deger") ? metod.donus_tipi.deger : metod.donus_tipi)
        end

        var params = [sinif_adi + "* self"]
        for param in metod.parametreler
            var c_tip = this._tyd_tip_to_c_tip(HAS_PROPERTY(param.tip, "deger") ? param.tip.deger : param.tip)
            var param_name = HAS_PROPERTY(param.ad, "deger") ? param.ad.deger : param.ad
            params.push(c_tip + " " + param_name)
        end

        var params_str = STRING_JOIN(params, ", ")
        this.c_functions.push("// METHOD: " + sinif_adi + "." + metod_adi)
        this.c_functions.push(return_tip + " " + func_name + "(" + params_str + ") {")
        this.c_functions.push("    // Method body")
        this.c_functions.push("    // TODO: Implement method body transformation")
        this.c_functions.push("}")
        this.c_functions.push("")

        this.emit("; Method '" + func_name + "' tanımlandı")
    end

    method _tyd_tip_to_c_tip(tyd_tip) -> string
        -- Converts TYD type to C type
        if HAS_METHOD(tyd_tip, "lower")
            tyd_tip = tyd_tip.lower()
        end

        var tip_map = {
            "SAYISAL": "int64_t",
            "sayısal": "int64_t",
            "sayisal": "int64_t",
            "METIN": "char*",
            "metin": "char*",
            "ZITLIK": "int64_t",
            "zıtlık": "int64_t",
            "zitlik": "int64_t"
        }
        return tip_map[tyd_tip] ?? "void*"
    end

    method _stringify_expression(expr) -> string
        -- Converts expression to simple string (for C code)
        if TYPE_OF(expr) == "Sayi"
            return string(expr.deger)
        end
        if TYPE_OF(expr) == "Metin"
            return '"' + expr.deger + '"'
        end
        if TYPE_OF(expr) == "Degisken"
            return expr.ad
        end
        if TYPE_OF(expr) == "IkiliIslem"
            var sol = this._stringify_expression(expr.sol)
            var sag = this._stringify_expression(expr.sag)
            var op_map = {
                "PLUS": "+", "OP_ARTI": "+",
                "MINUS": "-", "OP_EKSI": "-",
                "MUL": "*", "OP_CARP": "*",
                "DIV": "/", "OP_BOL": "/"
            }
            var op = op_map[expr.operator.tip] ?? "?"
            return "(" + sol + " " + op + " " + sag + ")"
        end
        return "/* complex expression */"
    end
end
