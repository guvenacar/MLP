-- ===============================================
-- MLP Code Generator (Assembly Generator)
-- ===============================================
-- Transpiled from: TYD-MLP/src/generator.py
-- Date: 2025-11-14
-- "GOLD COPY" - Array + Heap Supported, Unrefactored Stable Version
-- Walks AST ve generates x86-64 Assembly code

KULLAN ast.ast_nodes
KULLAN lexer.tokens
KULLAN codegen.c_arayuzu

SINIF Generator
    -- Walks AST ve generates complete Assembly code

    ast_koku DİNAMİK
    code DİZİ              -- Generated code (entire output)
    data DİZİ              -- .data section (constants, strings)
    main_kodu DİZİ         -- Instructions inside main function

    -- Scope Management
    degisken_haritalari DİZİ  -- Stack of variable maps (global + local scopes)
    stack_offset SAYISAL

    label_sayaci SAYISAL
    dongu_cikis_etiketleri DİZİ

    islec_haritasi SÖZLÜK
    mevcut_islec DİNAMİK
    c_arayuzu DİNAMİK

    -- Phase 8: OOP Support
    sinif_haritasi SÖZLÜK
    c_structs DİZİ         -- C struct definitions
    c_functions DİZİ       -- C function definitions (KURUCUs, methods)

    KURUCU(ast_koku)
        BU.ast_koku = ast_koku
        BU.code = []
        BU.data = []
        BU.main_kodu = []

        BU.degisken_haritalari = [{}]  -- Start with global scope (main)
        BU.stack_offset = 0

        BU.label_sayaci = 0
        BU.dongu_cikis_etiketleri = []

        BU.islec_haritasi = {}
        BU.mevcut_islec = HİÇLİK

        -- NEW: Initialize C Interface Layer
        BU.c_arayuzu = YENİ CArayuzu(this)

        -- Phase 8: OOP Support
        BU.sinif_haritasi = {}
        BU.c_structs = []
        BU.c_functions = []
    SON

    -- ===============================================
    -- Code Generation Helpers
    -- ===============================================

    IŞLEÇ emit(instruction)
        BU.main_kodu.push("    " + instruction)
    SON

    IŞLEÇ emit_data(data_line)
        BU.data.push("    " + data_line)
    SON

    IŞLEÇ _yeni_etiket() -> METIN
        BU.label_sayaci = BU.label_sayaci + 1
        DÖNÜŞ "_etiket_" + METIN(BU.label_sayaci)
    SON

    -- ===============================================
    -- Scope ve Memory Helpers
    -- ===============================================

    IŞLEÇ _kapsam_gir()
        BU.degisken_haritalari.push({})
        BU.stack_offset = 0
    SON

    IŞLEÇ _kapsam_cik()
        EĞER UZUNLUK(BU.degisken_haritalari) > 1
            BU.degisken_haritalari.pop()
        SON
        BU.stack_offset = 0
    SON

    IŞLEÇ _degisken_adres_bul(degisken_adi) -> SÖZLÜK
        -- Returns variable's address/size dictionary
        mevcut_kapsam = BU.degisken_haritalari[UZUNLUK(BU.degisken_haritalari) - 1];
        EĞER degisken_adi İÇİNDE mevcut_kapsam
            DÖNÜŞ mevcut_kapsam[degisken_adi]
        SON
        EĞER degisken_adi İÇİNDE BU.degisken_haritalari[0]
            DÖNÜŞ BU.degisken_haritalari[0][degisken_adi]
        SON
        HATA_FIRLAT YENİ Exception("[Generator] Tanımlanmamış değişken: " + degisken_adi)
    SON

    IŞLEÇ _degisken_yer_ayir(degisken_adi, adres, boyut) -> SÖZLÜK
        -- Allocates space on stack HER variable/DİZİ
        -- Stores info as {'adres': '...', 'boyut': X}
        mevcut_kapsam = BU.degisken_haritalari[UZUNLUK(BU.degisken_haritalari) - 1];

        EĞER degisken_adi İÇİNDE mevcut_kapsam
            HATA_FIRLAT YENİ Exception("[Generator] Değişken '" + degisken_adi + "' bu kapsamda zaten tanımlı.")
        SON

        EĞER adres == HİÇLİK
            -- LOCAL VARIABLE veya ARRAY
            toplam_byte_boyutu = boyut * 8;
            BU.stack_offset = BU.stack_offset - toplam_byte_boyutu
            adres = "[rbp" + METIN(BU.stack_offset) + "]";
            BU.emit("sub rsp, " + METIN(toplam_byte_boyutu) + "  ; '" + degisken_adi + "' içİÇİNDE yığında " + METIN(toplam_byte_boyutu) + " byte yer aç")
        SON

        mevcut_kapsam[degisken_adi] = {
            "adres": adres,
            "boyut": boyut
        }
        DÖNÜŞ mevcut_kapsam[degisken_adi]
    SON

    -- ===============================================
    -- Main Generation Functions
    -- ===============================================

    IŞLEÇ generate() -> METIN
        -- Walks entire AST ve returns complete Assembly code

        -- C library setup (now comes from C_Arayuzu)
        extern_decls = BU.c_arayuzu.generate_extern_bildirimleri();
        HER decl İÇİNDE extern_decls
            BU.code.push(decl)
        SON

        BU.emit_data('format_sayi db "%d", 10, 0')
        BU.emit_data('format_metin db "%s", 10, 0')

        BU.visit(BU.ast_koku)

        -- Phase 8: OOP - Add C Struct ve Function definitions
        EĞER UZUNLUK(BU.c_structs) > 0 veya UZUNLUK(BU.c_functions) > 0
            BU.code.insert(0, "; ========================================")
            BU.code.insert(1, "; Phase 8: OOP - C Code Generation")
            BU.code.insert(2, "; ========================================")
            BU.code.insert(3, ";")

            EĞER UZUNLUK(BU.c_structs) > 0
                BU.code.insert(4, "; --- C Struct Definitions ---")
                HER i = 0 to UZUNLUK(BU.c_structs) - 1
                    BU.code.insert(5 + i, "; " + BU.c_structs[i])
                SON
                BU.code.insert(5 + UZUNLUK(BU.c_structs), ";")
            SON

            EĞER UZUNLUK(BU.c_functions) > 0
                insert_pos = 5 + UZUNLUK(BU.c_structs) + 1;
                BU.code.insert(insert_pos, "; --- C Function Definitions ---")
                HER i = 0 to UZUNLUK(BU.c_functions) - 1
                    BU.code.insert(insert_pos + 1 + i, "; " + BU.c_functions[i])
                SON
                BU.code.insert(insert_pos + 1 + UZUNLUK(BU.c_functions), ";")
            SON

            BU.code.push("; ========================================")
            BU.code.push("")
        SON

        BU.code.push("\nsection .data")
        HER line İÇİNDE BU.data
            BU.code.push(line)
        SON

        BU.code.push("\nsection .text")
        BU.code.push("global main")
        BU.code.push("main:")
        BU.code.push("    push rbp")
        BU.code.push("    mov rbp, rsp")

        HER line İÇİNDE BU.main_kodu
            BU.code.push(line)
        SON

        BU.code.push("    mov rsp, rbp")
        BU.code.push("    pop rbp")
        BU.code.push("    ret")

        DÖNÜŞ STRING_JOIN(BU.code, "\n")
    SON

    IŞLEÇ visit(node)
        -- Visitor pattern dispatcher

        -- 0. SinifTanimlama? (Phase 8: OOP)
        EĞER TYPE_OF(node) == "SinifTanimlama"
            BU.visit_SinifTanimlama(node)
            return
        SON

        -- 1. IslecTanimlama?
        EĞER TYPE_OF(node) == "IslecTanimlama"
            BU.visit_IslecTanimlama(node)
            return
        SON

        -- 2. DiziTanimlama?
        EĞER TYPE_OF(node) == "DiziTanimlama"
            BU.visit_DiziTanimlama(node)
            return
        SON

        -- 3. Call IŞLEÇ by name (e.g., visit_DegiskenTanimlama)
        method_name = "visit_" + TYPE_OF(node);
        EĞER HAS_METHOD(this, method_name)
            DÖNÜŞ CALL_METHOD(this, method_name, node)
        DEĞILSE
            DÖNÜŞ BU.visit_bilinmeyen(node)
        SON
    SON

    IŞLEÇ visit_bilinmeyen(node)
        HATA_FIRLAT YENİ Exception("[Generator] Tanınmayan AST Düğümü: " + TYPE_OF(node))
    SON

    -- ===============================================
    -- Visitor Functions (Statements)
    -- ===============================================

    IŞLEÇ visit_Blok(node)
        HER komut İÇİNDE node.komutlar
            BU.visit(komut)
        SON
    SON

    IŞLEÇ visit_DegiskenTanimlama(node)
        degisken_adi = node.ad;
        BU.emit("; --- DegiskenTanimlama: " + degisken_adi + " ---")
        BU.visit(node.ifade)  -- Calculate value (rax)
        adres_bilgisi = BU._degisken_yer_ayir(degisken_adi, HİÇLİK, 1);
        adres = adres_bilgisi["adres"];
        BU.emit("mov " + adres + ", rax")
    SON

    IŞLEÇ visit_DiziTanimlama(node)
        degisken_adi = node.ad.deger;
        EĞER TYPE_OF(node.boyut) != "Sayi"
            HATA_FIRLAT YENİ Exception("Dizi boyutu şimdilik sadece sabit bir sayı olmalıdır.")
        SON
        boyut = PARSE_INT(METIN(node.boyut.deger));
        EĞER boyut <= 0
            HATA_FIRLAT YENİ Exception("Dizi boyutu pozitif olmalıdır.")
        SON
        BU.emit("; --- Dizi Tanımlama: " + degisken_adi + "[" + METIN(boyut) + "] ---")
        BU._degisken_yer_ayir(degisken_adi, HİÇLİK, boyut)
    SON

    IŞLEÇ visit_AtamaKomutu(node)
        BU.emit("; --- AtamaKomutu ---")

        -- 1. Calculate assigned value (right side) ve save to stack
        BU.visit(node.ifade)
        BU.emit("push rax  ; Atanacak değeri koru")

        -- 2. Determine target (left side)

        EĞER TYPE_OF(node.hedef) == "Degisken"
            -- Target: Simple Variable
            BU.emit("pop rax")
            degisken_adi = node.hedef.ad;
            adres_bilgisi = BU._degisken_adres_bul(degisken_adi);
            adres = adres_bilgisi["adres"];
            BU.emit("mov " + adres + ", rax  ; " + degisken_adi + " = (sonuç)")
        SON

        EĞER TYPE_OF(node.hedef) == "DiziErisim"
            -- Target: Array Access
            BU.emit("; --- Dizi Erişimi (Yazma) [ ] ---")

            dizi_adi = node.hedef.hedef.ad;
            adres_bilgisi = BU._degisken_adres_bul(dizi_adi);
            dizi_baslangic_adresi_str = adres_bilgisi["adres"];

            BU.visit(node.hedef.indeks)
            BU.emit("mov rdi, rax")
            BU.emit("shl rdi, 3")
            BU.emit("lea rax, " + dizi_baslangic_adresi_str)
            BU.emit("add rax, rdi  ; RAX = Elemanın Tam Adresi")

            BU.emit("mov rdi, rax  ; Hedef adresi RDI'a taşı")
            BU.emit("pop rax       ; Atanacak değeri yığından geri al")
            BU.emit("mov [rdi], rax")
        SON

        EĞER TYPE_OF(node.hedef) == "SozlukErisim"
            -- Target: Dictionary Access
            BU.emit("; --- Sözlük Erişimi (Yazma) {{ }} ---")
            BU.emit("pop rsi ; Atanacak değeri RSI'a al")
            BU.c_arayuzu.visit(node.hedef.anahtar)
            BU.emit("mov rdi, rax ; Anahtarı RDI'a al")
            BU.emit("mov rax, 0")
            BU.emit("call sozluk_ekle")
        SON
    SON

    IŞLEÇ visit_EgerBlogu(node)
        degilse_etiketi = BU._yeni_etiket();
        son_etiket = BU._yeni_etiket();
        BU.visit(node.kosul)
        BU.emit("cmp rax, 0")
        hedef_etiket = node.yanlis_blok != HİÇLİK ? degilse_etiketi : son_etiket;
        BU.emit("je " + hedef_etiket)
        BU.visit(node.dogru_blok)
        EĞER node.yanlis_blok != HİÇLİK
            BU.emit("jmp " + son_etiket)
            BU.emit(degilse_etiketi + ":")
            BU.visit(node.yanlis_blok)
        SON
        BU.emit(son_etiket + ":")
    SON

    IŞLEÇ visit_DonguBlogu(node)
        basi_etiketi = BU._yeni_etiket();
        sonu_etiketi = BU._yeni_etiket();
        BU.dongu_cikis_etiketleri.push(sonu_etiketi)
        BU.emit(basi_etiketi + ":")
        BU.visit(node.blok)
        BU.emit("jmp " + basi_etiketi)
        BU.emit(sonu_etiketi + ":")
        BU.dongu_cikis_etiketleri.pop()
    SON

    IŞLEÇ visit_DonguBitirKomutu(node)
        EĞER UZUNLUK(BU.dongu_cikis_etiketleri) == 0
            HATA_FIRLAT YENİ Exception("[Generator] 'DÖNGÜ_BITIR' komutu bir 'DÖNGÜ' bloğu içinde olmalıdır.")
        SON
        BU.emit("jmp " + BU.dongu_cikis_etiketleri[UZUNLUK(BU.dongu_cikis_etiketleri) - 1])
    SON

    IŞLEÇ visit_IslecTanimlama(node)
        islec_adi = node.ad.deger;
        asm_etiketi = "_islec_" + islec_adi;
        BU.islec_haritasi[islec_adi] = asm_etiketi

        islec_kodu = [];
        islec_kodu.push("\n; --- İŞLEÇ Tanımı: " + islec_adi + " ---")
        islec_kodu.push(asm_etiketi + ":")
        islec_kodu.push("    push rbp")
        islec_kodu.push("    mov rbp, rsp")

        BU._kapsam_gir()
        BU.mevcut_islec = node

        HER i = 0 to UZUNLUK(node.parametreler) - 1
            param = node.parametreler[i];
            param_adi = param.ad.deger;
            adres = "[rbp+" + METIN(16 + i * 8) + "]";
            BU._degisken_yer_ayir(param_adi, adres, 1)
        SON

        eski_main_kodu = BU.main_kodu;
        BU.main_kodu = islec_kodu
        BU.visit(node.govde)
        BU.main_kodu = eski_main_kodu

        islec_kodu.push("; " + islec_adi + " içİÇİNDE örtük epilog")
        islec_kodu.push("    mov rsp, rbp")
        islec_kodu.push("    pop rbp")
        islec_kodu.push("    ret")

        HER line İÇİNDE islec_kodu
            BU.code.push(line)
        SON

        BU.mevcut_islec = HİÇLİK
        BU._kapsam_cik()
    SON

    IŞLEÇ visit_DonusKomutu(node)
        EĞER BU.mevcut_islec == HİÇLİK
            HATA_FIRLAT YENİ Exception("'DÖNÜŞ' komutu sadece İŞLEÇ içinde kullanılabilir.")
        SON
        BU.visit(node.ifade)
        BU.emit("    mov rsp, rbp")
        BU.emit("    pop rbp")
        BU.emit("    ret")
    SON

    IŞLEÇ visit_IfadeKomutu(node)
        BU.visit(node.ifade)
    SON

    IŞLEÇ visit_YazdirKomutu(node)
        BU.emit("; --- YAZDIR Başlangıç (C Arayüzüne delege edildi) ---")
        BU.c_arayuzu.generate_c_call("YAZDIR", node)
    SON

    -- ===============================================
    -- Expression Visitors
    -- ===============================================

    IŞLEÇ visit_Sayi(node)
        BU.emit("mov rax, " + METIN(node.deger))
    SON

    IŞLEÇ visit_Metin(node)
        data_label = "str_" + METIN(UZUNLUK(BU.data));
        BU.emit_data(data_label + ' db "' + node.deger + '", 0')
        BU.emit("mov rax, " + data_label)
    SON

    IŞLEÇ visit_Degisken(node)
        degisken_adi = node.ad;
        adres_bilgisi = BU._degisken_adres_bul(degisken_adi);
        EĞER adres_bilgisi["boyut"] > 1
            HATA_FIRLAT YENİ Exception("HATA: '" + degisken_adi + "' bir dizidir. Elemanına ([i]) erişin.")
        SON
        adres = adres_bilgisi["adres"];
        BU.emit("mov rax, " + adres)
    SON

    IŞLEÇ visit_DiziErisim(node)
        BU.emit("; --- Dizi Erişimi (Okuma) [ ] ---")

        dizi_adi = node.hedef.ad;
        adres_bilgisi = BU._degisken_adres_bul(dizi_adi);
        dizi_baslangic_adresi_str = adres_bilgisi["adres"];

        BU.visit(node.indeks)
        BU.emit("mov rdi, rax")
        BU.emit("shl rdi, 3")
        BU.emit("lea rax, " + dizi_baslangic_adresi_str)
        BU.emit("add rax, rdi")
        BU.emit("mov rax, [rax]")
    SON

    IŞLEÇ visit_SozlukErisim(node)
        BU.emit("; --- Sözlük Erişimi (Okuma) {{ }} ---")
        BU.c_arayuzu.generate_sozluk_getir(node.anahtar)
    SON

    IŞLEÇ visit_IslecCagirma(node)
        islec_adi = node.hedef_token.deger;
        BU.emit("; --- İŞLEÇ Çağırma: " + islec_adi + " ---")

        -- 1. Is this a magic C function?
        EĞER BU.c_arayuzu.is_c_function(islec_adi)
            BU.c_arayuzu.generate_c_call(islec_adi, node)
            return
        SON

        -- 2. Is this a TYD-MLP function we defined?
        EĞER islec_adi İÇİNDE BU.islec_haritasi
            asm_etiketi = BU.islec_haritasi[islec_adi];

            -- Prepare arguments HER TYD-MLP protocol (stack)
            arg_sayisi = UZUNLUK(node.argumanlar);
            HER i = arg_sayisi - 1 to 0 step -1
                BU.visit(node.argumanlar[i])
                BU.emit("push rax")
            SON

            BU.emit("call " + asm_etiketi)

            -- Clean stack
            EĞER arg_sayisi > 0
                BU.emit("add rsp, " + METIN(arg_sayisi * 8) + "  ; Yığını temizle")
            SON
            return
        SON

        -- 3. Not found
        HATA_FIRLAT YENİ Exception("Tanımsız İŞLEÇ çağrıldı: " + islec_adi)
    SON

    IŞLEÇ visit_IkiliIslem(node)
        BU.visit(node.sag)
        BU.emit("push rax")
        BU.visit(node.sol)
        BU.emit("pop rbx")

        op = node.operator.tip;

        EĞER op == TOKEN_TIPLERI["PLUS"] veya op == TOKEN_TIPLERI["OP_ARTI"]
            BU.emit("add rax, rbx")
        SON

        EĞER op == TOKEN_TIPLERI["MINUS"] veya op == TOKEN_TIPLERI["OP_EKSI"]
            BU.emit("sub rax, rbx")
        SON

        EĞER op == TOKEN_TIPLERI["MUL"] veya op == TOKEN_TIPLERI["OP_CARP"]
            BU.emit("imul rax, rbx")
        SON

        EĞER op == TOKEN_TIPLERI["DIV"] veya op == TOKEN_TIPLERI["OP_BOL"]
            BU.emit("xor rdx, rdx")
            BU.emit("idiv rbx")
        SON

        EĞER op == TOKEN_TIPLERI["OP_ESIT"] veya op == TOKEN_TIPLERI["OP_GT"] veya op == TOKEN_TIPLERI["OP_LT"]
            BU.emit("cmp rax, rbx")
            EĞER op == TOKEN_TIPLERI["OP_ESIT"]
                BU.emit("sete al")
            SON
            EĞER op == TOKEN_TIPLERI["OP_GT"]
                BU.emit("setg al")
            SON
            EĞER op == TOKEN_TIPLERI["OP_LT"]
                BU.emit("setl al")
            SON
            BU.emit("movzx rax, al")
        SON
    SON

    -- ===============================================
    -- Phase 8: OOP Support
    -- ===============================================

    IŞLEÇ visit_SinifTanimlama(node)
        -- SINIF → C Struct + Constructor + Methods
        sinif_adi = node.ad;
        BU.emit("; --- SINIF Tanımı: " + sinif_adi + " ---")

        BU.sinif_haritasi[sinif_adi] = {
            "ozellikler": node.ozellikler,
            "kurucu": node.kurucu,
            "metodlar": node.metodlar
        }

        -- STEP 1: Generate C Struct Definition
        BU._generate_c_struct(sinif_adi, node.ozellikler)

        -- STEP 2: Generate Constructor Function
        EĞER node.kurucu != HİÇLİK
            BU._generate_constructor(sinif_adi, node.kurucu)
        SON

        -- STEP 3: Generate Method Functions
        HER metod İÇİNDE node.metodlar
            BU._generate_method(sinif_adi, metod)
        SON
    SON

    IŞLEÇ _generate_c_struct(sinif_adi, ozellikler)
        -- Generates C struct definition
        BU.c_structs.push("// SINIF: " + sinif_adi)
        BU.c_structs.push("typedef struct {")

        HER ozellik İÇİNDE ozellikler
            tip_deger = HAS_PROPERTY(ozellik.tip, "deger") ? ozellik.tip.deger : ozellik.tip;
            c_tip = BU._tyd_tip_to_c_tip(tip_deger);
            BU.c_structs.push("    " + c_tip + " " + ozellik.ad + ";")
        SON

        BU.c_structs.push("} " + sinif_adi + ";")
        BU.c_structs.push("")

        BU.emit("; C struct '" + sinif_adi + "' tanımlandı")
    SON

    IŞLEÇ _generate_constructor(sinif_adi, kurucu)
        -- Generates KURUCU function: ClassName_new()
        func_name = sinif_adi + "_new";

        params = [];
        HER param İÇİNDE kurucu.parametreler
            c_tip = BU._tyd_tip_to_c_tip(HAS_PROPERTY(param.tip, "deger") ? param.tip.deger : param.tip);
            param_name = HAS_PROPERTY(param.ad, "deger") ? param.ad.deger : param.ad;
            params.push(c_tip + " " + param_name)
        SON

        params_str = STRING_JOIN(params, ", ");
        BU.c_functions.push("// KURUCU: " + sinif_adi)
        BU.c_functions.push(sinif_adi + "* " + func_name + "(" + params_str + ") {")
        BU.c_functions.push("    " + sinif_adi + "* self = (" + sinif_adi + "*)mlp_alloc(sizeof(" + sinif_adi + "));")

        BU.c_functions.push("    // Field initialization from KURUCU")
        HER komut İÇİNDE kurucu.govde.komutlar
            EĞER TYPE_OF(komut) == "AtamaKomutu"
                field_name = HAS_PROPERTY(komut.hedef, "ad") ? komut.hedef.ad : METIN(komut.hedef);
                value = BU._stringify_expression(komut.ifade);
                BU.c_functions.push("    self->" + field_name + " = " + value + ";")
            SON
        SON

        BU.c_functions.push("    DÖNÜŞ self;")
        BU.c_functions.push("}")
        BU.c_functions.push("")

        BU.emit("; Constructor '" + func_name + "' tanımlandı")
    SON

    IŞLEÇ _generate_method(sinif_adi, metod)
        -- Generates IŞLEÇ function: ClassName_methodname(ClassName* self, ...)
        metod_adi = HAS_PROPERTY(metod.ad, "deger") ? metod.ad.deger : metod.ad;
        func_name = sinif_adi + "_" + metod_adi;

        return_tip = "void";
        EĞER metod.donus_tipi != HİÇLİK
            return_tip = BU._tyd_tip_to_c_tip(HAS_PROPERTY(metod.donus_tipi, "deger") ? metod.donus_tipi.deger : metod.donus_tipi);
        SON

        params = [sinif_adi + "* self"];
        HER param İÇİNDE metod.parametreler
            c_tip = BU._tyd_tip_to_c_tip(HAS_PROPERTY(param.tip, "deger") ? param.tip.deger : param.tip);
            param_name = HAS_PROPERTY(param.ad, "deger") ? param.ad.deger : param.ad;
            params.push(c_tip + " " + param_name)
        SON

        params_str = STRING_JOIN(params, ", ");
        BU.c_functions.push("// METHOD: " + sinif_adi + "." + metod_adi)
        BU.c_functions.push(return_tip + " " + func_name + "(" + params_str + ") {")
        BU.c_functions.push("    // Method body")
        BU.c_functions.push("    // TODO: Implement IŞLEÇ body transformation")
        BU.c_functions.push("}")
        BU.c_functions.push("")

        BU.emit("; Method '" + func_name + "' tanımlandı")
    SON

    IŞLEÇ _tyd_tip_to_c_tip(tyd_tip) -> METIN
        -- Converts TYD type to C type
        EĞER HAS_METHOD(tyd_tip, "lower")
            tyd_tip = tyd_tip.lower();
        SON

        tip_map = {;
            "SAYISAL": "int64_t",
            "sayısal": "int64_t",
            "sayisal": "int64_t",
            "METIN": "char*",
            "metin": "char*",
            "ZITLIK": "int64_t",
            "zıtlık": "int64_t",
            "zitlik": "int64_t"
        }
        DÖNÜŞ tip_map[tyd_tip] ?? "void*"
    SON

    IŞLEÇ _stringify_expression(expr) -> METIN
        -- Converts expression to simple METIN (HER C code)
        EĞER TYPE_OF(expr) == "Sayi"
            DÖNÜŞ METIN(expr.deger)
        SON
        EĞER TYPE_OF(expr) == "Metin"
            DÖNÜŞ '"' + expr.deger + '"'
        SON
        EĞER TYPE_OF(expr) == "Degisken"
            DÖNÜŞ expr.ad
        SON
        EĞER TYPE_OF(expr) == "IkiliIslem"
            sol = BU._stringify_expression(expr.sol);
            sag = BU._stringify_expression(expr.sag);
            op_map = {;
                "PLUS": "+", "OP_ARTI": "+",
                "MINUS": "-", "OP_EKSI": "-",
                "MUL": "*", "OP_CARP": "*",
                "DIV": "/", "OP_BOL": "/"
            }
            op = op_map[expr.operator.tip] ?? "?";
            DÖNÜŞ "(" + sol + " " + op + " " + sag + ")"
        SON
        DÖNÜŞ "/* complex expression */"
    SON
SON
