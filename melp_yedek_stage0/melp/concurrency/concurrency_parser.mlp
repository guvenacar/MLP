-- Concurrency Parser Sabitleri
-- Thread ve synchronization parsing

-- Thread declaration parse durumları
numeric PARSE_THREAD_KEYWORD = 0   -- thread keyword
numeric PARSE_THREAD_NAME = 1      -- Thread adı
numeric PARSE_THREAD_ARGS = 2      -- Argümanlar
numeric PARSE_THREAD_BODY = 3      -- Thread body
numeric PARSE_THREAD_COMPLETE = 4  -- Parse tamamlandı

-- Mutex declaration parse durumları
numeric PARSE_MUTEX_KEYWORD = 10   -- mutex keyword
numeric PARSE_MUTEX_TYPE = 11      -- Mutex türü
numeric PARSE_MUTEX_NAME = 12      -- Mutex adı
numeric PARSE_MUTEX_COMPLETE = 13  -- Parse tamamlandı

-- Semaphore parse durumları
numeric PARSE_SEM_KEYWORD = 20     -- semaphore keyword
numeric PARSE_SEM_TYPE = 21        -- Type (binary/counting)
numeric PARSE_SEM_INIT_VAL = 22    -- Initial value
numeric PARSE_SEM_MAX_VAL = 23     -- Max value
numeric PARSE_SEM_NAME = 24        -- Semaphore adı
numeric PARSE_SEM_COMPLETE = 25    -- Parse tamamlandı

-- Condition variable parse durumları
numeric PARSE_CV_KEYWORD = 30      -- condvar keyword
numeric PARSE_CV_MUTEX = 31        -- İlişkili mutex
numeric PARSE_CV_NAME = 32         -- Condvar adı
numeric PARSE_CV_COMPLETE = 33     -- Parse tamamlandı

-- Barrier parse durumları
numeric PARSE_BAR_KEYWORD = 40     -- barrier keyword
numeric PARSE_BAR_THRESHOLD = 41   -- Threshold değeri
numeric PARSE_BAR_NAME = 42        -- Barrier adı
numeric PARSE_BAR_COMPLETE = 43    -- Parse tamamlandı

-- RWLock parse durumları
numeric PARSE_RW_KEYWORD = 50      -- rwlock keyword
numeric PARSE_RW_NAME = 51         -- RWLock adı
numeric PARSE_RW_COMPLETE = 52     -- Parse tamamlandı

-- Thread pool parse durumları
numeric PARSE_POOL_KEYWORD = 60    -- thread_pool keyword
numeric PARSE_POOL_SIZE = 61       -- Pool boyutu
numeric PARSE_POOL_NAME = 62       -- Pool adı
numeric PARSE_POOL_COMPLETE = 63   -- Parse tamamlandı

-- Lock operation parse
numeric PARSE_LOCK_KEYWORD = 70    -- lock keyword
numeric PARSE_LOCK_TARGET = 71     -- Lock hedefi (mutex/rwlock)
numeric PARSE_LOCK_TYPE = 72       -- Lock türü (read/write)
numeric PARSE_LOCK_COMPLETE = 73   -- Parse tamamlandı

-- Unlock operation parse
numeric PARSE_UNLOCK_KEYWORD = 80  -- unlock keyword
numeric PARSE_UNLOCK_TARGET = 81   -- Unlock hedefi
numeric PARSE_UNLOCK_COMPLETE = 82 -- Parse tamamlandı

-- Wait operation parse
numeric PARSE_WAIT_KEYWORD = 90    -- wait keyword
numeric PARSE_WAIT_TARGET = 91     -- Wait hedefi (sem/cv/barrier)
numeric PARSE_WAIT_TIMEOUT = 92    -- Timeout değeri
numeric PARSE_WAIT_COMPLETE = 93   -- Parse tamamlandı

-- Signal operation parse
numeric PARSE_SIGNAL_KEYWORD = 100 -- signal keyword
numeric PARSE_SIGNAL_TARGET = 101  -- Signal hedefi
numeric PARSE_SIGNAL_TYPE = 102    -- Signal türü (one/all)
numeric PARSE_SIGNAL_COMPLETE = 103 -- Parse tamamlandı

-- Thread operation parse
numeric PARSE_TSTART_KEYWORD = 110 -- thread_start keyword
numeric PARSE_TJOIN_KEYWORD = 111  -- thread_join keyword
numeric PARSE_TDETACH_KEYWORD = 112 -- thread_detach keyword
numeric PARSE_TEXIT_KEYWORD = 113  -- thread_exit keyword
numeric PARSE_TYIELD_KEYWORD = 114 -- thread_yield keyword
numeric PARSE_TCANCEL_KEYWORD = 115 -- thread_cancel keyword

-- Atomic operation parse
numeric PARSE_ATOMIC_KEYWORD = 120 -- atomic keyword
numeric PARSE_ATOMIC_OP = 121      -- Operation türü
numeric PARSE_ATOMIC_TARGET = 122  -- Hedef değişken
numeric PARSE_ATOMIC_VALUE = 123   -- Değer
numeric PARSE_ATOMIC_COMPLETE = 124 -- Parse tamamlandı

-- Keyword tanıma
numeric KW_THREAD = 200            -- thread
numeric KW_MUTEX = 201             -- mutex
numeric KW_SEMAPHORE = 202         -- semaphore
numeric KW_CONDVAR = 203           -- condvar
numeric KW_BARRIER = 204           -- barrier
numeric KW_RWLOCK = 205            -- rwlock
numeric KW_THREAD_POOL = 206       -- thread_pool
numeric KW_LOCK = 207              -- lock
numeric KW_UNLOCK = 208            -- unlock
numeric KW_WAIT = 209              -- wait
numeric KW_SIGNAL = 210            -- signal
numeric KW_BROADCAST = 211         -- broadcast
numeric KW_ATOMIC = 212            -- atomic

-- Type keywords
numeric KW_BINARY = 220            -- binary
numeric KW_COUNTING = 221          -- counting
numeric KW_READ = 222              -- read
numeric KW_WRITE = 223             -- write
numeric KW_SPINLOCK = 224          -- spinlock

-- Syntax kontrol
numeric SYNTAX_THREAD_DECL = 1     -- Thread declaration syntax
numeric SYNTAX_LOCK_BALANCED = 1   -- Lock/unlock dengelenmeli

-- Parse hata kodları
numeric ERROR_MISSING_KEYWORD = 1  -- Keyword eksik
numeric ERROR_INVALID_TYPE = 2     -- Geçersiz tür
numeric ERROR_MISSING_NAME = 3     -- İsim eksik
numeric ERROR_INVALID_VALUE = 4    -- Geçersiz değer
numeric ERROR_UNBALANCED_LOCK = 5  -- Lock/unlock dengesiz
numeric ERROR_DEADLOCK_RISK = 6    -- Deadlock riski
numeric ERROR_INVALID_TARGET = 7   -- Geçersiz hedef

-- Context tracking
numeric CTX_IN_THREAD = 300        -- Thread içinde
numeric CTX_IN_CRITICAL = 301      -- Critical section içinde
numeric CTX_IN_ATOMIC = 302        -- Atomic block içinde
