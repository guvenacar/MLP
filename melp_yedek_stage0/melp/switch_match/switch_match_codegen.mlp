-- Switch/Match Codegen Modülü
-- Assembly üretimi sabitleri

-- Register kullanımı
numeric REG_SWITCH_VALUE = 0        -- rax: switch değeri
numeric REG_JUMP_TABLE = 1          -- rbx: jump table base
numeric REG_CASE_INDEX = 2          -- rcx: case index

-- Optimizasyon eşikleri
numeric JUMP_TABLE_MIN_CASES = 10   -- Jump table için min case sayısı
numeric BINARY_SEARCH_MIN = 7       -- Binary search için min case

-- Label tipleri
numeric LABEL_CASE = 0
numeric LABEL_DEFAULT = 1
numeric LABEL_END = 2
numeric LABEL_FALL_THROUGH = 3

-- Karşılaştırma operasyonları
numeric CMP_EQUAL = 0               -- ==
numeric CMP_RANGE = 1               -- x..y
numeric CMP_CONDITION = 2           -- when expr
