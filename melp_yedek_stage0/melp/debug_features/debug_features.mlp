-- Debug Features Modülü - Debug Özellikleri
-- debug label, goto, pause, print, if - production'da strip

-- Debug mode
numeric DEBUG_OFF = 0                -- Production (debug kod silinir)
numeric DEBUG_ON = 1                 -- Debug mode aktif

-- Debug statement tipi
numeric DEBUG_LABEL = 0              -- debug cikis
numeric DEBUG_GOTO = 1               -- debug goto cikis
numeric DEBUG_PAUSE = 2              -- debug pause (breakpoint)
numeric DEBUG_PRINT = 3              -- debug print x
numeric DEBUG_IF = 4                 -- debug if ... debug end if

-- Goto tipi
numeric GOTO_UNCONDITIONAL = 0       -- Koşulsuz
numeric GOTO_CONDITIONAL = 1         -- debug if içinde

-- Pause tipi
numeric PAUSE_SIMPLE = 0             -- debug pause
numeric PAUSE_WITH_MESSAGE = 1       -- debug pause "message"
numeric PAUSE_CONDITIONAL = 2        -- debug if içinde pause

-- Debug if içerik
numeric IF_CONTAINS_GOTO = 1         -- goto var
numeric IF_CONTAINS_PAUSE = 2        -- pause var
numeric IF_CONTAINS_PRINT = 4        -- print var

-- Production strip
numeric STRIP_ALL = 1                -- Tüm debug kod silinir
numeric STRIP_NONE = 0               -- Debug kod korunur

-- Debug keyword prefix (sadece belirli keyword'lerde)
numeric PREFIX_REQUIRED = 1          -- Tek başına: debug gerekli
numeric PREFIX_NOT_REQUIRED = 0      -- Debug bloğu içinde: debug gerekmez
