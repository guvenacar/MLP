-- Null Safety Parser Modülü
-- Parse işlemleri sabitleri

-- Optional parse durumları
numeric PARSE_OPT_TYPE = 0
numeric PARSE_OPT_QUESTION = 1      -- numeric? için ?
numeric PARSE_OPT_NAME = 2
numeric PARSE_OPT_ASSIGN = 3
numeric PARSE_OPT_VALUE = 4

-- Null kontrol parse
numeric PARSE_NULL_EXPR = 0
numeric PARSE_NULL_OP = 1           -- ==, !=
numeric PARSE_NULL_NULL = 2         -- null keyword

-- Null-coalescing parse
numeric PARSE_COAL_LEFT = 0
numeric PARSE_COAL_DOUBLE_Q = 1     -- ??
numeric PARSE_COAL_RIGHT = 2

-- Safe navigation parse
numeric PARSE_SAFE_OBJ = 0
numeric PARSE_SAFE_QUESTION = 1     -- ?
numeric PARSE_SAFE_DOT = 2          -- .
numeric PARSE_SAFE_MEMBER = 3
numeric PARSE_SAFE_CHAIN = 4        -- a?.b?.c için

-- Null assertion parse
numeric PARSE_ASSERT_EXPR = 0
numeric PARSE_ASSERT_BANG = 1       -- !
numeric PARSE_ASSERT_MSG = 2        -- Optional mesaj
