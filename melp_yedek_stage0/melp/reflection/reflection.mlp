-- Reflection Module Sabitleri
-- Runtime type information için temel sabitler

-- Type kategorileri
numeric TYPE_PRIMITIVE = 0         -- int, float, bool, vb.
numeric TYPE_STRUCT = 1            -- Struct types
numeric TYPE_ENUM = 2              -- Enum types
numeric TYPE_ARRAY = 3             -- Array types
numeric TYPE_POINTER = 4           -- Pointer types
numeric TYPE_FUNCTION = 5          -- Function types
numeric TYPE_INTERFACE = 6         -- Interface/Trait types
numeric TYPE_GENERIC = 7           -- Generic types

-- Primitive types
numeric PRIM_INT8 = 0
numeric PRIM_INT16 = 1
numeric PRIM_INT32 = 2
numeric PRIM_INT64 = 3
numeric PRIM_UINT8 = 4
numeric PRIM_UINT16 = 5
numeric PRIM_UINT32 = 6
numeric PRIM_UINT64 = 7
numeric PRIM_FLOAT32 = 8
numeric PRIM_FLOAT64 = 9
numeric PRIM_BOOL = 10
numeric PRIM_CHAR = 11
numeric PRIM_STRING = 12
numeric PRIM_VOID = 13

-- Type flags
numeric TYPE_FLAG_CONST = 1        -- Const qualifier (1 << 0)
numeric TYPE_FLAG_VOLATILE = 2     -- Volatile qualifier (1 << 1)
numeric TYPE_FLAG_MUTABLE = 4      -- Mutable (1 << 2)
numeric TYPE_FLAG_PUBLIC = 8       -- Public visibility (1 << 3)
numeric TYPE_FLAG_PRIVATE = 16     -- Private visibility (1 << 4)

-- Field flags
numeric FIELD_PUBLIC = 8           -- Public field
numeric FIELD_PRIVATE = 16         -- Private field
numeric FIELD_STATIC = 32          -- Static field
numeric FIELD_READONLY = 64        -- Read-only field

-- Method flags
numeric METHOD_PUBLIC = 8          -- Public method
numeric METHOD_PRIVATE = 16        -- Private method
numeric METHOD_STATIC = 32         -- Static method
numeric METHOD_VIRTUAL = 64        -- Virtual method
numeric METHOD_ABSTRACT = 128      -- Abstract method

-- Reflection operation sonuçları
numeric REFL_SUCCESS = 0           -- Başarılı
numeric REFL_ERROR = 1             -- Hata
numeric REFL_NOT_FOUND = 2         -- Bulunamadı
numeric REFL_TYPE_MISMATCH = 3     -- Tip uyuşmazlığı
numeric REFL_ACCESS_DENIED = 4     -- Erişim engellendi

-- Type compatibility
numeric COMPAT_EXACT = 0           -- Tam uyumlu
numeric COMPAT_CONVERTIBLE = 1     -- Dönüştürülebilir
numeric COMPAT_INCOMPATIBLE = 2    -- Uyumsuz

-- Cast türleri
numeric CAST_STATIC = 0            -- Static cast
numeric CAST_DYNAMIC = 1           -- Dynamic cast
numeric CAST_REINTERPRET = 2       -- Reinterpret cast

-- Query türleri
numeric QUERY_FIELDS = 0           -- Field'leri sorgula
numeric QUERY_METHODS = 1          -- Method'ları sorgula
numeric QUERY_ATTRIBUTES = 2       -- Attribute'leri sorgula
numeric QUERY_BASE_TYPES = 3       -- Base type'ları sorgula

-- Visibility levels
numeric VIS_PUBLIC = 0             -- Public
numeric VIS_PROTECTED = 1          -- Protected
numeric VIS_PRIVATE = 2            -- Private
numeric VIS_INTERNAL = 3           -- Internal

-- Error kodları
numeric ERR_INVALID_TYPE = 1       -- Geçersiz tip
numeric ERR_FIELD_NOT_FOUND = 2    -- Field bulunamadı
numeric ERR_METHOD_NOT_FOUND = 3   -- Method bulunamadı
numeric ERR_INVALID_CAST = 4       -- Geçersiz cast
numeric ERR_TYPE_NOT_REGISTERED = 5 -- Tip kayıtlı değil
numeric ERR_ATTRIBUTE_NOT_FOUND = 6 -- Attribute bulunamadı
