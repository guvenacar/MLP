-- Recursive function test

function fibonacci(n)
    if n <= 1 then
        return n
    else
        numeric a = fibonacci(n - 1)
        numeric b = fibonacci(n - 2)
        return a + b
    end_if
end_function

function factorial(n)
    if n <= 1 then
        return 1
    else
        numeric rec = factorial(n - 1)
        return n * rec
    end_if
end_function

function main()
    print "=== Recursive Functions Test ==="
    
    print "Fibonacci(10): "
    numeric fib = fibonacci(10)
    print fib
    
    print "Factorial(5): "
    numeric fact = factorial(5)
    print fact
    
    return 0
end_function
