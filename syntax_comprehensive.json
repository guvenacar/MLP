{
  "version": "2.0",
  "description": "Comprehensive multi-syntax transformations for MLP",
  "default_syntax": "mlp",

  "target_syntax": {
    "id": "mlp",
    "name": "MLP Base (IR)",
    "description": "Canonical MLP intermediate representation",
    "example": "if x > 0 then\n    print x\nend if"
  },

  "syntax_styles": [
    {
      "id": "mlp",
      "name": "MLP Base",
      "description": "Canonical MLP syntax - no transformation needed",
      "file_extensions": [".mlp"],
      "example": "if x > 0 then\n    print \"positive\"\nend if",
      "no_transformation": true
    },

    {
      "id": "c",
      "name": "C/C++ Style",
      "description": "C-family brace-based syntax (C, C++, C#, Java)",
      "file_extensions": [".c", ".cpp", ".cc", ".java", ".cs"],
      "example": "if (x > 0) {\n    printf(\"positive\");\n}",
      "patterns": {
        "block_start": "{",
        "block_end": "}",
        "statement_terminator": ";",
        "condition_wrapper": "(...)"
      },
      "transformations": {
        "priority": 1,
        "rules": [
          {
            "name": "if_statement",
            "pattern": "\\bif\\s*\\(([^)]+)\\)\\s*\\{",
            "replacement": "if \\1 then",
            "description": "if (condition) { → if condition then"
          },
          {
            "name": "else_if",
            "pattern": "\\}\\s*else\\s+if\\s*\\(([^)]+)\\)\\s*\\{",
            "replacement": "else if \\1 then",
            "description": "} else if (condition) { → else if condition then"
          },
          {
            "name": "else",
            "pattern": "\\}\\s*else\\s*\\{",
            "replacement": "else",
            "description": "} else { → else"
          },
          {
            "name": "for_loop",
            "pattern": "\\bfor\\s*\\(\\s*(?:\\w+\\s+)?(\\w+)\\s*=\\s*(\\d+)\\s*;\\s*\\w+\\s*<=?\\s*(\\d+)\\s*;\\s*\\w+\\+\\+\\s*\\)\\s*\\{",
            "replacement": "for \\1 = \\2 to \\3",
            "description": "for ([type] i=0; i<=10; i++) { → for i = 0 to 10"
          },
          {
            "name": "while_loop",
            "pattern": "\\bwhile\\s*\\(([^)]+)\\)\\s*\\{",
            "replacement": "while",
            "description": "while (condition) { → while [condition moved to if inside]"
          },
          {
            "name": "while_infinite",
            "pattern": "\\bwhile\\s*\\{",
            "replacement": "while",
            "description": "while { → while [infinite loop]"
          },
          {
            "name": "function",
            "pattern": "\\b(\\w+)\\s+(\\w+)\\s*\\(([^)]*)\\)\\s*\\{",
            "replacement": "function \\2(\\3) then",
            "description": "type name(params) { → function name(params) then"
          },
          {
            "name": "print",
            "pattern": "\\b(printf|println|cout|print)\\s*\\(([^)]+)\\)",
            "replacement": "print \\2",
            "description": "printf(...) / print(...) → print ..."
          },
          {
            "name": "semicolon",
            "pattern": ";\\s*$",
            "replacement": "",
            "description": "Remove semicolons at line end"
          },
          {
            "name": "closing_brace",
            "pattern": "^\\s*\\}\\s*$",
            "replacement": "end",
            "description": "} → end [will be made specific: end if, end for]"
          }
        ]
      }
    },

    {
      "id": "python",
      "name": "Python Style",
      "description": "Python indentation-based syntax",
      "file_extensions": [".py"],
      "example": "if x > 0:\n    print(\"positive\")",
      "patterns": {
        "block_start": ":",
        "block_end": "dedent",
        "indentation_sensitive": true
      },
      "transformations": {
        "priority": 2,
        "rules": [
          {
            "name": "if_statement",
            "pattern": "\\bif\\s+(.+?):",
            "replacement": "if \\1 then",
            "description": "if condition: → if condition then"
          },
          {
            "name": "elif",
            "pattern": "\\belif\\s+(.+?):",
            "replacement": "else if \\1 then",
            "description": "elif condition: → else if condition then"
          },
          {
            "name": "else",
            "pattern": "\\belse:",
            "replacement": "else",
            "description": "else: → else"
          },
          {
            "name": "for_range",
            "pattern": "\\bfor\\s+(\\w+)\\s+in\\s+range\\((\\d+)\\)",
            "replacement": "for \\1 = 0 to \\2",
            "description": "for i in range(10): → for i = 0 to 10"
          },
          {
            "name": "for_range_start_end",
            "pattern": "\\bfor\\s+(\\w+)\\s+in\\s+range\\((\\d+),\\s*(\\d+)\\)",
            "replacement": "for \\1 = \\2 to \\3",
            "description": "for i in range(0, 10): → for i = 0 to 10"
          },
          {
            "name": "while_loop",
            "pattern": "\\bwhile\\s+(.+?):",
            "replacement": "while",
            "description": "while condition: → while [condition moved inside]"
          },
          {
            "name": "def_function",
            "pattern": "\\bdef\\s+(\\w+)\\(([^)]*)\\):",
            "replacement": "function \\1(\\2) then",
            "description": "def name(params): → function name(params) then"
          },
          {
            "name": "print",
            "pattern": "\\bprint\\(([^)]+)\\)",
            "replacement": "print \\1",
            "description": "print(...) → print ..."
          }
        ],
        "dedent_handling": {
          "enabled": true,
          "description": "Track indentation levels and insert 'end' keywords on dedent"
        }
      }
    },

    {
      "id": "javascript",
      "name": "JavaScript/TypeScript Style",
      "description": "JavaScript-style syntax with const/let",
      "file_extensions": [".js", ".ts", ".jsx", ".tsx"],
      "example": "if (x > 0) {\n    console.log(\"positive\");\n}",
      "patterns": {
        "block_start": "{",
        "block_end": "}",
        "statement_terminator": ";"
      },
      "transformations": {
        "priority": 1,
        "inherits_from": "c",
        "additional_rules": [
          {
            "name": "console_log",
            "pattern": "\\bconsole\\.log\\(([^)]+)\\)",
            "replacement": "print \\1",
            "description": "console.log(...) → print ..."
          },
          {
            "name": "const_declaration",
            "pattern": "\\bconst\\s+(\\w+)\\s*=",
            "replacement": "int \\1 =",
            "description": "const x = ... → int x = ..."
          },
          {
            "name": "let_declaration",
            "pattern": "\\blet\\s+(\\w+)\\s*=",
            "replacement": "int \\1 =",
            "description": "let x = ... → int x = ..."
          },
          {
            "name": "var_declaration",
            "pattern": "\\bvar\\s+(\\w+)\\s*=",
            "replacement": "int \\1 =",
            "description": "var x = ... → int x = ..."
          }
        ]
      }
    },

    {
      "id": "vbnet",
      "name": "VB.NET/Visual Basic Style",
      "description": "Visual Basic .NET syntax",
      "file_extensions": [".vb"],
      "example": "If x > 0 Then\n    Console.WriteLine(\"positive\")\nEnd If",
      "patterns": {
        "block_start": "Then",
        "block_end": "End [Type]",
        "case_insensitive": true
      },
      "transformations": {
        "priority": 3,
        "rules": [
          {
            "name": "if_statement",
            "pattern": "\\bIf\\s+(.+?)\\s+Then",
            "replacement": "if \\1 then",
            "description": "If condition Then → if condition then",
            "case_insensitive": true
          },
          {
            "name": "elseif",
            "pattern": "\\bElseIf\\s+(.+?)\\s+Then",
            "replacement": "else if \\1 then",
            "description": "ElseIf condition Then → else if condition then",
            "case_insensitive": true
          },
          {
            "name": "else",
            "pattern": "\\bElse\\b",
            "replacement": "else",
            "description": "Else → else",
            "case_insensitive": true
          },
          {
            "name": "for_to",
            "pattern": "\\bFor\\s+(\\w+)\\s*=\\s*(\\d+)\\s+To\\s+(\\d+)",
            "replacement": "for \\1 = \\2 to \\3",
            "description": "For i = 0 To 10 → for i = 0 to 10",
            "case_insensitive": true
          },
          {
            "name": "while_loop",
            "pattern": "\\bWhile\\s+(.+)",
            "replacement": "while",
            "description": "While condition → while",
            "case_insensitive": true
          },
          {
            "name": "function",
            "pattern": "\\b(Function|Sub)\\s+(\\w+)\\(([^)]*)\\)",
            "replacement": "function \\2(\\3) then",
            "description": "Function name(params) → function name(params) then",
            "case_insensitive": true
          },
          {
            "name": "console_writeline",
            "pattern": "\\bConsole\\.WriteLine\\(([^)]+)\\)",
            "replacement": "print \\1",
            "description": "Console.WriteLine(...) → print ..."
          },
          {
            "name": "end_if",
            "pattern": "\\bEnd\\s+If\\b",
            "replacement": "end if",
            "description": "End If → end if",
            "case_insensitive": true
          },
          {
            "name": "end_for",
            "pattern": "\\b(Next|End\\s+For)\\b",
            "replacement": "end for",
            "description": "Next / End For → end for",
            "case_insensitive": true
          },
          {
            "name": "end_while",
            "pattern": "\\b(Wend|End\\s+While)\\b",
            "replacement": "end while",
            "description": "Wend / End While → end while",
            "case_insensitive": true
          },
          {
            "name": "end_function",
            "pattern": "\\bEnd\\s+(Function|Sub)\\b",
            "replacement": "end function",
            "description": "End Function/Sub → end function",
            "case_insensitive": true
          }
        ]
      }
    },

    {
      "id": "ruby",
      "name": "Ruby Style",
      "description": "Ruby syntax with do/end blocks",
      "file_extensions": [".rb"],
      "example": "if x > 0\n  puts \"positive\"\nend",
      "patterns": {
        "block_start": "do",
        "block_end": "end",
        "statement_terminator": ""
      },
      "transformations": {
        "priority": 3,
        "rules": [
          {
            "name": "if_statement",
            "pattern": "\\bif\\s+(.+?)\\s*$",
            "replacement": "if \\1 then",
            "description": "if condition → if condition then"
          },
          {
            "name": "elsif",
            "pattern": "\\belsif\\s+(.+?)\\s*$",
            "replacement": "else if \\1 then",
            "description": "elsif condition → else if condition then"
          },
          {
            "name": "times_loop",
            "pattern": "(\\d+)\\.times\\s+do",
            "replacement": "for i = 0 to \\1",
            "description": "10.times do → for i = 0 to 10"
          },
          {
            "name": "each_range",
            "pattern": "\\((\\d+)\\.\\.(\\d+)\\)\\.each\\s+do\\s*\\|(\\w+)\\|",
            "replacement": "for \\3 = \\1 to \\2",
            "description": "(0..10).each do |i| → for i = 0 to 10"
          },
          {
            "name": "while_loop",
            "pattern": "\\bwhile\\s+(.+?)\\s*$",
            "replacement": "while",
            "description": "while condition → while"
          },
          {
            "name": "def_function",
            "pattern": "\\bdef\\s+(\\w+)(\\(([^)]*)\\))?",
            "replacement": "function \\1(\\3) then",
            "description": "def name(params) → function name(params) then"
          },
          {
            "name": "puts",
            "pattern": "\\bputs\\s+(.+)$",
            "replacement": "print \\1",
            "description": "puts ... → print ..."
          },
          {
            "name": "print",
            "pattern": "\\bprint\\s+(.+)$",
            "replacement": "print \\1",
            "description": "print ... → print ... (already correct)"
          }
        ]
      }
    },

    {
      "id": "go",
      "name": "Go Style",
      "description": "Go programming language syntax",
      "file_extensions": [".go"],
      "example": "if x > 0 {\n    fmt.Println(\"positive\")\n}",
      "patterns": {
        "block_start": "{",
        "block_end": "}",
        "statement_terminator": ""
      },
      "transformations": {
        "priority": 1,
        "inherits_from": "c",
        "additional_rules": [
          {
            "name": "fmt_println",
            "pattern": "\\bfmt\\.Println\\(([^)]+)\\)",
            "replacement": "print \\1",
            "description": "fmt.Println(...) → print ..."
          },
          {
            "name": "var_declaration",
            "pattern": "\\bvar\\s+(\\w+)\\s+(\\w+)\\s*=",
            "replacement": "int \\1 =",
            "description": "var x int = ... → int x = ..."
          },
          {
            "name": "short_declaration",
            "pattern": "(\\w+)\\s*:=",
            "replacement": "int \\1 =",
            "description": "x := ... → int x = ..."
          },
          {
            "name": "for_range",
            "pattern": "\\bfor\\s+(\\w+)\\s*:=\\s*range\\s+(.+?)\\s*\\{",
            "replacement": "for \\1 = 0 to length(\\2)",
            "description": "for i := range array { → for i = 0 to length(array)"
          }
        ]
      }
    },

    {
      "id": "rust",
      "name": "Rust Style",
      "description": "Rust programming language syntax",
      "file_extensions": [".rs"],
      "example": "if x > 0 {\n    println!(\"positive\");\n}",
      "patterns": {
        "block_start": "{",
        "block_end": "}",
        "statement_terminator": ";"
      },
      "transformations": {
        "priority": 1,
        "inherits_from": "c",
        "additional_rules": [
          {
            "name": "println_macro",
            "pattern": "\\bprintln!\\(([^)]+)\\)",
            "replacement": "print \\1",
            "description": "println!(...) → print ..."
          },
          {
            "name": "let_declaration",
            "pattern": "\\blet\\s+(mut\\s+)?(\\w+)(:\\s*\\w+)?\\s*=",
            "replacement": "int \\2 =",
            "description": "let x: i32 = ... → int x = ..."
          },
          {
            "name": "for_range",
            "pattern": "\\bfor\\s+(\\w+)\\s+in\\s+(\\d+)\\.\\.(\\d+)\\s*\\{",
            "replacement": "for \\1 = \\2 to \\3",
            "description": "for i in 0..10 { → for i = 0 to 10"
          },
          {
            "name": "fn_function",
            "pattern": "\\bfn\\s+(\\w+)\\(([^)]*)\\)(\\s*->\\s*\\w+)?\\s*\\{",
            "replacement": "function \\1(\\2) then",
            "description": "fn name(params) -> type { → function name(params) then"
          }
        ]
      }
    },

    {
      "id": "pascal",
      "name": "Pascal/Delphi Style",
      "description": "Pascal and Delphi syntax",
      "file_extensions": [".pas", ".dpr"],
      "example": "if x > 0 then\nbegin\n  WriteLn('positive');\nend;",
      "patterns": {
        "block_start": "begin",
        "block_end": "end",
        "statement_terminator": ";"
      },
      "transformations": {
        "priority": 3,
        "rules": [
          {
            "name": "if_statement",
            "pattern": "\\bif\\s+(.+?)\\s+then\\s+begin",
            "replacement": "if \\1 then",
            "description": "if condition then begin → if condition then",
            "case_insensitive": true
          },
          {
            "name": "for_to",
            "pattern": "\\bfor\\s+(\\w+)\\s*:=\\s*(\\d+)\\s+to\\s+(\\d+)\\s+do\\s+begin",
            "replacement": "for \\1 = \\2 to \\3",
            "description": "for i := 0 to 10 do begin → for i = 0 to 10",
            "case_insensitive": true
          },
          {
            "name": "while_loop",
            "pattern": "\\bwhile\\s+(.+?)\\s+do\\s+begin",
            "replacement": "while",
            "description": "while condition do begin → while",
            "case_insensitive": true
          },
          {
            "name": "procedure",
            "pattern": "\\b(procedure|function)\\s+(\\w+)(\\(([^)]*)\\))?",
            "replacement": "function \\2(\\4) then",
            "description": "procedure/function name(params) → function name(params) then",
            "case_insensitive": true
          },
          {
            "name": "writeln",
            "pattern": "\\bWriteLn\\(([^)]+)\\)",
            "replacement": "print \\1",
            "description": "WriteLn(...) → print ...",
            "case_insensitive": true
          },
          {
            "name": "begin",
            "pattern": "\\bbegin\\b",
            "replacement": "",
            "description": "Remove standalone begin",
            "case_insensitive": true
          },
          {
            "name": "end_semicolon",
            "pattern": "\\bend;",
            "replacement": "end",
            "description": "end; → end",
            "case_insensitive": true
          }
        ]
      }
    },

    {
      "id": "basic",
      "name": "BASIC Style",
      "description": "BASIC programming language syntax",
      "file_extensions": [".bas"],
      "example": "IF X > 0 THEN\n  PRINT \"positive\"\nEND IF",
      "patterns": {
        "block_start": "THEN",
        "block_end": "END [TYPE]",
        "case_insensitive": true
      },
      "transformations": {
        "priority": 3,
        "rules": [
          {
            "name": "if_statement",
            "pattern": "\\bIF\\s+(.+?)\\s+THEN",
            "replacement": "if \\1 then",
            "description": "IF condition THEN → if condition then",
            "case_insensitive": true
          },
          {
            "name": "for_to",
            "pattern": "\\bFOR\\s+(\\w+)\\s*=\\s*(\\d+)\\s+TO\\s+(\\d+)",
            "replacement": "for \\1 = \\2 to \\3",
            "description": "FOR I = 0 TO 10 → for i = 0 to 10",
            "case_insensitive": true
          },
          {
            "name": "while_loop",
            "pattern": "\\bWHILE\\s+(.+)",
            "replacement": "while",
            "description": "WHILE condition → while",
            "case_insensitive": true
          },
          {
            "name": "print",
            "pattern": "\\bPRINT\\s+(.+)$",
            "replacement": "print \\1",
            "description": "PRINT ... → print ...",
            "case_insensitive": true
          },
          {
            "name": "next",
            "pattern": "\\bNEXT(\\s+\\w+)?",
            "replacement": "end for",
            "description": "NEXT → end for",
            "case_insensitive": true
          },
          {
            "name": "wend",
            "pattern": "\\bWEND\\b",
            "replacement": "end while",
            "description": "WEND → end while",
            "case_insensitive": true
          }
        ]
      }
    },

    {
      "id": "kotlin",
      "name": "Kotlin Style",
      "description": "Kotlin programming language syntax",
      "file_extensions": [".kt", ".kts"],
      "example": "if (x > 0) {\n    println(\"positive\")\n}",
      "patterns": {
        "block_start": "{",
        "block_end": "}",
        "statement_terminator": ""
      },
      "transformations": {
        "priority": 1,
        "inherits_from": "c",
        "additional_rules": [
          {
            "name": "println",
            "pattern": "\\bprintln\\(([^)]+)\\)",
            "replacement": "print \\1",
            "description": "println(...) → print ..."
          },
          {
            "name": "val_declaration",
            "pattern": "\\bval\\s+(\\w+)(:\\s*\\w+)?\\s*=",
            "replacement": "int \\1 =",
            "description": "val x: Int = ... → int x = ..."
          },
          {
            "name": "var_declaration",
            "pattern": "\\bvar\\s+(\\w+)(:\\s*\\w+)?\\s*=",
            "replacement": "int \\1 =",
            "description": "var x: Int = ... → int x = ..."
          },
          {
            "name": "fun_function",
            "pattern": "\\bfun\\s+(\\w+)\\(([^)]*)\\)(:\\s*\\w+)?\\s*\\{",
            "replacement": "function \\1(\\2) then",
            "description": "fun name(params): Type { → function name(params) then"
          }
        ]
      }
    }
  ],

  "syntax_detection": {
    "auto_detect": true,
    "detection_rules": [
      {
        "syntax_id": "c",
        "indicators": ["if (", ") {", "};", "printf(", "scanf("],
        "confidence_threshold": 2
      },
      {
        "syntax_id": "python",
        "indicators": ["if ", ":", "def ", "import ", "    "],
        "confidence_threshold": 2
      },
      {
        "syntax_id": "javascript",
        "indicators": ["console.log", "const ", "let ", "=>"],
        "confidence_threshold": 1
      },
      {
        "syntax_id": "vbnet",
        "indicators": ["If ", " Then", "End If", "Console.WriteLine"],
        "confidence_threshold": 2
      },
      {
        "syntax_id": "ruby",
        "indicators": ["puts ", "def ", ".times", ".each"],
        "confidence_threshold": 2
      },
      {
        "syntax_id": "go",
        "indicators": ["fmt.Println", "func ", ":=", "package "],
        "confidence_threshold": 2
      },
      {
        "syntax_id": "rust",
        "indicators": ["println!", "fn ", "let mut", "impl "],
        "confidence_threshold": 2
      },
      {
        "syntax_id": "pascal",
        "indicators": ["begin", "WriteLn", "procedure ", ":="],
        "confidence_threshold": 2
      },
      {
        "syntax_id": "mlp",
        "indicators": ["then", "end if", "end for", "print "],
        "confidence_threshold": 2,
        "is_default": true
      }
    ]
  }
}
