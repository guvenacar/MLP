-- Simple test with proper type annotations
-- Only basic features: class, KURUCU, method, var, return

SINIF Point
    x SAYISAL
    y SAYISAL

    KURUCU(METIN msg)
        YAZDIR msg
    SON

    IŞLEÇ distance() -> SAYISAL
        VAR dx = x * x
        VAR dy = y * y
        VAR result = dx + dy
        DÖNÜŞ result
    SON
SON

YAZDIR "=== Point Test ==="
YAZDIR "Test complete!"
