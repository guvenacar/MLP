-- Generic Types Modülü - Jenerik Tipler
-- Type parameters, constraints, monomorphization

-- Type parameter özellikleri
numeric PARAM_UNCONSTRAINED = 0      -- T
numeric PARAM_CONSTRAINED = 1        -- T: Comparable
numeric PARAM_DEFAULT = 2            -- T = int

-- Constraint tipi
numeric CONSTRAINT_TRAIT = 0         -- T: Trait
numeric CONSTRAINT_TYPE = 1          -- T: Type
numeric CONSTRAINT_LIFETIME = 2      -- 'a: 'b (Rust-style)

-- Instantiation stratejisi
numeric INST_MONOMORPHIZATION = 0    -- Compile-time (C++, Rust)
numeric INST_BOXING = 1              -- Runtime (Java, C#)
numeric INST_ERASURE = 2             -- Type erasure (Java old)

-- Specialization tipi
numeric SPEC_FULL = 0                -- Tam specialization
numeric SPEC_PARTIAL = 1             -- Kısmi specialization

-- Generic item tipi
numeric GENERIC_TYPE = 0             -- struct, class
numeric GENERIC_FUNCTION = 1         -- function
numeric GENERIC_TRAIT = 2            -- trait/interface
numeric GENERIC_IMPL = 3             -- implementation

-- Monomorphization durumu
numeric MONOMORPH_PENDING = 0
numeric MONOMORPH_IN_PROGRESS = 1
numeric MONOMORPH_COMPLETED = 2
numeric MONOMORPH_CACHED = 3

-- Type argument tipi
numeric ARG_CONCRETE = 0             -- int, string
numeric ARG_GENERIC = 1              -- T, U
numeric ARG_WILDCARD = 2             -- _
