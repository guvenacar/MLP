-- Debug Features Parser Modülü
-- Parse işlemleri sabitleri

-- Debug label parse
numeric PARSE_DEBUG_KEYWORD = 0      -- debug
numeric PARSE_LABEL_NAME = 1         -- cikis

-- Debug goto parse
numeric PARSE_GOTO_DEBUG = 0         -- debug (optional)
numeric PARSE_GOTO_KEYWORD = 1       -- goto
numeric PARSE_GOTO_LABEL = 2         -- cikis

-- Debug pause parse
numeric PARSE_PAUSE_DEBUG = 0        -- debug (optional)
numeric PARSE_PAUSE_KEYWORD = 1      -- pause
numeric PARSE_PAUSE_MESSAGE = 2      -- "message" (optional)

-- Debug print parse
numeric PARSE_PRINT_DEBUG = 0        -- debug
numeric PARSE_PRINT_KEYWORD = 1      -- print
numeric PARSE_PRINT_VAR = 2          -- x

-- Debug if parse
numeric PARSE_DIF_DEBUG = 0          -- debug
numeric PARSE_DIF_IF = 1             -- if
numeric PARSE_DIF_CONDITION = 2
numeric PARSE_DIF_THEN = 3           -- then
numeric PARSE_DIF_BODY = 4           -- goto, pause içerebilir (debug keyword'süz)
numeric PARSE_DIF_ELSE = 5           -- else (optional)
numeric PARSE_DIF_ELSE_BODY = 6
numeric PARSE_DIF_END = 7            -- debug end if

-- Debug keyword kontrol
numeric CHECK_DEBUG_REQUIRED = 1     -- Tek başına kullanım
numeric CHECK_DEBUG_OPTIONAL = 0     -- Debug bloğu içinde
