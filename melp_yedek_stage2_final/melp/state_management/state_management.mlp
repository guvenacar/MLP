-- State Management Modülü - Durum Makineleri
-- State machine, transition, event yönetimi

-- State durumları
numeric STATE_IDLE = 0
numeric STATE_ACTIVE = 1
numeric STATE_SUSPENDED = 2
numeric STATE_ERROR = 3

-- Transition tipleri
numeric TRANS_IMMEDIATE = 0     -- Anında geçiş
numeric TRANS_GUARDED = 1       -- Koşullu geçiş
numeric TRANS_DELAYED = 2       -- Gecikmeli geçiş

-- Event tipleri
numeric EVENT_SYNC = 0          -- Senkron event
numeric EVENT_ASYNC = 1         -- Asenkron event
numeric EVENT_PRIORITY = 2      -- Öncelikli event

-- State machine modu
numeric SM_MODE_AUTO = 0        -- Otomatik geçişler
numeric SM_MODE_MANUAL = 1      -- Manuel kontrol
numeric SM_MODE_HYBRID = 2      -- Karma

-- Callback tipleri
numeric CB_ON_ENTER = 0
numeric CB_ON_EXIT = 1
numeric CB_ON_TRANSITION = 2

-- History tipi
numeric HISTORY_NONE = 0        -- Geçmiş yok
numeric HISTORY_SHALLOW = 1     -- Sığ geçmiş (son state)
numeric HISTORY_DEEP = 2        -- Derin geçmiş (tüm stack)

-- Event queue kapasitesi
numeric EVENT_QUEUE_SIZE = 256
