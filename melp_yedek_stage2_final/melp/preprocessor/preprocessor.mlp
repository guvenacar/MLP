-- Preprocessor ve Macro Sistemi Sabitleri
-- Compile-time code generation, macro expansion

-- Macro türleri
numeric MACRO_OBJECT_LIKE = 0      -- #define PI 3.14
numeric MACRO_FUNCTION_LIKE = 1    -- #define MAX(a,b) ((a)>(b)?(a):(b))
numeric MACRO_VARIADIC = 2         -- #define LOG(fmt, ...) printf(fmt, __VA_ARGS__)
numeric MACRO_BUILTIN = 3          -- __FILE__, __LINE__, __DATE__

-- Preprocessor direktif türleri
numeric DIRECTIVE_DEFINE = 0       -- #define
numeric DIRECTIVE_UNDEF = 1        -- #undef
numeric DIRECTIVE_INCLUDE = 2      -- #include
numeric DIRECTIVE_IF = 3           -- #if
numeric DIRECTIVE_IFDEF = 4        -- #ifdef
numeric DIRECTIVE_IFNDEF = 5       -- #ifndef
numeric DIRECTIVE_ELIF = 6         -- #elif
numeric DIRECTIVE_ELSE = 7         -- #else
numeric DIRECTIVE_ENDIF = 8        -- #endif
numeric DIRECTIVE_ERROR = 9        -- #error
numeric DIRECTIVE_WARNING = 10     -- #warning
numeric DIRECTIVE_PRAGMA = 11      -- #pragma
numeric DIRECTIVE_LINE = 12        -- #line

-- Macro parametresi özellikleri
numeric PARAM_NORMAL = 0           -- Normal parametre
numeric PARAM_VARIADIC = 1         -- ... variadic parametre
numeric PARAM_WITH_DEFAULT = 2     -- Varsayılan değerli

-- Macro expansion durumları
numeric EXPANSION_NOT_STARTED = 0  -- Henüz başlamadı
numeric EXPANSION_IN_PROGRESS = 1  -- Devam ediyor
numeric EXPANSION_COMPLETED = 2    -- Tamamlandı
numeric EXPANSION_FAILED = 3       -- Başarısız

-- Token işlem türleri
numeric TOKEN_PASTE = 0            -- ## operatörü (token paste)
numeric TOKEN_STRINGIFY = 1        -- # operatörü (stringification)
numeric TOKEN_REPLACE = 2          -- Parametre replacement
numeric TOKEN_CONCAT = 3           -- String concatenation

-- Include türleri
numeric INCLUDE_LOCAL = 0          -- "file.h" (tırnakla)
numeric INCLUDE_SYSTEM = 1         -- <stdlib.h> (köşeli parantezle)
numeric INCLUDE_COMPUTED = 2       -- Macro ile hesaplanmış

-- Include guard durumları
numeric GUARD_NONE = 0             -- Guard yok
numeric GUARD_IFNDEF = 1           -- #ifndef guard
numeric GUARD_PRAGMA_ONCE = 2      -- #pragma once

-- Conditional compilation durumları
numeric COND_TRUE = 0              -- Koşul doğru (kod aktif)
numeric COND_FALSE = 1             -- Koşul yanlış (kod pasif)
numeric COND_UNKNOWN = 2           -- Koşul bilinmiyor

-- Conditional stack işlemleri
numeric STACK_PUSH = 0             -- Stack'e ekle
numeric STACK_POP = 1              -- Stack'ten çıkar
numeric STACK_PEEK = 2             -- Tepedekine bak

-- Built-in macro türleri
numeric BUILTIN_FILE = 0           -- __FILE__
numeric BUILTIN_LINE = 1           -- __LINE__
numeric BUILTIN_DATE = 2           -- __DATE__
numeric BUILTIN_TIME = 3           -- __TIME__
numeric BUILTIN_COUNTER = 4        -- __COUNTER__
numeric BUILTIN_FUNCTION = 5       -- __FUNCTION__

-- Pragma direktif türleri
numeric PRAGMA_ONCE = 0            -- #pragma once
numeric PRAGMA_PACK = 1            -- #pragma pack
numeric PRAGMA_WARNING = 2         -- #pragma warning
numeric PRAGMA_OPTIMIZE = 3        -- #pragma optimize

-- Hata türleri
numeric ERROR_MACRO_NOT_FOUND = 1  -- Macro bulunamadı
numeric ERROR_PARAM_MISMATCH = 2   -- Parametre sayısı uyumsuz
numeric ERROR_RECURSIVE = 3        -- Recursive expansion
numeric ERROR_INVALID_SYNTAX = 4   -- Geçersiz syntax
numeric ERROR_FILE_NOT_FOUND = 5   -- Include dosyası bulunamadı
numeric ERROR_CIRCULAR_INCLUDE = 6 -- Circular include
numeric ERROR_UNDEF_BUILTIN = 7    -- Built-in macro undef edilemez

-- Expansion stratejileri
numeric EXPAND_EAGER = 0           -- Hemen genişlet
numeric EXPAND_LAZY = 1            -- Gerektiğinde genişlet
numeric EXPAND_ONCE = 2            -- Sadece bir kez genişlet
numeric EXPAND_RECURSIVE = 3       -- Recursive genişletme

-- Macro replacement flags
numeric REPLACE_SIMPLE = 0         -- Basit replacement
numeric REPLACE_WITH_PASTE = 1     -- Token paste ile
numeric REPLACE_WITH_STRINGIFY = 2 -- Stringification ile
numeric REPLACE_VARIADIC = 3       -- Variadic args ile
