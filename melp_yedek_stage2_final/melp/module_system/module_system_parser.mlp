-- Module System Parser Modülü
-- Parse işlemleri sabitleri

-- Module parse
numeric PARSE_MODULE_KEYWORD = 0
numeric PARSE_MODULE_NAME = 1
numeric PARSE_MODULE_LBRACE = 2
numeric PARSE_MODULE_BODY = 3
numeric PARSE_MODULE_RBRACE = 4

-- Import parse
numeric PARSE_IMPORT_KEYWORD = 0
numeric PARSE_IMPORT_LBRACE = 1     -- { için
numeric PARSE_IMPORT_SYMBOLS = 2
numeric PARSE_IMPORT_RBRACE = 3     -- }
numeric PARSE_IMPORT_FROM = 4       -- from keyword
numeric PARSE_IMPORT_PATH = 5
numeric PARSE_IMPORT_AS = 6         -- as keyword (alias)
numeric PARSE_IMPORT_ALIAS = 7

-- Import wildcard parse
numeric PARSE_WILD_STAR = 0         -- *
numeric PARSE_WILD_AS = 1           -- as
numeric PARSE_WILD_ALIAS = 2

-- Export parse
numeric PARSE_EXPORT_KEYWORD = 0
numeric PARSE_EXPORT_DEFAULT = 1    -- default keyword
numeric PARSE_EXPORT_SYMBOL = 2
numeric PARSE_EXPORT_DECL = 3       -- Declaration

-- Symbol declaration parse
numeric PARSE_SYM_VIS = 0           -- public, private
numeric PARSE_SYM_TYPE = 1          -- func, var, etc.
numeric PARSE_SYM_NAME = 2
numeric PARSE_SYM_BODY = 3
