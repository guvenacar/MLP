-- Struct Modülü - Yapı Tanımları
-- Yapılar için tip ve üye yönetimi

-- Üye tipleri
numeric MEMBER_TYPE_NUMERIC = 0
numeric MEMBER_TYPE_STRING = 1
numeric MEMBER_TYPE_BOOLEAN = 2
numeric MEMBER_TYPE_STRUCT = 3

-- Yapı yerleşim stratejileri
numeric STRUCT_LAYOUT_PACKED = 0     -- Padding yok
numeric STRUCT_LAYOUT_ALIGNED = 1    -- 8-byte hizalama (default)

-- Yapı ayırma konumları
numeric STRUCT_ALLOC_STACK = 0
numeric STRUCT_ALLOC_HEAP = 1
