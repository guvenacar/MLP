// MLP Fibonacci Project
// Calculate Fibonacci numbers

int fibonacci(int n) {
    if n <= 1 then
        return n;
    else
        return fibonacci(n-1) + fibonacci(n-2);
    end
}

// Print first 10 Fibonacci numbers
print "Fibonacci Sequence:"
print "-------------------"

int i = 0
while i < 10 do
    print "fib("
    print i
    print ") = "
    print fibonacci(i)
    i = i + 1
end
