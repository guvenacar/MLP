// MLP Calculator Project
// Simple calculator with functions

int add(int a, int b) {
    return a + b;
}

int subtract(int a, int b) {
    return a - b;
}

int multiply(int a, int b) {
    return a * b;
}

int divide(int a, int b) {
    if b == 0 then
        print "Error: Division by zero!"
        return 0;
    else
        return a / b;
    end
}

// Test the calculator
print "Calculator Demo"
print "---------------"

int x = 10
int y = 5

print "x = "
print x
print "y = "
print y

print "x + y = "
print add(x, y)

print "x - y = "
print subtract(x, y)

print "x * y = "
print multiply(x, y)

print "x / y = "
print divide(x, y)
