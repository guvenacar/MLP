-- MELP Phase 15: Null Safety - Simple Test
-- Test null coalescing operator (??)

func main()
    print("=== Null Coalescing Tests ===")
    
    -- Test 1: Value ?? default with value
    numeric a = 50
    numeric result1 = a ?? 100
    print("50 ?? 100 = ")
    print(result1)
    
    -- Test 2: 0 ?? default (0 is treated as null)
    numeric b = 0
    numeric result2 = b ?? 200
    print("0 ?? 200 = ")
    print(result2)
    
    -- Test 3: Chained null coalescing
    numeric c = 0
    numeric d = 0
    numeric e = 30
    numeric result3 = c ?? d ?? e ?? 999
    print("0 ?? 0 ?? 30 ?? 999 = ")
    print(result3)
    
    -- Test 4: Non-zero value in chain
    numeric f = 0
    numeric g = 42
    numeric result4 = f ?? g ?? 999
    print("0 ?? 42 ?? 999 = ")
    print(result4)
    
    print("=== Tests complete ===")
end func

main()
