interface Drawable
    yaz draw() returns void
    yaz getArea() returns numeric
end interface

struct Circle implements Drawable
    numeric radius
    
    yaz draw() returns void
        yazdir("Circle with radius:")
        yazdir(radius)
    end yaz
    
    yaz getArea() returns numeric
        dondur 3.14 * radius * radius
    end yaz
end struct

struct Rectangle implements Drawable
    numeric width
    numeric height
    
    yaz draw() returns void
        yazdir("Rectangle:")
        yazdir(width)
        yazdir(height)
    end yaz
    
    yaz getArea() returns numeric
        dondur width * height
    end yaz
end struct

yaz main() returns numeric
    Circle c
    c.radius = 5
    c.draw()
    numeric area1 = c.getArea()
    yazdir(area1)
    
    Rectangle r
    r.width = 10
    r.height = 20
    r.draw()
    numeric area2 = r.getArea()
    yazdir(area2)
    
    dondur 0
end yaz
