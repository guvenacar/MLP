-- Comprehensive nullable types test

-- Test nullable numeric
numeric? x = null
if x == null then
    print(10)  -- Should print
end if
x = 5
print(x)  -- 5

-- Test nullable decimal (if supported)
decimal? y = null
if y == null then
    print(20)  -- Should print
end if
y = 3
print(y)  -- 3

-- Test nullable boolean (if supported)
boolean? flag = null
if flag == null then
    print(30)  -- Should print
end if
flag = 1
print(flag)  -- 1

-- Test nullable text
text? msg = null
if msg == null then
    print(40)  -- Should print (null check works)
end if

-- Test non-nullable (should work as before)
numeric z = 7
print(z)  -- 7

print(999)
