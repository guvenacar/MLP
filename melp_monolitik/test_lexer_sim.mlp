func main()
    text source = "func main() return 42 end func"
    
    print(str_length(source))
    
    numeric pos = 0
    numeric len = str_length(source)
    
    numeric space1 = indexOf(source, " ")
    print(space1)
    
    text token1 = substring(source, 0, space1)
    print(token1)
    
    text remaining = substring(source, space1, len)
    print(remaining)
    
    text first_char = charAt(source, 0)
    print(first_char)
    
    return 0
end func
