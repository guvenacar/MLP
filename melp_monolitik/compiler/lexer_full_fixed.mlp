-- MELP Self-Hosting Compiler - Full Lexer
-- Complete tokenization with all token types

-- Token type constants (matching bootstrap/lexer.c)
numeric TOKEN_NUMERIC = 1
numeric TOKEN_DECIMAL = 2
numeric TOKEN_BOOLEAN = 3
numeric TOKEN_TEXT = 4
numeric TOKEN_IDENTIFIER = 5
numeric TOKEN_NUMBER = 6
numeric TOKEN_STRING = 7
numeric TOKEN_ASSIGN = 8
numeric TOKEN_LPAREN = 9
numeric TOKEN_RPAREN = 10
numeric TOKEN_PLUS = 11
numeric TOKEN_MINUS = 12
numeric TOKEN_MULTIPLY = 13
numeric TOKEN_DIVIDE = 14
numeric TOKEN_PRINT = 15
numeric TOKEN_IF = 16
numeric TOKEN_THEN = 17
numeric TOKEN_ELSE = 18
numeric TOKEN_END = 19
numeric TOKEN_FOR = 20
numeric TOKEN_TO = 21
numeric TOKEN_WHILE = 22
numeric TOKEN_FUNC = 23
numeric TOKEN_RETURN = 24
numeric TOKEN_COMMA = 25
numeric TOKEN_EQUAL = 26
numeric TOKEN_NOT_EQUAL = 27
numeric TOKEN_LESS = 28
numeric TOKEN_GREATER = 29
numeric TOKEN_LBRACKET = 30
numeric TOKEN_RBRACKET = 31
numeric TOKEN_EOF = 99

-- Global lexer state
text source_code
numeric source_len
numeric pos
numeric line

-- Token storage (parallel arrays)
numeric[] token_types
numeric[] token_lines
text[] token_values
numeric token_count
numeric token_capacity

-- Initialize lexer (returns 1 for success)
func lexer_init(text src)
    source_code = src
    source_len = str_length(src)
    pos = 0
    line = 1
    token_count = 0
    token_capacity = 1000
    
    token_types = malloc(token_capacity)
    token_lines = malloc(token_capacity)
    token_values = malloc(token_capacity)
    
    return 1
end func

-- Add token to list (returns 1 for success)
func add_token(numeric ttype, text tvalue)
    token_types[token_count] = ttype
    token_values[token_count] = tvalue
    token_lines[token_count] = line
    token_count = token_count + 1
    return 1
end func

-- Get character at position (returns empty string if out of bounds)
func get_char(numeric p)
    if p >= source_len then
        return ""
    end if
    return charAt(source_code, p)
end func

-- Advance position (returns 1)
func do_advance()
    text c = get_char(pos)
    if c == "\n" then
        line = line + 1
    end if
    pos = pos + 1
    return 1
end func

-- Check if character is digit
func is_digit(text c)
    if c == "0" then return 1 end if
    if c == "1" then return 1 end if
    if c == "2" then return 1 end if
    if c == "3" then return 1 end if
    if c == "4" then return 1 end if
    if c == "5" then return 1 end if
    if c == "6" then return 1 end if
    if c == "7" then return 1 end if
    if c == "8" then return 1 end if
    if c == "9" then return 1 end if
    return 0
end func

-- Check if character is alpha
func is_alpha(text c)
    if c == "a" then return 1 end if
    if c == "b" then return 1 end if
    if c == "c" then return 1 end if
    if c == "d" then return 1 end if
    if c == "e" then return 1 end if
    if c == "f" then return 1 end if
    if c == "g" then return 1 end if
    if c == "h" then return 1 end if
    if c == "i" then return 1 end if
    if c == "j" then return 1 end if
    if c == "k" then return 1 end if
    if c == "l" then return 1 end if
    if c == "m" then return 1 end if
    if c == "n" then return 1 end if
    if c == "o" then return 1 end if
    if c == "p" then return 1 end if
    if c == "q" then return 1 end if
    if c == "r" then return 1 end if
    if c == "s" then return 1 end if
    if c == "t" then return 1 end if
    if c == "u" then return 1 end if
    if c == "v" then return 1 end if
    if c == "w" then return 1 end if
    if c == "x" then return 1 end if
    if c == "y" then return 1 end if
    if c == "z" then return 1 end if
    if c == "_" then return 1 end if
    return 0
end func

-- Main tokenize function (returns token count)
func tokenize()
    while pos < source_len
        -- Skip whitespace
        for j = pos to source_len - 1
            text c = get_char(pos)
            numeric should_continue = 0
            if c == " " then
                numeric tmp = do_advance()
                should_continue = 1
            else if c == "\t" then
                numeric tmp = do_advance()
                should_continue = 1
            else if c == "\r" then
                numeric tmp = do_advance()
                should_continue = 1
            else if c == "\n" then
                numeric tmp = do_advance()
                should_continue = 1
            end if
            
            if should_continue == 0 then
                break
            end if
        end for
        
        if pos >= source_len then
            break
        end if
        
        text ch = get_char(pos)
        
        -- Single character tokens
        if ch == "=" then
            numeric tmp = add_token(TOKEN_ASSIGN, "=")
            numeric tmp2 = do_advance()
        else if ch == "+" then
            numeric tmp = add_token(TOKEN_PLUS, "+")
            numeric tmp2 = do_advance()
        else if ch == "-" then
            numeric tmp = add_token(TOKEN_MINUS, "-")
            numeric tmp2 = do_advance()
        else if ch == "*" then
            numeric tmp = add_token(TOKEN_MULTIPLY, "*")
            numeric tmp2 = do_advance()
        else if ch == "/" then
            numeric tmp = add_token(TOKEN_DIVIDE, "/")
            numeric tmp2 = do_advance()
        else if ch == "(" then
            numeric tmp = add_token(TOKEN_LPAREN, "(")
            numeric tmp2 = do_advance()
        else if ch == ")" then
            numeric tmp = add_token(TOKEN_RPAREN, ")")
            numeric tmp2 = do_advance()
        else if ch == "," then
            numeric tmp = add_token(TOKEN_COMMA, ",")
            numeric tmp2 = do_advance()
        else if ch == "[" then
            numeric tmp = add_token(TOKEN_LBRACKET, "[")
            numeric tmp2 = do_advance()
        else if ch == "]" then
            numeric tmp = add_token(TOKEN_RBRACKET, "]")
            numeric tmp2 = do_advance()
        else if is_digit(ch) == 1 then
            -- Read number
            numeric start = pos
            for k = pos to source_len - 1
                numeric should_break = 0
                if is_digit(get_char(pos)) == 1 then
                    numeric tmp = do_advance()
                else
                    should_break = 1
                end if
                if should_break == 1 then
                    break
                end if
            end for
            numeric len = pos - start
            text num_str = substring(source_code, start, len)
            numeric tmp = add_token(TOKEN_NUMBER, num_str)
        else if is_alpha(ch) == 1 then
            -- Read identifier
            numeric start = pos
            for k = pos to source_len - 1
                text c = get_char(pos)
                numeric should_break = 0
                if is_alpha(c) == 1 then
                    numeric tmp = do_advance()
                else if is_digit(c) == 1 then
                    numeric tmp = do_advance()
                else
                    should_break = 1
                end if
                if should_break == 1 then
                    break
                end if
            end for
            numeric len = pos - start
            text word = substring(source_code, start, len)
            
            -- Check keywords
            if word == "numeric" then
                numeric tmp = add_token(TOKEN_NUMERIC, word)
            else if word == "text" then
                numeric tmp = add_token(TOKEN_TEXT, word)
            else if word == "print" then
                numeric tmp = add_token(TOKEN_PRINT, word)
            else if word == "if" then
                numeric tmp = add_token(TOKEN_IF, word)
            else if word == "then" then
                numeric tmp = add_token(TOKEN_THEN, word)
            else if word == "else" then
                numeric tmp = add_token(TOKEN_ELSE, word)
            else if word == "end" then
                numeric tmp = add_token(TOKEN_END, word)
            else if word == "for" then
                numeric tmp = add_token(TOKEN_FOR, word)
            else if word == "to" then
                numeric tmp = add_token(TOKEN_TO, word)
            else if word == "while" then
                numeric tmp = add_token(TOKEN_WHILE, word)
            else if word == "func" then
                numeric tmp = add_token(TOKEN_FUNC, word)
            else if word == "return" then
                numeric tmp = add_token(TOKEN_RETURN, word)
            else
                numeric tmp = add_token(TOKEN_IDENTIFIER, word)
            end if
        else
            -- Unknown, skip
            numeric tmp = do_advance()
        end if
    end while
    
    -- Add EOF
    numeric tmp = add_token(TOKEN_EOF, "")
    return token_count
end func

-- Print tokens for debugging (returns 1)
func print_tokens()
    print(token_count)
    for i = 0 to token_count - 1
        print(token_types[i])
    end for
    return 1
end func

-- Main entry point
func main()
    text source = read_file("compiler/test_simple.mlp")
    
    lexer_init(source)
    tokenize()
    print_tokens()
    
    return 0
end func
