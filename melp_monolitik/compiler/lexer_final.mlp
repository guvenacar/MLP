-- MLP Self-Hosting Lexer - All Local Version
-- No global constants due to MLP constraints

-- Helper: Check if character is digit
func is_digit(text c)
    if c == "0" then return 1 end if
    if c == "1" then return 1 end if
    if c == "2" then return 1 end if
    if c == "3" then return 1 end if
    if c == "4" then return 1 end if
    if c == "5" then return 1 end if
    if c == "6" then return 1 end if
    if c == "7" then return 1 end if
    if c == "8" then return 1 end if
    if c == "9" then return 1 end if
    return 0
end func

-- Helper: Check if character is alpha
func is_alpha(text c)
    numeric idx = indexOf("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
    if idx >= 0 then
        return 1
    end if
    return 0
end func

-- Helper: Check if character is alphanumeric
func is_alnum(text c)
    numeric d = is_digit(c)
    if d == 1 then
        return 1
    end if
    return is_alpha(c)
end func

-- Helper: Check if character is whitespace
func is_whitespace(text c)
    if c == " " then return 1 end if
    if c == "	" then return 1 end if
    if str_length(c) == 0 then return 1 end if
    return 0
end func

-- Helper: Check if word is a keyword and return token type
func keyword_type(text word)
    if word == "numeric" then return 1 end if
    if word == "text" then return 2 end if
    if word == "print" then return 6 end if
    if word == "func" then return 15 end if
    if word == "return" then return 16 end if
    return 5
end func

-- Main tokenizer function
func tokenize(text source_code)
    -- Token type constants (local)
    numeric TOKEN_EOF = 0
    numeric TOKEN_NUMBER = 3
    numeric TOKEN_IDENTIFIER = 5
    numeric TOKEN_ASSIGN = 20
    numeric TOKEN_PLUS = 21
    numeric TOKEN_MINUS = 22
    numeric TOKEN_STAR = 23
    numeric TOKEN_SLASH = 24
    numeric TOKEN_LPAREN = 25
    numeric TOKEN_RPAREN = 26
    numeric TOKEN_COMMA = 33
    
    numeric source_len = str_length(source_code)
    numeric pos = 0
    
    -- Allocate token arrays
    numeric[] token_types = malloc(1000)
    text[] token_values = malloc(1000)
    numeric token_count = 0
    
    -- Main lexing loop
    while pos < source_len
        text ch = charAt(source_code, pos)
        
        -- Skip whitespace
        numeric is_ws = is_whitespace(ch)
        if is_ws == 1 then
            pos = pos + 1
        else
            -- Check for numbers
            numeric is_d = is_digit(ch)
            if is_d == 1 then
                numeric start = pos
                numeric done = 0
                while done == 0
                    if pos >= source_len then
                        done = 1
                    else
                        text numch = charAt(source_code, pos)
                        numeric is_numchar = is_digit(numch)
                        if is_numchar == 1 then
                            pos = pos + 1
                        else
                            if numch == "." then
                                pos = pos + 1
                            else
                                done = 1
                            end if
                        end if
                    end if
                end while
                
                numeric num_len = pos - start
                text num_str = substring(source_code, start, num_len)
                token_types[token_count] = TOKEN_NUMBER
                token_values[token_count] = num_str
                token_count = token_count + 1
            else
                -- Check for identifiers
                numeric is_a = is_alpha(ch)
                if is_a == 1 then
                    numeric start = pos
                    numeric done = 0
                    while done == 0
                        if pos >= source_len then
                            done = 1
                        else
                            text idch = charAt(source_code, pos)
                            numeric is_idchar = is_alnum(idch)
                            if is_idchar == 1 then
                                pos = pos + 1
                            else
                                done = 1
                            end if
                        end if
                    end while
                    
                    numeric id_len = pos - start
                    text word = substring(source_code, start, id_len)
                    numeric tok_type = keyword_type(word)
                    token_types[token_count] = tok_type
                    token_values[token_count] = word
                    token_count = token_count + 1
                else
                    -- Operators
                    if ch == "=" then
                        token_types[token_count] = TOKEN_ASSIGN
                        token_values[token_count] = "="
                        token_count = token_count + 1
                        pos = pos + 1
                    else
                        if ch == "+" then
                            token_types[token_count] = TOKEN_PLUS
                            token_values[token_count] = "+"
                            token_count = token_count + 1
                            pos = pos + 1
                        else
                            if ch == "-" then
                                token_types[token_count] = TOKEN_MINUS
                                token_values[token_count] = "-"
                                token_count = token_count + 1
                                pos = pos + 1
                            else
                                if ch == "*" then
                                    token_types[token_count] = TOKEN_STAR
                                    token_values[token_count] = "*"
                                    token_count = token_count + 1
                                    pos = pos + 1
                                else
                                    if ch == "/" then
                                        token_types[token_count] = TOKEN_SLASH
                                        token_values[token_count] = "/"
                                        token_count = token_count + 1
                                        pos = pos + 1
                                    else
                                        if ch == "(" then
                                            token_types[token_count] = TOKEN_LPAREN
                                            token_values[token_count] = "("
                                            token_count = token_count + 1
                                            pos = pos + 1
                                        else
                                            if ch == ")" then
                                                token_types[token_count] = TOKEN_RPAREN
                                                token_values[token_count] = ")"
                                                token_count = token_count + 1
                                                pos = pos + 1
                                            else
                                                if ch == "," then
                                                    token_types[token_count] = TOKEN_COMMA
                                                    token_values[token_count] = ","
                                                    token_count = token_count + 1
                                                    pos = pos + 1
                                                else
                                                    -- Unknown, skip
                                                    pos = pos + 1
                                                end if
                                            end if
                                        end if
                                    end if
                                end if
                            end if
                        end if
                    end if
                end if
            end if
        end if
    end while
    
    -- Add EOF token
    token_types[token_count] = TOKEN_EOF
    token_values[token_count] = ""
    token_count = token_count + 1
    
    return token_count
end func

-- Main entry point
func main()
    text source_code = read_file("compiler/test_simple.mlp")
    
    -- Token type constants (must be local for print)
    numeric TOKEN_EOF = 0
    numeric TOKEN_NUMERIC_KW = 1
    numeric TOKEN_TEXT_KW = 2
    numeric TOKEN_NUMBER = 3
    numeric TOKEN_IDENTIFIER = 5
    numeric TOKEN_PRINT_KW = 6
    numeric TOKEN_ASSIGN = 20
    numeric TOKEN_LPAREN = 25
    numeric TOKEN_RPAREN = 26
    
    -- Allocate token arrays for results
    numeric[] token_types = malloc(1000)
    text[] token_values = malloc(1000)
    
    -- Call tokenize (but we can't return arrays, so inline it)
    numeric source_len = str_length(source_code)
    numeric pos = 0
    numeric token_count = 0
    
    -- Main lexing loop (inline)
    while pos < source_len
        text ch = charAt(source_code, pos)
        
        -- Skip whitespace
        numeric is_ws = is_whitespace(ch)
        if is_ws == 1 then
            pos = pos + 1
        else
            -- Check for numbers
            numeric is_d = is_digit(ch)
            if is_d == 1 then
                numeric start = pos
                numeric done = 0
                while done == 0
                    if pos >= source_len then
                        done = 1
                    else
                        text numch = charAt(source_code, pos)
                        numeric is_numchar = is_digit(numch)
                        if is_numchar == 1 then
                            pos = pos + 1
                        else
                            if numch == "." then
                                pos = pos + 1
                            else
                                done = 1
                            end if
                        end if
                    end if
                end while
                
                numeric num_len = pos - start
                text num_str = substring(source_code, start, num_len)
                token_types[token_count] = TOKEN_NUMBER
                token_values[token_count] = num_str
                token_count = token_count + 1
            else
                -- Check for identifiers
                numeric is_a = is_alpha(ch)
                if is_a == 1 then
                    numeric start = pos
                    numeric done = 0
                    while done == 0
                        if pos >= source_len then
                            done = 1
                        else
                            text idch = charAt(source_code, pos)
                            numeric is_idchar = is_alnum(idch)
                            if is_idchar == 1 then
                                pos = pos + 1
                            else
                                done = 1
                            end if
                        end if
                    end while
                    
                    numeric id_len = pos - start
                    text word = substring(source_code, start, id_len)
                    numeric tok_type = keyword_type(word)
                    token_types[token_count] = tok_type
                    token_values[token_count] = word
                    token_count = token_count + 1
                else
                    -- Operators
                    if ch == "=" then
                        token_types[token_count] = TOKEN_ASSIGN
                        token_values[token_count] = "="
                        token_count = token_count + 1
                        pos = pos + 1
                    else
                        if ch == "(" then
                            token_types[token_count] = TOKEN_LPAREN
                            token_values[token_count] = "("
                            token_count = token_count + 1
                            pos = pos + 1
                        else
                            if ch == ")" then
                                token_types[token_count] = TOKEN_RPAREN
                                token_values[token_count] = ")"
                                token_count = token_count + 1
                                pos = pos + 1
                            else
                                -- Unknown, skip
                                pos = pos + 1
                            end if
                        end if
                    end if
                end if
            end if
        end if
    end while
    
    -- Add EOF token
    token_types[token_count] = TOKEN_EOF
    token_values[token_count] = ""
    token_count = token_count + 1
    
    print("=== LEXER RESULTS ===")
    print("Token count: ")
    print(token_count)
    print(" ")
    
    -- Print all tokens
    numeric i = 0
    while i < token_count
        print("Token ")
        print(i)
        print(": type=")
        print(token_types[i])
        print(" value=")
        print(token_values[i])
        print(" ")
        i = i + 1
    end while
    
    return 0
end func
