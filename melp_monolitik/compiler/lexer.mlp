-- MELP Self-Hosting Compiler - Lexer
-- Token types and lexical analysis

-- Token type constants
numeric TOKEN_NUMERIC = 1
numeric TOKEN_IDENTIFIER = 2
numeric TOKEN_NUMBER = 3
numeric TOKEN_STRING = 4
numeric TOKEN_ASSIGN = 5
numeric TOKEN_LPAREN = 6
numeric TOKEN_RPAREN = 7
numeric TOKEN_PLUS = 8
numeric TOKEN_MINUS = 9
numeric TOKEN_MULTIPLY = 10
numeric TOKEN_DIVIDE = 11
numeric TOKEN_PRINT = 12
numeric TOKEN_IF = 13
numeric TOKEN_THEN = 14
numeric TOKEN_ELSE = 15
numeric TOKEN_END = 16
numeric TOKEN_FOR = 17
numeric TOKEN_TO = 18
numeric TOKEN_WHILE = 19
numeric TOKEN_FUNC = 20
numeric TOKEN_RETURN = 21
numeric TOKEN_COMMA = 22
numeric TOKEN_EQUAL = 23
numeric TOKEN_NOT_EQUAL = 24
numeric TOKEN_LESS = 25
numeric TOKEN_GREATER = 26
numeric TOKEN_LBRACKET = 27
numeric TOKEN_RBRACKET = 28
numeric TOKEN_EOF = 99

-- Token arrays (parallel arrays to represent tokens)
numeric[] token_types
numeric[] token_lines
numeric[] token_values
numeric token_count

-- Lexer state
string source_code
numeric source_pos
numeric source_len
numeric current_line

-- Initialize lexer with source code
func lexer_init(string src)
    source_code = src
    source_pos = 0
    source_len = str_length(src)
    current_line = 1
    token_count = 0
    
    -- Allocate token arrays (start with capacity 100)
    token_types = malloc(100)
    token_lines = malloc(100)
    token_values = malloc(100)
end func

-- Add a token to the token list
func add_token(numeric ttype, string tvalue, numeric tline)
    token_types[token_count] = ttype
    token_values[token_count] = tvalue
    token_lines[token_count] = tline
    token_count = token_count + 1
end func

-- Get current character
func current_char()
    if source_pos >= source_len then
        return ""
    end if
    return charAt(source_code, source_pos)
end func

-- Peek next character
func peek_char()
    if source_pos + 1 >= source_len then
        return ""
    end if
    return charAt(source_code, source_pos + 1)
end func

-- Advance position
func advance()
    source_pos = source_pos + 1
end func

-- Skip whitespace and handle newlines
func skip_whitespace()
    for i = source_pos to source_len - 1
        string c = charAt(source_code, i)
        
        if c == " " then
            source_pos = source_pos + 1
        else if c == "\t" then
            source_pos = source_pos + 1
        else if c == "\r" then
            source_pos = source_pos + 1
        else if c == "\n" then
            source_pos = source_pos + 1
            current_line = current_line + 1
        else
            exit
        end if
    end for
end func

-- Check if character is digit
func is_digit(string c)
    if c == "0" then return 1 end if
    if c == "1" then return 1 end if
    if c == "2" then return 1 end if
    if c == "3" then return 1 end if
    if c == "4" then return 1 end if
    if c == "5" then return 1 end if
    if c == "6" then return 1 end if
    if c == "7" then return 1 end if
    if c == "8" then return 1 end if
    if c == "9" then return 1 end if
    return 0
end func

-- Check if character is letter or underscore
func is_alpha(string c)
    -- Simple check for common letters
    if c == "a" then return 1 end if
    if c == "b" then return 1 end if
    if c == "c" then return 1 end if
    if c == "d" then return 1 end if
    if c == "e" then return 1 end if
    if c == "f" then return 1 end if
    if c == "g" then return 1 end if
    if c == "h" then return 1 end if
    if c == "i" then return 1 end if
    if c == "j" then return 1 end if
    if c == "k" then return 1 end if
    if c == "l" then return 1 end if
    if c == "m" then return 1 end if
    if c == "n" then return 1 end if
    if c == "o" then return 1 end if
    if c == "p" then return 1 end if
    if c == "q" then return 1 end if
    if c == "r" then return 1 end if
    if c == "s" then return 1 end if
    if c == "t" then return 1 end if
    if c == "u" then return 1 end if
    if c == "v" then return 1 end if
    if c == "w" then return 1 end if
    if c == "x" then return 1 end if
    if c == "y" then return 1 end if
    if c == "z" then return 1 end if
    if c == "_" then return 1 end if
    return 0
end func

-- Read a number token
func read_number()
    numeric start = source_pos
    
    for i = source_pos to source_len - 1
        string c = charAt(source_code, i)
        if is_digit(c) == 0 then
            exit
        end if
        source_pos = source_pos + 1
    end for
    
    numeric len = source_pos - start
    string num_str = substring(source_code, start, len)
    add_token(TOKEN_NUMBER, num_str, current_line)
end func

-- Read an identifier or keyword
func read_identifier()
    numeric start = source_pos
    
    for i = source_pos to source_len - 1
        string c = charAt(source_code, i)
        if is_alpha(c) == 0 then
            if is_digit(c) == 0 then
                exit
            end if
        end if
        source_pos = source_pos + 1
    end for
    
    numeric len = source_pos - start
    string word = substring(source_code, start, len)
    
    -- Check for keywords
    if word == "numeric" then
        add_token(TOKEN_NUMERIC, word, current_line)
    else if word == "print" then
        add_token(TOKEN_PRINT, word, current_line)
    else if word == "if" then
        add_token(TOKEN_IF, word, current_line)
    else if word == "then" then
        add_token(TOKEN_THEN, word, current_line)
    else if word == "else" then
        add_token(TOKEN_ELSE, word, current_line)
    else if word == "end" then
        add_token(TOKEN_END, word, current_line)
    else if word == "for" then
        add_token(TOKEN_FOR, word, current_line)
    else if word == "to" then
        add_token(TOKEN_TO, word, current_line)
    else if word == "while" then
        add_token(TOKEN_WHILE, word, current_line)
    else if word == "func" then
        add_token(TOKEN_FUNC, word, current_line)
    else if word == "return" then
        add_token(TOKEN_RETURN, word, current_line)
    else
        -- It's an identifier
        add_token(TOKEN_IDENTIFIER, word, current_line)
    end if
end func

-- Main tokenization function
func tokenize()
    for i = 0 to source_len - 1
        skip_whitespace()
        
        if source_pos >= source_len then
            exit
        end if
        
        string c = current_char()
        
        -- Single character tokens
        if c == "=" then
            add_token(TOKEN_ASSIGN, "=", current_line)
            advance()
        else if c == "+" then
            add_token(TOKEN_PLUS, "+", current_line)
            advance()
        else if c == "-" then
            add_token(TOKEN_MINUS, "-", current_line)
            advance()
        else if c == "*" then
            add_token(TOKEN_MULTIPLY, "*", current_line)
            advance()
        else if c == "/" then
            add_token(TOKEN_DIVIDE, "/", current_line)
            advance()
        else if c == "(" then
            add_token(TOKEN_LPAREN, "(", current_line)
            advance()
        else if c == ")" then
            add_token(TOKEN_RPAREN, ")", current_line)
            advance()
        else if c == "," then
            add_token(TOKEN_COMMA, ",", current_line)
            advance()
        else if c == "[" then
            add_token(TOKEN_LBRACKET, "[", current_line)
            advance()
        else if c == "]" then
            add_token(TOKEN_RBRACKET, "]", current_line)
            advance()
        else if is_digit(c) == 1 then
            read_number()
        else if is_alpha(c) == 1 then
            read_identifier()
        else
            -- Unknown character, skip it
            advance()
        end if
    end for
    
    -- Add EOF token
    add_token(TOKEN_EOF, "", current_line)
end func

-- Print all tokens (for debugging)
func print_tokens()
    for i = 0 to token_count - 1
        print(token_types[i])
        print(token_values[i])
        print(token_lines[i])
        print(999)  -- separator
    end for
end func

-- Test function
func main()
    string test_code = "numeric x = 42\nprint(x)\n"
    
    lexer_init(test_code)
    tokenize()
    print_tokens()
    
    return 0
end func
