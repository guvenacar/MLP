-- MELP Self-Hosting Compiler - Lexer v0.2
-- Kaynak dosyadan okuyup basit tokenization

func main()
    -- Dosyayı oku
    text source = read_file("compiler/test_simple.mlp")
    numeric len = str_length(source)
    
    print(len)
    
    -- İlk birkaç karakteri göster
    if len > 0 then
        text first = charAt(source, 0)
        print(first)
    end if
    
    if len > 1 then
        text second = charAt(source, 1)
        print(second)
    end if
    
    return 0
end func
