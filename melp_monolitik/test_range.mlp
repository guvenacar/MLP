-- Test 4: For-in loop with range() function

func main() returns numeric
    print("Numbers using range(5):")
    for i in range(5)
        print(i)
    end for
    
    print("Numbers using range(3, 8):")
    for i in range(3, 8)
        print(i)
    end for
    
    print("Even numbers using range(0, 10, 2):")
    for i in range(0, 10, 2)
        print(i)
    end for
    
    return 0
end func
