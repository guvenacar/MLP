-- ============================================
-- MLP Self-Hosting Lexer (Converted from C)
-- ============================================

-- Token Types (Constants)
numeric TOKEN_NUMERIC = 0
numeric TOKEN_TEXT = 1
numeric TOKEN_BOOLEAN = 2
numeric TOKEN_IDENTIFIER = 3
numeric TOKEN_ASSIGN = 4
numeric TOKEN_NUMBER = 5
numeric TOKEN_STRING = 6
numeric TOKEN_TRUE = 7
numeric TOKEN_FALSE = 8
numeric TOKEN_PLUS = 9
numeric TOKEN_MINUS = 10
numeric TOKEN_MULTIPLY = 11
numeric TOKEN_DIVIDE = 12
numeric TOKEN_EQUAL = 13
numeric TOKEN_NOT_EQUAL = 14
numeric TOKEN_LESS = 15
numeric TOKEN_GREATER = 16
numeric TOKEN_LESS_EQUAL = 17
numeric TOKEN_GREATER_EQUAL = 18
numeric TOKEN_AND = 19
numeric TOKEN_OR = 20
numeric TOKEN_NOT = 21
numeric TOKEN_IF = 22
numeric TOKEN_THEN = 23
numeric TOKEN_ELSE = 24
numeric TOKEN_END = 25
numeric TOKEN_WHILE = 26
numeric TOKEN_DO = 27
numeric TOKEN_FOR = 28
numeric TOKEN_TO = 29
numeric TOKEN_EXIT = 30
numeric TOKEN_FUNCTION = 31
numeric TOKEN_RETURN = 32
numeric TOKEN_PRINT = 33
numeric TOKEN_LPAREN = 34
numeric TOKEN_RPAREN = 35
numeric TOKEN_LBRACKET = 36
numeric TOKEN_RBRACKET = 37
numeric TOKEN_COMMA = 38
numeric TOKEN_SEMICOLON = 39
numeric TOKEN_DOT = 40
numeric TOKEN_EOF = 41
numeric TOKEN_ERROR = 42

-- Lexer struct simulation (using numeric pointers)
-- lexer_ptr points to:
--   offset 0: source text pointer
--   offset 8: pos (numeric)
--   offset 16: line (numeric)

func lexer_create(text source) returns numeric
    -- Allocate 24 bytes for Lexer struct
    numeric lexer_ptr = malloc(24)
    -- Note: Can't store text directly in struct with current MLP
    -- We'll use a workaround with global variables
    return lexer_ptr
end func

func lexer_free(numeric lexer_ptr)
    free(lexer_ptr)
end func

-- Helper: Check if character is digit
func is_digit(text c) returns numeric
    if c == "0" then return 1 end if
    if c == "1" then return 1 end if
    if c == "2" then return 1 end if
    if c == "3" then return 1 end if
    if c == "4" then return 1 end if
    if c == "5" then return 1 end if
    if c == "6" then return 1 end if
    if c == "7" then return 1 end if
    if c == "8" then return 1 end if
    if c == "9" then return 1 end if
    return 0
end func

-- Helper: Check if character is alpha
func is_alpha(text c) returns numeric
    numeric idx = indexOf("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
    if idx >= 0 then
        return 1
    end if
    return 0
end func

-- Helper: Check if character is alphanumeric
func is_alnum(text c) returns numeric
    numeric d = is_digit(c)
    if d == 1 then return 1 end if
    numeric a = is_alpha(c)
    if a == 1 then return 1 end if
    return 0
end func

-- Helper: Check if character is whitespace
func is_whitespace(text c) returns numeric
    if c == " " then return 1 end if
    if c == "\n" then return 1 end if
    if c == "\r" then return 1 end if
    if c == "\t" then return 1 end if
    return 0
end func

func main()
    text source = "numeric x = 42"
    
    print("Testing MLP Lexer")
    print("Source:")
    print(source)
    
    numeric pos = 0
    numeric len = str_length(source)
    
    text first = substring(source, 0, 7)
    print("First token:")
    print(first)
    
    if first == "numeric" then
        print("Recognized: TOKEN_NUMERIC")
    end if
    
    return 0
end func
