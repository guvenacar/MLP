-- Comprehensive do-while loop tests

-- Test 1: Basic counter (should print 0,1,2)
numeric i = 0
do
    print(i)
    i = i + 1
while i < 3

print(111)  -- separator

-- Test 2: Do-while that runs only once (i starts at 10)
numeric j = 10
do
    print(j)
    j = j + 1
while j < 5

print(222)  -- separator

-- Test 3: Nested do-while
numeric x = 0
do
    numeric y = 0
    do
        print(x * 10 + y)
        y = y + 1
    while y < 2
    x = x + 1
while x < 2

print(333)  -- separator

-- Test 4: Sum with do-while
numeric sum = 0
numeric n = 1
do
    sum = sum + n
    n = n + 1
while n <= 5
print(sum)  -- should be 15 (1+2+3+4+5)

print(999)  -- final marker
