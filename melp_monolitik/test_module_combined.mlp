-- Combined module test - definition and usage in same file

module MathUtils
    export func add(numeric a, numeric b) returns numeric
        return a + b
    end func
    
    export func multiply(numeric x, numeric y) returns numeric
        return x * y
    end func
end module

-- Main code - use module functions
import MathUtils

numeric result1 = MathUtils.add(10, 20)
print(result1)

numeric result2 = MathUtils.multiply(5, 6)
print(result2)

numeric result3 = MathUtils.add(100, 200)
print(result3)
