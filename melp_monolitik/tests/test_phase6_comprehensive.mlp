-- Comprehensive Phase 6 Test: Structs & Ternary Operator
-- Test struct definition
struct Person
    text name
    numeric age
end struct

-- Test struct instance
Person alice

-- Test ternary operator with numbers
numeric x = 15
numeric y = 20
numeric max = x > y ? x : y
print(max)

numeric min = x < y ? x : y  
print(min)

-- Test ternary with strings
text status = x > 18 ? "adult" : "minor"
print(status)

-- Test nested ternary
numeric grade = 85
text result = grade >= 90 ? "A" : grade >= 80 ? "B" : grade >= 70 ? "C" : "D"
print(result)

-- Test with boolean conditions
numeric is_valid = 1
text msg = is_valid ? "Valid" : "Invalid"
print(msg)
