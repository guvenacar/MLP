-- Test comprehensive string interpolation

text name = "Bob"
numeric age = 25
numeric score = 95

-- Simple interpolation
text msg1 = $"Name: {name}"
print(msg1)

-- Multiple interpolations
text msg2 = $"Hello {name}, age {age}"
print(msg2)

-- Expressions in interpolation
text msg3 = $"Next year you will be {age + 1} years old"
print(msg3)

-- Arithmetic in interpolation
text msg4 = $"Your score doubled is {score * 2}"
print(msg4)

-- Just expression, no text
text msg5 = $"{name}"
print(msg5)

-- Mixed text and multiple expressions
text msg6 = $"Student {name} (age {age}) scored {score} points"
print(msg6)
