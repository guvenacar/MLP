-- MELP Phase 3 Full Test
-- While loop + step + exit/continue

numeric x = 0

-- While loop test
while x < 5
    x = x + 1
    print(x)
end while

-- For with step
numeric sum = 0
for i = 0 to 10 step 2
    sum = sum + i
    print(sum)
end for

-- Exit test
for i = 0 to 20
    if i == 8 then
        exit
    end if
    print(i)
end for

print(999)
