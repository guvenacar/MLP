-- Test: Phase 11.5 - Multiple Return Values
-- Tests the ability to return multiple values from a function
-- Syntax: func name() returns type1, type2
-- Usage: a, b = func()

-- Test 1: Simple multiple return with literals
numeric x
numeric y

func get_coords() returns numeric, numeric
    return 10, 20
end func

x, y = get_coords()
print(x)  -- Expected: 10
print(y)  -- Expected: 20

-- Test 2: Multiple return with calculations
numeric sum
numeric product

func calculate(numeric a, numeric b) returns numeric, numeric
    numeric s
    numeric p
    s = a + b
    p = a * b
    return s, p
end func

sum, product = calculate(5, 3)
print(sum)      -- Expected: 8
print(product)  -- Expected: 15

-- Test 3: Chained usage
numeric result1
numeric result2
numeric final1
numeric final2

result1, result2 = calculate(7, 2)  -- 9, 14

func swap(numeric a, numeric b) returns numeric, numeric
    return b, a
end func

final1, final2 = swap(result1, result2)  -- Should swap: 14, 9
print(final1)  -- Expected: 14
print(final2)  -- Expected: 9

print(999)  -- Success marker
