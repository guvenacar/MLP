-- Test 2: For-in loop with different array types

func main() returns numeric
    -- Stack allocated array
    numeric[] stack_arr = [10, 20, 30]
    
    print("Stack array iteration:")
    for val in stack_arr
        print(val)
    end for
    
    -- Test sum calculation
    numeric total = 0
    for n in stack_arr
        total = total + n
    end for
    print("Sum:")
    print(total)
    
    return 0
end func
