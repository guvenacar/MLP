// Test complete array functionality - Phase 8A
defn main():
    // Test 1: Fixed-size array with literal initialization
    numeric[5] nums = [10, 20, 30, 40, 50]
    
    print "Test 1: Array literal initialization"
    print nums[0]  // Should print 10
    print nums[2]  // Should print 30
    print nums[4]  // Should print 50
    
    // Test 2: Array assignment
    print "Test 2: Array assignment"
    nums[0] = 100
    nums[2] = 300
    nums[4] = 500
    
    print nums[0]  // Should print 100
    print nums[2]  // Should print 300
    print nums[4]  // Should print 500
    
    // Test 3: Array with loop
    print "Test 3: Array operations in loop"
    numeric[3] squares = [0, 0, 0]
    
    for i in 0..3:
        squares[i] = i * i
    end
    
    print squares[0]  // Should print 0
    print squares[1]  // Should print 1
    print squares[2]  // Should print 4
    
    // Test 4: Sum array elements
    print "Test 4: Calculate sum"
    numeric sum = 0
    for i in 0..3:
        sum = sum + squares[i]
    end
    print sum  // Should print 5 (0 + 1 + 4)
    
    print "All array tests completed!"
end
