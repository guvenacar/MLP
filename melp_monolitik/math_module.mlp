-- math_module.mlp - Separate math module file
module MathUtils
    func add(numeric a, numeric b)
        return a + b
    end func
    
    func multiply(numeric x, numeric y)
        return x * y
    end func
    
    func power(numeric base, numeric exp)
        numeric result = 1
        numeric i = 0
        for i = 0 to exp - 1
            result = result * base
        end for
        return result
    end func
end module
