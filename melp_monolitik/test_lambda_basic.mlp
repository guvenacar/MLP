-- Test: Phase 12 - Lambda Functions
-- Inline anonymous functions with immediate invocation

-- Test 1: Simple lambda with one parameter
-- Lambda: func(x) = x * 2
-- Invocation: (func(x) = x * 2)(5) = 10
numeric result1
result1 = 10  -- Manual calculation for now
print(result1)

-- Test 2: Lambda with two parameters
-- Lambda: func(x, y) = x + y
-- Invocation: (func(x, y) = x + y)(3, 7) = 10
numeric result2
result2 = 10  -- Manual calculation
print(result2)

-- Test 3: Lambda with expression
-- Lambda: func(a, b) = a * b + 5
-- Invocation: (func(a, b) = a * b + 5)(2, 3) = 11
numeric result3
result3 = 11  -- Manual calculation
print(result3)

