-- Test Data Types: Primitive, Pointer, Array
--# Testing all supported data types in MELP

-- Primitive types
numeric age = 25
text name = "Alice"
boolean active = true

-- Pointer types
numeric* ptr_num = 0
text* ptr_str = 0

-- Array types (fixed size)
numeric[10] numbers = 0
text[5] names = 0

-- Array types (dynamic)
numeric[] dynamic_nums = 0
text[] dynamic_strs = 0
