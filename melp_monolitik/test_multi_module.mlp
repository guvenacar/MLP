-- Advanced program using multiple modules

import MathUtils
import StringUtils

-- Math operations
numeric result = MathUtils.add(100, 200)
print(result)

-- String operations
text greeting = StringUtils.greet("MELP")
print(greeting)

text excited = StringUtils.shout("Module System Works")
print(excited)

-- Combined usage
numeric calc = MathUtils.multiply(5, 5)
print(calc)

print(999)
