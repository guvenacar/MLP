func main()
    numeric[] arr = malloc(3)
    
    arr[0] = 10
    arr[1] = 20
    arr[2] = 30
    
    print(arr[0])
    print(arr[1])
    print(arr[2])
    
    arr = resize(arr, 5)
    
    arr[3] = 40
    arr[4] = 50
    
    for i = 0 to 4 step 1
        print(arr[i])
    end for
    
    free(arr)
    
    return 0
end func
