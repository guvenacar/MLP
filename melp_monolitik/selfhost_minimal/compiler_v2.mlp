-- ============================================
-- MLP Minimal Self-Hosting Compiler v0.2
-- WITH ARRAY SUPPORT!
-- ============================================

state text g_output = ""
state numeric g_var_count = 0

-- Global variable offsets pointer
state numeric g_var_offsets_ptr = 0

-- Temp storage for variable names (using offsets as keys)
state text g_var_name_0 = ""
state text g_var_name_1 = ""
state text g_var_name_2 = ""
state text g_var_name_3 = ""
state text g_var_name_4 = ""

func emit(text code)
    g_output = g_output + code
end func

func add_variable(text name) returns numeric
    numeric[] offsets = g_var_offsets_ptr
    
    if g_var_count == 0 then g_var_name_0 = name end if
    if g_var_count == 1 then g_var_name_1 = name end if
    if g_var_count == 2 then g_var_name_2 = name end if
    if g_var_count == 3 then g_var_name_3 = name end if
    if g_var_count == 4 then g_var_name_4 = name end if
    
    offsets[g_var_count] = (g_var_count + 1) * 8
    numeric offset = offsets[g_var_count]
    g_var_count = g_var_count + 1
    return offset
end func

func find_variable(text name) returns numeric
    numeric[] offsets = g_var_offsets_ptr
    
    if g_var_count > 0 then
        if g_var_name_0 == name then return offsets[0] end if
    end if
    if g_var_count > 1 then
        if g_var_name_1 == name then return offsets[1] end if
    end if
    if g_var_count > 2 then
        if g_var_name_2 == name then return offsets[2] end if
    end if
    if g_var_count > 3 then
        if g_var_name_3 == name then return offsets[3] end if
    end if
    if g_var_count > 4 then
        if g_var_name_4 == name then return offsets[4] end if
    end if
    return -1
end func

func compile_hardcoded()
    -- Allocate array for offsets
    numeric[] g_var_offsets = malloc(10)
    g_var_offsets_ptr = g_var_offsets
    
    -- Generate header
    emit("section .text\n")
    emit("extern print_number\n")
    emit("global _start\n\n")
    emit("_start:\n")
    emit("    push rbp\n")
    emit("    mov rbp, rsp\n")
    emit("    sub rsp, 64\n\n")
    
    -- Add variable x to symbol table
    numeric x_offset = add_variable("x")
    
    -- numeric x = 42
    emit("    mov rax, 42\n")
    emit("    mov [rbp-")
    emit(int_to_string(x_offset))
    emit("], rax\n\n")
    
    -- print(x)
    numeric found_offset = find_variable("x")
    emit("    mov rax, [rbp-")
    emit(int_to_string(found_offset))
    emit("]\n")
    emit("    mov rdi, rax\n")
    emit("    call print_number\n\n")
    
    -- Add variable y
    numeric y_offset = add_variable("y")
    
    -- numeric y = 10
    emit("    mov rax, 10\n")
    emit("    mov [rbp-")
    emit(int_to_string(y_offset))
    emit("], rax\n\n")
    
    -- print(y)
    numeric found_y = find_variable("y")
    emit("    mov rax, [rbp-")
    emit(int_to_string(found_y))
    emit("]\n")
    emit("    mov rdi, rax\n")
    emit("    call print_number\n\n")
    
    -- Exit
    mov rax, 60\n")
    emit("    xor rdi, rdi\n")
    emit("    syscall\n")
    
    free(g_var_offsets)
end func

func main()
    compile_hardcoded()
    
    numeric[] offsets = g_var_offsets_ptr
    
    print("=== GENERATED ASSEMBLY ===")
    print(g_output)
    print("=== SYMBOL TABLE ===")
    print("x offset:")
    print(offsets[0])
    print("y offset:")
    print(offsets[1])
    return 0
end func
