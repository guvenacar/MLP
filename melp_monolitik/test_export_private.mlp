-- Module with export and private functions
module SecretMath
    export func public_add(numeric a, numeric b)
        return a + b
    end func
    
    private func internal_helper(numeric x)
        return x * 2
    end func
    
    export func public_double(numeric n)
        return SecretMath.internal_helper(n)
    end func
end module

numeric result1 = SecretMath.public_add(5, 10)
print(result1)

numeric result2 = SecretMath.public_double(7)
print(result2)
