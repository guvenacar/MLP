-- ============================================
-- MLP Self-Hosting Compiler - Codegen Switch
-- ============================================
-- Switch/Case statement code generation
-- Generates x86-64 NASM assembly
-- ============================================

-- Forward declarations
-- extern func codegen_emit(string line)
-- extern func codegen_generate_expression_value(numeric expr_idx)
-- extern func codegen_generate_statement(numeric stmt_idx)

-- Generate switch statement assembly
func codegen_generate_switch(numeric stmt_idx) returns numeric
    numeric switch_end = get_next_label()
    
    -- Save previous loop context (switch acts like a loop for exit)
    numeric prev_end = loop_end_label
    numeric prev_in_loop = in_loop
    
    -- Set switch context for 'exit' to work
    loop_end_label = switch_end
    in_loop = 1
    
    codegen_emit("")
    codegen_emit("    ; Switch statement")
    
    -- Evaluate switch expression and store in rax
    numeric switch_expr = get_switch_value(stmt_idx)
    codegen_generate_expression_value(switch_expr)
    codegen_emit("    push rax         ; Save switch value")
    
    -- Get case count
    numeric case_count = get_switch_case_count(stmt_idx)
    
    -- Generate labels for each case
    numeric[] case_labels[case_count]
    for i = 0 to case_count - 1
        case_labels[i] = get_next_label()
    end for
    
    numeric default_label = switch_end
    if has_switch_default(stmt_idx) then
        default_label = get_next_label()
    end if
    
    -- Generate comparison jumps for each case
    for i = 0 to case_count - 1
        codegen_emit("    ; Case comparison")
        codegen_emit("    pop rax          ; Restore switch value")
        codegen_emit("    push rax         ; Save again for next comparison")
        
        -- Get case info
        numeric case_expr = get_case_value(stmt_idx, i)
        numeric range_start = get_case_range_start(stmt_idx, i)
        numeric range_end = get_case_range_end(stmt_idx, i)
        boolean is_type_check = get_case_is_type_check(stmt_idx, i)
        numeric guard_expr = get_case_guard(stmt_idx, i)
        
        numeric guard_check_label = -1
        if guard_expr >= 0 then
            guard_check_label = get_next_label()
        end if
        
        -- Handle different pattern matching types
        if range_start >= 0 and range_end >= 0 then
            -- Range matching: case 1..10
            codegen_emit("    ; Range match")
            
            codegen_generate_expression_value(range_start)
            codegen_emit("    mov rbx, rax")
            codegen_emit("    pop rax          ; Get switch value")
            codegen_emit("    push rax         ; Save again")
            codegen_emit("    cmp rax, rbx")
            numeric skip_label = get_next_label()
            string skip_jmp = "    jl .L" + to_string(skip_label) + "          ; Skip if value < start"
            codegen_emit(skip_jmp)
            
            codegen_generate_expression_value(range_end)
            codegen_emit("    mov rbx, rax")
            codegen_emit("    pop rax          ; Get switch value")
            codegen_emit("    push rax         ; Save again")
            codegen_emit("    cmp rax, rbx")
            
            if guard_check_label >= 0 then
                string jle_guard = "    jle .L" + to_string(guard_check_label) + "         ; Range matched, check guard"
                codegen_emit(jle_guard)
            else
                string jle_case = "    jle .L" + to_string(case_labels[i]) + "         ; Range matched, execute case"
                codegen_emit(jle_case)
            end if
            
            string skip_lbl = ".L" + to_string(skip_label) + ":  ; Skip label"
            codegen_emit(skip_lbl)
            
        else if is_type_check then
            -- Type checking: null
            codegen_emit("    ; Type check (null)")
            codegen_emit("    pop rax          ; Get switch value")
            codegen_emit("    push rax         ; Save again")
            codegen_emit("    cmp rax, 0")
            
            if guard_check_label >= 0 then
                string je_guard = "    je .L" + to_string(guard_check_label) + "          ; Null matched, check guard"
                codegen_emit(je_guard)
            else
                string je_case = "    je .L" + to_string(case_labels[i]) + "          ; Null matched, execute case"
                codegen_emit(je_case)
            end if
            
        else if case_expr >= 0 then
            -- Regular value matching
            codegen_generate_expression_value(case_expr)
            codegen_emit("    mov rbx, rax")
            codegen_emit("    pop rax          ; Get switch value")
            codegen_emit("    push rax         ; Save again")
            codegen_emit("    cmp rax, rbx")
            
            if guard_check_label >= 0 then
                string je_guard = "    je .L" + to_string(guard_check_label) + "          ; Value matched, check guard"
                codegen_emit(je_guard)
            else
                string je_case = "    je .L" + to_string(case_labels[i]) + "          ; Value matched, execute case"
                codegen_emit(je_case)
            end if
        end if
        
        -- Guard check
        if guard_check_label >= 0 then
            string guard_lbl = ".L" + to_string(guard_check_label) + ":  ; Guard check"
            codegen_emit(guard_lbl)
            
            codegen_emit("    ; Evaluate guard condition")
            codegen_generate_expression_value(guard_expr)
            codegen_emit("    cmp rax, 0")
            string jne_case = "    jne .L" + to_string(case_labels[i]) + "         ; Guard passed, execute case"
            codegen_emit(jne_case)
        end if
    end for
    
    -- No match - jump to default or end
    codegen_emit("    pop rax          ; Clean up switch value")
    string jmp_default = "    jmp .L" + to_string(default_label) + "         ; Jump to default/end"
    codegen_emit(jmp_default)
    
    -- Generate case bodies
    for i = 0 to case_count - 1
        string case_lbl = ".L" + to_string(case_labels[i]) + ":  ; case " + to_string(i)
        codegen_emit(case_lbl)
        
        numeric body_start = get_case_body_start(stmt_idx, i)
        numeric body_count = get_case_body_count(stmt_idx, i)
        
        for j = 0 to body_count - 1
            codegen_generate_statement(body_start + j)
        end for
        
        string jmp_end = "    jmp .L" + to_string(switch_end) + "         ; Fall through to end"
        codegen_emit(jmp_end)
    end for
    
    -- Default body
    if has_switch_default(stmt_idx) then
        string def_lbl = ".L" + to_string(default_label) + ":  ; default"
        codegen_emit(def_lbl)
        
        numeric default_start = get_switch_default_start(stmt_idx)
        numeric default_count = get_switch_default_count(stmt_idx)
        
        for i = 0 to default_count - 1
            codegen_generate_statement(default_start + i)
        end for
    end if
    
    -- Switch end label
    string end_lbl = ".L" + to_string(switch_end) + ":  ; switch_end"
    codegen_emit(end_lbl)
    
    -- Restore previous loop context
    loop_end_label = prev_end
    in_loop = prev_in_loop
    
    return 0
end func

-- ============================================
-- Helper functions to access switch data
-- ============================================

func get_switch_value(numeric stmt_idx) returns numeric
    return stmt_expr_indices[stmt_idx]
end func

func get_switch_case_count(numeric stmt_idx) returns numeric
    return stmt_case_counts[stmt_idx]
end func

func has_switch_default(numeric stmt_idx) returns boolean
    return stmt_has_default[stmt_idx]
end func

func get_case_value(numeric stmt_idx, numeric case_idx) returns numeric
    return case_values[stmt_idx][case_idx]
end func

func get_case_range_start(numeric stmt_idx, numeric case_idx) returns numeric
    return case_range_starts[stmt_idx][case_idx]  -- -1 if no range
end func

func get_case_range_end(numeric stmt_idx, numeric case_idx) returns numeric
    return case_range_ends[stmt_idx][case_idx]  -- -1 if no range
end func

func get_case_is_type_check(numeric stmt_idx, numeric case_idx) returns boolean
    return case_type_checks[stmt_idx][case_idx]
end func

func get_case_guard(numeric stmt_idx, numeric case_idx) returns numeric
    return case_guards[stmt_idx][case_idx]  -- -1 if no guard
end func

func get_case_body_start(numeric stmt_idx, numeric case_idx) returns numeric
    return case_body_starts[stmt_idx][case_idx]
end func

func get_case_body_count(numeric stmt_idx, numeric case_idx) returns numeric
    return case_body_counts[stmt_idx][case_idx]
end func

func get_switch_default_start(numeric stmt_idx) returns numeric
    return stmt_default_starts[stmt_idx]
end func

func get_switch_default_count(numeric stmt_idx) returns numeric
    return stmt_default_counts[stmt_idx]
end func
