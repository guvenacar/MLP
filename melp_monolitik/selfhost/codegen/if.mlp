-- ============================================
-- MLP Self-Hosting Compiler - Codegen If
-- ============================================
-- If statement code generation
-- Generates x86-64 NASM assembly
-- ============================================

-- Include types
-- import "types.mlp"

-- Forward declarations (will be in separate modules)
-- extern func codegen_emit(string line)
-- extern func codegen_generate_comparison(numeric expr_idx, numeric false_label)
-- extern func codegen_generate_expression_value(numeric expr_idx)
-- extern func codegen_generate_statement(numeric stmt_idx)

-- Global state for labels
state numeric label_counter = 0

-- Get next label number
func get_next_label() returns numeric
    numeric label = label_counter
    label_counter = label_counter + 1
    return label
end func

-- Generate if statement assembly
func codegen_generate_if(numeric stmt_idx) returns numeric
    -- Get label numbers
    numeric else_label = get_next_label()
    numeric end_label = get_next_label()
    
    -- Emit comment
    codegen_emit("")
    codegen_emit("    ; If statement")
    
    -- Get condition expression index from statement
    numeric cond_idx = get_if_condition(stmt_idx)
    numeric cond_type = get_expr_type(cond_idx)
    
    -- Generate condition check
    if cond_type == EXPR_COMPARISON then
        codegen_generate_comparison(cond_idx, else_label)
    else if cond_type == EXPR_LOGICAL_AND then
        codegen_generate_expression_value(cond_idx)
        codegen_emit("    test rax, rax")
        string jmp_line = "    jz .L" + to_string(else_label)
        codegen_emit(jmp_line)
    else if cond_type == EXPR_LOGICAL_OR then
        codegen_generate_expression_value(cond_idx)
        codegen_emit("    test rax, rax")
        string jmp_line = "    jz .L" + to_string(else_label)
        codegen_emit(jmp_line)
    else if cond_type == EXPR_LOGICAL_NOT then
        codegen_generate_expression_value(cond_idx)
        codegen_emit("    test rax, rax")
        string jmp_line = "    jz .L" + to_string(else_label)
        codegen_emit(jmp_line)
    else
        -- Other expressions: evaluate and check if non-zero
        codegen_generate_expression_value(cond_idx)
        codegen_emit("    test rax, rax")
        string jmp_line = "    jz .L" + to_string(else_label)
        codegen_emit(jmp_line)
    end if
    
    -- Then body
    codegen_emit("    ; Then body")
    numeric then_start = get_if_then_start(stmt_idx)
    numeric then_count = get_if_then_count(stmt_idx)
    
    for i = 0 to then_count - 1
        codegen_generate_statement(then_start + i)
    end for
    
    -- Check if there's an else body
    numeric else_count = get_if_else_count(stmt_idx)
    if else_count > 0 then
        string jmp_end = "    jmp .L" + to_string(end_label)
        codegen_emit(jmp_end)
    end if
    
    -- Else label
    string else_lbl = ".L" + to_string(else_label) + ":"
    codegen_emit(else_lbl)
    
    -- Else body (if exists)
    if else_count > 0 then
        codegen_emit("    ; Else body")
        numeric else_start = get_if_else_start(stmt_idx)
        
        for i = 0 to else_count - 1
            codegen_generate_statement(else_start + i)
        end for
        
        string end_lbl = ".L" + to_string(end_label) + ":"
        codegen_emit(end_lbl)
    end if
    
    return 0
end func

-- ============================================
-- Helper functions to access if statement data
-- These should be implemented based on AST structure
-- ============================================

-- Get condition expression index from if statement
func get_if_condition(numeric stmt_idx) returns numeric
    -- Implementation depends on AST structure
    return stmt_expr_indices[stmt_idx]
end func

-- Get then body start index
func get_if_then_start(numeric stmt_idx) returns numeric
    return stmt_body_starts[stmt_idx]
end func

-- Get then body count
func get_if_then_count(numeric stmt_idx) returns numeric
    return stmt_body_counts[stmt_idx]
end func

-- Get else body start index
func get_if_else_start(numeric stmt_idx) returns numeric
    -- Implementation specific to AST storage
    return stmt_else_starts[stmt_idx]
end func

-- Get else body count
func get_if_else_count(numeric stmt_idx) returns numeric
    -- Implementation specific to AST storage
    return stmt_else_counts[stmt_idx]
end func
