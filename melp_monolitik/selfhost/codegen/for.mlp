-- ============================================
-- MLP Self-Hosting Compiler - Codegen For
-- ============================================
-- For loop code generation
-- Generates x86-64 NASM assembly
-- ============================================

-- Include types
-- import "types.mlp"

-- Forward declarations
-- extern func codegen_emit(string line)
-- extern func codegen_generate_expression_value(numeric expr_idx)
-- extern func codegen_generate_statement(numeric stmt_idx)
-- extern func codegen_add_variable(string name, numeric offset, numeric var_type)
-- extern func codegen_find_variable(string name) returns numeric

-- Loop context state
state numeric loop_start_label = -1
state numeric loop_continue_label = -1
state numeric loop_end_label = -1
state numeric in_loop = 0

-- Stack offset tracking
state numeric stack_offset = 0

-- Generate for loop assembly
func codegen_generate_for(numeric stmt_idx) returns numeric
    numeric loop_start = get_next_label()
    numeric loop_continue = get_next_label()
    numeric loop_end = get_next_label()
    
    -- Save previous loop context
    numeric prev_start = loop_start_label
    numeric prev_continue = loop_continue_label
    numeric prev_end = loop_end_label
    numeric prev_in_loop = in_loop
    
    -- Set current loop context
    loop_start_label = loop_start
    loop_continue_label = loop_continue
    loop_end_label = loop_end
    in_loop = 1
    
    codegen_emit("")
    codegen_emit("    ; For loop")
    
    -- Get loop variable name
    string var_name = get_for_var_name(stmt_idx)
    
    -- Allocate loop variable on stack
    stack_offset = stack_offset + 8
    codegen_add_variable(var_name, stack_offset, TYPE_NUMERIC)
    
    string alloc_line = "    sub rsp, 8         ; Allocate " + var_name
    codegen_emit(alloc_line)
    
    -- Initialize loop variable with start value
    numeric start_expr = get_for_start(stmt_idx)
    codegen_generate_expression_value(start_expr)
    
    numeric var_offset = codegen_find_variable(var_name)
    string init_line = "    mov [rbp-" + to_string(var_offset) + "], rax   ; Initialize " + var_name
    codegen_emit(init_line)
    
    -- Loop start label
    string start_lbl = ".L" + to_string(loop_start) + ":  ; loop_start"
    codegen_emit(start_lbl)
    
    -- Check condition: loop_var <= end_value
    string load_line = "    mov rax, [rbp-" + to_string(var_offset) + "]   ; Load " + var_name
    codegen_emit(load_line)
    codegen_emit("    push rax")
    
    numeric end_expr = get_for_end(stmt_idx)
    codegen_generate_expression_value(end_expr)
    codegen_emit("    mov rbx, rax")
    codegen_emit("    pop rax")
    codegen_emit("    cmp rax, rbx")
    
    string exit_line = "    jg .L" + to_string(loop_end) + "           ; Exit if i > end"
    codegen_emit(exit_line)
    
    -- Loop body
    codegen_emit("    ; Loop body")
    numeric body_start = get_for_body_start(stmt_idx)
    numeric body_count = get_for_body_count(stmt_idx)
    
    for i = 0 to body_count - 1
        codegen_generate_statement(body_start + i)
    end for
    
    -- Loop continue label
    string cont_lbl = ".L" + to_string(loop_continue) + ":  ; loop_continue"
    codegen_emit(cont_lbl)
    
    -- Increment loop variable
    codegen_emit("    ; Increment loop variable")
    string load_line2 = "    mov rax, [rbp-" + to_string(var_offset) + "]"
    codegen_emit(load_line2)
    
    -- Check for custom step
    numeric step_expr = get_for_step(stmt_idx)
    if step_expr >= 0 then
        codegen_emit("    push rax")
        codegen_generate_expression_value(step_expr)
        codegen_emit("    mov rbx, rax")
        codegen_emit("    pop rax")
        codegen_emit("    add rax, rbx")
    else
        -- Default step = 1
        codegen_emit("    add rax, 1")
    end if
    
    string store_line = "    mov [rbp-" + to_string(var_offset) + "], rax"
    codegen_emit(store_line)
    
    -- Jump back to loop start
    string jmp_line = "    jmp .L" + to_string(loop_start)
    codegen_emit(jmp_line)
    
    -- Loop end label
    string end_lbl = ".L" + to_string(loop_end) + ":  ; loop_end"
    codegen_emit(end_lbl)
    
    -- Restore previous loop context
    loop_start_label = prev_start
    loop_continue_label = prev_continue
    loop_end_label = prev_end
    in_loop = prev_in_loop
    
    return 0
end func

-- Generate for-in loop assembly (array iteration)
func codegen_generate_for_in(numeric stmt_idx) returns numeric
    numeric loop_start = get_next_label()
    numeric loop_end = get_next_label()
    numeric loop_continue = get_next_label()
    
    -- Save previous loop context
    numeric prev_start = loop_start_label
    numeric prev_continue = loop_continue_label
    numeric prev_end = loop_end_label
    numeric prev_in_loop = in_loop
    
    loop_start_label = loop_start
    loop_continue_label = loop_continue
    loop_end_label = loop_end
    in_loop = 1
    
    codegen_emit("")
    codegen_emit("    ; For-in loop")
    
    string var_name = get_for_in_var_name(stmt_idx)
    numeric var_type = get_for_in_var_type(stmt_idx)
    
    -- Allocate space for loop variable and index
    stack_offset = stack_offset + 8
    numeric var_offset = stack_offset
    codegen_add_variable(var_name, var_offset, var_type)
    string alloc_var = "    sub rsp, 8         ; Allocate space for " + var_name
    codegen_emit(alloc_var)
    
    stack_offset = stack_offset + 8
    numeric index_offset = stack_offset
    codegen_emit("    sub rsp, 8         ; Allocate space for loop index")
    
    stack_offset = stack_offset + 8
    numeric arr_offset = stack_offset
    codegen_emit("    sub rsp, 8         ; Allocate space for array base")
    
    stack_offset = stack_offset + 8
    numeric len_offset = stack_offset
    codegen_emit("    sub rsp, 8         ; Allocate space for array length")
    
    -- Get iterable and store
    numeric iterable_expr = get_for_in_iterable(stmt_idx)
    codegen_generate_expression_value(iterable_expr)
    string store_arr = "    mov [rbp-" + to_string(arr_offset) + "], rax   ; Store array pointer"
    codegen_emit(store_arr)
    
    codegen_emit("    mov rdi, rax")
    codegen_emit("    call mlp_array_length")
    string store_len = "    mov [rbp-" + to_string(len_offset) + "], rax   ; Store array length"
    codegen_emit(store_len)
    
    -- Initialize index to 0
    string init_idx = "    mov qword [rbp-" + to_string(index_offset) + "], 0   ; Initialize index"
    codegen_emit(init_idx)
    
    -- Loop start
    string start_lbl = ".L" + to_string(loop_start) + ":  ; for_in_start"
    codegen_emit(start_lbl)
    
    -- Check if index < length
    string load_idx = "    mov rax, [rbp-" + to_string(index_offset) + "]"
    codegen_emit(load_idx)
    string cmp_len = "    cmp rax, [rbp-" + to_string(len_offset) + "]"
    codegen_emit(cmp_len)
    string jge_end = "    jge .L" + to_string(loop_end)
    codegen_emit(jge_end)
    
    -- Load current element
    string load_arr = "    mov rdi, [rbp-" + to_string(arr_offset) + "]   ; Array base"
    codegen_emit(load_arr)
    string load_idx2 = "    mov rsi, [rbp-" + to_string(index_offset) + "]   ; Index"
    codegen_emit(load_idx2)
    codegen_emit("    mov rax, [rdi + rsi*8]   ; Load element")
    string store_var = "    mov [rbp-" + to_string(var_offset) + "], rax   ; Store in loop variable"
    codegen_emit(store_var)
    
    -- Generate loop body
    numeric body_start = get_for_in_body_start(stmt_idx)
    numeric body_count = get_for_in_body_count(stmt_idx)
    
    for i = 0 to body_count - 1
        codegen_generate_statement(body_start + i)
    end for
    
    -- Continue label
    string cont_lbl = ".L" + to_string(loop_continue) + ":  ; for_in_continue"
    codegen_emit(cont_lbl)
    
    -- Increment index
    string load_idx3 = "    mov rax, [rbp-" + to_string(index_offset) + "]"
    codegen_emit(load_idx3)
    codegen_emit("    add rax, 1")
    string store_idx = "    mov [rbp-" + to_string(index_offset) + "], rax"
    codegen_emit(store_idx)
    
    -- Jump back to loop start
    string jmp_start = "    jmp .L" + to_string(loop_start)
    codegen_emit(jmp_start)
    
    -- Loop end label
    string end_lbl = ".L" + to_string(loop_end) + ":  ; for_in_end"
    codegen_emit(end_lbl)
    
    -- Restore previous loop context
    loop_start_label = prev_start
    loop_continue_label = prev_continue
    loop_end_label = prev_end
    in_loop = prev_in_loop
    
    return 0
end func

-- ============================================
-- Helper functions to access for statement data
-- ============================================

func get_for_var_name(numeric stmt_idx) returns string
    return stmt_var_names[stmt_idx]
end func

func get_for_start(numeric stmt_idx) returns numeric
    -- Implementation specific to AST
    return stmt_for_starts[stmt_idx]
end func

func get_for_end(numeric stmt_idx) returns numeric
    return stmt_for_ends[stmt_idx]
end func

func get_for_step(numeric stmt_idx) returns numeric
    return stmt_for_steps[stmt_idx]  -- -1 if no custom step
end func

func get_for_body_start(numeric stmt_idx) returns numeric
    return stmt_body_starts[stmt_idx]
end func

func get_for_body_count(numeric stmt_idx) returns numeric
    return stmt_body_counts[stmt_idx]
end func

func get_for_in_var_name(numeric stmt_idx) returns string
    return stmt_var_names[stmt_idx]
end func

func get_for_in_var_type(numeric stmt_idx) returns numeric
    return stmt_var_types[stmt_idx]
end func

func get_for_in_iterable(numeric stmt_idx) returns numeric
    return stmt_expr_indices[stmt_idx]
end func

func get_for_in_body_start(numeric stmt_idx) returns numeric
    return stmt_body_starts[stmt_idx]
end func

func get_for_in_body_count(numeric stmt_idx) returns numeric
    return stmt_body_counts[stmt_idx]
end func
