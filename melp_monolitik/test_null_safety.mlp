-- MELP Phase 15: Null Safety Tests
-- Tests for nullable types (?), optional chaining (?.) and null coalescing (??)

-- Test 1: Basic null literal
func test_null_literal()
    print("Test 1: Null literal")
    numeric? x = null
    if x == null then
        print("PASS: x is null")
    else
        print("FAIL: x should be null")
    end if
end func

-- Test 2: Nullable with value
func test_nullable_with_value()
    print("Test 2: Nullable with value")
    numeric? y = 42
    if y != null then
        print("PASS: y has value")
        print(y)
    else
        print("FAIL: y should have value")
    end if
end func

-- Test 3: Null coalescing operator (??)
func test_null_coalesce()
    print("Test 3: Null coalescing operator")
    
    -- null ?? default should return default
    numeric? a = null
    numeric result1 = a ?? 100
    print("null ?? 100 = ")
    print(result1)
    
    -- value ?? default should return value
    numeric? b = 50
    numeric result2 = b ?? 100
    print("50 ?? 100 = ")
    print(result2)
end func

-- Test 4: Chained null coalescing
func test_chained_coalesce()
    print("Test 4: Chained null coalescing")
    numeric? a = null
    numeric? b = null
    numeric? c = 30
    
    numeric result = a ?? b ?? c ?? 999
    print("null ?? null ?? 30 ?? 999 = ")
    print(result)
end func

-- Test 5: Null comparison
func test_null_comparison()
    print("Test 5: Null comparison")
    numeric? x = null
    numeric? y = 10
    
    if x == null then
        print("PASS: x == null")
    end if
    
    if y != null then
        print("PASS: y != null")
    end if
end func

-- Main
func main()
    print("=== MELP Null Safety Tests ===")
    print("")
    
    test_null_literal()
    print("")
    
    test_nullable_with_value()
    print("")
    
    test_null_coalesce()
    print("")
    
    test_chained_coalesce()
    print("")
    
    test_null_comparison()
    print("")
    
    print("=== All tests complete ===")
end func

main()
