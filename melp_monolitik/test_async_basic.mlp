-- Test: Async/Await basic syntax
-- Phase 12: Asynchronous functions

-- Simple async function
async func fetchData(numeric id)
    return id * 100
end func

-- Async function with await
async func processData()
    numeric result = await fetchData(5)
    print(result)
end func

-- Main code
print(42)

-- Call async function
numeric data = fetchData(5)
print(data)

-- Call async with await
processData()
