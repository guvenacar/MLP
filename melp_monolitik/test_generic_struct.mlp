struct Box<T>
    T value
end struct

struct Pair<T, U>
    T first
    U second
end struct

func main() returns numeric
    Box<numeric> b
    b.value = 42
    print(b.value)
    
    Pair<numeric, numeric> p
    p.first = 100
    p.second = 200
    print(p.first)
    print(p.second)
    
    return 0
end func
