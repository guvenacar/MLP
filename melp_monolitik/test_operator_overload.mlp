-- Phase 16: Operator Overloading Test

struct Vector
    numeric x
    numeric y
end struct

-- Define + operator for Vector type
operator +(Vector a, Vector b) returns numeric
    numeric result
    result = a.x + b.x + a.y + b.y
    return result
end operator

-- Define - operator for Vector type
operator -(Vector a, Vector b) returns numeric
    numeric result
    result = a.x - b.x + a.y - b.y
    return result
end operator

-- Main program
Vector v1
v1.x = 10
v1.y = 20

Vector v2
v2.x = 5
v2.y = 15

print("=== Operator Overloading Test ===")
print("Vector v1 (x, y):")
print(v1.x)
print(v1.y)

print("Vector v2 (x, y):")
print(v2.x)
print(v2.y)

-- Use overloaded + operator 
numeric sum
sum = v1 + v2
print("v1 + v2 (sum of all fields) =")
print(sum)

-- Use overloaded - operator
numeric diff
diff = v1 - v2
print("v1 - v2 (diff of all fields) =")
print(diff)

print(999)
