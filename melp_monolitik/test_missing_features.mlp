-- Test AND/OR/NOT
func test_logical()
    numeric x = 5
    numeric y = 10
    
    if x > 0 and y > 0 then
        print(1)
    end if
    
    if x > 0 or y < 0 then
        print(2)
    end if
    
    boolean flag = true
    if not flag then
        print(3)
    end if
    
    return 0
end func
