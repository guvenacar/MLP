-- MLP JSON Lexer v1.0
-- Pure MLP implementation - English keywords only

-- Helper: Check if character is whitespace
function is_whitespace(ch) then
    int code = char_code(ch);
    if code == 32 then
        return 1
    end
    if code == 9 then
        return 1
    end
    if code == 10 then
        return 1
    end
    if code == 13 then
        return 1
    end
    return 0
end

-- Helper: Check if character is digit
function is_digit(ch) then
    int code = char_code(ch);
    if code >= 48 then
        if code <= 57 then
            return 1
        end
    end
    return 0
end

-- Helper: Skip whitespace and return new position
function skip_whitespace(text, pos) then
    int len = string_length(text);

    while pos < len
        string ch = substring(text, pos, 1);
        if is_whitespace(ch) == 0 then
            return pos
        end
        pos = pos + 1
    end

    return pos
end

-- Helper: Scan string literal, return end position
function scan_string(text, start_pos) then
    int pos = start_pos + 1;
    int len = string_length(text);

    while pos < len
        string ch = substring(text, pos, 1);
        if ch == "\"" then
            return pos + 1
        end
        pos = pos + 1
    end

    print "ERROR: Unclosed string at position "
    print start_pos
    return pos
end

-- Helper: Scan number, return end position
function scan_number(text, start_pos) then
    int pos = start_pos;
    int len = string_length(text);

    while pos < len
        string ch = substring(text, pos, 1);
        if is_digit(ch) == 0 then
            int code = char_code(ch);
            if code == 46 then
                pos = pos + 1
            else
                return pos
            end
        else
            pos = pos + 1
        end
    end

    return pos
end

-- Helper: Match keyword at position
function match_keyword(text, pos, keyword) then
    int kw_len = string_length(keyword);
    int text_len = string_length(text);

    if pos + kw_len > text_len then
        return 0
    end

    string substr = substring(text, pos, kw_len);
    int sub_len = string_length(substr);

    if sub_len == kw_len then
        int i = 0;
        while i < kw_len
            string ch1 = substring(keyword, i, 1)
            string ch2 = substring(substr, i, 1)
            int code1 = char_code(ch1)
            int code2 = char_code(ch2)
            if code1 =/= code2 then
                return 0
            end
            i = i + 1
        end
        return 1
    end

    return 0
end

-- Main tokenizer function
function tokenize_json(text) then
    int pos = 0;
    int len = string_length(text);
    int token_count = 0;

    print "=== JSON Lexer v1.0 ==="
    print ""
    print "Input length: "
    print len
    print ""
    print "Tokens:"
    print "--------"

    while pos < len
        pos = skip_whitespace(text, pos)

        if pos >= len then
            break
        end

        string ch = substring(text, pos, 1);

        if ch == "{" then
            print "Token "
            print token_count
            print ": LBRACE"
            token_count = token_count + 1
            pos = pos + 1
        else if ch == "}" then
            print "Token "
            print token_count
            print ": RBRACE"
            token_count = token_count + 1
            pos = pos + 1
        else if ch == "[" then
            print "Token "
            print token_count
            print ": LBRACKET"
            token_count = token_count + 1
            pos = pos + 1
        else if ch == "]" then
            print "Token "
            print token_count
            print ": RBRACKET"
            token_count = token_count + 1
            pos = pos + 1
        else if ch == ":" then
            print "Token "
            print token_count
            print ": COLON"
            token_count = token_count + 1
            pos = pos + 1
        else if ch == "," then
            print "Token "
            print token_count
            print ": COMMA"
            token_count = token_count + 1
            pos = pos + 1
        else if ch == "\"" then
            int start = pos;
            int end_pos = scan_string(text, pos);
            int value_len = end_pos - start - 2;
            string value = substring(text, start + 1, value_len);

            print "Token "
            print token_count
            print ": STRING '"
            print value
            print "'"

            token_count = token_count + 1
            pos = end_pos
        else if is_digit(ch) == 1 then
            int start = pos;
            int end_pos = scan_number(text, pos);
            int value_len = end_pos - start;
            string value = substring(text, start, value_len);

            print "Token "
            print token_count
            print ": NUMBER "
            print value

            token_count = token_count + 1
            pos = end_pos
        else if ch == "t" then
            if match_keyword(text, pos, "true") == 1 then
                print "Token "
                print token_count
                print ": TRUE"
                token_count = token_count + 1
                pos = pos + 4
            else
                print "ERROR: Unknown token at pos "
                print pos
                pos = pos + 1
            end
        else if ch == "f" then
            if match_keyword(text, pos, "false") == 1 then
                print "Token "
                print token_count
                print ": FALSE"
                token_count = token_count + 1
                pos = pos + 5
            else
                print "ERROR: Unknown token at pos "
                print pos
                pos = pos + 1
            end
        else if ch == "n" then
            if match_keyword(text, pos, "null") == 1 then
                print "Token "
                print token_count
                print ": NULL"
                token_count = token_count + 1
                pos = pos + 4
            else
                print "ERROR: Unknown token at pos "
                print pos
                pos = pos + 1
            end
        else
            print "ERROR: Unexpected character at pos "
            print pos
            pos = pos + 1
        end
    end

    print "--------"
    print "Total tokens: "
    print token_count

    return token_count
end

-- Test with simple JSON
print "Test 1: Simple object"
print "====================="
string json1 = "{\"name\": \"MLP\", \"version\": 3}";
int count1 = tokenize_json(json1);
print ""

print "Test 2: Array"
print "============="
string json2 = "[\"tr\", \"en\", \"ru\"]";
int count2 = tokenize_json(json2);
print ""

print "Test 3: Keywords"
print "================"
string json3 = "{\"active\": true, \"flag\": false, \"data\": null}";
int count3 = tokenize_json(json3);
print ""

print "All tests complete!"
