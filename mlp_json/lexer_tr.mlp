-- MLP JSON Lexer v1.0 (Türkçe)
-- Saf MLP implementasyonu - dış bağımlılık yok

-- Token tipi sabitleri
SAYISAL TOKEN_LBRACE = 1;
SAYISAL TOKEN_RBRACE = 2;
SAYISAL TOKEN_LBRACKET = 3;
SAYISAL TOKEN_RBRACKET = 4;
SAYISAL TOKEN_COLON = 5;
SAYISAL TOKEN_COMMA = 6;
SAYISAL TOKEN_STRING = 7;
SAYISAL TOKEN_NUMBER = 8;
SAYISAL TOKEN_TRUE = 9;
SAYISAL TOKEN_FALSE = 10;
SAYISAL TOKEN_NULL = 11;
SAYISAL TOKEN_EOF = 12;

-- Yardımcı: Karakter boşluk mu?
İŞLEÇ is_whitespace(ch) İSE
    SAYISAL code = KARAKTER_KODU(ch);
    -- space(32), tab(9), newline(10), carriage return(13)
    EĞER code == 32 İSE
        DÖNÜŞ 1;
    SON;
    EĞER code == 9 İSE
        DÖNÜŞ 1;
    SON;
    EĞER code == 10 İSE
        DÖNÜŞ 1;
    SON;
    EĞER code == 13 İSE
        DÖNÜŞ 1;
    SON;
    DÖNÜŞ 0;
SON;

-- Yardımcı: Karakter rakam mı?
İŞLEÇ is_digit(ch) İSE
    SAYISAL code = KARAKTER_KODU(ch);
    EĞER code >= 48 İSE
        EĞER code <= 57 İSE
            DÖNÜŞ 1;
        SON;
    SON;
    DÖNÜŞ 0;
SON;

-- Yardımcı: Boşlukları atla
İŞLEÇ skip_whitespace(text, pos) İSE
    SAYISAL len = STRING_UZUNLUK(text);

    DÖNGÜ pos < len İSE
        METIN ch = STRING_ALT(text, pos, 1);
        EĞER is_whitespace(ch) == 0 İSE
            DÖNÜŞ pos;
        SON;
        pos = pos + 1;
    SON;

    DÖNÜŞ pos;
SON;

-- Yardımcı: String literal'ı tara
İŞLEÇ scan_string(text, start_pos) İSE
    SAYISAL pos = start_pos + 1;
    SAYISAL len = STRING_UZUNLUK(text);

    -- Kapanış tırnağını bul
    DÖNGÜ pos < len İSE
        METIN ch = STRING_ALT(text, pos, 1);
        EĞER ch == "\"" İSE
            DÖNÜŞ pos + 1;
        SON;
        pos = pos + 1;
    SON;

    -- Hata: kapatılmamış string
    YAZDIR "HATA: Kapatılmamış string, pozisyon: ";
    YAZDIR start_pos;
    DÖNÜŞ pos;
SON;

-- Yardımcı: Sayıyı tara
İŞLEÇ scan_number(text, start_pos) İSE
    SAYISAL pos = start_pos;
    SAYISAL len = STRING_UZUNLUK(text);

    DÖNGÜ pos < len İSE
        METIN ch = STRING_ALT(text, pos, 1);
        EĞER is_digit(ch) == 0 İSE
            -- Ondalık nokta kontrolü
            SAYISAL code = KARAKTER_KODU(ch);
            EĞER code == 46 İSE
                pos = pos + 1;
            DEĞİLSE
                DÖNÜŞ pos;
            SON;
        DEĞİLSE
            pos = pos + 1;
        SON;
    SON;

    DÖNÜŞ pos;
SON;

-- Yardımcı: Anahtar kelime eşleştir
İŞLEÇ match_keyword(text, pos, keyword) İSE
    SAYISAL kw_len = STRING_UZUNLUK(keyword);
    SAYISAL text_len = STRING_UZUNLUK(text);

    EĞER pos + kw_len > text_len İSE
        DÖNÜŞ 0;
    SON;

    METIN substr = STRING_ALT(text, pos, kw_len);

    -- Basit string karşılaştırma
    SAYISAL sub_len = STRING_UZUNLUK(substr);
    EĞER sub_len == kw_len İSE
        -- Karakter karakter karşılaştır
        SAYISAL i = 0;
        DÖNGÜ i < kw_len İSE
            METIN ch1 = STRING_ALT(keyword, i, 1);
            METIN ch2 = STRING_ALT(substr, i, 1);
            SAYISAL code1 = KARAKTER_KODU(ch1);
            SAYISAL code2 = KARAKTER_KODU(ch2);
            EĞER code1 =/= code2 İSE
                DÖNÜŞ 0;
            SON;
            i = i + 1;
        SON;
        DÖNÜŞ 1;
    SON;

    DÖNÜŞ 0;
SON;

-- Ana tokenizer fonksiyonu
İŞLEÇ tokenize_json(text) İSE
    SAYISAL pos = 0;
    SAYISAL len = STRING_UZUNLUK(text);
    SAYISAL token_count = 0;

    YAZDIR "=== JSON Lexer v1.0 ===";
    YAZDIR "";
    YAZDIR "Tokenizing...";
    YAZDIR "";

    DÖNGÜ pos < len İSE
        -- Boşlukları atla
        pos = skip_whitespace(text, pos);

        EĞER pos >= len İSE
            ÇIKIŞ;
        SON;

        METIN ch = STRING_ALT(text, pos, 1);
        SAYISAL code = KARAKTER_KODU(ch);

        -- Tek karakterli tokenlar
        EĞER ch == "{" İSE
            YAZDIR "Token ";
            YAZDIR token_count;
            YAZDIR ": LBRACE at pos ";
            YAZDIR pos;
            token_count = token_count + 1;
            pos = pos + 1;

        DEĞİLSE EĞER ch == "}" İSE
            YAZDIR "Token ";
            YAZDIR token_count;
            YAZDIR ": RBRACE at pos ";
            YAZDIR pos;
            token_count = token_count + 1;
            pos = pos + 1;

        DEĞİLSE EĞER ch == "[" İSE
            YAZDIR "Token ";
            YAZDIR token_count;
            YAZDIR ": LBRACKET at pos ";
            YAZDIR pos;
            token_count = token_count + 1;
            pos = pos + 1;

        DEĞİLSE EĞER ch == "]" İSE
            YAZDIR "Token ";
            YAZDIR token_count;
            YAZDIR ": RBRACKET at pos ";
            YAZDIR pos;
            token_count = token_count + 1;
            pos = pos + 1;

        DEĞİLSE EĞER ch == ":" İSE
            YAZDIR "Token ";
            YAZDIR token_count;
            YAZDIR ": COLON at pos ";
            YAZDIR pos;
            token_count = token_count + 1;
            pos = pos + 1;

        DEĞİLSE EĞER ch == "," İSE
            YAZDIR "Token ";
            YAZDIR token_count;
            YAZDIR ": COMMA at pos ";
            YAZDIR pos;
            token_count = token_count + 1;
            pos = pos + 1;

        -- String literal
        DEĞİLSE EĞER ch == "\"" İSE
            SAYISAL start = pos;
            SAYISAL end_pos = scan_string(text, pos);
            METIN value = STRING_ALT(text, start + 1, end_pos - start - 2);

            YAZDIR "Token ";
            YAZDIR token_count;
            YAZDIR ": STRING '";
            YAZDIR value;
            YAZDIR "' at pos ";
            YAZDIR start;

            token_count = token_count + 1;
            pos = end_pos;

        -- Sayı
        DEĞİLSE EĞER is_digit(ch) == 1 İSE
            SAYISAL start = pos;
            SAYISAL end_pos = scan_number(text, pos);
            METIN value = STRING_ALT(text, start, end_pos - start);

            YAZDIR "Token ";
            YAZDIR token_count;
            YAZDIR ": NUMBER ";
            YAZDIR value;
            YAZDIR " at pos ";
            YAZDIR start;

            token_count = token_count + 1;
            pos = end_pos;

        -- Anahtar kelimeler: true, false, null
        DEĞİLSE EĞER ch == "t" İSE
            EĞER match_keyword(text, pos, "true") == 1 İSE
                YAZDIR "Token ";
                YAZDIR token_count;
                YAZDIR ": TRUE at pos ";
                YAZDIR pos;
                token_count = token_count + 1;
                pos = pos + 4;
            DEĞİLSE
                YAZDIR "HATA: Bilinmeyen token, pozisyon: ";
                YAZDIR pos;
                pos = pos + 1;
            SON;

        DEĞİLSE EĞER ch == "f" İSE
            EĞER match_keyword(text, pos, "false") == 1 İSE
                YAZDIR "Token ";
                YAZDIR token_count;
                YAZDIR ": FALSE at pos ";
                YAZDIR pos;
                token_count = token_count + 1;
                pos = pos + 5;
            DEĞİLSE
                YAZDIR "HATA: Bilinmeyen token, pozisyon: ";
                YAZDIR pos;
                pos = pos + 1;
            SON;

        DEĞİLSE EĞER ch == "n" İSE
            EĞER match_keyword(text, pos, "null") == 1 İSE
                YAZDIR "Token ";
                YAZDIR token_count;
                YAZDIR ": NULL at pos ";
                YAZDIR pos;
                token_count = token_count + 1;
                pos = pos + 4;
            DEĞİLSE
                YAZDIR "HATA: Bilinmeyen token, pozisyon: ";
                YAZDIR pos;
                pos = pos + 1;
            SON;

        DEĞİLSE
            YAZDIR "HATA: Beklenmeyen karakter '";
            YAZDIR ch;
            YAZDIR "' pozisyon: ";
            YAZDIR pos;
            pos = pos + 1;
        SON;
    SON;

    YAZDIR "";
    YAZDIR "Tokenization tamamlandı!";
    YAZDIR "Toplam token: ";
    YAZDIR token_count;

    DÖNÜŞ token_count;
SON;

-- Basit JSON ile test
YAZDIR "Test 1: Basit object";
YAZDIR "=====================";
METIN json1 = "{\"name\": \"MLP\", \"version\": 3}";
SAYISAL count1 = tokenize_json(json1);
YAZDIR "";

YAZDIR "Test 2: İç içe yapı";
YAZDIR "========================";
METIN json2 = "{\"languages\": [\"tr\", \"en\", \"ru\"]}";
SAYISAL count2 = tokenize_json(json2);
YAZDIR "";

YAZDIR "Test 3: Anahtar kelimeler";
YAZDIR "==================";
METIN json3 = "{\"active\": true, \"count\": null, \"flag\": false}";
SAYISAL count3 = tokenize_json(json3);
YAZDIR "";

YAZDIR "Tüm testler tamamlandı!";
