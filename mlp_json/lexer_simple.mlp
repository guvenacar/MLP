-- MLP JSON Lexer - Basit Test Versiyonu
-- Token type'ları print ederek göster

İŞLEÇ test_lexer() İSE
    -- Test JSON
    METIN json = "{\"name\": \"MLP\"}";

    SAYISAL pos = 0;
    SAYISAL len = STRING_UZUNLUK(json);

    YAZDIR "JSON Lexer Testi";
    YAZDIR "Input: ";
    YAZDIR json;
    YAZDIR "";
    YAZDIR "Tokens:";

    DÖNGÜ pos < len İSE
        METIN ch = STRING_ALT(json, pos, 1);

        EĞER ch == "{" İSE
            YAZDIR "LBRACE";
        DEĞİLSE EĞER ch == "}" İSE
            YAZDIR "RBRACE";
        DEĞİLSE EĞER ch == ":" İSE
            YAZDIR "COLON";
        DEĞİLSE EĞER ch == "\"" İSE
            -- String literal başlıyor
            pos = pos + 1;
            SAYISAL start = pos;

            -- Kapanış tırnağını bul
            DÖNGÜ pos < len İSE
                METIN ch2 = STRING_ALT(json, pos, 1);
                EĞER ch2 == "\"" İSE
                    ÇIKIŞ;
                SON;
                pos = pos + 1;
            SON;

            METIN value = STRING_ALT(json, start, pos - start);
            YAZDIR "STRING: ";
            YAZDIR value;
        SON;

        pos = pos + 1;
    SON;

    YAZDIR "";
    YAZDIR "Lexer testi tamamlandı!";

    DÖNÜŞ 0;
SON;

-- Test'i çalıştır
SAYISAL result = test_lexer();
