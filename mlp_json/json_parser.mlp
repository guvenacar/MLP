-- MLP JSON Parser v1.0
-- Recursive Descent Parser for JSON
-- Input: Token array from json_lexer_final.mlp
-- Output: Key-value storage for diller_comprehensive.json queries

-- ========================================
-- TOKEN DEFINITIONS (same as lexer)
-- ========================================
int TOKEN_LBRACE = 1      -- {
int TOKEN_RBRACE = 2      -- }
int TOKEN_LBRACKET = 3    -- [
int TOKEN_RBRACKET = 4    -- ]
int TOKEN_COLON = 5       -- :
int TOKEN_COMMA = 6       -- ,
int TOKEN_STRING = 7      -- "text"
int TOKEN_NUMBER = 8      -- 123
int TOKEN_TRUE = 9        -- true
int TOKEN_FALSE = 10      -- false
int TOKEN_NULL = 11       -- null
int TOKEN_EOF = 12        -- End of input

-- ========================================
-- TOKEN STORAGE (Global Arrays)
-- ========================================
int token_types[1000]     -- Token type codes
string token_values[1000] -- Token values (for STRING, NUMBER)
int token_count = 0       -- Current token count
int current_token_index = 0 -- Parser position

-- ========================================
-- JSON VALUE STORAGE (Flat Key-Value)
-- ========================================
string json_keys[500]     -- Keys
string json_values[500]   -- Values (stored as strings)
int json_count = 0        -- Entry count

-- ========================================
-- TOKEN MANAGEMENT FUNCTIONS
-- ========================================

-- Get current token type
function current_token() then
    if current_token_index >= token_count then
        return TOKEN_EOF
    end
    return token_types[current_token_index]
end

-- Get current token value (for STRING/NUMBER)
function current_token_value() then
    if current_token_index >= token_count then
        return ""
    end
    return token_values[current_token_index]
end

-- Advance to next token
function advance_token() then
    current_token_index = current_token_index + 1
end

-- Expect a specific token type, error if mismatch
function expect_token(expected_type) then
    int current = current_token()
    if current != expected_type then
        print "ERROR: Expected token type "
        print expected_type
        print " but got "
        print current
        return 0
    end
    advance_token()
    return 1
end

-- ========================================
-- JSON STORAGE FUNCTIONS
-- ========================================

-- Store key-value pair
function json_store(key, value) then
    if json_count >= 500 then
        print "ERROR: JSON storage full (max 500 entries)"
        return 0
    end
    json_keys[json_count] = key
    json_values[json_count] = value
    json_count = json_count + 1
    return 1
end

-- Query value by key
function json_get(key) then
    int i = 0
    while i < json_count
        if json_keys[i] == key then
            return json_values[i]
        end
        i = i + 1
    end
    return ""
end

-- ========================================
-- RECURSIVE DESCENT PARSER
-- ========================================

-- Forward declarations (MLP requires this for recursion)
function parse_value() then
    int tok = current_token()
    
    if tok == TOKEN_LBRACE then
        return parse_object()
    end
    if tok == TOKEN_LBRACKET then
        return parse_array()
    end
    if tok == TOKEN_STRING then
        string val = current_token_value()
        advance_token()
        return val
    end
    if tok == TOKEN_NUMBER then
        string val = current_token_value()
        advance_token()
        return val
    end
    if tok == TOKEN_TRUE then
        advance_token()
        return "true"
    end
    if tok == TOKEN_FALSE then
        advance_token()
        return "false"
    end
    if tok == TOKEN_NULL then
        advance_token()
        return "null"
    end
    
    print "ERROR: Unexpected token in parse_value: "
    print tok
    return ""
end

-- Parse JSON object: {"key": value, ...}
function parse_object() then
    expect_token(TOKEN_LBRACE)
    
    while current_token() != TOKEN_RBRACE
        int tok = current_token()
        
        -- Parse key (must be string)
        if tok != TOKEN_STRING then
            print "ERROR: Expected string key in object"
            return ""
        end
        string key = current_token_value()
        advance_token()
        
        -- Expect colon
        expect_token(TOKEN_COLON)
        
        -- Parse value (recursive!)
        string value = parse_value()
        
        -- Store key-value
        json_store(key, value)
        
        -- Check for comma
        tok = current_token()
        if tok == TOKEN_COMMA then
            advance_token()
        end
    end
    
    expect_token(TOKEN_RBRACE)
    return "object"
end

-- Parse JSON array: [value1, value2, ...]
function parse_array() then
    expect_token(TOKEN_LBRACKET)
    int index = 0
    
    while current_token() != TOKEN_RBRACKET
        -- Parse value (recursive!)
        string value = parse_value()
        
        -- Store with array index as key
        string key = string_concat("[", string_concat(int_to_string(index), "]"))
        json_store(key, value)
        index = index + 1
        
        -- Check for comma
        int tok = current_token()
        if tok == TOKEN_COMMA then
            advance_token()
        end
    end
    
    expect_token(TOKEN_RBRACKET)
    return "array"
end

-- ========================================
-- MAIN PARSER ENTRY POINT
-- ========================================

-- Parse JSON from token array
function json_parse() then
    current_token_index = 0
    json_count = 0
    
    print "=== JSON Parser v1.0 ==="
    print "Parsing tokens..."
    
    string result = parse_value()
    
    print "Parsing complete!"
    print "Stored entries: "
    print json_count
    print ""
    
    return result
end

-- ========================================
-- HELPER: Convert int to string (MISSING IN MLP!)
-- ========================================
function int_to_string(num) then
    if num == 0 then
        return "0"
    end
    if num == 1 then
        return "1"
    end
    if num == 2 then
        return "2"
    end
    if num == 3 then
        return "3"
    end
    if num == 4 then
        return "4"
    end
    if num == 5 then
        return "5"
    end
    if num == 6 then
        return "6"
    end
    if num == 7 then
        return "7"
    end
    if num == 8 then
        return "8"
    end
    if num == 9 then
        return "9"
    end
    -- For numbers > 9, manual digit extraction needed
    return "?"
end

-- ========================================
-- INTEGRATION TEST
-- ========================================

print "========================================="
print "JSON Parser Test"
print "========================================="

-- Simulate tokenized input (manual for now)
-- JSON: {"name": "MLP", "version": 3}

token_types[0] = TOKEN_LBRACE
token_types[1] = TOKEN_STRING
token_values[1] = "name"
token_types[2] = TOKEN_COLON
token_types[3] = TOKEN_STRING
token_values[3] = "MLP"
token_types[4] = TOKEN_COMMA
token_types[5] = TOKEN_STRING
token_values[5] = "version"
token_types[6] = TOKEN_COLON
token_types[7] = TOKEN_NUMBER
token_values[7] = "3"
token_types[8] = TOKEN_RBRACE
token_count = 9

string result = json_parse()

-- Query test
print "Query test: json_get('name') = "
print json_get("name")
print "Query test: json_get('version') = "
print json_get("version")

print "========================================="
print "Test complete!"
print "========================================="
