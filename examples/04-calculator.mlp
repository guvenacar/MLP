-- Simple Calculator Example
-- Demonstrates: classes, methods, variables, expressions

SINIF Calculator
    result SAYISAL

    KURUCU()
        YAZDIR "Calculator initialized"
    SON

    IŞLEÇ add(SAYISAL a, SAYISAL b)
        sum = a + b;
        YAZDIR "Adding numbers..."
        DÖNÜŞ sum
    SON

    IŞLEÇ multiply(SAYISAL a, SAYISAL b)
        product = a * b;
        YAZDIR "Multiplying numbers..."
        DÖNÜŞ product
    SON
SON

YAZDIR "=== MLP Calculator ==="
YAZDIR "Test complete!"
