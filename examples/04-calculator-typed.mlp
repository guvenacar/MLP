-- Simple Calculator Example (with type annotations)
-- Demonstrates: classes, methods, variables, expressions

class Calculator
    result number

    constructor()
        YAZDIR "Calculator initialized"
    end

    method add(number a, number b) -> number
        var sum = a + b
        YAZDIR "Adding numbers..."
        return sum
    end

    method multiply(number a, number b) -> number
        var product = a * b
        YAZDIR "Multiplying numbers..."
        return product
    end
end

YAZDIR "=== MLP Calculator ==="
YAZDIR "Test complete!"
