// Phase 8.8: Async I/O Primitives Test
// Tests async_sleep, async_read_file, async_write_file, async_http_get

async function main()
    print("=== Async I/O Test Starting ===")
    
    // Test 1: async_sleep
    print("Test 1: Sleeping for 1 second...")
    numeric sleep_result = await async_sleep(1000)
    print("Woke up after 1 second!")
    
    // Test 2: async_write_file
    print("Test 2: Writing to file...")
    numeric write_result = await async_write_file("test_output.txt", "Hello from MLP async I/O!")
    print("File written successfully!")
    
    // Test 3: async_read_file
    print("Test 3: Reading file back...")
    string content = await async_read_file("test_output.txt")
    print("File content:")
    print(content)
    
    // Test 4: async_http_get
    print("Test 4: HTTP GET request...")
    string response = await async_http_get("https://httpbin.org/get")
    print("HTTP Response:")
    print(response)
    
    print("=== All Async I/O Tests Completed! ===")
    return 0
end
