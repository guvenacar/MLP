-- Test all compound end keywords
function test_compound_ends()
    numeric x = 10
    
    -- Test if...end if
    if x > 5 then
        print "x is greater than 5"
    end if
    
    -- Test while...end while
    numeric i = 0
    while i < 3
        print "Loop iteration"
        i = i + 1
    end while
    
    -- Test for...end for
    for j = 1 to 5
        print "For loop"
    end for
    
    return 0
end function

test_compound_ends()
