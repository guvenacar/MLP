// Quick integration test

function main()
    print "Integration Test - Short Version"
    print ""
    
    // Test 1: Race
    print "Test 1: Race"
    numeric t1 = async_sleep(30)
    numeric t2 = async_sleep(60)
    numeric t3 = async_sleep(90)
    numeric winner = promise_race_simple(t1, t2, t3)
    numeric s = promise_await_safe(winner)
    print s
    print ""
    
    // Test 2: Timeout succeeds
    print "Test 2: Timeout (succeeds)"
    numeric fast = async_sleep(50)
    numeric timed = async_timeout(fast, 200)
    numeric s2 = promise_await_safe(timed)
    print s2
    print ""
    
    // Test 3: Timeout fails
    print "Test 3: Timeout (fails)"
    numeric slow = async_sleep(300)
    numeric timed2 = async_timeout(slow, 100)
    numeric s3 = promise_await_safe(timed2)
    print s3
    print ""
    
    // Test 4: Immediate race
    print "Test 4: Immediate + Slow"
    numeric imm = promise_new()
    promise_resolve_numeric(imm, 777)
    numeric slow2 = async_sleep(100)
    numeric w2 = promise_race_simple(imm, slow2, slow2)
    numeric s4 = promise_await_safe(w2)
    numeric v = promise_get_numeric_value(w2)
    print s4
    print v
    print ""
    
    print "All Tests Complete!"
    return 0
end
