-- -----------------------------------------------------------------------------
-- BigDecimal wrapper type
-- -----------------------------------------------------------------------------

struct BigDecimal then
    numeric ptr
end_struct

-- -----------------------------------------------------------------------------
-- Constructors
-- -----------------------------------------------------------------------------

function bigdecimal_from_metin(value)
    BigDecimal bd
    -- TODO: Call C runtime
    -- bd.ptr = bigdecimal_create(value)
    bd.ptr = 0
    return bd
end_function

function bigdecimal_from_int(value)
    metin str_value = int_to_string(value)
    return bigdecimal_from_metin(str_value)
end_function

function bigdecimal_zero()
    return bigdecimal_from_metin("0")
end_function

function bigdecimal_one()
    return bigdecimal_from_metin("1")
end_function

