-- -----------------------------------------------------------------------------
-- MLP memory allocation helpers
-- -----------------------------------------------------------------------------

function alloc_bigdecimal()
    numeric size = 32
    return gc_malloc(size)
end_function

function alloc_bigmetin()
    numeric size = 64
    return gc_malloc_atomic(size)
end_function

function alloc_hashmap()
    numeric size = 128
    return gc_malloc(size)
end_function

function alloc_list()
    numeric size = 64
    return gc_malloc(size)
end_function

function alloc_struct(field_count)
    numeric size = field_count * 8
    return gc_malloc(size)
end_function

function alloc_closure(captured_count)
    numeric base_size = 32
    numeric capture_size = captured_count * 8
    return gc_malloc(base_size + capture_size)
end_function

-- -----------------------------------------------------------------------------
-- GC control functions
-- -----------------------------------------------------------------------------

function gc_enable()
    -- TODO: Call C runtime
    -- GC_enable()
    print "GC enabled"
end_function

function gc_disable()
    -- TODO: Call C runtime
    -- GC_disable()
    print "GC disabled"
end_function

function gc_is_enabled()
    -- TODO: Call C runtime
    -- return GC_is_enabled()
    return 1
end_function

-- -----------------------------------------------------------------------------
-- GC debugging
-- -----------------------------------------------------------------------------

function gc_print_stats()
    numeric heap_size = gc_heap_size()
    numeric free_bytes = gc_free_bytes()
    numeric since_gc = gc_bytes_since_gc()
    
    print "=== GC Statistics ==="
    print "Heap size: " + metin(heap_size)
    print "Free bytes: " + metin(free_bytes)
    print "Bytes since last GC: " + metin(since_gc)
    print "===================="
end_function

function gc_trigger_if_needed()
    numeric since_gc = gc_bytes_since_gc()
    numeric threshold = 1048576
    
    if since_gc > threshold then
        gc_collect()
    end_if
end_function
