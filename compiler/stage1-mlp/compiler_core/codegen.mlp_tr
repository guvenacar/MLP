-- lang: en-US
-- syntax: mlp

-- -----------------------------------------------------------------------------
-- Code Generator Module - AST → x86-64 Assembly
-- -----------------------------------------------------------------------------
-- C bootstrap derleyicisindeki code generator mantığını MLP'ye taşır.
-- AST traversal, assembly generation, register allocation.
-- -----------------------------------------------------------------------------

import "compiler_core/token_types.mlp"
import "compiler_core/ast/ast_nodes.mlp"
import "compiler_core/scope_manager.mlp"
import "compiler_core/codegen_functions.mlp"
import "compiler_core/codegen_structures.mlp"
import "compiler_core/codegen_control.mlp"
import "compiler_core/import_handler.mlp"

-- Import runtime helpers
import "runtime/bigdecimal.mlp"
import "runtime/bigstring.mlp"
import "runtime/hashmap.mlp"
import "runtime/async.mlp"
import "runtime/gc.mlp"
import "runtime/file_io.mlp"

-- -----------------------------------------------------------------------------
-- Assembly code sections
-- -----------------------------------------------------------------------------

yapı AsmCode ise
    liste data_section
    liste text_section
    liste lambda_section
    liste imports
son_yapı

fonksiyon asm_code_create()
    AsmCode code
    code.data_section = liste()
    code.text_section = liste()
    code.lambda_section = liste()
    code.imports = liste()
    döndür code
son_fonksiyon

fonksiyon asm_emit_data(code, line)
    mlp_list_add(code.data_secton, line)
    döndür code
son_fonksiyon

fonksiyon asm_emit_text(code, line)
    mlp_list_add(code.text_secton, line)
    döndür code
son_fonksiyon

fonksiyon asm_emit_lambda(code, line)
    mlp_list_add(code.lambda_secton, line)
    döndür code
son_fonksiyon

fonksiyon asm_to_metin(code)
    metin result = ""
    
    -- Imports
    için i = 0 için mlp_list_length(code, mports) - 1 do
        result = result + mlp_list_get(code, mports, i) + "\n"
    son
    
    -- Data section
    result = result + "\nsection .data\n"
    için i = 0 için mlp_list_length(code.data_secton) - 1 do
        result = result + "    " + mlp_list_get(code.data_secton, i) + "\n"
    son
    
    -- Text section
    result = result + "\nsection .text\n"
    result = result + "    global _start\n\n"
    
    için i = 0 için mlp_list_length(code.text_secton) - 1 do
        result = result + mlp_list_get(code.text_secton, i) + "\n"
    son
    
    -- Lambda section
    eğer mlp_list_length(code.lambda_secton) > 0 ise
        result = result + "\n; Lambda functions\n"
        için i = 0 için mlp_list_length(code.lambda_secton) - 1 do
            result = result + mlp_list_get(code.lambda_secton, i) + "\n"
        son
    son_eğer
    
    döndür result
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Code Generator state
-- -----------------------------------------------------------------------------

yapı CodeGenState ise
    AsmCode code
    ScopeManager scope
    ASTArena arena
    sayısal string_counter
    sayısal label_counter
    liste register_stack
son_yapı

fonksiyon codegen_create(arena)
    CodeGenState state
    state.code = asm_code_create()
    state.scope = scope_manager_create()
    state.arena = arena
    state.string_counter = 0
    state.label_counter = 0
    state.register_stack = liste()
    
    döndür state
son_fonksiyon

-- -----------------------------------------------------------------------------
-- String literal registration
-- -----------------------------------------------------------------------------

fonksiyon codegen_register_metin(state, str_value)
    metin label = ""
    label = "str_" + numeric_to_metin(state.string_counter)
    state.string_counter = state.string_counter + 1
    
    metin data_line = label + ": db \"" + str_value + "\", 0"
    state.code = asm_emit_data(state.code, data_line)
    
    döndür label
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Label generation
-- -----------------------------------------------------------------------------

fonksiyon codegen_generate_label(state, prefix)
    sayısal id = state.label_counter
    state.label_counter = state.label_counter + 1
    
    metin label = ""
    label = prefix + "_" + numeric_to_metin(id)
    döndür label
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Visit functions (AST node handlers)
-- -----------------------------------------------------------------------------

fonksiyon visit_number(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    -- Get literal value
    metin value = "0"
    
    state.code = asm_emit_text(state.code, "    ; Number literal: " + value)
    state.code = asm_emit_text(state.code, "    mov rax, " + value)
    
    döndür state
son_fonksiyon

fonksiyon visit_metin(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    metin value = "Hello"
    metin label = ""
    label = register_string_literal(state, value)
    
    state.code = asm_emit_text(state.code, "    ; String literal")
    
    -- RUNTIME: Call bigstring_create(str)
    state.code = asm_emit_text(state.code, "    ; Create BigString")
    state.code = asm_emit_text(state.code, "    lea rdi, [rel " + label + "]")
    state.code = asm_emit_text(state.code, "    call bigstring_create")
    state.code = asm_emit_text(state.code, "    ; BigString ptr in rax")
    
    döndür state
son_fonksiyon

fonksiyon visit_variable(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    metin var_name = "x"
    
    VariableInfo info
    info = scope_lookup_variable(state.scope, var_name)
    
    state.code = asm_emit_text(state.code, "    ; Load variable: " + var_name)
    state.code = asm_emit_text(state.code, "    mov rax, [rbp - " + numeric_to_metin(info.stack_offset) + "]")
    
    döndür state
son_fonksiyon

fonksiyon visit_binary_op(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    sayısal left_id = 1
    sayısal right_id = 2
    metin operator = "+"
    
    state.code = asm_emit_text(state.code, "    ; Binary operation: " + operator)
    
    -- Evaluate left (BigDecimal ptr in rax)
    state = visit_expression(state, left_id)
    state.code = asm_emit_text(state.code, "    push rax")
    
    -- Evaluate right (BigDecimal ptr in rax)
    state = visit_expression(state, right_id)
    state.code = asm_emit_text(state.code, "    mov rsi, rax")
    state.code = asm_emit_text(state.code, "    pop rdi")
    
    -- RUNTIME: Call bigdecimal arithmetic operations
    eğer operator == "+" ise
        state.code = asm_emit_text(state.code, "    call bigdecimal_add")
    son_eğer
    
    eğer operator == "-" ise
        state.code = asm_emit_text(state.code, "    call bigdecimal_sub")
    son_eğer
    
    eğer operator == "*" ise
        state.code = asm_emit_text(state.code, "    call bigdecimal_mul")
    son_eğer
    
    eğer operator == "/" ise
        state.code = asm_emit_text(state.code, "    call bigdecimal_div")
    son_eğer
    
    eğer operator == "%" ise
        state.code = asm_emit_text(state.code, "    call bigdecimal_mod")
    son_eğer
    
    -- Comparison operators
    eğer operator == "==" ise
        state.code = asm_emit_text(state.code, "    call bigdecimal_eq")
    son_eğer
    
    eğer operator == "<" ise
        state.code = asm_emit_text(state.code, "    call bigdecimal_lt")
    son_eğer
    
    eğer operator == ">" ise
        state.code = asm_emit_text(state.code, "    call bigdecimal_gt")
    son_eğer
    
    eğer operator == "<=" ise
        state.code = asm_emit_text(state.code, "    call bigdecimal_lte")
    son_eğer
    
    eğer operator == ">=" ise
        state.code = asm_emit_text(state.code, "    call bigdecimal_gte")
    son_eğer
    
    state.code = asm_emit_text(state.code, "    ; Result BigDecimal ptr in rax")
    
    döndür state
son_fonksiyon

fonksiyon visit_expression(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    eğer node.type == AST_SAYI ise
        döndür visit_number(state, node_id)
    son_eğer
    
    eğer node.type == AST_METIN ise
        döndür visit_metin(state, node_id)
    son_eğer
    
    eğer node.type == AST_INTERPOLATED_STRING ise
        döndür visit_metin(state, node_id)
    son_eğer
    
    eğer node.type == AST_DEGISKEN ise
        döndür visit_variable(state, node_id)
    son_eğer
    
    eğer node.type == AST_IKILI_ISLEM ise
        döndür visit_binary_op(state, node_id)
    son_eğer
    
    eğer node.type == AST_UNARY_OP ise
        döndür visit_unary_op(state, node_id)
    son_eğer
    
    eğer node.type == AST_FUNCTION_CALL ise
        döndür visit_function_call(state, node_id)
    son_eğer
    
    eğer node.type == AST_LAMBDA ise
        döndür visit_lambda(state, node_id)
    son_eğer
    
    eğer node.type == AST_LIST_LITERAL ise
        döndür visit_list_literal(state, node_id)
    son_eğer
    
    eğer node.type == AST_HASHMAP_LITERAL ise
        döndür visit_hashmap_literal(state, node_id)
    son_eğer
    
    eğer node.type == AST_SET_LITERAL ise
        döndür visit_set_literal(state, node_id)
    son_eğer
    
    eğer node.type == AST_ARRAY_ACCESS ise
        döndür visit_array_access(state, node_id)
    son_eğer
    
    eğer node.type == AST_MEMBER_ACCESS ise
        döndür visit_member_access(state, node_id)
    son_eğer
    
    eğer node.type == AST_RANGE ise
        döndür visit_range(state, node_id)
    son_eğer
    
    eğer node.type == AST_STRUCT_INSTANTIATION ise
        döndür visit_struct_instantiation(state, node_id)
    son_eğer
    
    eğer node.type == AST_AWAIT ise
        döndür visit_await(state, node_id)
    son_eğer
    
    eğer node.type == AST_YIELD ise
        döndür visit_yield(state, node_id)
    son_eğer
    
    döndür state
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Statement visitors
-- -----------------------------------------------------------------------------

fonksiyon visit_print(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    sayısal expr_id = 1
    
    state.code = asm_emit_text(state.code, "    ; Print statement")
    
    -- Evaluate expression (BigDecimal or BigString ptr in rax)
    state = visit_expression(state, expr_id)
    
    -- RUNTIME: Convert için metin için printing
    state.code = asm_emit_text(state.code, "    mov rdi, rax")
    state.code = asm_emit_text(state.code, "    call bigstring_to_cstr")
    state.code = asm_emit_text(state.code, "    ; C metin ptr in rax")
    
    -- RUNTIME: Call printf or write syscall
    state.code = asm_emit_text(state.code, "    mov rdi, rax")
    state.code = asm_emit_text(state.code, "    call puts")
    
    döndür state
son_fonksiyon

fonksiyon visit_return(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    sayısal expr_id = 1
    
    state.code = asm_emit_text(state.code, "    ; Return statement")
    
    -- Evaluate expression
    state = visit_expression(state, expr_id)
    
    -- Cleanup and döndür
    state.code = asm_emit_text(state.code, "    mov rsp, rbp")
    state.code = asm_emit_text(state.code, "    pop rbp")
    state.code = asm_emit_text(state.code, "    ret")
    
    döndür state
son_fonksiyon

fonksiyon visit_variable_declaration(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    metin var_name = "x"
    metin type_name = "sayısal"
    sayısal value_id = 1
    
    state.code = asm_emit_text(state.code, "    ; Variable declaration: " + var_name)
    
    -- Register variable
    state.scope = scope_register_variable(state.scope, var_name, type_name, 0)
    VariableInfo info
    info = scope_lookup_variable(state.scope, var_name)
    
    -- Evaluate initializer
    eğer value_id >= 0 ise
        state = visit_expression(state, value_id)
        state.code = asm_emit_text(state.code, "    mov [rbp - " + numeric_to_metin(info.stack_offset) + "], rax")
    son_eğer
    
    döndür state
son_fonksiyon

fonksiyon visit_assignment(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    metin var_name = "x"
    sayısal value_id = 1
    
    state.code = asm_emit_text(state.code, "    ; Assignment: " + var_name)
    
    -- Evaluate value
    state = visit_expression(state, value_id)
    
    -- Store için variable
    VariableInfo info
    info = scope_lookup_variable(state.scope, var_name)
    state.code = asm_emit_text(state.code, "    mov [rbp - " + numeric_to_metin(info.stack_offset) + "], rax")
    
    döndür state
son_fonksiyon

fonksiyon visit_if_statement(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    sayısal condition_id = 1
    sayısal then_block_id = 2
    sayısal else_block_id = -1
    
    metin else_label = ""
    else_label = codegen_generate_label(state, "değilse")
    metin end_label = ""
    end_label = codegen_generate_label(state, "endif")
    
    state.code = asm_emit_text(state.code, "    ; If statement")
    
    -- Evaluate condition
    state = visit_expression(state, condition_id)
    state.code = asm_emit_text(state.code, "    cmp rax, 0")
    state.code = asm_emit_text(state.code, "    je " + else_label)
    
    -- Then block
    state = visit_block(state, then_block_id)
    state.code = asm_emit_text(state.code, "    jmp " + end_label)
    
    -- Else block
    state.code = asm_emit_text(state.code, else_label + ":")
    eğer else_block_id >= 0 ise
        state = visit_block(state, else_block_id)
    son_eğer
    
    state.code = asm_emit_text(state.code, end_label + ":")
    
    döndür state
son_fonksiyon

fonksiyon visit_while_loop(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    sayısal condition_id = 1
    sayısal body_id = 2
    
    metin loop_label = ""
    loop_label = codegen_generate_label(state, "while_loop")
    metin end_label = ""
    end_label = codegen_generate_label(state, "while_end")
    
    state.code = asm_emit_text(state.code, "    ; While loop")
    state.code = asm_emit_text(state.code, loop_label + ":")
    
    -- Evaluate condition
    state = visit_expression(state, condition_id)
    state.code = asm_emit_text(state.code, "    cmp rax, 0")
    state.code = asm_emit_text(state.code, "    je " + end_label)
    
    -- Body
    state = visit_block(state, body_id)
    state.code = asm_emit_text(state.code, "    jmp " + loop_label)
    
    state.code = asm_emit_text(state.code, end_label + ":")
    
    döndür state
son_fonksiyon

fonksiyon visit_statement(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    eğer node.type == AST_IMPORT_STATEMENT ise
        döndür visit_import(state, node_id)
    son_eğer
    
    eğer node.type == AST_FUNCTION_DECLARATION ise
        döndür visit_function_declaration(state, node_id)
    son_eğer
    
    eğer node.type == AST_STRUCT_DEFINITION ise
        döndür visit_struct_definition(state, node_id)
    son_eğer
    
    eğer node.type == AST_ENUM_DEFINITION ise
        döndür visit_enum_definition(state, node_id)
    son_eğer
    
    eğer node.type == AST_TYPE_ALIAS ise
        döndür visit_type_alias(state, node_id)
    son_eğer
    
    eğer node.type == AST_PRINT_STATEMENT ise
        döndür visit_print(state, node_id)
    son_eğer
    
    eğer node.type == AST_RETURN_STATEMENT_KOMUTU ise
        döndür visit_return(state, node_id)
    son_eğer
    
    eğer node.type == AST_VARIABLE_DECLARATION ise
        döndür visit_variable_declaration(state, node_id)
    son_eğer
    
    eğer node.type == AST_ASSIGNMENT_KOMUTU ise
        döndür visit_assignment(state, node_id)
    son_eğer
    
    eğer node.type == AST_IF_STATEMENT_KOMUTU ise
        döndür visit_if_statement(state, node_id)
    son_eğer
    
    eğer node.type == AST_WHILE_LOOP_KOMUTU ise
        döndür visit_while_loop(state, node_id)
    son_eğer
    
    eğer node.type == AST_FOR_LOOP ise
        döndür visit_for_loop(state, node_id)
    son_eğer
    
    eğer node.type == AST_FOR_EACH_LOOP ise
        döndür visit_foreach_loop(state, node_id)
    son_eğer
    
    eğer node.type == AST_TRY_CATCH ise
        döndür visit_try_catch(state, node_id)
    son_eğer
    
    eğer node.type == AST_THROW ise
        döndür visit_throw(state, node_id)
    son_eğer
    
    eğer node.type == AST_BREAK ise
        döndür visit_break(state, node_id)
    son_eğer
    
    eğer node.type == AST_CONTINUE ise
        döndür visit_continue(state, node_id)
    son_eğer
    
    eğer node.type == AST_MATCH ise
        döndür visit_match(state, node_id)
    son_eğer
    
    eğer node.type == AST_DEFER ise
        döndür visit_defer(state, node_id)
    son_eğer
    
    eğer node.type == AST_WITH ise
        döndür visit_with(state, node_id)
    son_eğer
    
    eğer node.type == AST_PANIC ise
        döndür visit_panic(state, node_id)
    son_eğer
    
    eğer node.type == AST_EXPRESSION_STATEMENT ise
        döndür visit_expression_statement(state, node_id)
    son_eğer
    
    döndür state
son_fonksiyon

fonksiyon visit_block(state, node_id)
    ASTNode node
    node = ast_arena_get(state.arena, node_id)
    
    ASTBlockData data
    data = ast_arena_get_data(state.arena, node_id)
    -- liste statement_ids = liste()  -- TODO: Get from yapı field
    liste statement_ids = liste()  -- TODO: Get from data.statement_ids
    
    state.scope = scope_enter(state.scope)
    
    için i = 0 için mlp_list_length(statement_ids) - 1 do
        sayısal stmt_id = 0
        stmt_id = mlp_list_get(statement_ids, i)
        state = visit_statement(state, stmt_id)
    son
    
    state.scope = scope_exit(state.scope)
    
    döndür state
son_fonksiyon

-- -----------------------------------------------------------------------------
-- Main code generation entry point (5-PHASE PRE-SCAN STRATEGY)
-- -----------------------------------------------------------------------------
-- Port from: mlp_compiler.c generate_asm() lines 8920-9250
-- 
-- Phase 1: Collect imports (don't emit assembly)
-- Phase 2: Emit imported functions BEFORE main
-- Phase 3: Main entry point (prolog)
-- Phase 4: Main body (skip imports & functions)
-- Phase 5: User-defined functions
-- -----------------------------------------------------------------------------

fonksiyon generate_code(arena, lexer, parser, base_dir)
    CodeGenState state
    state = codegen_create(arena)
    
    -- Get root block
    ASTNode root
    root = ast_arena_get(arena, 0)
    
    -- ========== PHASE 1: COLLECT IMPORTS ==========
    -- Parse root AST and collect imported functions WITHOUT emitting assembly
    ImportContext import_ctx
    import_ctx = create_import_context(base_dir)
    
    eğer root.type == AST_BLOK ise
        ASTBlockData root_data
        root_data = ast_arena_get_data(arena, root.id)
        -- TODO: liste stmts = liste()  -- TODO: Get from yapı field
liste liste stmts = liste()  -- TODO: Get from yapı field = liste()ids
        sayısal count = mlp_list_length(stmts)
        
        için i = 0 için count - 1 do
            sayısal stmt_id = mlp_list_get(stmts, i)
            ASTNode stmt
            stmt = ast_arena_get(arena, stmt_id)
            
            eğer stmt.type == AST_IMPORT_STATEMENT ise
                handle_import(import_ctx, stmt, lexer, parser)
            son_eğer
        son
    son_eğer
    
    -- ========== PHASE 2: EMIT IMPORTED FUNCTIONS (BEFORE MAIN) ==========
    state.code = asm_emit_text(state.code, "section .text")
    state.code = asm_emit_text(state.code, "global main")
    state.code = asm_emit_text(state.code, "")
    
    sayisal imported_count
    imported_count = get_imported_count(import_ctx)
    eğer imported_count > 0 ise
        state.code = asm_emit_text(state.code, "    ; === Imported Functions ===")
        
        liste imported_funcs = get_imported_functions(import_ctx)
        için i = 0 için imported_count - 1 do
            ASTNode func_node = mlp_list_get(imported_funcs, i)
            -- Emit fonksiyon (call visit_statement için each imported fonksiyon)
            state = visit_statement(state, func_node.id)
        son
        
        state.code = asm_emit_text(state.code, "    ; === End Imported Functions ===")
        state.code = asm_emit_text(state.code, "")
    son_eğer
    
    -- ========== PHASE 3: MAIN ENTRY POINT ==========
    state.code = asm_emit_text(state.code, "main:")
    state.code = asm_emit_text(state.code, "    push rbp")
    state.code = asm_emit_text(state.code, "    mov rbp, rsp")
    state.code = asm_emit_text(state.code, "    sub rsp, 256")
    state.code = asm_emit_text(state.code, "    call mlp_set_args")
    state.code = asm_emit_text(state.code, "    call tyd_fix_cwd")
    state.code = asm_emit_text(state.code, "")
    
    -- ========== PHASE 4: MAIN BODY (SKIP IMPORTS AND FUNCTIONS) ==========
    state.code = asm_emit_text(state.code, "    ; --- Ana Program Akışı ---")
    
    -- Check eğer there's a main fonksiyon
    sayısal has_main = 0
    sayısal main_is_async = 0
    
    eğer root.type == AST_BLOK ise
        ASTBlockData root_data
        root_data = ast_arena_get_data(arena, root.id)
        -- TODO: liste stmts = liste()  -- TODO: Get from yapı field
liste liste stmts = liste()  -- TODO: Get from yapı field = liste()ids
        sayısal count = mlp_list_length(stmts)
        
        için i = 0 için count - 1 do
            sayısal stmt_id = mlp_list_get(stmts, i)
            ASTNode stmt
            stmt = ast_arena_get(arena, stmt_id)
            
            eğer stmt.type == AST_FUNCTION_DECLARATION ise
                ASTFunctionData func_data
                func_data = ast_arena_get_data(arena, stmt.id)
                eğer func_data.name == "main" ise
                    has_main = 1
                son_eğer
            son_eğer
            
            eğer stmt.type == AST_ASYNC_FUNCTION ise
                ASTAsyncFunctionData async_data
                async_data = ast_arena_get_data(arena, stmt.id)
                eğer async_data.name == "main" ise
                    has_main = 1
                    main_is_async = 1
                son_eğer
            son_eğer
        son
    son_eğer
    
    eğer has_main ise
        eğer main_is_async ise
            -- Async main with blocking await
            state.code = asm_emit_text(state.code, "    ; Async main (blocking await)")
            state.code = asm_emit_text(state.code, "    call mlp_main")
            state.code = asm_emit_text(state.code, "    mov rbx, rax  ; Save promise")
            state.code = asm_emit_text(state.code, "__main_wait:")
            state.code = asm_emit_text(state.code, "    mov rdi, rbx")
            state.code = asm_emit_text(state.code, "    call promise_is_resolved")
            state.code = asm_emit_text(state.code, "    test rax, rax")
            state.code = asm_emit_text(state.code, "    jz __main_wait")
            state.code = asm_emit_text(state.code, "    mov rdi, rbx")
            state.code = asm_emit_text(state.code, "    call promise_get_value")
        değilse
            -- Regular synchronous main
            state.code = asm_emit_text(state.code, "    call mlp_main")
        son_eğer
    değilse
        -- No main - execute top level commands (SKIP IMPORTS)
        eğer root.type == AST_BLOK ise
            ASTBlockData root_data
            root_data = ast_arena_get_data(arena, root.id)
            -- TODO: liste stmts = liste()  -- TODO: Get from yapı field
liste liste stmts = liste()  -- TODO: Get from yapı field = liste()ids
            sayısal count = mlp_list_length(stmts)
            
            için i = 0 için count - 1 do
                sayısal stmt_id = mlp_list_get(stmts, i)
                ASTNode stmt
                stmt = ast_arena_get(arena, stmt_id)
                
                -- SKIP: Import statements (already processed in Phase 1)
                eğer stmt.type == AST_IMPORT_STATEMENT ise
                    continue
                son_eğer
                
                -- SKIP: Function declarations (will be emitted in Phase 5)
                eğer stmt.type == AST_FUNCTION_DECLARATION ise
                    continue
                son_eğer
                eğer stmt.type == AST_ASYNC_FUNCTION ise
                    continue
                son_eğer
                
                -- Execute other top-level statements
                state = visit_statement(state, stmt_id)
            son
        değilse
            state = visit_statement(state, 0)
        son_eğer
    son_eğer
    
    -- Program exit (epilog)
    state.code = asm_emit_text(state.code, "    ; --- Program Sonu ---")
    state.code = asm_emit_text(state.code, "    xor rax, rax")
    state.code = asm_emit_text(state.code, "    mov rsp, rbp")
    state.code = asm_emit_text(state.code, "    pop rbp")
    state.code = asm_emit_text(state.code, "    ret")
    state.code = asm_emit_text(state.code, "")
    
    -- ========== PHASE 5: USER-DEFINED FUNCTIONS ==========
    eğer root.type == AST_BLOK ise
        state.code = asm_emit_text(state.code, "; === Fonksiyon Tanımları ===")
        
        ASTBlockData root_data
        root_data = ast_arena_get_data(arena, root.id)
        -- TODO: liste stmts = liste()  -- TODO: Get from yapı field
liste liste stmts = liste()  -- TODO: Get from yapı field = liste()ids
        sayısal count = mlp_list_length(stmts)
        
        için i = 0 için count - 1 do
            sayısal stmt_id = mlp_list_get(stmts, i)
            ASTNode stmt
            stmt = ast_arena_get(arena, stmt_id)
            
            eğer stmt.type == AST_FUNCTION_DECLARATION ise
                state = visit_statement(state, stmt_id)
            son_eğer
            eğer stmt.type == AST_ASYNC_FUNCTION ise
                state = visit_statement(state, stmt_id)
            son_eğer
        son
    son_eğer
    
    -- Cleanup imports
    cleanup_imports(import_ctx)
    
    döndür asm_to_metin(state.code)
son_fonksiyon
