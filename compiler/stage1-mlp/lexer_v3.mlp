-- MLP Self-Hosting Lexer v3.0
-- Modern Python-style API
-- NO SEMICOLONS | numeric (not int) | explicit ends

-- ========================================
-- HELPER FUNCTIONS (Modern API)
-- ========================================

-- Check if character is whitespace
function is_whitespace(ch) then
    numeric code = ord(ch)
    
    if code == 32 then return 1 end_if    -- space
    if code == 9 then return 1 end_if     -- tab
    if code == 10 then return 1 end_if    -- newline
    if code == 13 then return 1 end_if    -- carriage return
    
    return 0
end_function

-- Check if character is digit (0-9)
function is_digit(ch) then
    numeric code = ord(ch)
    if code >= 48 then
        if code <= 57 then
            return 1
        end_if
    end_if
    return 0
end_function

-- Check if character is letter (A-Z, a-z) or underscore
function is_alpha(ch) then
    numeric code = ord(ch)
    
    -- A-Z
    if code >= 65 then
        if code <= 90 then
            return 1
        end_if
    end_if
    
    -- a-z
    if code >= 97 then
        if code <= 122 then
            return 1
        end_if
    end_if
    
    -- underscore
    if code == 95 then
        return 1
    end_if
    
    return 0
end_function

-- Check if character is alphanumeric
function is_alnum(ch) then
    if is_alpha(ch) == 1 then
        return 1
    end_if
    if is_digit(ch) == 1 then
        return 1
    end_if
    return 0
end_function

-- ========================================
-- TOKEN SCANNING
-- ========================================

-- Scan number literal
function scan_number(text, start_pos) then
    numeric pos = start_pos
    numeric length = len(text)
    numeric has_dot = 0
    
    while pos < length
        string ch = substring(text, pos, 1)
        
        if is_digit(ch) == 1 then
            pos = pos + 1
        else
            numeric code = ord(ch)
            if code == 46 then    -- decimal point
                if has_dot == 0 then
                    has_dot = 1
                    pos = pos + 1
                else
                    return pos    -- second dot, stop
                end_if
            else
                return pos        -- not a number character
            end_if
        end_if
    end_while
    
    return pos
end_function

-- Scan string literal
function scan_string(text, start_pos) then
    numeric pos = start_pos + 1  -- Skip opening quote
    numeric length = len(text)
    
    while pos < length
        string ch = substring(text, pos, 1)
        
        if ch == "\"" then
            return pos + 1  -- Include closing quote
        end_if
        
        pos = pos + 1
    end_while
    
    print "ERROR: Unclosed string at position "
    print start_pos
    return pos
end_function

-- Scan identifier or keyword
function scan_identifier(text, start_pos) then
    numeric pos = start_pos
    numeric length = len(text)
    
    while pos < length
        string ch = substring(text, pos, 1)
        
        if is_alnum(ch) == 0 then
            return pos
        end_if
        
        pos = pos + 1
    end_while
    
    return pos
end_function

-- Check if word is a keyword
function is_keyword(word) then
    -- Data types
    if word == "numeric" then return 1 end_if
    if word == "string" then return 1 end_if
    if word == "boolean" then return 1 end_if
    if word == "const" then return 1 end_if
    
    -- Control flow
    if word == "if" then return 1 end_if
    if word == "then" then return 1 end_if
    if word == "else" then return 1 end_if
    if word == "end" then return 1 end_if
    if word == "while" then return 1 end_if
    if word == "for" then return 1 end_if
    if word == "to" then return 1 end_if
    if word == "step" then return 1 end_if
    if word == "break" then return 1 end_if
    if word == "continue" then return 1 end_if
    
    -- Functions
    if word == "function" then return 1 end_if
    if word == "return" then return 1 end_if
    
    -- Built-ins
    if word == "print" then return 1 end_if
    
    -- Literals
    if word == "true" then return 1 end_if
    if word == "false" then return 1 end_if
    
    -- Logical operators
    if word == "and" then return 1 end_if
    if word == "or" then return 1 end_if
    if word == "not" then return 1 end_if
    if word == "mod" then return 1 end_if
    
    -- Compound types
    if word == "struct" then return 1 end_if
    if word == "enum" then return 1 end_if
    
    return 0
end_function

-- ========================================
-- MAIN TOKENIZER
-- ========================================

function tokenize(text) then
    numeric pos = 0
    numeric length = len(text)
    numeric token_count = 0
    
    print "=== MLP Lexer v3.0 (Modern API) ==="
    print "Input length: "
    print length
    print ""
    print "Tokens:"
    print "--------"
    
    while pos < length
        -- Skip whitespace
        string current = substring(text, pos, 1)
        
        if is_whitespace(current) == 1 then
            pos = pos + 1
        else
            -- Single-character tokens
            if current == "(" then
                print "LPAREN"
                token_count = token_count + 1
                pos = pos + 1
            else if current == ")" then
                print "RPAREN"
                token_count = token_count + 1
                pos = pos + 1
            else if current == "{" then
                print "LBRACE"
                token_count = token_count + 1
                pos = pos + 1
            else if current == "}" then
                print "RBRACE"
                token_count = token_count + 1
                pos = pos + 1
            else if current == "," then
                print "COMMA"
                token_count = token_count + 1
                pos = pos + 1
            else if current == "." then
                print "DOT"
                token_count = token_count + 1
                pos = pos + 1
            else if current == "+" then
                print "PLUS"
                token_count = token_count + 1
                pos = pos + 1
            else if current == "-" then
                print "MINUS"
                token_count = token_count + 1
                pos = pos + 1
            else if current == "*" then
                print "STAR"
                token_count = token_count + 1
                pos = pos + 1
            else if current == "/" then
                print "SLASH"
                token_count = token_count + 1
                pos = pos + 1
            
            -- Two-character operators
            else if current == "=" then
                if pos + 1 < length then
                    string next = substring(text, pos + 1, 1)
                    if next == "=" then
                        print "EQ"
                        token_count = token_count + 1
                        pos = pos + 2
                    else
                        print "ASSIGN"
                        token_count = token_count + 1
                        pos = pos + 1
                    end_if
                else
                    print "ASSIGN"
                    token_count = token_count + 1
                    pos = pos + 1
                end_if
            
            else if current == "!" then
                if pos + 1 < length then
                    string next = substring(text, pos + 1, 1)
                    if next == "=" then
                        print "NEQ"
                        token_count = token_count + 1
                        pos = pos + 2
                    else
                        print "ERROR: Expected '=' after '!'"
                        pos = pos + 1
                    end_if
                else
                    print "ERROR: Expected '=' after '!'"
                    pos = pos + 1
                end_if
            
            else if current == "<" then
                if pos + 1 < length then
                    string next = substring(text, pos + 1, 1)
                    if next == "=" then
                        print "LTE"
                        token_count = token_count + 1
                        pos = pos + 2
                    else
                        print "LT"
                        token_count = token_count + 1
                        pos = pos + 1
                    end_if
                else
                    print "LT"
                    token_count = token_count + 1
                    pos = pos + 1
                end_if
            
            else if current == ">" then
                if pos + 1 < length then
                    string next = substring(text, pos + 1, 1)
                    if next == "=" then
                        print "GTE"
                        token_count = token_count + 1
                        pos = pos + 2
                    else
                        print "GT"
                        token_count = token_count + 1
                        pos = pos + 1
                    end_if
                else
                    print "GT"
                    token_count = token_count + 1
                    pos = pos + 1
                end_if
            
            -- String literal
            else if current == "\"" then
                numeric start = pos
                numeric end_pos = scan_string(text, pos)
                numeric value_len = end_pos - start
                string value = substring(text, start, value_len)
                print "STRING: "
                print value
                token_count = token_count + 1
                pos = end_pos
            
            -- Number literal
            else if is_digit(current) == 1 then
                numeric start = pos
                numeric end_pos = scan_number(text, pos)
                numeric value_len = end_pos - start
                string value = substring(text, start, value_len)
                print "NUMBER: "
                print value
                token_count = token_count + 1
                pos = end_pos
            
            -- Identifier or keyword
            else if is_alpha(current) == 1 then
                numeric start = pos
                numeric end_pos = scan_identifier(text, pos)
                numeric value_len = end_pos - start
                string word = substring(text, start, value_len)
                
                if is_keyword(word) == 1 then
                    print "KEYWORD: "
                    print word
                else
                    print "IDENTIFIER: "
                    print word
                end_if
                
                token_count = token_count + 1
                pos = end_pos
            
            else
                print "ERROR: Unexpected character at position "
                print pos
                print " (code: "
                print ord(current)
                print ")"
                pos = pos + 1
            end_if
            end_if
            end_if
            end_if
            end_if
            end_if
            end_if
            end_if
            end_if
            end_if
            end_if
            end_if
            end_if
            end_if
            end_if
            end_if
        end_if
    end_while
    
    print "--------"
    print "Total tokens: "
    print token_count
    print ""
    
    return token_count
end_function

-- ========================================
-- TESTS
-- ========================================

print "========================================="
print "Test 1: Variable declaration"
print "========================================="
string test1 = "numeric x = 42"
numeric count1 = tokenize(test1)

print "========================================="
print "Test 2: Function definition"
print "========================================="
string test2 = "function add(a, b) then return a + b end_function"
numeric count2 = tokenize(test2)

print "========================================="
print "Test 3: If statement"
print "========================================="
string test3 = "if x > 10 then print x end_if"
numeric count3 = tokenize(test3)

print "========================================="
print "Test 4: String with modern API"
print "========================================="
string test4 = "\"hello world\""
numeric count4 = tokenize(test4)

print "========================================="
print "All tests complete!"
print "========================================="
