# Test: Math Operations - Phase 4
# Tests sqrt, pow, abs, fabs, min, max, round, floor, ceil, sin, cos, tan

def test_sqrt():
    """Test square root function"""
    print("\n=== Test 1: Square Root ===")
    
    # Perfect squares
    val1 = math_sqrt(16.0)
    assert val1 >= 3.99 and val1 <= 4.01, "Expected sqrt(16) = 4"
    
    val2 = math_sqrt(25.0)
    assert val2 >= 4.99 and val2 <= 5.01, "Expected sqrt(25) = 5"
    
    val3 = math_sqrt(100.0)
    assert val3 >= 9.99 and val3 <= 10.01, "Expected sqrt(100) = 10"
    
    # Non-perfect square
    val4 = math_sqrt(2.0)
    assert val4 >= 1.41 and val4 <= 1.42, "Expected sqrt(2) ≈ 1.414"
    
    # Zero
    val5 = math_sqrt(0.0)
    assert val5 >= -0.01 and val5 <= 0.01, "Expected sqrt(0) = 0"
    
    print("✅ Square root calculations correct")

def test_pow():
    """Test power function"""
    print("\n=== Test 2: Power Function ===")
    
    # Basic powers
    val1 = math_pow(2.0, 3.0)
    assert val1 >= 7.99 and val1 <= 8.01, "Expected 2^3 = 8"
    
    val2 = math_pow(5.0, 2.0)
    assert val2 >= 24.99 and val2 <= 25.01, "Expected 5^2 = 25"
    
    val3 = math_pow(10.0, 3.0)
    assert val3 >= 999.9 and val3 <= 1000.1, "Expected 10^3 = 1000"
    
    # Zero exponent
    val4 = math_pow(42.0, 0.0)
    assert val4 >= 0.99 and val4 <= 1.01, "Expected 42^0 = 1"
    
    # Negative exponent
    val5 = math_pow(2.0, -1.0)
    assert val5 >= 0.49 and val5 <= 0.51, "Expected 2^-1 = 0.5"
    
    print("✅ Power calculations correct")

def test_abs():
    """Test absolute value (integer)"""
    print("\n=== Test 3: Absolute Value (Int) ===")
    
    # Negative numbers
    val1 = math_abs(-5)
    assert val1 == 5, "Expected abs(-5) = 5"
    
    val2 = math_abs(-999)
    assert val2 == 999, "Expected abs(-999) = 999"
    
    # Positive numbers (unchanged)
    val3 = math_abs(5)
    assert val3 == 5, "Expected abs(5) = 5"
    
    # Zero
    val4 = math_abs(0)
    assert val4 == 0, "Expected abs(0) = 0"
    
    print("✅ Integer absolute value correct")

def test_fabs():
    """Test absolute value (float)"""
    print("\n=== Test 4: Absolute Value (Float) ===")
    
    # Negative floats
    val1 = math_fabs(-5.5)
    assert val1 >= 5.49 and val1 <= 5.51, "Expected fabs(-5.5) = 5.5"
    
    val2 = math_fabs(-123.456)
    assert val2 >= 123.45 and val2 <= 123.46, "Expected fabs(-123.456) ≈ 123.456"
    
    # Positive floats (unchanged)
    val3 = math_fabs(5.5)
    assert val3 >= 5.49 and val3 <= 5.51, "Expected fabs(5.5) = 5.5"
    
    # Zero
    val4 = math_fabs(0.0)
    assert val4 >= -0.01 and val4 <= 0.01, "Expected fabs(0.0) = 0.0"
    
    print("✅ Float absolute value correct")

def test_min_max():
    """Test min and max functions"""
    print("\n=== Test 5: Min/Max Functions ===")
    
    # Min tests
    val1 = math_min(5, 10)
    assert val1 == 5, "Expected min(5, 10) = 5"
    
    val2 = math_min(10, 5)
    assert val2 == 5, "Expected min(10, 5) = 5"
    
    val3 = math_min(-5, 5)
    assert val3 == -5, "Expected min(-5, 5) = -5"
    
    val4 = math_min(0, 0)
    assert val4 == 0, "Expected min(0, 0) = 0"
    
    # Max tests
    val5 = math_max(5, 10)
    assert val5 == 10, "Expected max(5, 10) = 10"
    
    val6 = math_max(10, 5)
    assert val6 == 10, "Expected max(10, 5) = 10"
    
    val7 = math_max(-5, 5)
    assert val7 == 5, "Expected max(-5, 5) = 5"
    
    val8 = math_max(0, 0)
    assert val8 == 0, "Expected max(0, 0) = 0"
    
    print("✅ Min/Max functions correct")

def test_round():
    """Test rounding function"""
    print("\n=== Test 6: Rounding ===")
    
    # Round up
    val1 = math_round(5.7)
    assert val1 == 6, "Expected round(5.7) = 6"
    
    val2 = math_round(2.5)
    assert val2 == 2 or val2 == 3, "Expected round(2.5) = 2 or 3"
    
    # Round down
    val3 = math_round(5.3)
    assert val3 == 5, "Expected round(5.3) = 5"
    
    val4 = math_round(2.4)
    assert val4 == 2, "Expected round(2.4) = 2"
    
    # Negative rounding
    val5 = math_round(-5.7)
    assert val5 == -6, "Expected round(-5.7) = -6"
    
    val6 = math_round(-5.3)
    assert val6 == -5, "Expected round(-5.3) = -5"
    
    # Zero
    val7 = math_round(0.0)
    assert val7 == 0, "Expected round(0.0) = 0"
    
    print("✅ Rounding functions correct")

def test_floor():
    """Test floor function"""
    print("\n=== Test 7: Floor Function ===")
    
    # Positive numbers
    val1 = math_floor(5.7)
    assert val1 == 5, "Expected floor(5.7) = 5"
    
    val2 = math_floor(5.3)
    assert val2 == 5, "Expected floor(5.3) = 5"
    
    val3 = math_floor(5.0)
    assert val3 == 5, "Expected floor(5.0) = 5"
    
    # Negative numbers (floor goes down)
    val4 = math_floor(-5.3)
    assert val4 == -6, "Expected floor(-5.3) = -6"
    
    val5 = math_floor(-5.7)
    assert val5 == -6, "Expected floor(-5.7) = -6"
    
    # Zero
    val6 = math_floor(0.0)
    assert val6 == 0, "Expected floor(0.0) = 0"
    
    print("✅ Floor function correct")

def test_ceil():
    """Test ceiling function"""
    print("\n=== Test 8: Ceiling Function ===")
    
    # Positive numbers (ceil goes up)
    val1 = math_ceil(5.1)
    assert val1 == 6, "Expected ceil(5.1) = 6"
    
    val2 = math_ceil(5.9)
    assert val2 == 6, "Expected ceil(5.9) = 6"
    
    val3 = math_ceil(5.0)
    assert val3 == 5, "Expected ceil(5.0) = 5"
    
    # Negative numbers
    val4 = math_ceil(-5.9)
    assert val4 == -5, "Expected ceil(-5.9) = -5"
    
    val5 = math_ceil(-5.1)
    assert val5 == -5, "Expected ceil(-5.1) = -5"
    
    # Zero
    val6 = math_ceil(0.0)
    assert val6 == 0, "Expected ceil(0.0) = 0"
    
    print("✅ Ceiling function correct")

def test_trigonometry():
    """Test trigonometric functions"""
    print("\n=== Test 9: Trigonometry ===")
    
    # sin(0) = 0
    val1 = math_sin(0.0)
    assert val1 >= -0.01 and val1 <= 0.01, "Expected sin(0) = 0"
    
    # sin(π/2) ≈ 1 (use 1.5708 for π/2)
    val2 = math_sin(1.5708)
    assert val2 >= 0.99 and val2 <= 1.01, "Expected sin(π/2) ≈ 1"
    
    # cos(0) = 1
    val3 = math_cos(0.0)
    assert val3 >= 0.99 and val3 <= 1.01, "Expected cos(0) = 1"
    
    # cos(π) ≈ -1 (use 3.14159 for π)
    val4 = math_cos(3.14159)
    assert val4 >= -1.01 and val4 <= -0.99, "Expected cos(π) ≈ -1"
    
    # tan(0) = 0
    val5 = math_tan(0.0)
    assert val5 >= -0.01 and val5 <= 0.01, "Expected tan(0) = 0"
    
    # tan(π/4) ≈ 1 (use 0.7854 for π/4)
    val6 = math_tan(0.7854)
    assert val6 >= 0.99 and val6 <= 1.01, "Expected tan(π/4) ≈ 1"
    
    print("✅ Trigonometric functions correct")

def test_combined_operations():
    """Test combining multiple math operations"""
    print("\n=== Test 10: Combined Operations ===")
    
    # (2^3) * sqrt(16) = 8 * 4 = 32
    val1 = math_pow(2.0, 3.0)
    val2 = math_sqrt(16.0)
    result1 = val1 * val2
    assert result1 >= 31.9 and result1 <= 32.1, "Expected (2^3) * sqrt(16) = 32"
    
    # abs(-5) + abs(-10) = 15
    val3 = math_abs(-5)
    val4 = math_abs(-10)
    result2 = val3 + val4
    assert result2 == 15, "Expected abs(-5) + abs(-10) = 15"
    
    # max(5, min(10, 3)) = max(5, 3) = 5
    val5 = math_min(10, 3)
    result3 = math_max(5, val5)
    assert result3 == 5, "Expected max(5, min(10, 3)) = 5"
    
    # round(sqrt(50)) ≈ 7
    val6 = math_sqrt(50.0)
    result4 = math_round(val6)
    assert result4 == 7, "Expected round(sqrt(50)) = 7"
    
    # floor(pow(2.5, 2)) = floor(6.25) = 6
    val7 = math_pow(2.5, 2.0)
    result5 = math_floor(val7)
    assert result5 == 6, "Expected floor(2.5^2) = 6"
    
    print("✅ Combined operations work correctly")

def test_edge_cases():
    """Test mathematical edge cases"""
    print("\n=== Test 11: Edge Cases ===")
    
    # sqrt(0) = 0
    val1 = math_sqrt(0.0)
    assert val1 >= -0.01 and val1 <= 0.01, "Expected sqrt(0) = 0"
    
    # pow(0, 0) = 1
    val2 = math_pow(0.0, 0.0)
    assert val2 >= 0.99 and val2 <= 1.01, "Expected 0^0 = 1"
    
    # pow(1, large) = 1
    val3 = math_pow(1.0, 999999.0)
    assert val3 >= 0.99 and val3 <= 1.01, "Expected 1^999999 = 1"
    
    # min/max with equal values
    val4 = math_min(42, 42)
    assert val4 == 42, "Expected min(42, 42) = 42"
    
    val5 = math_max(42, 42)
    assert val5 == 42, "Expected max(42, 42) = 42"
    
    # Round with exact .5
    val6 = math_round(0.5)
    assert val6 == 0 or val6 == 1, "Expected round(0.5) = 0 or 1"
    
    print("✅ Edge cases handled correctly")

def test_negative_sqrt():
    """Test error handling for negative sqrt"""
    print("\n=== Test 12: Error Handling ===")
    
    # Negative sqrt should return 0 and print error
    val1 = math_sqrt(-1.0)
    assert val1 >= -0.01 and val1 <= 0.01, "Expected sqrt(-1) = 0 (with error)"
    
    val2 = math_sqrt(-100.0)
    assert val2 >= -0.01 and val2 <= 0.01, "Expected sqrt(-100) = 0 (with error)"
    
    print("✅ Error handling works correctly")

# Main test execution
def main():
    print("╔══════════════════════════════════════╗")
    print("║    Math Operations Tests - Phase 4  ║")
    print("╚══════════════════════════════════════╝")
    
    test_sqrt()
    test_pow()
    test_abs()
    test_fabs()
    test_min_max()
    test_round()
    test_floor()
    test_ceil()
    test_trigonometry()
    test_combined_operations()
    test_edge_cases()
    test_negative_sqrt()
    
    print("\n╔══════════════════════════════════════╗")
    print("║       All Tests Passed! ✅           ║")
    print("╚══════════════════════════════════════╝")

# Run tests
main()
