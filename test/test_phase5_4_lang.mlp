print "=== Phase 5.4: Language Features Test ==="

print "1. Testing modulo operator..."
print 10 % 3
print 17 % 5

print "2. Testing logical 'and'..."
print 1 and 1
print 1 and 0
print 0 and 1

print "3. Testing logical 'or'..."
print 1 or 0
print 0 or 1
print 0 or 0

print "4. Testing logical 'not'..."
print not 0
print not 1
print not 5

print "=== Language Features: Tests Complete ==="
