// Test 11: Double then sum
numeric doubled_vals[] = map_double(numbers, 5)
numeric doubled_sum = reduce_sum(doubled_vals, 5)
print(68)  // 'D'
print(111) // 'o'
print(117) // 'u'
print(98)  // 'b'
print(108) // 'l'
print(101) // 'e'
print(43)  // '+'
print(83)  // 'S'
print(117) // 'u'
print(109) // 'm'
print(58)
print(32)
print(doubled_sum)
// Expected: 30 (sum of [2,4,6,8,10])

