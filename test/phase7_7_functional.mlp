// Phase 7.7: Functional Programming Test
// Tests map, filter, reduce patterns with array parameters

// Test data
numeric numbers[] = [1, 2, 3, 4, 5]
numeric mixed[] = [-2, -1, 0, 1, 2]
numeric values[] = [5, 10, 15, 20, 25]

// ============================================================================
// Test MAP functions
// ============================================================================

print(61)  // '='
print(61)
print(61)
print(32)  // ' '
print(77)  // 'M'
print(65)  // 'A'
print(80)  // 'P'
print(32)
print(84)  // 'T'
print(101) // 'e'
print(115) // 's'
print(116) // 't'
print(115) // 's'
print(32)
print(61)
print(61)
print(61)

// Test 1: Map double
numeric doubled[] = map_double(numbers, 5)
numeric i = 0
print(68)  // 'D'
print(111) // 'o'
print(117) // 'u'
print(98)  // 'b'
print(108) // 'l'
print(101) // 'e'
print(100) // 'd'
print(58)  // ':'
print(32)
while i < 5
    print(doubled[i])
    i = i + 1
end

// Expected: 2, 4, 6, 8, 10

// Test 2: Map square
numeric squared[] = map_square(numbers, 5)
i = 0
print(83)  // 'S'
print(113) // 'q'
print(117) // 'u'
print(97)  // 'a'
print(114) // 'r'
print(101) // 'e'
print(100) // 'd'
print(58)
print(32)
while i < 5
    print(squared[i])
    i = i + 1
end
// Expected: 1, 4, 9, 16, 25

// Test 3: Map increment
numeric incremented[] = map_increment(numbers, 5)
i = 0
print(73)  // 'I'
print(110) // 'n'
print(99)  // 'c'
print(114) // 'r'
print(101) // 'e'
print(109) // 'm'
print(101) // 'e'
print(110) // 'n'
print(116) // 't'
print(58)
print(32)
while i < 5
    print(incremented[i])
    i = i + 1
end
// Expected: 2, 3, 4, 5, 6

// ============================================================================
// Test REDUCE functions
