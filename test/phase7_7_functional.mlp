print(61)
print(61)
print(61)
print(32)
print(82)  // 'R'
print(69)  // 'E'
print(68)  // 'D'
print(85)  // 'U'
print(67)  // 'C'
print(69)  // 'E'
print(32)
print(84)  // 'T'
print(101) // 'e'
print(115) // 's'
print(116) // 't'
print(115) // 's'
print(32)
print(61)
print(61)
print(61)

// Test 4: Sum
numeric sum = reduce_sum(numbers, 5)
print(83)  // 'S'
print(117) // 'u'
print(109) // 'm'
print(58)
print(32)
print(sum)
// Expected: 15

// Test 5: Product
numeric product = reduce_product(numbers, 5)
print(80)  // 'P'
print(114) // 'r'
print(111) // 'o'
print(100) // 'd'
print(117) // 'u'
print(99)  // 'c'
print(116) // 't'
print(58)
print(32)
print(product)
// Expected: 120

// Test 6: Max
numeric maximum = reduce_max(values, 5)
print(77)  // 'M'
print(97)  // 'a'
print(120) // 'x'
print(58)
print(32)
print(maximum)
// Expected: 25

// Test 7: Min
numeric minimum = reduce_min(values, 5)
print(77)  // 'M'
print(105) // 'i'
print(110) // 'n'
print(58)
print(32)
print(minimum)
// Expected: 5

