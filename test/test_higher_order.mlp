function apply(numeric a, numeric b, function op)
    return op(a, b)
end

numeric result1 = apply(6, 7, lambda(x, y) => x * y)
print(result1)

numeric result2 = apply(10, 32, lambda(x, y) => x + y)
print(result2)

numeric double_fn = lambda(n) => n * 2
numeric result3 = apply(5, 0, double_fn)
print(result3)
