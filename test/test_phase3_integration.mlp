-- Phase 3 Integration Test
-- Tests File I/O and String Operations

function test_file_io() then
    string content = "Hello, MLP Phase 3!";
    int result = 0;
    string read_content = "";
    int exists = 0;
    int size = 0;

    -- Write file
    result = write_file("/tmp/mlp_test.txt", content)
    print "File write result: "
    print result

    -- Read file
    read_content = read_file("/tmp/mlp_test.txt")
    print "Read content: "
    print read_content

    -- Check file exists
    exists = file_exists("/tmp/mlp_test.txt")
    print "File exists: "
    print exists

    -- Get file size
    size = file_size("/tmp/mlp_test.txt")
    print "File size: "
    print size

    return 0
end

function test_string_ops() then
    string text = "hello world";
    string upper = "";
    string lower = "";
    string replaced = "";
    string trimmed = "";
    int pos = 0;
    int starts = 0;
    int ends = 0;

    -- Uppercase
    upper = string_upper(text)
    print "Uppercase: "
    print upper

    -- Lowercase
    lower = string_lower("HELLO")
    print "Lowercase: "
    print lower

    -- Replace
    replaced = string_replace(text, "world", "MLP")
    print "Replaced: "
    print replaced

    -- Trim
    trimmed = string_trim("  hello  ")
    print "Trimmed: "
    print trimmed

    -- Find
    pos = string_find(text, "world")
    print "Find position: "
    print pos

    -- Starts with
    starts = string_starts_with(text, "hello")
    print "Starts with: "
    print starts

    -- Ends with
    ends = string_ends_with(text, "world")
    print "Ends with: "
    print ends

    return 0
end

-- Run tests
print "=== Phase 3 Integration Tests ==="
print ""

print "--- File I/O Tests ---"
test_file_io()

print ""
print "--- String Operations Tests ---"
test_string_ops()

print ""
print "=== All Tests Complete! ==="
