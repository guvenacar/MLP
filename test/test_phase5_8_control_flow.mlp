-- Phase 5.8: Control Flow & Debugging Test
-- Ternary operator, break, continue, stop, goto, labels

print "=== Phase 5.8: Control Flow & Debugging ==="

-- 1. Ternary Operator (?:)
print ""
print "1. Ternary Operator"
int x = 10;
int y = 5;
int max = x > y ? x : y;
print "max(10, 5) = "
print max

int min = x < y ? x : y;  
print "min(10, 5) = "
print min

-- Nested ternary
int a = 15;
int b = 10;
int c = 20;
int largest = a > b ? (a > c ? a : c) : (b > c ? b : c);
print "largest(15, 10, 20) = "
print largest

-- Ternary with strings (result in int for now)
int result = 5 > 3 ? 1 : 0;
print "5 > 3 ? 1 : 0 = "
print result

-- 2. Break Statement
print ""
print "2. Break Statement"
print "Loop with break at 5:"
int i = 0;
while i < 10 do
    if i == 5 then
        break
    end
    print i
    i = i + 1
end

-- 3. Continue Statement
print ""
print "3. Continue Statement"
print "Loop skipping even numbers:"
int j = 0;
while j < 10 do
    j = j + 1
    if j % 2 == 0 then
        continue
    end
    print j
end

-- 4. Break and Continue in For Loop
print ""
print "4. For loop with break/continue"
print "For loop 1-20, skip multiples of 3, break at 15:"
for k = 1 to 20 do
    if k % 3 == 0 then
        continue
    end
    if k > 15 then
        break
    end
    print k
end

-- 5. Goto and Labels
print ""
print "5. Goto and Labels"
print "Testing goto forward:"
int m = 0;
goto skip_section
m = 100
skip_section:
print "After goto, m = "
print m

print "Testing goto in loop:"
int n = 0;
loop_start:
print n
n = n + 1
if n < 5 then
    goto loop_start
end

-- 6. Stop (Debugging Breakpoint)
-- Uncomment to test with debugger:
-- print ""
-- print "6. Stop (will trigger breakpoint)"
-- stop

-- 7. Complex Example: Ternary + Break + Continue
print ""
print "7. Complex: Find first odd number > 10 in range"
int num = 0;
for search = 0 to 30 do
    if search % 2 == 0 then
        continue
    end
    int found = search > 10 ? 1 : 0;
    if found == 1 then
        num = search
        break
    end
end
print "Found: "
print num

print ""
print "=== Phase 5.8: All Tests Complete ==="
