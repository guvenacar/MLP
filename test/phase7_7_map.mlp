// Phase 7.7: Map Functions (In-Place Transformation)
// Since we can't return arrays yet, map functions modify array in-place

// map_double_inplace: Double each element (modifies original)
function map_double_inplace(arr[], size)
    numeric i = 0
    while i < size
        arr[i] = arr[i] * 2
        i = i + 1
    end
end

// map_square_inplace: Square each element
function map_square_inplace(arr[], size)
    numeric i = 0
    while i < size
        arr[i] = arr[i] * arr[i]
        i = i + 1
    end
end

// map_increment_inplace: Add 1 to each element
function map_increment_inplace(arr[], size)
    numeric i = 0
    while i < size
        arr[i] = arr[i] + 1
        i = i + 1
    end
end

// map_negate_inplace: Negate each element
function map_negate_inplace(arr[], size)
    numeric i = 0
    while i < size
        arr[i] = 0 - arr[i]
        i = i + 1
    end
end

// Test map functions
numeric data1[] = [1, 2, 3, 4, 5]
map_double_inplace(data1, 5)
print(data1[0])  // 2
print(data1[1])  // 4
print(data1[2])  // 6
print(data1[3])  // 8
print(data1[4])  // 10

numeric data2[] = [1, 2, 3, 4, 5]
map_square_inplace(data2, 5)
print(data2[0])  // 1
print(data2[1])  // 4
print(data2[2])  // 9
print(data2[3])  // 16
print(data2[4])  // 25

numeric data3[] = [10, 20, 30]
map_increment_inplace(data3, 3)
print(data3[0])  // 11
print(data3[1])  // 21
print(data3[2])  // 31
