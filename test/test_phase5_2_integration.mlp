-- Phase 5.2 Integration Test

function test_error_handling() then
    int code = 0;
    int dummy_error = 0;
    
    print "=== Error Handling Test ==="

    -- Test error code functions
    dummy_error = set_error_code(42)
    code = get_error_code()
    print "Error code: "
    print code

    -- Test assert (should pass)
    dummy_error = assert(1, "This should pass")
    print "Assert passed"

    -- Note: panic and exit_with_code will terminate program
    print "panic() and exit_with_code() tests in separate files"

    return 0
end

function test_memory_management() then
    int buffer = 0;
    int before = 0;
    int after = 0;
    int array = 0;
    int buf2 = 0;
    int dummy_mem = 0;
    
    print "=== Memory Management Test ==="

    -- Test malloc/free
    buffer = mlp_malloc(256)
    print "Allocated 256 bytes"

    before = get_allocated_bytes()
    print "Allocated bytes: "
    print before

    dummy_mem = mlp_free(buffer)
    print "Freed buffer"

    after = get_allocated_bytes()
    print "Allocated bytes after free: "
    print after

    -- Test calloc
    array = mlp_calloc(10, 8)
    print "Allocated 10x8 bytes with calloc"
    dummy_mem = mlp_free(array)

    -- Test realloc
    buf2 = mlp_malloc(100)
    buf2 = mlp_realloc(buf2, 200)
    print "Reallocated from 100 to 200 bytes"
    dummy_mem = mlp_free(buf2)

    return 0
end

function test_system_utilities() then
    string home = "";
    int timestamp = 0;
    int dummy_sys = 0;
    
    print "=== System Utilities Test ==="

    -- Test get_env
    home = get_env("HOME")
    print "HOME env var: "
    print home

    -- Test current_timestamp
    timestamp = current_timestamp()
    print "Current timestamp: "
    print timestamp

    -- Test sleep_ms
    print "Sleeping for 100ms..."
    dummy_sys = sleep_ms(100)
    print "Awake!"

    return 0
end

function run_all_tests() then
    int leaks = 0;
    int dummy_main = 0;
    
    print "==================================="
    print "Phase 5.2 Integration Tests"
    print "==================================="
    print ""

    dummy_main = test_error_handling()
    print ""

    dummy_main = test_memory_management()
    print ""

    dummy_main = test_system_utilities()
    print ""

    -- Check for memory leaks at end
    leaks = check_memory_leaks()
    if leaks == 0 then
        print "No memory leaks detected!"
    end

    print "==================================="
    print "All Tests Complete!"
    print "==================================="
    
    return 0
end

run_all_tests()
