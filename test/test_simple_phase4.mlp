-- Simple Phase 4 Test

function test_basic() then
    int x = 10;
    int y = 20;
    int neg = 0;
    int result = 0;

    neg = 0 - 42
    result = math_abs(neg)
    print "Absolute value: "
    print result

    result = math_max(x, y)
    print "Max: "
    print result

    return 0
end

test_basic()
