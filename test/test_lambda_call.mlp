// Phase 7.2: Lambda Function Call Test
// Testing function pointer calls

// Test 1: Simple lambda call
numeric double = lambda(x) => x * 2
numeric result1 = double(5)
print result1  // Should print 10

// Test 2: Lambda with addition
numeric add10 = lambda(n) => n + 10
numeric result2 = add10(32)
print result2  // Should print 42

// Test 3: Two parameter lambda
numeric multiply = lambda(a, b) => a * b
numeric result3 = multiply(6, 7)
print result3  // Should print 42
