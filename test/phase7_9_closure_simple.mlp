-- Phase 7.9: Simple Closure Test
-- Closure: Lambda captures variable from outer scope

function make_adder(x)
    -- Lambda captures 'x' from outer function scope
    return lambda(y) => x + y
end

numeric add_5 = make_adder(5)
numeric result1 = add_5(10)  -- Should be 15 (5 + 10)
print "Result 1: " + str(result1)

numeric add_100 = make_adder(100)
numeric result2 = add_100(23)  -- Should be 123 (100 + 23)
print "Result 2: " + str(result2)

-- Multiple closures with different captured values
numeric add_7 = make_adder(7)
numeric result3 = add_7(3)  -- Should be 10 (7 + 3)
print "Result 3: " + str(result3)
