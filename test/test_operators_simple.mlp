print "=== Testing Modulo and Logical Operators ==="

print "Modulo: 10 % 3 ="
print 10 % 3

print "Modulo: 17 % 5 ="
print 17 % 5

print "Logical AND: 1 and 1 ="
print 1 and 1

print "Logical AND: 1 and 0 ="
print 1 and 0

print "Logical OR: 1 or 0 ="
print 1 or 0

print "Logical OR: 0 or 0 ="
print 0 or 0

print "=== Tests Complete ==="
