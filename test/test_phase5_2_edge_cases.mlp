function test_calloc_zero_count() then
    print "Test: Calloc Zero Count"

    int ptr = mlp_calloc(0, 100)
    if ptr == 0 then
        print "  PASS: calloc(0, 100) returns NULL"
        passed = passed + 1
    else
        print "  FAIL: calloc(0, 100) should return NULL"
        mlp_free(ptr)
        failed = failed + 1
    end

    print ""
    return 0
end

-- ==================== Edge Case: Calloc Zero Size ====================

function test_calloc_zero_size() then
    print "Test: Calloc Zero Size"

    int ptr = mlp_calloc(100, 0)
    if ptr == 0 then
        print "  PASS: calloc(100, 0) returns NULL"
        passed = passed + 1
    else
        print "  FAIL: calloc(100, 0) should return NULL"
        mlp_free(ptr)
        failed = failed + 1
    end

    print ""
    return 0
end

-- ==================== Stress Test: Rapid Alloc/Free Cycles ====================

function test_rapid_cycles() then
    print "Test: Rapid Alloc/Free Cycles"

    int i = 0
    int success = 1
    
    while i < 50 then
        int ptr1 = mlp_malloc(100)
        int ptr2 = mlp_malloc(200)
        int ptr3 = mlp_malloc(300)
        
        if ptr1 == 0 then success = 0 end
        if ptr2 == 0 then success = 0 end
        if ptr3 == 0 then success = 0 end
        
        mlp_free(ptr2)
        mlp_free(ptr1)
        mlp_free(ptr3)
        
        i = i + 1
    end

    if success == 1 then
        print "  PASS: All rapid cycles succeeded"
        passed = passed + 1
    else
        print "  FAIL: Some rapid cycles failed"
        failed = failed + 1
    end

    print ""
    return 0
end

-- ==================== Edge Case: Realloc Same Size ====================

function test_realloc_same_size() then
    print "Test: Realloc Same Size"

    int buffer = mlp_malloc(256)
    if buffer == 0 then
        print "  FAIL: Initial malloc failed"
        failed = failed + 1
        return 0
    end

    int old_buffer = buffer
    buffer = mlp_realloc(buffer, 256)
    
    if buffer != 0 then
        print "  PASS: realloc same size succeeded"
        passed = passed + 1
    else
        print "  FAIL: realloc same size failed"
        failed = failed + 1
        mlp_free(old_buffer)
        return 0
    end

    mlp_free(buffer)

    print ""
    return 0
end

-- ==================== Stress Test: Nested Allocations ====================

function allocate_nested(depth) then
    if depth == 0 then
        return 1
    end
    
    int ptr = mlp_malloc(100)
    if ptr == 0 then
        return 0
    end
    
    int result = allocate_nested(depth - 1)
    mlp_free(ptr)
    return result
end

function test_nested_allocations() then
    print "Test: Nested Allocations (Recursion)"

    int result = allocate_nested(10)
    if result == 1 then
        print "  PASS: Nested allocations succeeded"
        passed = passed + 1
    else
        print "  FAIL: Nested allocations failed"
        failed = failed + 1
    end

    print ""
    return 0
end

-- ==================== Edge Case: Multiple Error Code Changes ====================

function test_error_code_changes() then
    print "Test: Multiple Error Code Changes"

    set_error_code(1)
    set_error_code(2)
    set_error_code(3)
    set_error_code(4)
    set_error_code(5)
    
    int final = get_error_code()
    if final == 5 then
        print "  PASS: Error code retained last value"
        passed = passed + 1
    else
        print "  FAIL: Error code not retained correctly"
        failed = failed + 1
    end

    set_error_code(0)
    print ""
    return 0
end

-- ==================== Stress Test: Interleaved Operations ====================

function test_interleaved_operations() then
    print "Test: Interleaved Operations"

    int ptr1 = mlp_malloc(100)
    set_error_code(10)
    int ptr2 = mlp_malloc(200)
    int code1 = get_error_code()
    mlp_free(ptr1)
    set_error_code(20)
    int ptr3 = mlp_malloc(300)
    int code2 = get_error_code()
    mlp_free(ptr2)
    mlp_free(ptr3)

    if code1 == 10 then
        if code2 == 20 then
            print "  PASS: Interleaved operations work correctly"
            passed = passed + 1
        else
            print "  FAIL: Second error code incorrect"
            failed = failed + 1
        end
    else
        print "  FAIL: First error code incorrect"
        failed = failed + 1
    end

    set_error_code(0)
    print ""
    return 0
end

-- ==================== Edge Case: Assert with Zero ====================

function test_assert_zero() then
    print "Test: Assert with Various Values"

    -- These should all pass (non-zero)
    assert(1, "1 is truthy")
    assert(-1, "−1 is truthy")
    assert(100, "100 is truthy")
    
    print "  PASS: Non-zero assertions passed"
    passed = passed + 1

    print ""
    return 0
end

-- ==================== Run All Tests ====================

test_zero_size_allocation()
test_negative_size()
test_free_null()
test_large_allocation()
test_many_small_allocations()
test_realloc_chain()
test_error_code_boundaries()
test_calloc_zero_count()
test_calloc_zero_size()
test_rapid_cycles()
test_realloc_same_size()
test_nested_allocations()
test_error_code_changes()
test_interleaved_operations()
test_assert_zero()

print "===================================="
print "Results:"
print "  Passed: "
print passed
print "  Failed: "
print failed
print "===================================="

int final_leaks = check_memory_leaks()
if final_leaks == 0 then
    print "No memory leaks!"
else
    print "WARNING: "
    print final_leaks
    print " memory leaks detected!"
end

if failed > 0 then
    exit_with_code(1)
end

exit_with_code(0)
