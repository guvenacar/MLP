// Test Time & Date Utilities (Phase 5.3)

function main() then
    print("=== Time & Date Utilities Test ===\n")
    
    // Test 1: format_timestamp
    print("\n1. Testing format_timestamp():\n")
    timestamp = 1704067200  // 2024-01-01 00:00:00 UTC
    formatted = format_timestamp(timestamp, "%Y-%m-%d %H:%M:%S")
    print("  Formatted: ")
    print(formatted)
    print("\n")
    
    // Test 2: parse_timestamp
    print("\n2. Testing parse_timestamp():\n")
    date_str = "2024-01-01 12:30:45"
    parsed = parse_timestamp(date_str)
    print("  Parsed timestamp: ")
    print_int(parsed)
    print("\n")
    
    // Test 3: get_milliseconds (profiling)
    print("\n3. Testing get_milliseconds():\n")
    start_ms = get_milliseconds()
    print("  Start: ")
    print_long(start_ms)
    print(" ms\n")
    
    // Do some work with a simple loop
    counter = 0
    limit = 1000
    while counter < limit do
        counter = counter + 1
    end
    
    end_ms = get_milliseconds()
    print("  End: ")
    print_long(end_ms)
    print(" ms\n")
    
    // Test 4: get_time_string
    print("\n4. Testing get_time_string():\n")
    time_str = get_time_string()
    print("  Current time: ")
    print(time_str)
    print("\n")
    
    print("\n=== All time utilities tests completed ===\n")
    return 0
end
