# Benchmark: Performance Tests - Phase 4
# Tests performance of hash maps, type conversions, and math operations

def benchmark_hash_map_insert():
    """Benchmark hash map insertion performance"""
    print("\n=== Benchmark 1: Hash Map Insert ===")
    
    map = HashMap()
    iterations = 1000
    
    print("Inserting " + int_to_string(iterations) + " items...")
    
    i = 0
    while i < iterations:
        key = "key_" + int_to_string(i)
        map.set(key, i)
        i = i + 1
    
    assert map.size() == iterations, "All items should be inserted"
    print("✅ Inserted " + int_to_string(iterations) + " items successfully")

def benchmark_hash_map_lookup():
    """Benchmark hash map lookup performance"""
    print("\n=== Benchmark 2: Hash Map Lookup ===")
    
    map = HashMap()
    
    # Prepare data
    i = 0
    while i < 500:
        key = "key_" + int_to_string(i)
        map.set(key, i)
        i = i + 1
    
    print("Performing 1000 lookups...")
    
    # Perform lookups
    lookups = 0
    while lookups < 1000:
        key_idx = lookups % 500
        key = "key_" + int_to_string(key_idx)
        val = map.get(key)
        assert val == key_idx, "Lookup should return correct value"
        lookups = lookups + 1
    
    print("✅ Completed 1000 lookups successfully")

def benchmark_hash_map_remove():
    """Benchmark hash map removal performance"""
    print("\n=== Benchmark 3: Hash Map Remove ===")
    
    map = HashMap()
    
    # Insert 500 items
    i = 0
    while i < 500:
        key = "key_" + int_to_string(i)
        map.set(key, i)
        i = i + 1
    
    print("Removing 250 items...")
    
    # Remove half
    i = 0
    while i < 250:
        key = "key_" + int_to_string(i * 2)
        map.remove(key)
        i = i + 1
    
    assert map.size() == 250, "Half items should remain"
    print("✅ Removed 250 items, 250 remain")

def benchmark_hash_map_mixed():
    """Benchmark mixed hash map operations"""
    print("\n=== Benchmark 4: Mixed Operations ===")
    
    map = HashMap()
    
    print("Performing 1000 mixed operations...")
    
    i = 0
    while i < 1000:
        op = i % 4
        
        if op == 0:
            # Insert
            key = "k" + int_to_string(i)
            map.set(key, i)
        
        if op == 1:
            # Lookup
            if i > 0:
                key = "k" + int_to_string(i - 1)
                val = map.get(key)
        
        if op == 2:
            # Update
            if i > 1:
                key = "k" + int_to_string(i - 2)
                map.set(key, i * 2)
        
        if op == 3:
            # Remove
            if i > 3:
                key = "k" + int_to_string(i - 4)
                map.remove(key)
        
        i = i + 1
    
    print("✅ Completed 1000 mixed operations")
    print("Final size: " + int_to_string(map.size()))

def benchmark_type_conversion():
    """Benchmark type conversion performance"""
    print("\n=== Benchmark 5: Type Conversion ===")
    
    print("Performing 1000 conversions...")
    
    i = 0
    while i < 1000:
        # Int to string and back
        str1 = int_to_string(i)
        int1 = string_to_int(str1)
        assert int1 == i, "Conversion failed"
        
        # Float to string and back
        f = i + 0.5
        str2 = float_to_string(f)
        float1 = string_to_float(str2)
        
        # Bool to string and back
        b = i % 2
        str3 = bool_to_string(b)
        bool1 = string_to_bool(str3)
        
        i = i + 1
    
    print("✅ Completed 1000 conversion cycles")

def benchmark_math_sqrt():
    """Benchmark square root performance"""
    print("\n=== Benchmark 6: Square Root ===")
    
    print("Computing 1000 square roots...")
    
    i = 1
    while i <= 1000:
        f = i + 0.0
        result = math_sqrt(f)
        # Verify it's positive
        assert result >= 0.0, "sqrt should be positive"
        i = i + 1
    
    print("✅ Computed 1000 square roots")

def benchmark_math_pow():
    """Benchmark power function performance"""
    print("\n=== Benchmark 7: Power Function ===")
    
    print("Computing 1000 power operations...")
    
    i = 1
    while i <= 1000:
        base = (i % 10) + 1.0  # 1-10
        exp = (i % 5) + 0.0    # 0-4
        result = math_pow(base, exp)
        assert result >= 0.0, "pow result should be valid"
        i = i + 1
    
    print("✅ Computed 1000 power operations")

def benchmark_math_trig():
    """Benchmark trigonometric functions"""
    print("\n=== Benchmark 8: Trigonometry ===")
    
    print("Computing 300 trig operations (sin/cos/tan)...")
    
    i = 0
    while i < 100:
        angle = i * 0.0314  # ~0 to ~3.14 (π)
        
        sin_val = math_sin(angle)
        cos_val = math_cos(angle)
        tan_val = math_tan(angle)
        
        # Verify in valid range
        assert sin_val >= -1.1 and sin_val <= 1.1, "sin in range"
        assert cos_val >= -1.1 and cos_val <= 1.1, "cos in range"
        
        i = i + 1
    
    print("✅ Computed 300 trig operations")

def benchmark_math_rounding():
    """Benchmark rounding functions"""
    print("\n=== Benchmark 9: Rounding Operations ===")
    
    print("Performing 1000 rounding operations...")
    
    i = 0
    while i < 1000:
        f = i * 0.123  # Creates various decimals
        
        r1 = math_round(f)
        r2 = math_floor(f)
        r3 = math_ceil(f)
        
        # floor <= round <= ceil
        assert r2 <= r1, "floor <= round"
        assert r1 <= r3, "round <= ceil"
        
        i = i + 1
    
    print("✅ Completed 1000 rounding operations")

def benchmark_combined_stress():
    """Combined stress test - all operations"""
    print("\n=== Benchmark 10: Combined Stress Test ===")
    
    map = HashMap()
    
    print("Running 500 iterations of combined operations...")
    
    i = 0
    while i < 500:
        # Hash map operation
        key = "key_" + int_to_string(i)
        map.set(key, i)
        
        # Type conversion
        str_val = int_to_string(i)
        int_val = string_to_int(str_val)
        
        # Math operation
        f = i + 1.0
        sqrt_val = math_sqrt(f)
        pow_val = math_pow(2.0, 3.0)
        
        # Min/max
        min_val = math_min(i, 100)
        max_val = math_max(i, 50)
        
        # Verification
        assert map.has(key) == 1, "Key should exist"
        assert int_val == i, "Conversion should work"
        assert sqrt_val > 0.0, "sqrt should be positive"
        
        i = i + 1
    
    assert map.size() == 500, "All items inserted"
    print("✅ Completed 500 combined stress iterations")
    print("   - 500 hash map operations")
    print("   - 500 type conversions")
    print("   - 2500 math operations")

def benchmark_memory_intensive():
    """Memory-intensive benchmark"""
    print("\n=== Benchmark 11: Memory Intensive ===")
    
    print("Creating multiple large hash maps...")
    
    # Create 5 maps with 100 items each
    map1 = HashMap()
    map2 = HashMap()
    map3 = HashMap()
    map4 = HashMap()
    map5 = HashMap()
    
    i = 0
    while i < 100:
        key = "k" + int_to_string(i)
        map1.set(key, i)
        map2.set(key, i * 2)
        map3.set(key, i * 3)
        map4.set(key, i * 4)
        map5.set(key, i * 5)
        i = i + 1
    
    # Verify all independent
    assert map1.get("k50") == 50, "Map1 correct"
    assert map2.get("k50") == 100, "Map2 correct"
    assert map3.get("k50") == 150, "Map3 correct"
    assert map4.get("k50") == 200, "Map4 correct"
    assert map5.get("k50") == 250, "Map5 correct"
    
    total_items = map1.size() + map2.size() + map3.size() + map4.size() + map5.size()
    print("✅ Created 5 maps with " + int_to_string(total_items) + " total items")

def benchmark_sequential_access():
    """Benchmark sequential access patterns"""
    print("\n=== Benchmark 12: Sequential Access ===")
    
    map = HashMap()
    
    # Insert 1000 sequential items
    print("Sequential insert of 1000 items...")
    i = 0
    while i < 1000:
        key = int_to_string(i)
        map.set(key, i)
        i = i + 1
    
    # Sequential read
    print("Sequential read of 1000 items...")
    i = 0
    while i < 1000:
        key = int_to_string(i)
        val = map.get(key)
        assert val == i, "Sequential read failed"
        i = i + 1
    
    print("✅ Sequential access: 1000 writes + 1000 reads")

# Main benchmark execution
def main():
    print("╔══════════════════════════════════════╗")
    print("║   Performance Benchmarks - Phase 4  ║")
    print("╚══════════════════════════════════════╝")
    print("")
    print("Testing performance of:")
    print("  - Hash map operations")
    print("  - Type conversions")
    print("  - Math operations")
    print("")
    
    # Hash map benchmarks
    benchmark_hash_map_insert()
    benchmark_hash_map_lookup()
    benchmark_hash_map_remove()
    benchmark_hash_map_mixed()
    
    # Type conversion benchmarks
    benchmark_type_conversion()
    
    # Math benchmarks
    benchmark_math_sqrt()
    benchmark_math_pow()
    benchmark_math_trig()
    benchmark_math_rounding()
    
    # Stress tests
    benchmark_combined_stress()
    benchmark_memory_intensive()
    benchmark_sequential_access()
    
    print("\n╔══════════════════════════════════════╗")
    print("║    All Benchmarks Completed! ✅      ║")
    print("╚══════════════════════════════════════╝")

# Run benchmarks
main()
