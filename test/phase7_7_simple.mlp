// Phase 7.7: Simple Functional Test
// Test reduce functions (don't need array returns)

// Helper function: Sum array
function sum_array(arr[], size)
    numeric total = 0
    numeric i = 0
    while i < size
        total = total + arr[i]
        i = i + 1
    end
    return total
end

// Helper: Product
function product_array(arr[], size)
    numeric result = 1
    numeric i = 0
    while i < size
        result = result * arr[i]
        i = i + 1
    end
    return result
end

// Helper: Max
function max_array(arr[], size)
    numeric max_val = arr[0]
    numeric i = 1
    while i < size
        if arr[i] > max_val then
            max_val = arr[i]
        end
        i = i + 1
    end
    return max_val
end

// Helper: Min
function min_array(arr[], size)
    numeric min_val = arr[0]
    numeric i = 1
    while i < size
        if arr[i] < min_val then
            min_val = arr[i]
        end
        i = i + 1
    end
    return min_val
end

// Helper: Count positive
function count_positive(arr[], size)
    numeric count = 0
    numeric i = 0
    while i < size
        if arr[i] > 0 then
            count = count + 1
        end
        i = i + 1
    end
    return count
end

// Test data
numeric numbers[] = [1, 2, 3, 4, 5]
numeric values[] = [5, 10, 15, 20, 25]

// Create mixed array manually (negative literals not supported in array init)
numeric mixed[] = [0, 0, 0, 0, 0]
mixed[0] = 0 - 2  // -2
mixed[1] = 0 - 1  // -1
mixed[2] = 0
mixed[3] = 1
mixed[4] = 2

// Test reduce operations
print(sum_array(numbers, 5))      // Expected: 15
print(product_array(numbers, 5))  // Expected: 120
print(max_array(values, 5))       // Expected: 25
print(min_array(values, 5))       // Expected: 5
print(count_positive(mixed, 5))   // Expected: 2
