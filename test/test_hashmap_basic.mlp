-- Hash Map Basic Tests - Phase 4
-- Tests fundamental hash map operations in MLP

-- Test 1: String-Int Map
function test_string_int_map() then
    map[string:int] ages = map();
    int result = 0;
    int size = 0;

    print "=== Test 1: String-Int Map ===";

    -- Initial size should be 0
    size = ages.size();
    if size == 0 then
        print "✅ Initial size: 0"
    else
        print "❌ Initial size failed"
    end

    -- Set values
    ages.set("Alice", 25);
    ages.set("Bob", 30);
    ages.set("Charlie", 35);

    size = ages.size();
    if size == 3 then
        print "✅ After 3 inserts: 3"
    else
        print "❌ Size after insert failed"
    end

    -- Get values
    result = ages.get("Alice");
    if result == 25 then
        print "✅ Alice's age: 25"
    else
        print "❌ Get Alice failed"
    end

    result = ages.get("Bob");
    if result == 30 then
        print "✅ Bob's age: 30"
    else
        print "❌ Get Bob failed"
    end

    -- Has key
    result = ages.has("Alice");
    if result == 1 then
        print "✅ Has Alice: true"
    else
        print "❌ Has check failed"
    end

    result = ages.has("David");
    if result == 0 then
        print "✅ Has David: false"
    else
        print "❌ Has non-existent failed"
    end

    -- Remove
    ages.remove("Bob");
    size = ages.size();
    if size == 2 then
        print "✅ After remove: 2"
    else
        print "❌ Remove failed"
    end

    result = ages.has("Bob");
    if result == 0 then
        print "✅ Bob removed successfully"
    else
        print "❌ Remove verification failed"
    end

    -- Clear
    ages.clear();
    size = ages.size();
    if size == 0 then
        print "✅ After clear: 0"
    else
        print "❌ Clear failed"
    end

    return 1;
end

-- Test 2: Int-String Map
function test_int_string_map() then
    map[int:string] names = map();
    string result = "";
    int size = 0;

    print "";
    print "=== Test 2: Int-String Map ===";

    -- Set values
    names.set(1, "Alice");
    names.set(2, "Bob");
    names.set(3, "Charlie");

    size = names.size();
    if size == 3 then
        print "✅ Size after 3 inserts: 3"
    else
        print "❌ Size check failed"
    end

    -- Get values
    result = names.get(1);
    if string_esit_mi(result, "Alice") then
        print "✅ ID 1: Alice"
    else
        print "❌ Get by int key failed"
    end

    result = names.get(2);
    if string_esit_mi(result, "Bob") then
        print "✅ ID 2: Bob"
    else
        print "❌ Get Bob failed"
    end

    -- Update existing
    names.set(2, "Bobby");
    result = names.get(2);
    if string_esit_mi(result, "Bobby") then
        print "✅ Updated ID 2: Bobby"
    else
        print "❌ Update failed"
    end

    size = names.size();
    if size == 3 then
        print "✅ Size unchanged after update: 3"
    else
        print "❌ Size changed unexpectedly"
    end

    return 1;
end

-- Test 3: String-String Map
function test_string_string_map() then
    map[string:string] translations = map();
    string result = "";
    int size = 0;

    print "";
    print "=== Test 3: String-String Map ===";

    -- Set translations
    translations.set("hello", "merhaba");
    translations.set("world", "dünya");
    translations.set("test", "test");

    size = translations.size();
    if size == 3 then
        print "✅ Size: 3"
    else
        print "❌ Size check failed"
    end

    -- Get translations
    result = translations.get("hello");
    if string_esit_mi(result, "merhaba") then
        print "✅ hello -> merhaba"
    else
        print "❌ Translation failed"
    end

    result = translations.get("world");
    if string_esit_mi(result, "dünya") then
        print "✅ world -> dünya"
    else
        print "❌ Translation failed"
    end

    -- Check non-existent
    int has = translations.has("goodbye");
    if has == 0 then
        print "✅ Non-existent key returns false"
    else
        print "❌ Has check failed"
    end

    return 1;
end

-- Test 4: Multiple Maps
function test_multiple_maps() then
    map[string:int] scores = map();
    map[string:string] grades = map();

    print "";
    print "=== Test 4: Multiple Maps ===";

    -- First map
    scores.set("Alice", 95);
    scores.set("Bob", 87);

    -- Second map
    grades.set("Alice", "A");
    grades.set("Bob", "B");

    int score = scores.get("Alice");
    string grade = grades.get("Alice");

    if score == 95 then
        if string_esit_mi(grade, "A") then
            print "✅ Multiple maps work independently"
        else
            print "❌ Grade retrieval failed"
        end
    else
        print "❌ Score retrieval failed"
    end

    int size1 = scores.size();
    int size2 = grades.size();

    if size1 == 2 then
        if size2 == 2 then
            print "✅ Both maps have correct sizes"
        else
            print "❌ Grades map size wrong"
        end
    else
        print "❌ Scores map size wrong"
    end

    return 1;
end

-- Test 5: Empty Map Operations
function test_empty_map() then
    map[string:int] empty = map();

    print "";
    print "=== Test 5: Empty Map Operations ===";

    -- Size check
    int size = empty.size();
    if size == 0 then
        print "✅ Empty map size: 0"
    else
        print "❌ Empty map size wrong"
    end

    -- Has on empty map
    int has = empty.has("anything");
    if has == 0 then
        print "✅ Has returns false for empty map"
    else
        print "❌ Has check failed"
    end

    -- Clear empty map (should not crash)
    empty.clear();
    size = empty.size();
    if size == 0 then
        print "✅ Clear on empty map works"
    else
        print "❌ Clear failed"
    end

    return 1;
end

-- Run all tests
print "╔══════════════════════════════════════╗";
print "║   Hash Map Basic Tests - Phase 4    ║";
print "╚══════════════════════════════════════╝";
print "";

int total = 0;
int passed = 0;

total = total + 1;
passed = passed + test_string_int_map();

total = total + 1;
passed = passed + test_int_string_map();

total = total + 1;
passed = passed + test_string_string_map();

total = total + 1;
passed = passed + test_multiple_maps();

total = total + 1;
passed = passed + test_empty_map();

print "";
print "╔══════════════════════════════════════╗";
print "║          Test Results                ║";
print "╠══════════════════════════════════════╣";
print "║ Passed: ";
yazdir_sayi(passed);
print "║ Failed: ";
yazdir_sayi(total - passed);
print "║ Total:  ";
yazdir_sayi(total);
print "╚══════════════════════════════════════╝";
