// Phase 7.4: Higher-Order Functions with Lambdas

// Helper function that applies a function to a value
function apply(fn, value)
    return fn(value)
end

// Helper function that applies a binary function
function apply2(fn, x, y)
    return fn(x, y)
end

// Test 1: Pass lambda as argument
numeric double_result = apply(lambda(n) => n * 2, 5)
print double_result  // Expected: 10

// Test 2: Pass lambda to binary function
numeric sum_result = apply2(lambda(a, b) => a + b, 3, 7)
print sum_result  // Expected: 10

// Test 3: Store lambda and pass to function
numeric square_fn = lambda(n) => n * n
numeric square_result = apply(square_fn, 4)
print square_result  // Expected: 16
