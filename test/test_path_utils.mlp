// Test Path Utilities (Phase 5.3)

function main() then
    print("=== Path Utilities Test ===\n")
    
    // Test 1: join_path
    print("\n1. Testing join_path():\n")
    parts = ["home", "user", "documents"]
    joined = join_path(parts, 3)
    print("  Joined path: ")
    print(joined)
    print("\n")
    
    // Test 2: get_file_extension
    print("\n2. Testing get_file_extension():\n")
    
    path1 = "test.mlp"
    ext1 = get_file_extension(path1)
    print("  Extension of '")
    print(path1)
    print("': ")
    print(ext1)
    print("\n")
    
    path2 = "archive.tar.gz"
    ext2 = get_file_extension(path2)
    print("  Extension of '")
    print(path2)
    print("': ")
    print(ext2)
    print("\n")
    
    path3 = "README"
    ext3 = get_file_extension(path3)
    print("  Extension of '")
    print(path3)
    print("': ")
    print(ext3)
    print("\n")
    
    // Test 3: get_file_name
    print("\n3. Testing get_file_name():\n")
    
    full_path1 = "/home/user/test.mlp"
    filename1 = get_file_name(full_path1)
    print("  Filename from '")
    print(full_path1)
    print("': ")
    print(filename1)
    print("\n")
    
    full_path2 = "simple.txt"
    filename2 = get_file_name(full_path2)
    print("  Filename from '")
    print(full_path2)
    print("': ")
    print(filename2)
    print("\n")
    
    // Test 4: get_directory
    print("\n4. Testing get_directory():\n")
    
    dir_path1 = "/home/user/documents/file.txt"
    dir1 = get_directory(dir_path1)
    print("  Directory from '")
    print(dir_path1)
    print("': ")
    print(dir1)
    print("\n")
    
    dir_path2 = "file.txt"
    dir2 = get_directory(dir_path2)
    print("  Directory from '")
    print(dir_path2)
    print("': ")
    print(dir2)
    print("\n")
    
    print("\n=== All path utilities tests completed ===\n")
    return 0
end
