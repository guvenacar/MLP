-- Phase 5.6 Test: const keyword

print "=== Testing const keyword ==="

const int MAX_SIZE = 100;
print "MAX_SIZE: "
print MAX_SIZE

const string APP_NAME = "MLP Compiler";
print "App name: "
print APP_NAME

-- Use const in expression
int buffer_size = MAX_SIZE + 50;
print "Buffer size (MAX_SIZE + 50): "
print buffer_size

print ""
print "=== Phase 5.6 const Test Complete ==="

