// Phase 7.3: Immediate Lambda Call Test
// Testing (lambda(x) => expr)(args) syntax

// Test 1: Simple immediate call
numeric result1 = (lambda(x) => x * 2)(5)
print result1  // Should print 10

// Test 2: With addition
numeric result2 = (lambda(n) => n + 10)(32)
print result2  // Should print 42

// Test 3: Two parameters
numeric result3 = (lambda(a, b) => a * b)(6, 7)
print result3  // Should print 42

// Test 4: Nested expression
numeric result4 = (lambda(x) => x + 5)(10) + (lambda(y) => y * 2)(3)
print result4  // Should print 15 + 6 = 21
