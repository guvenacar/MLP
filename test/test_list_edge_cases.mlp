# lang: en-US
# syntax: mlp

# MLP Dynamic List - Edge Case Tests
# Tests boundary conditions and error handling

print("=== MLP List Edge Case Tests ===")
print("")

# Test 1: Empty list size
print("Test 1: Empty list operations")
list[int] empty = list()
int size = empty.size()
print("Empty list size: ")
print(size)

if size == 0 then
    print("✅ Empty list size is 0")
else
    print("❌ Empty list size wrong")
end if

print("")

# Test 2: Clear on empty list
print("Test 2: Clear on empty list")
empty.clear()
int size_after_clear = empty.size()
print("Size after clear: ")
print(size_after_clear)

if size_after_clear == 0 then
    print("✅ Clear on empty works")
else
    print("❌ Clear on empty failed")
end if

print("")

# Test 3: Add after clear
print("Test 3: Add element after clear")
empty.add(42)
int size_after_add = empty.size()
print("Size after add: ")
print(size_after_add)

if size_after_add == 1 then
    print("✅ Can add after clear")
else
    print("❌ Add after clear failed")
end if

int first_val = empty.get(0)
print("First element: ")
print(first_val)

if first_val == 42 then
    print("✅ Value correct")
else
    print("❌ Value wrong")
end if

print("")

# Test 4: Single element list
print("Test 4: Single element operations")
list[int] single = list()
single.add(100)

int single_size = single.size()
print("Single element list size: ")
print(single_size)

if single_size == 1 then
    print("✅ Size is 1")
else
    print("❌ Size wrong")
end if

int val = single.get(0)
print("Element value: ")
print(val)

if val == 100 then
    print("✅ Element correct")
else
    print("❌ Element wrong")
end if

# Remove single element
single.remove(0)
int size_after_remove = single.size()
print("Size after remove: ")
print(size_after_remove)

if size_after_remove == 0 then
    print("✅ Remove works on single element")
else
    print("❌ Remove failed")
end if

print("")

# Test 5: Boundary index access
print("Test 5: Boundary index access")
list[int] bounds = list()
bounds.add(10)
bounds.add(20)
bounds.add(30)

# First element (index 0)
int first = bounds.get(0)
print("First element (index 0): ")
print(first)

if first == 10 then
    print("✅ First element correct")
else
    print("❌ First element wrong")
end if

# Last element (index size-1)
int last = bounds.get(2)
print("Last element (index 2): ")
print(last)

if last == 30 then
    print("✅ Last element correct")
else
    print("❌ Last element wrong")
end if

print("")

# Test 6: Clear and reuse
print("Test 6: Clear and reuse list")
list[int] reuse = list()
reuse.add(1)
reuse.add(2)
reuse.add(3)
print("Before clear size: ")
print(reuse.size())

reuse.clear()
print("After clear size: ")
print(reuse.size())

# Add new elements
reuse.add(100)
reuse.add(200)
print("After re-adding size: ")
print(reuse.size())

int new_first = reuse.get(0)
int new_second = reuse.get(1)
print("New elements: ")
print(new_first)
print(new_second)

if new_first == 100 then
    if new_second == 200 then
        print("✅ List reuse works")
    else
        print("❌ Second element wrong")
    end if
else
    print("❌ First element wrong")
end if

print("")
print("=== Edge Case Tests Complete ===")
