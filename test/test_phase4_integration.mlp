-- Phase 4 Integration Test
-- Tests: Type conversions, Math operations, Hash maps

-- Test 1: Type Conversions
function test_type_conversions() then
    int num = 42;
    string str = "";
    string result = "";
    int converted = 0;

    print "=== Type Conversion Tests ===";

    -- int_to_string
    str = int_to_string(num);
    print "int_to_string(42): ";
    print str;

    -- string_to_int
    converted = string_to_int("123");
    print "string_to_int('123'): ";
    print converted;

    -- char_to_string
    str = char_to_string(65);
    print "char_to_string(65): ";
    print str;

    -- string_concat
    result = string_concat("Hello", " World");
    print "string_concat: ";
    print result;

    return 0;
end

-- Test 2: Math Operations
function test_math_operations() then
    int a = 10;
    int b = 20;
    int neg = -42;
    int result = 0;

    print "=== Math Operations Tests ===";

    -- math_abs
    result = math_abs(neg);
    print "math_abs(-42): ";
    print result;

    -- math_min
    result = math_min(a, b);
    print "math_min(10, 20): ";
    print result;

    -- math_max
    result = math_max(a, b);
    print "math_max(10, 20): ";
    print result;

    -- math_pow
    result = math_pow(2, 3);
    print "math_pow(2, 3): ";
    print result;

    return 0;
end

-- Test 3: Hash Map Basic Operations
function test_hashmap_basic() then
    map[string:int] ages = map();
    int result = 0;
    int size = 0;

    print "=== Hash Map Basic Tests ===";

    -- Test set
    ages.set("Alice", 25);
    ages.set("Bob", 30);
    ages.set("Charlie", 35);

    -- Test size
    size = ages.size();
    print "Map size after 3 inserts: ";
    print size;

    -- Test get
    result = ages.get("Alice");
    print "Alice's age: ";
    print result;

    result = ages.get("Bob");
    print "Bob's age: ";
    print result;

    -- Test has
    result = ages.has("Charlie");
    print "Has Charlie: ";
    print result;

    result = ages.has("David");
    print "Has David: ";
    print result;

    -- Test remove
    ages.remove("Bob");
    size = ages.size();
    print "Size after removing Bob: ";
    print size;

    result = ages.has("Bob");
    print "Has Bob after remove: ";
    print result;

    -- Test clear
    ages.clear();
    size = ages.size();
    print "Size after clear: ";
    print size;

    return 0;
end

-- Test 4: Hash Map with Different Types
function test_hashmap_types() then
    map[int:string] names = map();
    string name = "";
    int has = 0;

    print "=== Hash Map Type Tests ===";

    -- int keys, string values
    names.set(101, "Alice");
    names.set(102, "Bob");
    names.set(103, "Charlie");

    name = names.get(102);
    print "Employee 102: ";
    print name;

    has = names.has(103);
    print "Has employee 103: ";
    print has;

    return 0;
end

-- Test 5: Integration Test - All Features Combined
function test_integration() then
    map[string:int] scores = map();
    int total = 0;
    int count = 0;
    int max_score = 0;
    string report = "";

    print "=== Integration Test ===";

    -- Add scores
    scores.set("Alice", 95);
    scores.set("Bob", 87);
    scores.set("Charlie", 92);

    count = scores.size();
    print "Total students: ";
    print count;

    -- Calculate total
    total = scores.get("Alice");
    total = total + scores.get("Bob");
    total = total + scores.get("Charlie");

    -- Find max
    max_score = scores.get("Alice");
    int bob_score = scores.get("Bob");
    int charlie_score = scores.get("Charlie");
    max_score = math_max(max_score, bob_score);
    max_score = math_max(max_score, charlie_score);

    print "Total score: ";
    print total;
    print "Max score: ";
    print max_score;

    -- Build report using string operations
    report = string_concat("Summary: ", int_to_string(count));
    report = string_concat(report, " students, ");
    report = string_concat(report, "total=");
    report = string_concat(report, int_to_string(total));
    report = string_concat(report, ", max=");
    report = string_concat(report, int_to_string(max_score));

    print report;

    return 0;
end

-- Test 6: Edge Cases
function test_edge_cases() then
    map[string:int] empty = map();
    int size = 0;
    int has = 0;
    int value = 0;

    print "=== Edge Case Tests ===";

    -- Empty map
    size = empty.size();
    print "Empty map size: ";
    print size;

    has = empty.has("nonexistent");
    print "Has nonexistent key: ";
    print has;

    value = empty.get("nonexistent");
    print "Get nonexistent key: ";
    print value;

    -- Overwrite value
    empty.set("key", 100);
    value = empty.get("key");
    print "Initial value: ";
    print value;

    empty.set("key", 200);
    value = empty.get("key");
    print "Overwritten value: ";
    print value;

    return 0;
end

-- Main test runner
print "====================================";
print "Phase 4 Integration Test Suite";
print "====================================";
print "";

test_type_conversions();
print "";

test_math_operations();
print "";

test_hashmap_basic();
print "";

test_hashmap_types();
print "";

test_integration();
print "";

test_edge_cases();
print "";

print "====================================";
print "All Phase 4 Tests Complete!";
print "====================================";
