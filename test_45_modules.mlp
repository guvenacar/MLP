-- Test 1: Variables (variable module)
numeric x = 10
numeric y = 20
numeric z = 0

-- Test 2: Arithmetic (arithmetic module)
z = x + y
z = x - y
z = x * y
z = x / y
z = x % y

-- Test 3: Comparison (comparison module)
numeric result = 0
if x < y then
    result = 1
end if

if x > y then
    result = 2
end if

if x == y then
    result = 3
end if

if x != y then
    result = 4
end if

-- Test 4: Logical (logical module)
numeric a = 1
numeric b = 0
numeric c = 0

if a && b then
    c = 1
end if

if a || b then
    c = 2
end if

if !a then
    c = 3
end if

-- Test 5: Control Flow (control_flow module)
numeric i = 0
while i < 10 then
    i = i + 1
end while

-- Test 6: Functions (functions module)
function add(numeric x, numeric y) numeric
    numeric result = x + y
    return result
end function

numeric sum = add(5, 3)

