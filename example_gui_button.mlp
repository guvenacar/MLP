-- lang: en-US
-- GUI Example: Button Click Counter

print "=== MLP GUI Demo: Button Counter ==="
print ""

int window = gui_window_create("Counter App", 400, 300);
int label = gui_label_create(window, "Count: 0", 50, 50);
int button = gui_button_create(window, "Click Me!", 50, 100, 150, 40);

int count = 0;
gui_window_show(window)

print ""
print "Starting event loop..."
print ""

-- Event loop (simulated with 3 clicks then quit)
while
    int event = gui_poll_event();

    if event == 1 then
        -- GUI_EVENT_QUIT
        print "Quit event received, exiting..."
        break
    end

    if event == 2 then
        -- GUI_EVENT_BUTTON_CLICK
        int clicked_id = gui_get_clicked_button();
        if clicked_id == button then
            count = count + 1
            print "Button clicked! New count:"
            print count

            -- Update label (simplified, no string concat yet)
            gui_label_set_text(label, "Count updated")
        end
    end
end

print ""
print "Cleaning up..."
gui_window_destroy(window)
print "=== GUI Demo Complete ==="
