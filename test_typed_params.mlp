-- Test: Typed Parameters (Phase 5.10)
-- Bu test typed parameter desteğini doğrular

function greet(string name, numeric age)
    yaz("Hello, " + name)
    yaz("You are " + age + " years old")
end function

function calculate(numeric a, numeric b)
    numeric result = a + b
    yaz("Result: " + result)
    return result
end function

function main()
    greet("Alice", 25)
    greet("Bob", 30)
    
    numeric sum = calculate(10, 20)
    yaz("Sum is: " + sum)
end function
