#!/bin/bash
# MLP Syntax Normalizer
# Converts C-style/Python-style to MLP keyword-style

if [ "$#" -ne 2 ]; then
    echo "Usage: mlp_normalize <input.mlp> <output.mlp>"
    exit 1
fi

INPUT="$1"
OUTPUT="$2"

# Detect syntax style
if grep -q "syntax: c-style" "$INPUT"; then
    STYLE="c-style"
elif grep -q "syntax: python-style" "$INPUT"; then
    STYLE="python-style"
else
    # No normalization needed
    cp "$INPUT" "$OUTPUT"
    exit 0
fi

echo "Normalizing $STYLE syntax..."

# C-style normalization: {} and ; → then/end
if [ "$STYLE" = "c-style" ]; then
    # Simple sed-based transformation
    sed -e 's/)\s*{/ then/g' \
        -e 's/\s*{/ then/g' \
        -e 's/^\s*}$/end if/g' \
        -e 's/;\s*$//' \
        -e '/syntax: c-style/d' \
        "$INPUT" | \
    awk '
    BEGIN { in_if = 0; in_while = 0; }
    /if.*then/ { in_if++; print; next; }
    /while.*then/ { in_while++; print; next; }
    /^end if/ { 
        if (in_if > 0) {
            in_if--;
            if (in_while > 0) {
                print "end while"
                in_while--;
            } else {
                print "end if"
            }
        } else if (in_while > 0) {
            print "end while"
            in_while--;
        } else {
            print
        }
        next;
    }
    { print }
    ' > "$OUTPUT"
fi

# Python-style normalization: : and indentation → then/end
if [ "$STYLE" = "python-style" ]; then
    # Simple approach: : → then, dedent → end
    awk '
    BEGIN { prev_indent = 0; }
    /^[[:space:]]*$/ { print; next; }
    /^--/ { print; next; }
    {
        # Calculate indent
        match($0, /^[[:space:]]*/)
        curr_indent = RLENGTH
        
        # Remove syntax header
        if ($0 ~ /syntax: python-style/) next
        
        # Replace : with then
        gsub(/:$/, " then")
        
        # Detect dedent and insert "end"
        if (curr_indent < prev_indent && prev_indent > 0) {
            for (i = curr_indent; i < prev_indent; i += 4) {
                print "end"
            }
        }
        
        print
        prev_indent = curr_indent
    }
    END {
        # Close remaining blocks
        while (prev_indent > 0) {
            print "end"
            prev_indent -= 4
        }
    }
    ' "$INPUT" > "$OUTPUT"
fi

echo "✅ Normalized: $OUTPUT"
