-- Yeni MLP - Hello World Örneği
-- Türkçe syntax ile yazılmış

işlev main()
    yazdır "Merhaba Dünya!"
    yazdır "Bu yeni MLP ile yazılmış ilk program."
    
    sayısal toplam = 0
    için i = 1 kadar 10 yap
        toplam = toplam + i
    için_bitir
    
    yazdır "1'den 10'a kadar toplam: "
    yazdır toplam
    
    dön 0
işlev_bitir
