-- New MLP - Hello World Example
-- English syntax (normalized)

function main()
    print "Hello World!"
    print "This is the first program with new MLP."
    
    numeric total = 0
    for i = 1 to 10 do
        total = total + i
    end_for
    
    print "Sum from 1 to 10: "
    print total
    
    return 0
end_function
