-- Complex test for Stage1

-- Test 1: Variables and arithmetic
function test_arithmetic()
    numeric a = 10
    numeric b = 20
    numeric c = a + b * 2
    print "Arithmetic test: "
    print c
    return c
end_function

-- Test 2: Conditionals
function test_conditionals(x)
    if x > 10 then
        print "Greater than 10"
        return 1
    else
        print "Less or equal to 10"
        return 0
    end_if
end_function

-- Test 3: Loops
function test_loops()
    numeric sum = 0
    for i = 1 to 5 do
        sum = sum + i
    end_for
    print "Loop sum: "
    print sum
    return sum
end_function

-- Test 4: Struct
struct Point
    numeric x
    numeric y
end_struct

function test_struct()
    Point p
    p.x = 100
    p.y = 200
    print "Point.x: "
    print p.x
    return p.x
end_function

function main()
    print "=== Stage1 Complex Tests ==="
    
    numeric r1 = test_arithmetic()
    numeric r2 = test_conditionals(15)
    numeric r3 = test_loops()
    numeric r4 = test_struct()
    
    print "All tests completed!"
    return 0
end_function
