# Test Enum Support
# lang: en-US
# syntax: mlp

enum TokenType
    TOKEN_INT
    TOKEN_STRING
    TOKEN_KEYWORD
    TOKEN_EOF
end enum

enum Color
    RED
    GREEN
    BLUE
end enum

function main()
    # Test enum variables
    TokenType tok = TOKEN_INT
    Color c = RED
    
    print tok
    print c
    
    # Test enum comparison
    if tok == TOKEN_INT then
        print 100
    end if
    
    if c == RED then
        print 200
    end if
end function
